# Copier en `deploy/.env` (chmod 600) et remplacer chaque `change-me`.
# Ce fichier ne doit jamais entrer dans git : `deploy/.env` est ignoré.
# Détail des variables : docs/deploiement.md.

# --- Secrets ---
# Avec un change-me, l'antenne ne démarre pas. Les quatre secrets de machine
# sont obligatoires et font 24 caractères au moins : les tirer avec
# `openssl rand -hex 24`.
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me
RT_NOWPLAYING_SECRET=change-me
MEILI_MASTER_KEY=change-me
# Compte admin, créé au démarrage s'il n'existe pas. Une fois créé, vider
# RT_ADMIN_PASSWORD : sinon, un compte supprimé revient avec ce mot de passe.
RT_ADMIN_USER=admin
RT_ADMIN_PASSWORD=change-me
# En secours seulement : 1 laisse démarrer avec un secret de machine trop court,
# avec un avertissement à chaque démarrage. Voir docs/deploiement.md, « Les secrets ».
# RT_ALLOW_SHORT_SECRETS=1

# --- Données (chemins de l'hôte ; relatifs à deploy/ si non absolus) ---
RT_DATA=./data/radiotomate
NOWPLAYING_DATA=./data/nowplaying
MEILI_DATA=./data/meilisearch
# Banque de sons : musique, habillage, inbox. Voir deploy/scripts/setup-media-tree.sh.
BUTTON_MEDIA=./media

# --- Ports publiés sur l'hôte ---
CONSOLE_PORT=30126
ICECAST_PORT=18000
NOWPLAYING_PORT=6820
CATALOG_PORT=30127
# Adresse d'écoute de ces quatre ports. Vide, ils écoutent sur toutes les
# interfaces, en IPv4 et en IPv6, et Docker contourne le pare-feu (ufw).
# Sur un VPS, derrière un reverse proxy HTTPS sur la machine, décommenter, et
# laisser les ports sans adresse : seule la machine, reverse proxy compris,
# les joint alors.
# Voir docs/deploiement.md, « Installer ».
# BIND_ADDRESS=127.0.0.1

# --- Cookie de session ---
# Il porte l'attribut Secure : le navigateur ne l'accepte qu'en https://.
# Sans HTTPS devant la console (banc local, réseau privé), décommenter,
# sinon personne ne peut se connecter.
# RT_COOKIE_SECURE=false

# --- En-têtes de sécurité ---
# Rien à régler quand le flux et now.json passent par le domaine de la console.
# Sinon (autre domaine, port 18000 ou 6820), déclarer leurs origines à sa CSP,
# séparées par des espaces. Voir docs/deploiement.md, « Les en-têtes de sécurité ».
# Origine du flux et d'Icecast : entre dans media-src et connect-src.
# CSP_MEDIA_SRC=https://flux.radio.example
# Origine de now.json : entre dans connect-src.
# CSP_CONNECT_SRC=https://titre.radio.example

# --- Images ---
# Registre des images (un fork peut publier les siennes).
BUTTON_IMAGES=ghcr.io/lazbutton
# Vide = `main` (déploiement continu). Un tag daté (AAAAMMJJ-sha7) épingle le
# moteur et le playout, pour geler ou revenir en arrière.
RT_TAG=

# --- Divers ---
# Contact affiché sur la page de statut d'Icecast.
ICECAST_ADMIN_EMAIL=admin@localhost
# Adresse du moteur vue par la console (réseau Docker interne).
BUTTON_BACKEND=http://radiotomate-playout:6811
# Quota de l'inbox (envoi par le navigateur), en octets. Défaut : 100 Go.
INBOX_QUOTA_BYTES=107374182400

# --- Dossier Finder (profil Compose `share`, éteint par défaut) ---
# Nom du volume affiché sur le Mac. Lettres, chiffres, point, tiret.
# STATION_NAME=BUTTON
# Adresse d'écoute. L'interface Tailscale de la machine, jamais 0.0.0.0.
# SMB_BIND=
# Nom annoncé à la console pour smb://. Vide : le dossier n'est pas publié.
# SMB_HOST=
# SMB_ALLOW_PUBLIC=1 n'est posé que pour écouter sur toutes les interfaces.
