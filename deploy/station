#!/usr/bin/env bash
# station : installer une station BUTTON sur un VPS, puis l'exploiter. En root.
#   station install [options]   installer la station, ou la réparer
#   station status              son état ; logs, backup, restore, config,
#                               hold, unhold, cli et uninstall : station help
# Sur un VPS neuf, ce script se télécharge seul, depuis la plus haute version
# publiée. Il prend les fichiers de la station dans la même version, vérifiés
# par leur somme :
#   curl -fsSLO https://github.com/lazbutton/button/releases/latest/download/station
#   sudo bash station install
# Ensuite, il est dans le dossier de la station, et /usr/local/bin/station y
# mène. Voir docs/deploiement.md, « Installer sur un VPS » et « Exploiter la
# station ».
#
# Une commande, une fonction cmd_<nom>, avec les mêmes aides. Viendront ici
# update (MAJ-04) et rollback (MAJ-05).
set -euo pipefail

# Le dépôt dont chaque version publiée joint station, station.tar.gz et
# SHA256SUMS : scripts/version.py station. BUTTON_REPO : celui d'un fork.
REPO=${BUTTON_REPO:-lazbutton/button}
# Pour les tests : une racine à la place de /, pour les fichiers du système.
ROOT=${STATION_ROOT:-}
# Le dossier d'une station, sauf --dir, et la commande posée sur la machine.
DEFAULT_DIR=$ROOT/opt/button
BIN=$ROOT/usr/local/bin/station
# La place libre demandée, en Go : les images en prennent 3 environ, et la
# banque de sons grandit. INS-04 mesurera mieux.
MIN_FREE_GB=10
# L'attente du certificat, en secondes. Celle de la santé du moteur est celle
# de smoke.sh, 300 s ici, ou SMOKE_WAIT.
HTTPS_WAIT=180
# Le conteneur qui répond sur le port 80 pendant la vérification du domaine.
PROBE=button-verification-domaine
# Le format des archives de station backup. restore lit celui-ci et les plus
# anciens : une version plus récente de la commande lit encore une archive
# d'aujourd'hui, et un format nouveau prend le numéro suivant. Dans chaque
# format, l'archive commence par MANIFEST, qui le dit, puis SHA256SUMS, qui
# nomme les autres fichiers : voir backup_station.
BACKUP_FORMAT=1
# Les fichiers d'une archive de ce format, que SHA256SUMS couvre. Puis, avec
# les sons, la banque, sous son nom.
BACKUP_FILES=(MANIFEST radiotomate.tar.gz env caddy.tar.gz)
# La marge de place demandée par une sauvegarde ou une restauration, en Ko.
SPACE_MARGIN_KB=1048576
# Les dossiers de données de la station, que compose.yml monte : la variable
# de .env, et son défaut.
DATA_DIRS=(RT_DATA:./data/radiotomate NOWPLAYING_DATA:./data/nowplaying MEILI_DATA:./data/meilisearch
  CADDY_DATA:./data/caddy BUTTON_MEDIA:./media)
# Les fichiers qu'une version pose dans le dossier, ceux de station.tar.gz :
# station_files, dans scripts/version.py, que test_version.py compare à
# cette liste. uninstall les retire.
VERSION_FILES=(VERSION compose.yml Caddyfile .env.example station scripts)
# Le projet Compose, name dans compose.yml : ses conteneurs et ses volumes
# portent son nom.
PROJECT=button
# Le verrou des commandes qui changent la station, install comprise, hors de
# son dossier, qui peut ne pas exister encore. Dans /run, à root : pas dans
# /run/lock, où tous les comptes écrivent.
LOCK=$ROOT/run/button-station.lock
# Une restauration en cours d'échange l'écrit dans le dossier de la station,
# et l'efface à la fin : resté là, il dit quoi remettre (status le montre).
JOURNAL=restauration-en-cours
# L'heure des mises à jour automatiques, à celle de la station (TZ), quand
# BUTTON_UPDATE_TIME manque à .env. La commande update (MAJ-04) la lira.
UPDATE_TIME=04:00
# Ce que cleanup défait en sortant : le dossier de travail ; le conteneur de
# la vérification du domaine s'il tourne encore ; Caddy, arrêté pour elle ;
# une archive à moitié écrite ; une restauration interrompue ; ce qu'elle
# préparait. caddy_stopped et station_stopped portent le dossier de la
# station : cleanup ne voit pas toujours les variables locales des commandes.
work=""
probe_started=""
caddy_stopped=""
partial=""
station_stopped=""
swapped=()
prepared=()
restart_others=()
# Sans --yes, une question se pose au clavier. Une interruption au clavier
# dit ce message.
assume_yes=""
aborted="Installation interrompue : rien n'est écrit. Relancer station install."

say() { printf '%s\n' "$@"; }
warn() { printf 'Attention : %s\n' "$@" >&2; }
# Un échec : ce qui ne va pas, puis quoi faire.
die() {
  printf '%s\n' "$@" >&2
  exit 1
}
# L'aide à lire : celle de la commande en cours, que main pose.
help_topic=""
usage_error() {
  printf '%s\n' "$1" "Voir : station help${help_topic:+ $help_topic}." >&2
  exit 2
}

usage() {
  cat <<'EOF'
Usage : station COMMANDE [options]

La commande d'une station BUTTON sur un VPS, en root.

  install        installer la station, ou la réparer
  status         son état : version, services, disque, prochain direct
  logs           ses journaux
  backup         la sauvegarder, sans couper l'antenne
  restore        remettre une sauvegarde, ici ou sur une autre machine
  config         voir ou changer le domaine, l'e-mail, les mises à jour
  hold, unhold   bloquer, débloquer les mises à jour
  cli            une commande du moteur, radiotomate
  uninstall      la désinstaller

L'aide d'une commande : station help COMMANDE. Chacune prend --dir DOSSIER,
pour une station ailleurs que dans le dossier de la commande ou /opt/button.

Voir docs/deploiement.md, « Exploiter la station ».
EOF
}

# L'aide d'une commande.
usage_command() { # commande
  case $1 in
    install) usage_install ;;
    status)
      cat <<'EOF'
Usage : station status [--dir DOSSIER]

L'état de la station, sans rien changer : sa version et la plus haute
publiée, ses services, la place sur le disque, le prochain direct, la
dernière sauvegarde, et les mises à jour, bloquées ou non. Sort en erreur
quand un service ne va pas.
EOF
      ;;
    logs)
      cat <<'EOF'
Usage : station logs [SERVICE…] [options] [--dir DOSSIER]

Les journaux de la station, ou de ses services nommés : les 200 dernières
lignes. Les options vont à docker compose logs : -f les suit, --tail 50 ou
--since 1h en prennent d'autres. Les services : station status.
EOF
      ;;
    backup)
      cat <<'EOF'
Usage : station backup [ARCHIVE] [--with-media] [--dir DOSSIER]

Sauvegarde la station sans couper l'antenne : la base, avec les comptes, les
horloges, l'Agenda et les réglages, radiotomate.yaml, .env et les certificats
de Caddy. --with-media y met aussi la banque de sons.

ARCHIVE : le fichier à écrire, ou un dossier où l'écrire. Sinon, backups/,
dans le dossier de la station, sous le nom button-AAAAMMJJTHHMMSSZ.tar.
L'archive est en droits 600, à root : elle porte les secrets de .env, hors du
mot de passe admin. Elle se remet par station restore.
EOF
      ;;
    restore)
      cat <<'EOF'
Usage : station restore ARCHIVE [--without-media] [--yes] [--dir DOSSIER]

Remet une sauvegarde de station backup, sur cette station ou sur une autre
machine, après station install. La base, les certificats de Caddy et, s'ils y
sont, les sons, remplacent ceux de la station : les données en place sont
gardées à côté. De .env, seuls le fuseau (TZ) et le compte admin viennent de
la sauvegarde : le reste est celui de cette machine, domaine compris. L'antenne
se coupe le temps de redémarrer. Si la station ne repart pas, celle d'avant
revient.

--without-media : garder la banque de sons en place, même si l'archive en a.
--yes : sans confirmation, pour un script.
EOF
      ;;
    config)
      cat <<'EOF'
Usage : station config [options] [--dir DOSSIER]

Sans option : les réglages de la station. Avec, les change dans .env :
  --domain DOMAINE        le domaine, qui mène déjà à cette machine
  --email E-MAIL          l'e-mail du compte Let's Encrypt, "" pour aucun
  --updates auto|manual   les mises à jour automatiques
  --update-time HH:MM     leur heure, à celle de la station (04:00)
  --no-domain-check       ne pas vérifier que le domaine mène ici

Changer le domaine ou l'e-mail redémarre Caddy : le flux se coupe un instant.
EOF
      ;;
    hold | unhold)
      cat <<'EOF'
Usage : station hold [RAISON…] [--dir DOSSIER]
        station unhold [--dir DOSSIER]

hold bloque les mises à jour : il pose le fichier HOLD dans le dossier de la
station, avec la date et la raison. unhold le retire.
EOF
      ;;
    cli)
      cat <<'EOF'
Usage : station cli [--dir DOSSIER] COMMANDE…

Une commande du moteur, radiotomate, dans son conteneur. Par exemple :
  station cli users add studio --admin
  station cli maintenance next-live
Les commandes du moteur : station cli --help.
EOF
      ;;
    uninstall)
      cat <<'EOF'
Usage : station uninstall [--purge] [--yes] [--dir DOSSIER]

Désinstalle la station : ses conteneurs, ses images, les fichiers de sa
version et la commande station s'en vont. Restent .env, data/, media/ et
backups/ : station install les reprend.

--purge efface tout le dossier, données et sauvegardes comprises.
--yes : sans confirmation, pour un script.
EOF
      ;;
    *) usage_error "Commande inconnue : $1." ;;
  esac
}

usage_install() {
  cat <<'EOF'
Usage : station install [options]

Installe une station BUTTON sur cette machine, en root : Debian 12 ou 13, ou
Ubuntu 24.04, en x86-64. Relancée, la commande répare ce qui manque, sans
changer ni .env, ni les données, ni la version.

Les réponses, demandées au clavier quand l'option manque :
  --name NOM                  le nom de la station, dans la console (BUTTON)
  --domain DOMAINE            son domaine, qui pointe déjà sur cette machine
  --email E-MAIL              l'e-mail du compte Let's Encrypt (aucun)
  --timezone FUSEAU           le fuseau de la station (Europe/Paris)
  --admin IDENTIFIANT         l'identifiant du compte admin (admin)
  --updates auto|manual       les mises à jour automatiques (auto)

Les autres options :
  --version X.Y.Z             une version publiée, au lieu de la plus haute
  --dir DOSSIER               le dossier de la station (/opt/button)
  --github-token-file FICHIER un jeton GitHub qui lit les images privées
                              (read:packages), pour docker login
  --from ARCHIVE              les fichiers de la station depuis cette archive,
                              station.tar.gz, plutôt que de GitHub
  --tls internal              un certificat de Caddy, pour un essai : les
                              navigateurs le refusent
  --no-domain-check           ne pas vérifier que le domaine mène ici
  --yes                       ne rien demander : les options, sinon les
                              valeurs par défaut, et Docker installé s'il manque

Voir docs/deploiement.md, « Installer sur un VPS ».
EOF
}

# Une question se pose au clavier seulement : sans terminal, ou avec --yes,
# les options et les valeurs par défaut répondent.
interactive() { [[ -z $assume_yes && -t 0 ]]; }
# Le mot de passe admin ne s'affiche que dans un terminal : jamais dans un
# journal, ni dans la sortie d'une CI.
terminal() { [[ -t 1 ]]; }

trim() {
  local text=$1
  text=${text#"${text%%[![:space:]]*}"}
  printf '%s' "${text%"${text##*[![:space:]]}"}"
}

# ask <question> <défaut> <contrôle> : la réponse lue au clavier, ou le défaut
# sur Entrée, reposée tant que le contrôle la refuse. Le contrôle dit pourquoi.
ask() {
  local answer
  while :; do
    printf '  %s%s : ' "$1" "${2:+ [$2]}" >&2
    IFS= read -r answer || die "" "$aborted"
    answer=$(trim "$answer")
    answer=${answer:-$2}
    if "$3" "$answer"; then
      printf '%s\n' "$answer"
      return
    fi
  done
}

check_yes_no() {
  case ${1,,} in
    o | oui | y | yes | n | non | no) return ;;
  esac
  echo "  Répondre o ou n." >&2
  return 1
}

check_name() {
  if [[ -z $1 || ${#1} -gt 80 || $1 == *[[:cntrl:]]* ]]; then
    echo "  Le nom : une ligne, de 80 caractères au plus." >&2
    return 1
  fi
}

check_domain() {
  local label='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
  local name="^$label(\\.$label)+\$"
  if [[ ${#1} -gt 253 || ! ${1,,} =~ $name ]]; then
    echo "  « $1 » n'est pas un nom de domaine. Le nom seul, comme radio.example, sans http:// ni chemin." >&2
    return 1
  fi
  if [[ $1 =~ \.[0-9]+$ ]]; then
    echo "  « $1 » est une adresse IP : Let's Encrypt ne certifie que des noms de domaine." >&2
    return 1
  fi
}

check_email() {
  local address='^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'
  [[ -z $1 || $1 =~ $address ]] && return
  echo "  « $1 » n'est pas un e-mail. Rien, pour un compte Let's Encrypt sans e-mail." >&2
  return 1
}

check_timezone() {
  local zone='^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$'
  [[ $1 =~ $zone && -f $ROOT/usr/share/zoneinfo/$1 ]] && return
  echo "  « $1 » n'est pas un fuseau connu de cette machine, comme Europe/Paris ou America/Montreal." >&2
  return 1
}

check_admin() {
  local id='^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$'
  [[ $1 =~ $id ]] && return
  echo "  « $1 » : un identifiant de 32 caractères au plus, en lettres, chiffres, point, tiret ou soulignement." >&2
  return 1
}

check_updates() {
  [[ $1 == auto || $1 == manual ]] && return
  echo "  « $1 » : auto ou manual." >&2
  return 1
}

check_update_time() {
  [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && return
  echo "  « $1 » : une heure s'écrit HH:MM, comme 04:00." >&2
  return 1
}

check_version() {
  local number='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
  [[ $1 =~ $number ]] && return
  echo "  « $1 » : une version s'écrit X.Y.Z, comme 0.1.0. main ne s'installe que depuis une archive : voir --from." >&2
  return 1
}

# --- .env ---

# La valeur d'une variable de .env, la dernière, sans les guillemets autour ;
# le défaut quand la ligne manque. Vide quand elle est vide.
env_value() { # clé, défaut
  local line
  line=$(grep -E "^$1=" "$env_file" 2>/dev/null | tail -n 1) || true
  if [[ -z $line ]]; then
    printf '%s\n' "${2:-}"
    return
  fi
  line=${line#*=}
  if [[ ${#line} -ge 2 && ($line == \"*\" || $line == \'*\') ]]; then
    line=${line:1:${#line}-2}
  fi
  printf '%s\n' "$line"
}

# Le mount public du flux, celui qu'écrit init-radiotomate.sh : ICECAST_MOUNT
# dans .env, sans son / du début, et radio.mp3 sans elle, comme compose.yml.
stream_mount() {
  local mount
  mount=$(env_value ICECAST_MOUNT "")
  mount=${mount#/}
  printf '%s\n' "${mount:-radio.mp3}"
}

env_has() { grep -qE "^$1=" "$env_file" 2>/dev/null; }

# Une variable qui manque à .env, à la fin, sous une ligne qui date l'ajout.
env_add() { # clé, valeur
  if [[ -z $env_added ]]; then
    printf '\n# Ajouté par station install, le %s.\n' "$(date +%F)" >>"$env_file"
  fi
  printf '%s=%s\n' "$1" "$2" >>"$env_file"
  env_added="$env_added $1"
}

# Change la valeur d'une variable déjà dans .env, sans toucher au reste.
env_replace() { # clé, valeur
  local tmp
  tmp=$(mktemp "$env_file.XXXXXX")
  KEY=$1 VALUE=$2 awk 'index($0, ENVIRON["KEY"] "=") == 1 { print ENVIRON["KEY"] "=" ENVIRON["VALUE"]; next } { print }' \
    "$env_file" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$env_file"
}

# Pose une variable de .env : change sa valeur, ou l'ajoute à la fin, sous
# une ligne qui dit quelle commande l'a ajoutée.
env_set() { # clé, valeur, commande
  if env_has "$1"; then
    env_replace "$1" "$2"
    return
  fi
  [[ -z $(tail -c 1 "$env_file") ]] || printf '\n' >>"$env_file"
  printf '\n# Ajouté par station %s, le %s.\n%s=%s\n' "$3" "$(date +%F)" "$1" "$2" >>"$env_file"
}

# Un chemin de .env, comme RT_DATA, relatif au dossier de la station, sans
# barre oblique finale.
env_path() { # clé, défaut
  local path
  path=$(env_value "$1" "$2")
  [[ $path == /* ]] || path=$dir/${path#./}
  while [[ $path == ?*/ ]]; do path=${path%/}; done
  printf '%s\n' "$path"
}

# Un secret de machine, que personne ne tape : 48 caractères.
secret() {
  local value
  value=$(openssl rand -hex 24)
  [[ ${#value} -eq 48 ]] || die "openssl ne tire pas de secret." "Vérifier openssl (openssl rand -hex 24), puis relancer."
  printf '%s\n' "$value"
}

# Le mot de passe admin, tapé par une personne : 24 caractères, sans + ni /.
password() {
  local value
  value=$(openssl rand -base64 18 | tr '+/' '-_')
  [[ ${#value} -eq 24 ]] || die "openssl ne tire pas de mot de passe." "Vérifier openssl (openssl rand -base64 18), puis relancer."
  printf '%s\n' "$value"
}

# Ce que .env règle ne vient jamais de l'environnement de la commande : docker
# compose le préférerait à .env, et sudo garde TZ, par exemple.
env_isolate() {
  local key
  unset COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_ENV_FILES
  [[ -f $env_file ]] || return 0
  while IFS='=' read -r key _; do
    case $key in
      PATH | HOME) ;;
      *) unset "$key" ;;
    esac
  done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$env_file")
}

compose() { (cd "$dir" && docker compose "$@"); }

# --- Vérifications ---

check_machine() {
  local os_release=$ROOT/etc/os-release id version codename arch
  [[ $(id -u) == 0 ]] ||
    die "station install demande les droits root." "Relancer avec sudo : sudo bash station install."
  [[ -r $os_release ]] || die "$os_release est illisible : système inconnu." "Une station s'installe sur Debian 12 ou 13, ou sur Ubuntu 24.04."
  id=$(sed -n 's/^ID=//p' "$os_release" | tr -d '"')
  version=$(sed -n 's/^VERSION_ID=//p' "$os_release" | tr -d '"')
  codename=$(sed -n 's/^VERSION_CODENAME=//p' "$os_release" | tr -d '"')
  case "$id $version" in
    "debian 12" | "debian 13" | "ubuntu 24.04") ;;
    *)
      die "Système non pris en charge : ${id:-inconnu} ${version:-}." \
        "Une station s'installe sur Debian 12 ou 13, ou sur Ubuntu 24.04 : prendre l'un d'eux à la création du VPS."
      ;;
  esac
  os_id=$id
  os_codename=$codename
  arch=$(uname -m)
  [[ $arch == x86_64 ]] ||
    die "Processeur $arch : les images de BUTTON ne sont construites que pour x86-64 (amd64)." "Prendre un VPS x86-64."
  local tool missing=""
  for tool in curl openssl tar sha256sum ss; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
  done
  [[ -z $missing ]] ||
    die "Outils absents :$missing." "Les installer, par exemple : apt-get install -y curl openssl tar coreutils iproute2. Puis relancer."
  say "Machine : $id $version ($codename), x86-64."
}

# Docker et Compose v2, depuis le dépôt de Docker, comme le dit sa
# documentation : https://docs.docker.com/engine/install/
install_docker() {
  local apt=$ROOT/etc/apt failed="L'installation de Docker a échoué : voir le message d'apt-get plus haut."
  local again="Une fois réglé, relancer station install, ou installer Docker à la main : https://docs.docker.com/engine/install/"
  export DEBIAN_FRONTEND=noninteractive
  say "Docker : installation depuis download.docker.com."
  apt-get update -qq </dev/null || die "$failed" "$again"
  apt-get install -y -qq ca-certificates curl </dev/null >/dev/null || die "$failed" "$again"
  install -m 0755 -d "$apt/keyrings"
  curl --disable -fsSL "https://download.docker.com/linux/$os_id/gpg" -o "$apt/keyrings/docker.asc" ||
    die "La clé du dépôt de Docker ne se télécharge pas." "Vérifier l'accès de la machine à download.docker.com, puis relancer."
  chmod a+r "$apt/keyrings/docker.asc"
  mkdir -p "$apt/sources.list.d"
  cat >"$apt/sources.list.d/docker.sources" <<EOF
Types: deb
URIs: https://download.docker.com/linux/$os_id
Suites: $os_codename
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  apt-get update -qq </dev/null || die "$failed" "$again"
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin \
    </dev/null >/dev/null || die "$failed" "$again"
  systemctl enable --now docker >/dev/null 2>&1 || true
}

check_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    if [[ -z $assume_yes ]]; then
      if ! interactive; then
        die "Docker n'est pas installé." "Relancer avec --yes pour l'installer depuis le dépôt de Docker, ou l'installer d'abord : https://docs.docker.com/engine/install/"
      fi
      local answer
      answer=$(ask "Docker n'est pas installé. L'installer depuis le dépôt de Docker ? (o/n)" o check_yes_no)
      [[ ${answer,,} == [oy]* ]] ||
        die "Rien n'est installé : une station a besoin de Docker." "L'installer (https://docs.docker.com/engine/install/), puis relancer."
    fi
    install_docker
  fi
  docker compose version >/dev/null 2>&1 ||
    die "Docker est là, mais pas Compose v2 (docker compose)." "Installer le paquet docker-compose-plugin du dépôt de Docker (https://docs.docker.com/compose/install/linux/), puis relancer."
  if ! docker info >/dev/null 2>&1; then
    systemctl enable --now docker >/dev/null 2>&1 || true
    docker info >/dev/null 2>&1 ||
      die "Docker ne répond pas." "Voir pourquoi : systemctl status docker. Puis relancer."
  fi
  say "Docker : $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo présent), Compose $(docker compose version --short 2>/dev/null || echo v2)."
}

# Le plus proche dossier qui existe : celui de la station n'existe pas encore.
existing_parent() {
  local path=$1
  until [[ -e $path || $path == / || -z $path ]]; do path=${path%/*}; done
  printf '%s\n' "${path:-/}"
}

# Les droits d'un dossier créé dans celui-ci sous umask 077 : 700, sauf si une
# ACL par défaut passe outre le umask.
inherited_mode() { # dossier
  local probe=$1/.station-droits-$$
  (umask 077 && mkdir "$probe") ||
    die "Un dossier d'essai ne se crée pas dans $1." "Vérifier ses droits et sa place, puis relancer."
  stat -c %a "$probe"
  rmdir "$probe"
}

# Une ACL par défaut sur le dossier qui reçoit la station, comme celle de /opt
# sur un runner de GitHub, passe outre le umask. Si elle ouvre en écriture au
# groupe ou aux autres comptes, le dossier de la station ne la garde pas :
# root y lance station, et docker compose y lit compose.yml et .env. Elle s'en
# retire avec setfacl (make_station_dir) ; sans setfacl, rien ne s'installe.
check_acl() {
  local parent mode
  parent=$(existing_parent "$dir")
  mode=$(inherited_mode "$parent")
  [[ $mode =~ ^[0-7]+$ ]] ||
    die "Les droits d'un dossier d'essai, dans $parent, ne se lisent pas." "Vérifier $parent, puis relancer."
  ((8#$mode & 8#022)) || return 0
  command -v setfacl >/dev/null 2>&1 ||
    die "Une ACL par défaut sur $parent passe outre le umask : le dossier de la station y naîtrait en $mode, ouvert en écriture à d'autres comptes. Rien n'est écrit." \
      "Installer setfacl, qui retirera cette ACL du dossier de la station : apt-get install acl. Puis relancer. Ou choisir un autre dossier, avec --dir."
  acl_from=$parent
  say "Droits : une ACL par défaut sur $parent passe outre le umask. Le dossier de la station ne la garde pas : il reste à root, en 755."
}

# Une installation neuve s'arrête faute de place, même relancée après une
# interruption. Une station qui a déjà sa base, et dont la banque a grandi, se
# répare quand même : la place manque, mais elle tourne.
check_disk() {
  local path free low=""
  for path in "$dir" "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"; do
    path=$(existing_parent "$path")
    free=$(df -Pk "$path" 2>/dev/null | awk 'NR == 2 { print int($4 / 1048576) }') || free=""
    if [[ -z $free ]]; then
      warn "la place libre de $path ne se lit pas (df -Pk $path) : non vérifiée."
    elif ((free < MIN_FREE_GB)); then
      low="$low $path ($free Go)"
    fi
  done
  if [[ -z $low ]]; then
    say "Place : $MIN_FREE_GB Go libres au moins."
  elif [[ -f $env_file && -f $(env_path RT_DATA ./data/radiotomate)/radiotomate.db ]]; then
    warn "peu de place libre :$low. Une station neuve en demande $MIN_FREE_GB Go : libérer de la place, ou agrandir le disque."
  else
    die "Place libre insuffisante :$low. Il en faut $MIN_FREE_GB Go au moins : les images en prennent 3 environ, et la banque de sons grandit." \
      "Libérer de la place, ou agrandir le disque, puis relancer."
  fi
}

# Docker répond : sinon, docker compose ps ne voit aucun conteneur, et la
# station aurait l'air arrêtée.
docker_ok() {
  docker info >/dev/null 2>&1
}

# Les conteneurs de la station de ce dossier qui tournent : tous, ou ceux du
# service donné. Une relance ne vérifie pas les ports qu'ils tiennent.
station_running() { # [service]
  [[ -f $dir/compose.yml && -f $env_file ]] || return 1
  [[ -n $(compose ps -q --status running "$@" 2>/dev/null) ]]
}

check_ports() {
  local spec proto port listener taken=""
  local harbor
  harbor=$(env_value HARBOR_PORT 6800)
  for spec in tcp/80 tcp/443 udp/443 "tcp/${harbor##*:}"; do
    proto=${spec%/*}
    port=${spec#*/}
    listener=$(ss -H -l -n -p "--$proto" "sport = :$port" 2>/dev/null | head -n 1) || true
    [[ -n $listener ]] || continue
    listener=$(grep -o 'users:(("[^"]*' <<<"$listener" | cut -d'"' -f2) || true
    taken="$taken
  $port ($proto) : ${listener:-un autre programme}"
  done
  [[ -z $taken ]] ||
    die "Ports déjà pris :$taken" \
      "Caddy a besoin de 80 et 443, le direct de $harbor. Arrêter ce qui les tient, par exemple systemctl disable --now apache2, puis relancer."
  say "Ports : 80, 443 et $harbor libres."
}

# --- Les fichiers de la version ---

# La plus haute version publiée : celle où mène la page « latest » de GitHub,
# que version.yml ne donne qu'à la version qui prend stable.
latest_version() { # [attente en secondes, 30]
  local answer url
  answer=$(curl --disable -sS -o /dev/null --max-time "${1:-30}" -w '%{http_code} %{redirect_url}' \
    "https://github.com/$REPO/releases/latest") ||
    die "GitHub ne répond pas." "Vérifier l'accès de la machine à github.com, puis relancer."
  url=${answer#* }
  case $url in
    */releases/tag/v*) printf '%s\n' "${url##*/releases/tag/v}" ;;
    */releases) die "Aucune version publiée de BUTTON ($REPO)." "Pour un essai, installer depuis une archive : voir --from." ;;
    *) die "GitHub répond ${answer%% *} pour la dernière version de $REPO." "Réessayer dans un moment." ;;
  esac
}

# Télécharge station.tar.gz et SHA256SUMS de la version, puis compare.
fetch_version() { # version
  local base="https://github.com/$REPO/releases/download/v$1" name expected actual
  for name in station.tar.gz SHA256SUMS; do
    curl --disable -fsSL --retry 3 --max-time 120 -o "$work/$name" "$base/$name" ||
      die "La version $1 n'a pas de fichier $name sur GitHub : elle n'existe pas, ou elle date d'avant la commande station." \
        "Les versions publiées : https://github.com/$REPO/releases. En prendre une plus récente avec --version ; pour un essai, installer depuis une archive avec --from."
  done
  expected=$(awk '$2 == "station.tar.gz" { print $1 }' "$work/SHA256SUMS")
  actual=$(sha256sum "$work/station.tar.gz" | cut -d' ' -f1)
  [[ -n $expected && $actual == "$expected" ]] ||
    die "station.tar.gz de la version $1 ne correspond pas à sa somme, dans SHA256SUMS : rien n'est écrit." \
      "Relancer : un téléchargement peut s'abîmer. Si l'erreur revient, ne pas installer, et le signaler."
}

# Ouvre l'archive dans $work/files, et vérifie ce qu'elle porte.
unpack() { # archive
  local name
  mkdir -p "$work/files"
  tar -xzf "$1" -C "$work/files" ||
    die "$1 ne s'ouvre pas : archive abîmée, ou qui n'est pas station.tar.gz." "La télécharger à nouveau, puis relancer."
  for name in VERSION compose.yml Caddyfile station scripts/smoke.sh; do
    [[ -f $work/files/$name ]] ||
      die "$name manque dans $1 : ce n'est pas l'archive d'une station." "Prendre station.tar.gz d'une version publiée, ou le fabriquer : python3 scripts/version.py station main <dossier>."
  done
}

# Le domaine mène-t-il à cette machine, sur le port 80 ? Avant que Caddy
# demande un certificat : Let's Encrypt refuse un domaine un moment après
# quelques échecs. Un conteneur répond un jeton tiré au hasard sur le port 80,
# et chaque adresse du domaine, A et AAAA, doit le rendre. Les adresses se
# lisent dans un conteneur : dans le DNS, et non dans /etc/hosts. L'image est
# celle de Caddy, lue dans le compose.yml donné.
check_domain_here() { # compose.yml
  local image addresses address target answer token wrong=""
  image=$(sed -n 's/^ *image: *\(caddy:[^ ]*\) *$/\1/p' "$1" | head -n 1)
  [[ -n $image ]] || die "Le compose.yml de la version n'a pas d'image caddy." "Archive inattendue : la télécharger à nouveau."
  docker image inspect "$image" >/dev/null 2>&1 || docker pull -q "$image" >/dev/null ||
    die "L'image $image ne se tire pas." "Vérifier l'accès de la machine à Docker Hub, puis relancer."
  # Les deux réponses à la suite, chacune après sa ligne « Server: ».
  # shellcheck disable=SC2016
  addresses=$(docker run --rm "$image" sh -c 'nslookup -type=a "$1"; nslookup -type=aaaa "$1"' _ "$domain" 2>/dev/null |
    awk '/^Server:/ { answer = 0 } /^Name:/ { answer = 1; next } answer && /^Address:/ { print $2 }') || true
  [[ -n $addresses ]] ||
    die "Le domaine $domain ne mène à aucune adresse." \
      "Chez le registraire du domaine, créer un enregistrement A vers l'adresse IPv4 de cette machine, attendre qu'il se propage, puis relancer."
  token=$(openssl rand -hex 16)
  docker rm -f "$PROBE" >/dev/null 2>&1 || true
  docker run -d --rm --name "$PROBE" -p 80:80 "$image" caddy respond --listen :80 --body "$token" >/dev/null ||
    die "Le port 80 ne s'ouvre pas pour la vérification." "Voir ce qui le tient : ss -ltnp 'sport = :80'. Puis relancer."
  probe_started=1
  for address in $addresses; do
    target=$address
    [[ $address != *:* ]] || target="[$address]"
    # Les reprises laissent au conteneur le temps d'écouter.
    answer=$(curl --disable -sS --connect-timeout 5 --max-time 10 --retry 3 --retry-delay 1 --retry-connrefused \
      --resolve "$domain:80:$target" "http://$domain/.well-known/button-$token" 2>/dev/null) || answer=""
    [[ $answer == "$token" ]] || wrong="$wrong $address"
  done
  docker rm -f "$PROBE" >/dev/null 2>&1 || true
  probe_started=""
  [[ -z $wrong ]] ||
    die "Le domaine $domain mène à${wrong}, qui ne répond pas comme cette machine sur le port 80." \
      "Vérifier ses enregistrements A et AAAA chez le registraire, et le pare-feu de l'hébergeur pour le port 80. Un changement du DNS peut mettre une heure à se propager. Puis relancer."
  say "Domaine : $domain mène à cette machine ($(tr '\n' ' ' <<<"$addresses" | sed 's/ $//'))."
}

# --- Le dossier de la station ---

# Le dossier de la station, avec ceux qui manquent au-dessus. Sous une ACL par
# défaut qui les ouvre en écriture (check_acl), chacun la perd et reste à root,
# en 755 : ce qui s'y crée ensuite, par les conteneurs aussi, suit le umask.
make_station_dir() {
  local path=$dir created=()
  until [[ -e $path || -z $path ]]; do
    created+=("$path")
    path=${path%/*}
  done
  mkdir -p "$dir"
  [[ -n $acl_from ]] || return 0
  # Une station déjà là : son propre dossier.
  ((${#created[@]})) || created=("$dir")
  for path in "${created[@]}"; do
    setfacl -k -b "$path" ||
      die "setfacl ne retire pas l'ACL de $path." "La retirer à la main, setfacl -k -b $path && chmod 755 $path, puis relancer."
    chmod 755 "$path"
  done
}

# Les fichiers de la version : ce qui manque est posé, ce qui a changé est
# remis, et l'ancien gardé à côté. Rien d'autre du dossier n'est touché.
install_files() {
  local file mode stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  while IFS= read -r file; do
    file=${file#"$work/files/"}
    mode=$(stat -c %a "$work/files/$file")
    if [[ ! -e $dir/$file ]]; then
      install -D -m "$mode" "$work/files/$file" "$dir/$file"
      files_added="$files_added $file"
    elif ! cmp -s "$work/files/$file" "$dir/$file"; then
      mv -f "$dir/$file" "$dir/$file.local-$stamp"
      install -D -m "$mode" "$work/files/$file" "$dir/$file"
      files_restored="$files_restored $file"
    else
      chmod "$mode" "$dir/$file"
    fi
  done < <(find "$work/files" -type f | sort)
}

# .env : créé à la première installation, en droits 600. Ensuite, seule une
# variable qui manque s'ajoute : une valeur posée n'est jamais changée, sauf
# un mot de passe admin vide quand la base n'existe pas encore.
write_env() {
  local key value
  if [[ ! -e $env_file ]]; then
    local admin_password source_password admin_icecast nowplaying meili
    admin_password=$(password)
    source_password=$(secret)
    admin_icecast=$(secret)
    nowplaying=$(secret)
    meili=$(secret)
    # Vide et en 600 avant le moindre secret : une ACL par défaut sur le
    # dossier, comme celle de /opt sur un runner de GitHub, passe outre le
    # umask, mais pas le mode donné à la création.
    install -m 600 /dev/null "$env_file"
    cat >"$env_file" <<EOF
# La station, réglée par station install le $(date +%F). Les secrets sont ici :
# droits 600, et ce fichier n'entre dans aucun dépôt. Toutes les variables :
# .env.example, dans ce dossier. Une relance de station install n'y change
# rien : elle ajoute seulement ce qui manque.

# La version des images, la même que celle du dossier (VERSION).
BUTTON_VERSION=$version

# Sur Internet : Caddy devant la console, le flux et now.json, avec un
# certificat pour DOMAIN. Les autres ports n'écoutent que sur la machine.
COMPOSE_PROFILES=vps
DOMAIN=$domain
ACME_EMAIL=$email
BIND_ADDRESS=127.0.0.1
TZ=$timezone

# Le compte admin, créé au premier démarrage. Son mot de passe s'efface d'ici
# une fois affiché : il se change ensuite dans la console, Mon compte.
RT_ADMIN_USER=$admin
RT_ADMIN_PASSWORD=$admin_password

# Les secrets de machine, que personne ne tape.
ICECAST_SOURCE_PASSWORD=$source_password
ICECAST_ADMIN_PASSWORD=$admin_icecast
RT_NOWPLAYING_SECRET=$nowplaying
MEILI_MASTER_KEY=$meili

# Les mises à jour : auto, ou manual. La commande update les fera.
BUTTON_UPDATES=$updates
EOF
    if [[ $tls == internal ]]; then
      printf '\n# Un certificat de Caddy, pour un essai : les navigateurs le refusent.\nCADDY_TLS=internal\n' >>"$env_file"
    fi
    return 0
  fi
  chmod 600 "$env_file"
  env_has BUTTON_VERSION || env_add BUTTON_VERSION "$version"
  env_has COMPOSE_PROFILES || env_add COMPOSE_PROFILES vps
  env_has DOMAIN || env_add DOMAIN "$domain"
  env_has ACME_EMAIL || env_add ACME_EMAIL "$email"
  env_has BIND_ADDRESS || env_add BIND_ADDRESS 127.0.0.1
  env_has TZ || env_add TZ "$timezone"
  env_has RT_ADMIN_USER || env_add RT_ADMIN_USER "$admin"
  # Sans base, radiotomate-init crée le compte admin : il lui faut un mot de
  # passe, que la fin de l'installation affichera.
  if [[ -n $first && -z $(env_value RT_ADMIN_PASSWORD) ]]; then
    value=$(password)
    if env_has RT_ADMIN_PASSWORD; then
      env_replace RT_ADMIN_PASSWORD "$value"
      env_added="$env_added RT_ADMIN_PASSWORD"
    else
      env_add RT_ADMIN_PASSWORD "$value"
    fi
  fi
  for key in ICECAST_SOURCE_PASSWORD ICECAST_ADMIN_PASSWORD RT_NOWPLAYING_SECRET MEILI_MASTER_KEY; do
    if ! env_has "$key"; then
      value=$(secret)
      env_add "$key" "$value"
    fi
  done
  env_has BUTTON_UPDATES || env_add BUTTON_UPDATES "$updates"
}

make_data_dirs() {
  local key
  for key in "${DATA_DIRS[@]}"; do
    mkdir -p "$(env_path "${key%%:*}" "${key#*:}")"
  done
}

# /usr/local/bin/station mène au script du dossier : une mise à jour du
# dossier met aussi la commande à jour.
link_command() {
  local target=$dir/station
  if [[ -L $BIN ]]; then
    [[ $(readlink "$BIN") != "$target" ]] || return 0
    warn "$BIN menait à $(readlink "$BIN") : il mène maintenant à $target."
  elif [[ -e $BIN ]]; then
    warn "$BIN existe et n'est pas un lien : laissé tel quel. La commande de cette station est $target."
    return 0
  fi
  mkdir -p "${BIN%/*}"
  ln -sfn "$target" "$BIN"
}

ghcr_login() {
  local registry host user
  [[ -r $token_file ]] || die "Jeton illisible : $token_file." "Donner le chemin d'un fichier qui contient le jeton GitHub, lisible par root."
  registry=$(env_value BUTTON_IMAGES ghcr.io/lazbutton)
  host=${registry%%/*}
  user=${registry#*/}
  user=${user%%/*}
  tr -d '[:space:]' <"$token_file" | docker login "$host" --username "$user" --password-stdin >/dev/null ||
    die "$host refuse le jeton de $token_file." "Il doit lire les images (read:packages) et ne pas avoir expiré. En créer un autre, puis relancer."
  say "Registre : connecté à $host. Docker garde le jeton dans /root/.docker/config.json, pour les mises à jour."
}

# --- Démarrer et contrôler ---

# https://$domain répond-il, avec son certificat ? Jusqu'à HTTPS_WAIT s.
https_ok() {
  local args=(--disable -sS -o /dev/null --max-time 10) deadline=$((SECONDS + HTTPS_WAIT))
  if [[ $tls == internal ]]; then
    args+=(--cacert "$(env_path CADDY_DATA ./data/caddy)/pki/authorities/local/root.crt" --resolve "$domain:443:127.0.0.1")
  fi
  until curl "${args[@]}" "https://$domain/" 2>/dev/null; do
    ((SECONDS < deadline)) || return 1
    sleep 5
  done
}

wait_https() {
  https_ok ||
    die "https://$domain ne répond pas au bout de $HTTPS_WAIT s : le certificat manque encore." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Puis relancer station install."
  say "HTTPS : https://$domain répond."
}

# Le contrôle de la station, smoke.sh : par ses adresses publiques, en HTTPS,
# ou par les ports de la machine.
smoke_ok() {
  local console stream
  if [[ $tls == internal || -z $domain ]]; then
    # Les navigateurs, et curl, refusent le certificat de Caddy ; une station
    # sans domaine n'a que ses ports.
    console=http://127.0.0.1:$(env_value CONSOLE_PORT 30126)
    stream=http://127.0.0.1:$(env_value ICECAST_PORT 18000)/$(stream_mount)
  else
    console=https://$domain
    stream=https://$domain/$(stream_mount)
  fi
  (cd "$dir" && SMOKE_WAIT=${SMOKE_WAIT:-300} scripts/smoke.sh "$console" "$stream")
}

smoke() {
  smoke_ok ||
    die "" "Le contrôle de la station a échoué : voir plus haut. Une fois réglé, relancer station install, qui reprend où il en était."
}

# Le nom et les adresses publiques, dans les réglages Station du moteur : sans
# eux, la console reprendrait ceux de sa marque par défaut. Une seule fois, sur
# une station qui n'a encore aucun réglage Station : une ligne posée n'est
# jamais changée, et une ligne qu'un admin a retirée ne revient pas. Ensuite,
# ils se changent dans la console, Réglages → Station.
station_settings() {
  local harbor written
  harbor=$(env_value HARBOR_PORT 6800)
  [[ $harbor =~ ^[0-9]+$ ]] || harbor=""
  written=$(compose exec -T -e "BUTTON_NAME=$name" -e "BUTTON_DOMAIN=$domain" -e "BUTTON_HARBOR_PORT=$harbor" -e "BUTTON_MOUNT=$(stream_mount)" \
    radiotomate-interface python3 - <<'PY'
import os
import sqlite3
from contextlib import closing

domain = os.environ["BUTTON_DOMAIN"]
values = {
    "station.name": os.environ.get("BUTTON_NAME", ""),
    "station.public_stream_url": f"https://{domain}/{os.environ['BUTTON_MOUNT']}",
    "station.now_url": f"https://{domain}/now.json",
    "station.status_url": f"https://{domain}/status-json.xsl",
    "station.harbor_host": domain,
    "station.harbor_port": os.environ.get("BUTTON_HARBOR_PORT", ""),
}
with closing(sqlite3.connect("/data/radiotomate.db")) as con, con:
    if con.execute("select 1 from settings where key like 'station.%' limit 1").fetchone():
        raise SystemExit(0)
    for key, value in values.items():
        added = con.execute(
            "insert or ignore into settings (key, value) values (?, ?)", (key, value)
        ).rowcount if value else 0
        if added:
            print(key)
PY
  ) || die "Les réglages de la station ne s'écrivent pas." "Voir : cd $dir && docker compose logs radiotomate-interface. Puis relancer station install."
  if [[ -n $written ]]; then
    say "Réglages Station : nom et adresses publiques posés."
  fi
}

# Le mot de passe admin, une seule fois, dans un terminal. Il s'efface ensuite
# de .env, et radiotomate-init repasse sans lui : sinon, un compte admin
# supprimé reviendrait avec ce mot de passe (docs/deploiement.md, « Les secrets »).
admin_password() {
  local password restarted=1
  password=$(env_value RT_ADMIN_PASSWORD)
  if ! terminal; then
    say "Mot de passe admin : pas affiché, la sortie n'est pas un terminal. Il reste dans $env_file, en droits 600, jusqu'à ce que station install l'affiche, une fois, dans un terminal."
    return
  fi
  env_replace RT_ADMIN_PASSWORD ""
  compose up -d >/dev/null 2>&1 || restarted=""
  say "" "Compte admin : $(env_value RT_ADMIN_USER admin)" \
    "Mot de passe : $password" \
    "  Affiché cette fois seulement : le noter maintenant. Il se change dans la console, Mon compte."
  [[ -n $restarted ]] ||
    die "La station ne repart pas sans le mot de passe dans .env." "Voir : cd $dir && docker compose logs radiotomate-init. Puis relancer station install."
}

cleanup() {
  # Ce qui reste à défaire va jusqu'au bout : ni une erreur, ni un message qui
  # ne s'écrit plus (terminal fermé, | tee arrêté), ni un second Ctrl-C ne
  # l'arrêtent.
  set +e
  trap '' INT TERM HUP PIPE
  [[ -z ${probe_started:-} ]] || docker rm -f "$PROBE" >/dev/null 2>&1 || true
  if [[ -n ${caddy_stopped:-} ]]; then
    (cd "$caddy_stopped" && docker compose up -d caddy >/dev/null 2>&1) ||
      warn "Caddy ne repart pas : cd $caddy_stopped && docker compose up -d caddy."
  fi
  [[ -z ${partial:-} ]] || rm -f "$partial"
  if [[ -n ${station_stopped:-} ]]; then
    restore_undo
  fi
  local path
  for path in "${prepared[@]}"; do
    rm -rf "$path"
  done
  [[ -z ${work:-} ]] || rm -rf "$work"
}

# --- install ---

cmd_install() {
  local dir="" name="" domain="" email="" timezone="" admin="" updates="" version="" from=""
  local token_file="" tls="" assume_yes="" domain_check=1
  local given=" " option value
  while (($#)); do
    option=$1
    case $option in
      --yes | --no-domain-check | -h | --help) shift ;;
      --*=*)
        value=${option#*=}
        option=${option%%=*}
        shift
        ;;
      --*)
        (($# >= 2)) || usage_error "$option attend une valeur."
        value=$2
        shift 2
        ;;
      *) usage_error "Argument inattendu : $option." ;;
    esac
    case $option in
      --dir) dir=$value ;;
      --name) name=$(trim "$value") ;;
      --domain) domain=${value,,} ;;
      --email) email=$value ;;
      --timezone) timezone=$value ;;
      --admin) admin=$value ;;
      --updates) updates=$value ;;
      --version) version=$value ;;
      --from) from=$value ;;
      --github-token-file) token_file=$value ;;
      --tls) tls=$value ;;
      --yes) assume_yes=1 ;;
      --no-domain-check) domain_check="" ;;
      -h | --help)
        usage_install
        return 0
        ;;
      *) usage_error "Option inconnue : $option." ;;
    esac
    given="$given${option#--} "
  done
  [[ -z $tls || $tls == internal || $tls == acme ]] || usage_error "--tls vaut internal, ou acme, la valeur par défaut."
  [[ -z $dir || $dir == /* ]] || usage_error "--dir attend un chemin absolu, comme /opt/button."
  [[ -z $from || -f $from ]] || usage_error "--from : $from n'existe pas."
  if [[ -n $version && $version != stable && -z $from ]]; then
    check_version "$version" || exit 2
  fi

  dir=${dir:-$(default_dir)}
  dir=${dir%/}
  local env_file=$dir/.env env_added="" files_added="" files_restored="" os_id="" os_codename="" acl_from=""
  trap cleanup EXIT
  env_isolate

  say "BUTTON : installation de la station, dans $dir."
  check_machine
  lock_station install
  check_acl
  check_docker
  # Le reste d'une vérification du domaine interrompue tiendrait le port 80.
  docker rm -f "$PROBE" >/dev/null 2>&1 || true
  check_disk
  # running : Caddy tourne, la station a son certificat et ses images. Une
  # station qui tourne sans lui, Caddy tombé par exemple, tient encore le
  # port du direct : ses ports ne se vérifient pas non plus.
  local running=""
  if station_running caddy; then
    running=1
    say "Ports : la station tourne déjà, avec son Caddy."
  elif station_running; then
    say "Ports : la station tourne déjà, sans son Caddy."
  else
    check_ports
  fi

  # Une installation n'est finie qu'une fois le mot de passe admin affiché, et
  # effacé de .env. Jusque-là, le nom de la station se demande encore, et les
  # réglages Station se posent. Une base absente demande aussi un compte admin.
  local first=""
  if [[ ! -f $env_file || -n $(env_value RT_ADMIN_PASSWORD) ||
    ! -f $(env_path RT_DATA ./data/radiotomate)/radiotomate.db ]]; then
    first=1
  fi
  if [[ -f $env_file ]]; then
    say "Réponses : celles de $env_file, déjà là."
  elif interactive; then
    local answer
    for answer in name domain email timezone admin updates; do
      if [[ $given != *" $answer "* ]]; then
        say "" "Quelques questions. Entrée garde la valeur entre crochets."
        break
      fi
    done
  fi
  if [[ -n $first ]]; then
    name=$(choose "" name "$name" BUTTON check_name "Nom de la station")
  elif [[ $given == *" name "* ]]; then
    warn "--name n'est pas pris : la station est installée, son nom se change dans la console, Réglages → Station."
  fi
  domain=$(choose DOMAIN domain "$domain" "" check_domain "Domaine, qui pointe déjà sur cette machine")
  domain=${domain,,}
  email=$(choose ACME_EMAIL email "$email" "" check_email "E-mail du compte Let's Encrypt, facultatif")
  timezone=$(choose TZ timezone "$timezone" Europe/Paris check_timezone "Fuseau de la station")
  admin=$(choose RT_ADMIN_USER admin "$admin" admin check_admin "Identifiant du compte admin")
  updates=$(choose_updates)
  if [[ -f $env_file ]]; then
    local current_tls
    current_tls=$(env_value CADDY_TLS acme)
    if [[ -n $tls && $tls != "$current_tls" ]]; then
      warn "--tls $tls n'est pas pris : la station a déjà CADDY_TLS=$current_tls, que station install ne change pas."
    fi
    tls=$current_tls
  fi
  tls=${tls:-acme}

  work=$(mktemp -d)
  if [[ -f $env_file ]]; then
    local installed
    installed=$(env_value BUTTON_VERSION)
    [[ -n $installed ]] ||
      die "BUTTON_VERSION manque dans $env_file." "Y remettre la version de la station, celle du fichier VERSION du dossier, puis relancer."
    if [[ -n $version && $version != "$installed" ]]; then
      warn "--version $version n'est pas prise : la station est en $installed, et station install ne change pas de version."
    fi
    version=$installed
  fi
  if [[ -n $from ]]; then
    unpack "$from"
    local packed
    packed=$(<"$work/files/VERSION")
    [[ -z $version || $version == "$packed" ]] ||
      die "$from est la version $packed, et la station la $version." "Prendre l'archive de la version $version."
    version=$packed
    say "Version : $version, depuis $from."
  else
    if [[ -z $version || $version == stable ]]; then
      version=$(latest_version)
      check_version "$version" || die "GitHub donne une version inattendue : ne pas installer, et le signaler."
      say "Version : $version, la plus haute publiée."
    else
      check_version "$version" ||
        die "La station est en $version : seule une archive de cette version la répare, avec --from."
      say "Version : $version."
    fi
    fetch_version "$version"
    unpack "$work/station.tar.gz"
    [[ $(<"$work/files/VERSION") == "$version" ]] ||
      die "L'archive de la version $version se dit $(<"$work/files/VERSION")." "Archive inattendue : ne pas installer, et le signaler."
  fi

  if [[ $tls == internal ]]; then
    say "Domaine : pas vérifié, Caddy signe lui-même le certificat (--tls internal)."
  elif [[ -n $running ]]; then
    say "Domaine : pas vérifié, la station a déjà son certificat."
  elif [[ -z $domain_check ]]; then
    warn "le domaine n'est pas vérifié (--no-domain-check). S'il ne mène pas ici, Let's Encrypt le refusera un moment."
  else
    check_domain_here "$work/files/compose.yml"
  fi

  make_station_dir
  install_files
  write_env
  make_data_dirs
  link_command
  env_isolate
  if [[ -n $files_added$files_restored$env_added ]]; then
    say "Dossier : $dir, à la version $version."
    [[ -z $files_restored ]] || say "  Remis à la version :$files_restored. L'ancien est gardé à côté, en .local-… : les changements d'une station vont dans compose.override.yml."
    [[ -z $env_added ]] || say "  Ajouté à .env :$env_added."
  else
    say "Dossier : $dir, rien à réparer."
  fi

  [[ -z $token_file ]] || ghcr_login
  # Une station qui tourne garde ses images : seule une image qui manque se
  # tire, par up. Sinon, une relance prendrait la dernière caddy:2.11-alpine,
  # et recréerait Caddy.
  say "Démarrage : les images de la version $version."
  if [[ -z $running ]]; then
    compose pull ||
      die "Les images de la version $version ne se tirent pas." \
        "Images privées : relancer avec --github-token-file, un jeton GitHub qui a read:packages. Sinon, vérifier l'accès de la machine à ghcr.io, puis relancer."
  fi
  compose up -d ||
    die "La station ne démarre pas : voir le message de docker compose plus haut." \
      "Si radiotomate-init a échoué : cd $dir && docker compose logs radiotomate-init. Puis relancer station install."
  wait_https
  smoke
  if [[ -n $first ]]; then
    station_settings
  fi

  say "" "La station tourne : l'antenne joue."
  say "  Console : https://$domain$([[ $tls != internal ]] || echo ', avec un certificat que les navigateurs refusent')"
  say "  Flux : https://$domain/$(stream_mount)"
  say "  Direct : $domain, port $(env_value HARBOR_PORT 6800), avec le jeton d'encodeur de chaque compte"
  say "  Dossier : $dir, et la commande : station"
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    say "  Mises à jour : automatiques, dès que la commande update existera"
  else
    say "  Mises à jour : à la main, dès que la commande update existera"
  fi
  if [[ -n $first ]]; then
    admin_password
  fi
}

# choose <clé de .env> <option> <valeur de l'option> <défaut> <contrôle> <question>
# La valeur de .env si elle y est ; sinon celle de l'option ; sinon la réponse
# au clavier ; sinon le défaut. Une option qui contredit .env ne change rien.
# Sans défaut ni clavier, l'option est obligatoire.
choose() {
  local key=$1 option=$2 value=$3 default=$4 check=$5 question=$6 current
  if [[ -n $key && -f $env_file ]] && env_has "$key"; then
    current=$(env_value "$key")
    if [[ $given == *" $option "* && $value != "$current" ]]; then
      warn "--$option $value n'est pas pris : la station a déjà $key=$current, que station install ne change pas."
    fi
    printf '%s\n' "$current"
  elif [[ $given == *" $option "* ]]; then
    "$check" "$value" || exit 2
    printf '%s\n' "$value"
  elif interactive; then
    ask "$question" "$default" "$check"
  elif [[ -n $default || $option == email ]]; then
    printf '%s\n' "$default"
  else
    die "--$option manque : sans terminal, ou avec --yes, rien ne se demande." "Relancer avec --$option, par exemple --domain radio.example."
  fi
}

# Comme choose, mais la question se répond par oui ou non.
choose_updates() {
  local answer
  if { [[ -f $env_file ]] && env_has BUTTON_UPDATES; } || [[ $given == *" updates "* ]] || ! interactive; then
    choose BUTTON_UPDATES updates "$updates" auto check_updates ""
    return
  fi
  answer=$(ask "Mises à jour automatiques, quand la commande update existera ? (o/n)" o check_yes_no)
  if [[ ${answer,,} == [oy]* ]]; then echo auto; else echo manual; fi
}

# Le dossier de la station : celui de ce script s'il est déjà celui d'une
# station, puisque la commande posée sur la machine y mène ; sinon celui où
# mène cette commande, pour le script téléchargé, relancé ; sinon /opt/button.
default_dir() {
  local script folder
  for script in "${BASH_SOURCE[0]:-}" "$BIN"; do
    script=$(readlink -f "$script" 2>/dev/null) || continue
    folder=${script%/*}
    if [[ -f $folder/VERSION && -f $folder/compose.yml ]]; then
      printf '%s\n' "$folder"
      return
    fi
  done
  printf '%s\n' "$DEFAULT_DIR"
}

# --- Exploiter la station ---

# Les options d'une commande : un drapeau connu, ou une option connue suivie
# de sa valeur, --nom VALEUR ou --nom=VALEUR. Elles vont dans le tableau
# associatif opts de la commande, les autres arguments dans args.
parse_options() { # "drapeaux…", "options à valeur…", arguments…
  local flags=" $1 " valued=" $2 " option
  shift 2
  while (($#)); do
    option=$1
    shift
    case $option in
      --*=*)
        [[ $valued == *" ${option%%=*} "* ]] || usage_error "Option inconnue : ${option%%=*}."
        opts[${option%%=*}]=${option#*=}
        ;;
      -*)
        if [[ $flags == *" $option "* ]]; then
          opts[$option]=1
        elif [[ $valued == *" $option "* ]]; then
          (($#)) || usage_error "$option attend une valeur."
          opts[$option]=$1
          shift
        else
          usage_error "Option inconnue : $option."
        fi
        ;;
      *) args+=("$option") ;;
    esac
  done
}

help_asked() { [[ -n ${opts[-h]:-}${opts[--help]:-} ]]; }

# Le dossier de la station d'une commande : --dir, sinon default_dir.
station_dir() { # --dir donné, ou rien
  [[ -z $1 || $1 == /* ]] || usage_error "--dir attend un chemin absolu, comme /opt/button."
  dir=${1:-$(default_dir)}
  dir=${dir%/}
  env_file=$dir/.env
}

need_root() { # commande
  [[ $(id -u) == 0 ]] ||
    die "station $1 demande les droits root." "Relancer avec sudo : sudo station $1."
}

need_station() { # commande
  local missing=""
  [[ -f $dir/compose.yml ]] || missing="$missing compose.yml"
  [[ -f $env_file ]] || missing="$missing .env"
  [[ -z $missing ]] ||
    die "Pas de station dans $dir : il y manque$missing." \
      "L'installer, ou la réparer : station install. Une station ailleurs : station $1 --dir DOSSIER."
}

# Le début de chaque commande : son dossier, root, sa station, puis .env seul
# règle docker compose.
open_station() { # commande, --dir donné, ou rien
  station_dir "$2"
  need_root "$1"
  need_station "$1"
  env_isolate
}

# Une commande qui change la station la prend pour elle seule : une
# restauration, une réparation par install et une mise à jour (MAJ-04) ne se
# croisent pas. Le verrou tombe avec la commande.
lock_station() { # commande
  mkdir -p "${LOCK%/*}"
  exec 9>>"$LOCK"
  flock -n 9 ||
    die "Une autre commande station tourne déjà sur cette machine." "Attendre qu'elle finisse, puis relancer station $1."
}

# La version de la station : celle que .env épingle, sinon celle du dossier.
installed_version() {
  local version
  version=$(env_value BUTTON_VERSION)
  if [[ -z $version && -f $dir/VERSION ]]; then
    version=$(<"$dir/VERSION")
  fi
  printf '%s\n' "${version:-inconnue}"
}

# Une taille en Ko, lisible : 850 Ko, 12 Mo, 3,4 Go.
human_kb() {
  awk -v kb="$1" 'BEGIN {
    if (kb < 1024) { printf "%d Ko\n", kb; exit }
    if (kb < 1048576) { printf "%d Mo\n", kb / 1024; exit }
    size = sprintf(kb < 10485760 ? "%.1f" : "%d", kb / 1048576)
    sub(/\./, ",", size)
    print size " Go"
  }'
}

# Une heure, à celle de la station (TZ de .env) : 10/11/2026 à 13:00.
station_date() { # secondes depuis 1970
  TZ=$(env_value TZ Europe/Paris) date -d "@$1" '+%d/%m/%Y à %H:%M'
}

# Le temps passé depuis, en mots : 12 min, 5 h, 3 jours.
since() { # secondes depuis 1970
  local seconds=$(($(date +%s) - $1))
  if ((seconds < 3600)); then
    echo "$((seconds < 60 ? 1 : seconds / 60)) min"
  elif ((seconds < 2 * 86400)); then
    echo "$((seconds / 3600)) h"
  else
    echo "$((seconds / 86400)) jours"
  fi
}

# La place libre et la taille, en Ko, et le point de montage, là où vit ce
# chemin, ou son plus proche parent.
df_line() { # chemin
  df -Pk "$(existing_parent "$1")" 2>/dev/null | awk 'NR == 2 { print $4, $2, $6 }'
}

mount_of() { # chemin
  local line
  line=$(df_line "$1")
  printf '%s\n' "${line##* }"
}

# Assez de place, là où vit ce chemin, pour y écrire tant de Ko, et la marge ?
space_for() { # chemin, Ko, que faire sinon
  local line free need=$(($2 + SPACE_MARGIN_KB))
  line=$(df_line "$1")
  free=${line%% *}
  [[ $free =~ ^[0-9]+$ ]] || return 0
  ((free >= need)) ||
    die "Pas assez de place pour $1 : $(human_kb "$free") libres, il en faut $(human_kb "$need")." "$3"
}

# La taille de ces chemins, en Ko, 0 pour un chemin absent. Un fichier qui
# bouge pendant le calcul, déposé ou rangé, ne l'arrête pas.
size_kb() { # chemin…
  local kb
  kb=$(du -skc "$@" 2>/dev/null | tail -n 1 | cut -f1) || true
  [[ $kb =~ ^[0-9]+$ ]] || kb=0
  printf '%s\n' "$kb"
}

# Le dossier réel, au bout d'un lien symbolique : celui que tar lit, et que
# restore remplace.
real_path() { # chemin
  readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"
}

# Un point de montage ne se déplace pas, ni ne se remplace par un dossier.
mounted() { # chemin
  command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$1"
}

# Le nom de la banque de sons dans une archive : celui de son dossier, sans
# barre oblique ni tiret en tête, et pas celui d'un autre fichier de l'archive.
media_name_ok() { # nom
  local member
  [[ -n $1 && $1 != */* && $1 != -* && $1 != . && $1 != .. && $1 != *$'\n'* ]] || return 1
  for member in SHA256SUMS "${BACKUP_FILES[@]}"; do
    [[ $1 != "$member" ]] || return 1
  done
}

# Tous les profils de compose.yml, en options, dans le tableau profiles de
# l'appelant : un conteneur de share ou de cloud lancé à part compte aussi.
all_profiles() {
  local profile
  profiles=()
  while IFS= read -r profile; do
    [[ -z $profile ]] || profiles+=(--profile "$profile")
  done < <(compose config --profiles 2>/dev/null)
}

# Sans terminal ni --yes, ce qui se confirme ne se fait pas : à vérifier
# avant le travail, que la question vienne au début ou à la fin.
confirm_possible() { # commande
  [[ -n $assume_yes ]] || interactive ||
    die "Sans terminal, station $1 attend --yes pour se faire." "Relancer avec --yes, une fois sûr."
}

# Oui ou non, au clavier ; --yes répond oui.
confirm() { # commande, question
  [[ -z $assume_yes ]] || return 0
  confirm_possible "$1"
  local answer
  answer=$(ask "$2" n check_yes_no)
  [[ ${answer,,} == [oy]* ]] || die "" "$aborted"
}

# Un mot à taper, pour ce qui ne se défait pas ; --yes le tape.
confirm_word() { # commande, mot, question
  [[ -z $assume_yes ]] || return 0
  confirm_possible "$1"
  local answer
  printf '  %s ' "$3" >&2
  IFS= read -r answer || die "" "$aborted"
  [[ $(trim "$answer") == "$2" ]] || die "" "$aborted"
}

# Un programme dans l'image du moteur, avec ses données : un conteneur de
# radiotomate-init, en root, qui ne démarre rien d'autre, que la station tourne
# ou non. L'image a bash, tar et Python : l'hôte n'a besoin ni de sqlite3, ni de
# Python. Ce qu'il écrit sur sa sortie d'erreur ne s'affiche que s'il échoue.
# Il lit l'entrée standard : un script qui n'en a pas besoin reçoit /dev/null,
# et ne prend rien de ce qui se tape au clavier.
engine_run() { # options de docker compose run…
  compose run --rm --no-deps -T "$@" 2>"$work/moteur.log" || {
    cat "$work/moteur.log" >&2
    return 1
  }
}

# backup-radiotomate.sh, dans l'image du moteur : la base, copiée sans couper
# l'antenne, radiotomate.yaml et le reste de RT_DATA, avec leurs sommes. Sa
# copie de travail va dans le dossier donné, pas dans le /tmp du conteneur.
engine_backup() { # dossier où écrire radiotomate.tar.gz, dossier de travail
  engine_run -v "$dir/scripts/backup-radiotomate.sh:/backup-radiotomate.sh:ro" -v "$1:/sauvegarde" \
    -v "$2:/travail" -e TMPDIR=/travail \
    --entrypoint bash radiotomate-init /backup-radiotomate.sh /data /sauvegarde/radiotomate.tar.gz </dev/null >/dev/null
}

# restore-radiotomate.sh, dans l'image du moteur : l'archive de la base, ses
# sommes et la base vérifiées, dans un dossier vide.
engine_restore() { # radiotomate.tar.gz, dossier vide, dossier de travail
  engine_run -v "$dir/scripts/restore-radiotomate.sh:/restore-radiotomate.sh:ro" \
    -v "$1:/sauvegarde.tar.gz:ro" -v "$2:/cible" -v "$3:/travail" -e TMPDIR=/travail \
    --entrypoint bash radiotomate-init /restore-radiotomate.sh /sauvegarde.tar.gz /cible </dev/null >/dev/null
}

# La version du schéma de la base en place, puis celle de la base d'un dossier.
engine_schemas() { # dossier
  engine_run -v "$1:/cible" --entrypoint python3 radiotomate-init - <<'PY'
# schémas : la version de la base en place, puis celle de la base remise.
import sqlite3
from contextlib import closing

for path in ("/data/radiotomate.db", "/cible/radiotomate.db"):
    with closing(sqlite3.connect(path)) as con:
        row = con.execute("select value from settings where key = 'SCHEMA_VERSION'").fetchone()
    print(row[0] if row else "")
PY
}

# Les adresses publiques des réglages Station qui suivaient l'ancien domaine
# passent au nouveau. Celles qu'un admin a changées dans la console restent.
# Elles se forment comme dans station_settings. Écrit les clés changées.
engine_domain_settings() { # ancien domaine, nouveau
  engine_run -e "BUTTON_OLD=$1" -e "BUTTON_NEW=$2" -e "BUTTON_MOUNT=$(stream_mount)" \
    --entrypoint python3 radiotomate-init - <<'PY'
# domaine : les adresses publiques des réglages Station, de l'ancien au nouveau.
import os
import sqlite3
from contextlib import closing

old, new = os.environ["BUTTON_OLD"], os.environ["BUTTON_NEW"]
addresses = {
    "station.public_stream_url": "https://{}/" + os.environ["BUTTON_MOUNT"],
    "station.now_url": "https://{}/now.json",
    "station.status_url": "https://{}/status-json.xsl",
    "station.harbor_host": "{}",
}
with closing(sqlite3.connect("/data/radiotomate.db", timeout=30)) as con, con:
    for key, address in addresses.items():
        changed = con.execute(
            "update settings set value = ? where key = ? and value = ?",
            (address.format(new), key, address.format(old)),
        ).rowcount
        if changed:
            print(key)
PY
}

# --- status ---

cmd_status() {
  local dir="" env_file="" domain healthy=1
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command status
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  open_station status "${opts[--dir]:-}"
  domain=$(env_value DOMAIN)
  say "Station : $dir${domain:+, https://$domain}"
  journal_report || healthy=""
  version_report
  updates_report
  services_report || healthy=""
  disk_report
  next_live_report
  backup_report
  [[ -n $healthy ]]
}

# Une restauration coupée en plein échange, par un arrêt de la machine.
journal_report() {
  [[ -f $dir/$JOURNAL ]] || return 0
  warn "une restauration ne s'est pas finie. $dir/$JOURNAL dit, ligne à ligne, le dossier en place, celui d'avant, mis à côté, et celui de la sauvegarde :"
  grep -v '^#' "$dir/$JOURNAL" | sed 's/^/  /' >&2
  say "  Pour revenir à la station d'avant : cd $dir && docker compose stop, remettre chaque dossier d'avant à sa place, effacer $JOURNAL, puis docker compose up -d. Ou relancer station restore."
  return 1
}

version_report() {
  local installed latest
  installed=$(installed_version)
  latest=$(latest_version 5 2>/dev/null) || latest=""
  if [[ -z $latest ]]; then
    say "Version : $installed. La plus haute publiée ne se lit pas : GitHub ne répond pas."
  elif [[ $latest == "$installed" ]]; then
    say "Version : $installed, la plus haute publiée."
  else
    say "Version : $installed ; la plus haute publiée : $latest, https://github.com/$REPO/releases"
  fi
}

# Les mises à jour, comme install les note : automatiques seulement avec
# BUTTON_UPDATES=auto, ou sans la ligne.
updates_label() {
  local time
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    time=$(env_value BUTTON_UPDATE_TIME)
    printf 'automatiques, à %s (%s)\n' "${time:-$UPDATE_TIME}" "$(env_value TZ Europe/Paris)"
  else
    printf 'à la main\n'
  fi
}

updates_report() {
  say "Mises à jour : $(updates_label), dès que la commande update existera."
  if [[ -f $dir/HOLD ]]; then
    say "  Bloquées, par $dir/HOLD :"
    sed 's/^/    /' "$dir/HOLD"
  fi
}

# Chaque service attendu, avec son état. Échoue si l'un ne va pas.
services_report() {
  local services states service line state health code label bad=""
  if ! docker_ok; then
    say "Services : inconnus, Docker ne répond pas. Voir pourquoi : systemctl status docker."
    return 1
  fi
  services=$(compose config --services 2>/dev/null | sort) || services=""
  states=$(compose ps -a --format '{{.Name}}|{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2>/dev/null) || states=""
  if [[ -z $services ]]; then
    say "Services : la liste ne se lit pas. Voir pourquoi : cd $dir && docker compose config."
    return 1
  fi
  say "Services :"
  while IFS= read -r service; do
    # Le conteneur du service, pas celui d'un docker compose run.
    line=$(awk -F '|' -v service="$service" '$2 == service && $1 !~ /-run-/ { print; exit }' <<<"$states")
    IFS='|' read -r _ _ state health code <<<"$line"
    case $state/$health in
      running/healthy) label="sain" ;;
      running/) label="en marche" ;;
      running/starting) label="démarre" ;;
      running/unhealthy) label="en panne : son contrôle de santé échoue" ;;
      restarting/*) label="redémarre sans cesse" ;;
      exited/*)
        label="arrêté, code $code"
        [[ $service != radiotomate-init || $code != 0 ]] || label="fait"
        ;;
      /) label="absent : pas de conteneur" ;;
      *) label=$state ;;
    esac
    case $label in
      sain | "en marche" | fait) ;;
      *) bad="$bad${bad:+,} $service" ;;
    esac
    printf '  %-22s %s\n' "$service" "$label"
  done <<<"$services"
  [[ -n $bad ]] || return 0
  if [[ -z $states ]]; then
    say "  La station ne tourne pas. La démarrer : cd $dir && docker compose up -d."
  else
    say "  Ne vont pas :$bad. Leur journal : station logs SERVICE."
  fi
  return 1
}

disk_report() {
  local path line free total mount seen=" "
  for path in "$dir" "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"; do
    line=$(df_line "$path")
    read -r free total mount <<<"$line"
    if [[ ! $free =~ ^[0-9]+$ || ! $total =~ ^[0-9]+$ ]]; then
      say "Disque : la place de $path ne se lit pas."
      continue
    fi
    [[ $seen != *" $mount "* ]] || continue
    seen="$seen$mount "
    say "Disque : $(human_kb "$free") libres sur $(human_kb "$total"), sur $mount$([[ $path == "$dir" ]] || echo ', pour Docker')."
    if ((free < MIN_FREE_GB * 1048576)); then
      warn "moins de $MIN_FREE_GB Go libres sur $mount : en libérer, ou agrandir le disque."
    fi
  done
}

next_live_report() {
  local live
  if ! docker_ok; then
    say "Prochain direct : inconnu, Docker ne répond pas."
  elif ! station_running radiotomate-interface; then
    say "Prochain direct : inconnu, le moteur ne tourne pas."
  elif live=$(compose exec -T radiotomate-interface radiotomate maintenance next-live </dev/null 2>/dev/null) && [[ -n $live ]]; then
    say "Prochain direct : $live."
  else
    say "Prochain direct : inconnu, le moteur ne le dit pas : il ne répond pas, ou sa version n'a pas radiotomate maintenance next-live."
  fi
}

backup_report() {
  local line made archive size media
  line=$(grep -v '^#' "$dir/backups.log" 2>/dev/null | tail -n 1) || line=""
  IFS=$'\t' read -r made archive size media <<<"$line"
  if [[ ! $made =~ ^[0-9]+$ || ! $size =~ ^[0-9]+$ ]]; then
    say "Dernière sauvegarde : aucune. En faire une : station backup."
    return
  fi
  say "Dernière sauvegarde : le $(station_date "$made"), il y a $(since "$made"), $(human_kb "$size")$([[ $media != 1 ]] || echo ', avec les sons') : $archive$([[ -f $archive ]] || echo ", qui n'y est plus")."
}

# --- logs ---

cmd_logs() {
  local dir="" env_file="" option tail=(--tail 200) args=()
  while (($#)); do
    option=$1
    shift
    case $option in
      --dir=*) dir=${option#*=} ;;
      --dir)
        (($#)) || usage_error "--dir attend une valeur."
        dir=$1
        shift
        ;;
      -h | --help)
        usage_command logs
        return 0
        ;;
      -n | --tail | --tail=* | --since | --since=* | --until | --until=*)
        tail=()
        args+=("$option")
        ;;
      *) args+=("$option") ;;
    esac
  done
  open_station logs "$dir"
  compose logs "${tail[@]}" "${args[@]}"
}

# --- backup ---

cmd_backup() {
  local dir="" env_file="" archive
  local -A opts=()
  local args=()
  parse_options "--with-media -h --help" "--dir" "$@"
  if help_asked; then
    usage_command backup
    return 0
  fi
  ((${#args[@]} <= 1)) || usage_error "Argument inattendu : ${args[1]}. Une seule archive."
  open_station backup "${opts[--dir]:-}"
  lock_station backup
  trap cleanup EXIT
  archive=${args[0]:-}
  backup_target
  backup_station "$archive" "${opts[--with-media]:-}"
}

# Où écrire l'archive : le fichier donné ; dans le dossier donné ; sinon dans
# backups/, dans le dossier de la station. Son nom dit l'heure, en UTC. Une
# sauvegarde ne s'écrit jamais par-dessus un fichier.
backup_target() {
  local name
  name=button-$(date -u +%Y%m%dT%H%M%SZ).tar
  if [[ -z $archive ]]; then
    install -d -m 700 "$dir/backups"
    archive=$dir/backups/$name
  elif [[ -d $archive ]]; then
    archive=${archive%/}/$name
  fi
  [[ $archive == /* ]] || archive=$PWD/$archive
  [[ -d ${archive%/*} ]] ||
    die "Le dossier ${archive%/*} n'existe pas." "Le créer, ou donner un autre chemin à station backup."
  [[ ! -e $archive && ! -e $archive.part ]] ||
    die "$archive existe déjà : une sauvegarde ne s'écrit jamais par-dessus un fichier." "Donner un autre nom, ou un dossier."
}

# La sauvegarde de la station, dans archive, en droits 600 : de quoi la
# remettre, ici ou sur une autre machine, par station restore, même d'une
# version plus récente. L'antenne continue. Une ligne de backups.log la note.
# La commande update (MAJ-04) la fera avant chaque mise à jour. Tout s'écrit
# à côté de l'archive : son disque est le seul dont la place compte.
backup_station() { # archive, avec les sons (1) ou non
  local archive=$1 with_media=$2 stage data caddy media="" data_kb caddy_kb media_kb=0 size_kb
  data=$(env_path RT_DATA ./data/radiotomate)
  caddy=$(env_path CADDY_DATA ./data/caddy)
  [[ -f $data/radiotomate.db ]] ||
    die "La station n'a pas de base : $data/radiotomate.db manque." \
      "Finir l'installation : station install. Ou vérifier RT_DATA, dans $env_file."
  [[ -f $dir/scripts/backup-radiotomate.sh ]] ||
    die "$dir/scripts/backup-radiotomate.sh manque." "station install le remet. Puis relancer."
  if [[ -n $with_media ]]; then
    # La banque elle-même, au bout d'un lien : tar ne suit pas un lien.
    media=$(real_path "$(env_path BUTTON_MEDIA ./media)")
    [[ -d $media ]] || die "La banque de sons, $media, n'existe pas." "Vérifier BUTTON_MEDIA, dans $env_file."
    media_name_ok "${media##*/}" ||
      die "La banque de sons, $media, ne peut pas entrer dans une archive sous ce nom." \
        "La renommer, et BUTTON_MEDIA avec elle, dans $env_file : sans tiret en tête, et pas MANIFEST, SHA256SUMS, radiotomate.tar.gz, env ni caddy.tar.gz."
    media_kb=$(size_kb "$media")
  fi
  # Au plus : RT_DATA hors des copies de la base, deux fois, le temps de le
  # copier puis de le compresser ; Caddy ; les sons.
  data_kb=$(($(size_kb "$data") - $(size_kb "$data/backups")))
  caddy_kb=$(size_kb "$caddy")
  space_for "${archive%/*}" $((2 * data_kb + caddy_kb + media_kb)) \
    "Libérer de la place, ou écrire la sauvegarde ailleurs : station backup /un/autre/dossier."
  # L'archive naît vide, en 600, avant le reste : une ACL par défaut sur le
  # dossier passe outre le umask, mais pas le mode donné à la création. Un
  # dossier qui ne garde pas les droits, comme un partage Windows, la
  # laisserait lisible par d'autres, avec les secrets de .env.
  partial=$archive.part
  if ! install -m 600 /dev/null "$partial" 2>/dev/null || [[ $(stat -c %a "$partial") != 600 ]]; then
    die "${archive%/*} ne garde pas les droits des fichiers : l'archive, qui porte les secrets de .env, y serait lisible par d'autres." \
      "L'écrire sur un disque de cette machine, station backup /un/autre/dossier, puis la copier là."
  fi

  work=$(mktemp -d "${archive%/*}/.station-XXXXXX")
  stage=$work/sauvegarde
  mkdir "$stage" "$work/tmp"
  say "Sauvegarde : la base, sans couper l'antenne."
  backup_stage "$stage" "$data_kb" "$media" "$media_kb"
  backup_pack "$stage" "$archive" "$media"

  size_kb=$(size_kb "$archive")
  if [[ ! -f $dir/backups.log ]]; then
    printf '%s\n' "# Les sauvegardes de station backup, une par ligne : l'heure, en secondes depuis 1970, l'archive, sa taille en Ko, et 1 si elle a les sons." \
      >"$dir/backups.log"
  fi
  printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$archive" "$size_kb" "${with_media:-0}" >>"$dir/backups.log"
  say "Sauvegarde : $archive, $(human_kb "$size_kb"), $([[ -n $media ]] && echo 'avec les sons' || echo 'sans les sons')." \
    "  En droits 600, à root : elle porte les secrets de .env. En garder une copie hors de cette machine : voir docs/exploitation/sauvegarde.md."
}

# Ce qu'une sauvegarde porte, hors des sons, dans un dossier : MANIFEST, qui
# dit son format, sa date, la version de la station, et le nom de la banque
# de sons si elle y est ; SHA256SUMS, les sommes des autres fichiers ;
# radiotomate.tar.gz, l'archive de backup-radiotomate.sh ; env, le .env de la
# station, sans le mot de passe admin ; caddy.tar.gz, ses certificats et son
# compte Let's Encrypt. Une sauvegarde hors de la machine (SAV-01) peut
# envoyer ce dossier tel quel.
backup_stage() { # dossier, taille de RT_DATA en Ko, banque de sons ou rien, sa taille
  local stage=$1 caddy status=0
  engine_backup "$stage" "$work/tmp" ||
    die "La base ne se sauvegarde pas : voir le message plus haut." "Voir l'état de la station, station status, puis relancer."
  # Le mot de passe admin ne s'écrit que dans .env, jusqu'à son affichage.
  install -m 600 /dev/null "$stage/env"
  sed 's/^RT_ADMIN_PASSWORD=.*/RT_ADMIN_PASSWORD=/' "$env_file" >"$stage/env"
  caddy=$(env_path CADDY_DATA ./data/caddy)
  if [[ ! -d $caddy ]]; then
    caddy=$work/vide
    mkdir "$caddy"
  fi
  # 1 : le tar de GNU a vu un fichier changer, un verrou de Caddy par exemple.
  tar -czf "$stage/caddy.tar.gz" -C "$caddy" . || status=$?
  ((status <= 1)) ||
    die "Les certificats de Caddy ne se copient pas : voir le message de tar plus haut." "Vérifier $caddy et la place, puis relancer."
  cat >"$stage/MANIFEST" <<EOF
# Une sauvegarde de station BUTTON, faite par station backup : station restore
# la remet. Les sommes de ses fichiers sont dans SHA256SUMS, sauf celles des sons.
format=$BACKUP_FORMAT
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
time=$(date +%s)
version=$(installed_version)
data_kb=$2
media=${3##*/}
media_kb=$4
EOF
  (cd "$stage" && sha256sum "${BACKUP_FILES[@]}" >SHA256SUMS)
}

# L'archive : MANIFEST, SHA256SUMS, les autres fichiers, puis les sons. Une
# tar sans compression : ses fichiers le sont déjà, les sons aussi, et
# restore lit MANIFEST sans lire le reste. Elle s'écrit dans partial, que
# backup_station a créé en 600, puis prend son nom.
backup_pack() { # dossier, archive, banque de sons ou rien
  local stage=$1 archive=$2 media=$3 parent status=0 members=()
  members=(-C "$stage" MANIFEST SHA256SUMS "${BACKUP_FILES[@]:1}")
  if [[ -n $media ]]; then
    parent=${media%/*}
    members+=(-C "${parent:-/}" "${media##*/}")
  fi
  say "Sauvegarde : l'archive$([[ -z $media ]] || echo ', avec les sons'), dans ${archive%/*}."
  tar -cf - "${members[@]}" >"$partial" || status=$?
  if ((status == 1)) && [[ -n $media ]]; then
    # Le tar de GNU : des fichiers ont changé pendant qu'il les lisait.
    warn "des sons ont changé pendant la sauvegarde, déposés ou rangés : elle les a tels que tar les a lus."
  elif ((status != 0)); then
    die "L'archive ne s'écrit pas : voir le message de tar plus haut." "Vérifier la place, et le dossier ${archive%/*}. Puis relancer."
  fi
  mv -f "$partial" "$archive"
  partial=""
}

# --- restore ---

cmd_restore() {
  local dir="" env_file="" archive assume_yes="" aborted="Rien n'est changé."
  local -A opts=()
  local args=()
  parse_options "--yes --without-media -h --help" "--dir" "$@"
  if help_asked; then
    usage_command restore
    return 0
  fi
  ((${#args[@]} == 1)) || usage_error "station restore attend une archive, et une seule : station restore ARCHIVE."
  archive=${args[0]}
  [[ $archive == /* ]] || archive=$PWD/$archive
  assume_yes=${opts[--yes]:-}
  open_station restore "${opts[--dir]:-}"
  confirm_possible restore
  [[ -f $archive && -r $archive ]] ||
    die "$archive n'existe pas, ou ne se lit pas." "Donner le chemin d'une archive de station backup."
  lock_station restore
  trap cleanup EXIT
  restore_station "$archive" "${opts[--without-media]:-}"
}

# Une valeur du MANIFEST de la sauvegarde.
manifest_value() { # clé
  sed -n "s/^$1=//p" "$work/sauvegarde/MANIFEST" | tail -n 1
}

# Un nombre du MANIFEST, 0 s'il n'en est pas un : rien d'autre d'une archive
# ne se calcule.
manifest_number() { # clé
  local value
  value=$(manifest_value "$1")
  [[ $value =~ ^[0-9]{1,15}$ ]] || value=0
  printf '%s\n' "$value"
}

# Une valeur, ou une variable posée, dans un autre .env que celui de la station.
env_value_in() { # .env, clé, défaut
  local env_file=$1
  shift
  env_value "$@"
}

env_set_in() { # .env, clé, valeur, commande
  local env_file=$1
  shift
  env_set "$@"
}

# Ouvre la sauvegarde dans un dossier : MANIFEST et SHA256SUMS d'abord, au
# début de l'archive, puis les fichiers que SHA256SUMS nomme, vérifiés. Le
# format se lit avant le reste : une archive d'un format plus ancien se lit
# aussi. Les sons restent dans l'archive.
restore_unpack() { # archive, dossier
  local archive=$1 in=$2 format name listed=()
  tar -xf "$archive" -C "$in" --occurrence MANIFEST SHA256SUMS 2>"$work/tar.log" ||
    die "$archive n'est pas une sauvegarde de station, ou elle est abîmée : $(head -n 1 "$work/tar.log")" \
      "Prendre une archive faite par station backup."
  format=$(manifest_value format)
  [[ $format =~ ^[0-9]+$ ]] ||
    die "$archive n'a pas de MANIFEST lisible : ce n'est pas une sauvegarde de station." "Prendre une archive faite par station backup."
  ((format <= BACKUP_FORMAT)) ||
    die "Cette sauvegarde est au format $format, plus récent que celui de cette commande, $BACKUP_FORMAT." \
      "Prendre la commande station de la version de la sauvegarde, ou d'une plus récente, puis relancer."
  while read -r _ name; do
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
      die "La sauvegarde est abîmée : SHA256SUMS nomme « $name »." "En prendre une autre."
    listed+=("$name")
  done <"$in/SHA256SUMS"
  tar -xf "$archive" -C "$in" --occurrence "${listed[@]}" 2>"$work/tar.log" ||
    die "La sauvegarde est abîmée : $(head -n 1 "$work/tar.log")" "En prendre une autre."
  (cd "$in" && sha256sum -c SHA256SUMS >/dev/null 2>&1) ||
    die "La sauvegarde est abîmée : un de ses fichiers ne correspond pas à sa somme, dans SHA256SUMS." "En prendre une autre."
  for name in "${BACKUP_FILES[@]}"; do
    [[ -f $in/$name ]] || die "La sauvegarde est abîmée : il y manque $name." "En prendre une autre."
  done
}

# Une variable de .env qui va avec la base : celle de la sauvegarde, à la
# place de celle de cette machine, si son contrôle la prend.
restore_env_value() { # clé, défaut, contrôle ou rien
  local value
  value=$(env_value_in "$in/env" "$1" "$2")
  [[ $value != "$(env_value_in "$new_env" "$1" "$2")" ]] || return 0
  if [[ -n $3 ]] && ! "$3" "$value" 2>/dev/null; then
    warn "$1 de la sauvegarde, « $value », ne vaut pas sur cette machine : .env garde le sien."
    return 0
  fi
  env_set_in "$new_env" "$1" "$value" restore
  [[ $1 == RT_ADMIN_PASSWORD ]] || taken="$taken${taken:+,} $1=$value"
}

# Remet une sauvegarde de station backup. Tout se prépare à côté, pendant que
# l'antenne continue : la base vérifiée, Caddy, les sons, .env. Puis la
# station s'arrête, chacun prend la place du sien, et elle repart. Si elle ne
# repart pas, cleanup remet celle d'avant (restore_undo).
restore_station() { # archive, sans les sons (1) ou non
  local archive=$1 without_media=$2 in stamp version saved_at media media_kb data_kb path
  local data caddy media_dir new_data new_caddy="" new_media="" new_env schemas current restored
  local listing saved_domain differs="" taken="" key domain tls entry aside keys="" profiles=()
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # Les dossiers réels, au bout d'un lien.
  data=$(real_path "$(env_path RT_DATA ./data/radiotomate)")
  caddy=$(real_path "$(env_path CADDY_DATA ./data/caddy)")
  media_dir=$(real_path "$(env_path BUTTON_MEDIA ./media)")
  [[ -f $data/radiotomate.db ]] ||
    die "La station de $dir n'a pas encore de base : $data/radiotomate.db manque." \
      "Finir l'installation, station install, puis relancer la restauration."
  [[ -f $dir/scripts/restore-radiotomate.sh ]] ||
    die "$dir/scripts/restore-radiotomate.sh manque." "station install le remet. Puis relancer."
  # Le travail, sur le disque des données : la base s'y ouvre.
  work=$(mktemp -d "${data%/*}/.station-XXXXXX")
  in=$work/sauvegarde
  mkdir "$in" "$work/tmp"
  say "Restauration : lecture de $archive."
  restore_unpack "$archive" "$in"
  version=$(manifest_value version)
  saved_at=$(manifest_number time)
  media=$(manifest_value media)
  media_kb=$(manifest_number media_kb)
  data_kb=$(manifest_number data_kb)
  [[ -z $media ]] || media_name_ok "$media" ||
    die "Le MANIFEST de la sauvegarde nomme mal la banque de sons : « $media »." "En prendre une autre."
  if [[ -n $media && -n $without_media ]]; then
    say "Restauration : sans les sons de la sauvegarde (--without-media), la banque en place reste."
    media=""
  fi
  # Un point de montage ne se déplace pas : restore ne le remplace pas.
  for path in "$data" "$caddy"; do
    if mounted "$path"; then
      die "$path est un point de montage : restore ne sait pas le remplacer. Rien n'a changé." \
        "Restaurer à la main, avec les scripts : voir docs/exploitation/sauvegarde.md, « Avec les scripts »."
    fi
  done
  if [[ -n $media ]] && mounted "$media_dir"; then
    die "La banque de sons, $media_dir, est un point de montage : restore ne sait pas la remplacer. Rien n'a changé." \
      "Restaurer sans les sons, station restore --without-media, puis y remettre ceux de la sauvegarde : tar -xf ARCHIVE -C $media_dir --strip-components=1 $media."
  fi
  say "Sauvegarde du $(station_date "$saved_at"), d'une station en version ${version:-inconnue}$([[ -z $media ]] || echo ', avec ses sons')."
  # La place : la base deux fois à côté de la sienne, le temps de la vérifier ;
  # les sons à côté de la banque.
  if [[ -n $media && $(mount_of "$data") == "$(mount_of "$media_dir")" ]]; then
    space_for "$data" $((2 * data_kb + media_kb)) "Libérer de la place, ou agrandir le disque. Puis relancer."
  else
    space_for "$data" $((2 * data_kb)) "Libérer de la place, ou agrandir le disque. Puis relancer."
    [[ -z $media ]] || space_for "$media_dir" "$media_kb" "Libérer de la place, ou agrandir le disque. Puis relancer."
  fi

  # La base, vérifiée, à côté de celle en place, sur le même disque.
  new_data=$data.restauration-$stamp
  prepared+=("$new_data")
  mkdir "$new_data"
  say "Restauration : la base de la sauvegarde, vérifiée, à côté de celle en place."
  engine_restore "$in/radiotomate.tar.gz" "$new_data" "$work/tmp" ||
    die "La base de la sauvegarde ne se remet pas : voir le message plus haut. Rien n'a changé." "En prendre une autre."
  schemas=$(engine_schemas "$new_data") ||
    die "La version du schéma des bases ne se lit pas : voir le message plus haut. Rien n'a changé." "Voir l'état de la station : station status."
  current=$(sed -n 1p <<<"$schemas")
  restored=$(sed -n 2p <<<"$schemas")
  [[ $current =~ ^[0-9]+$ && $restored =~ ^[0-9]+$ ]] ||
    die "La version du schéma des bases ne se lit pas : « $current », « $restored ». Rien n'a changé." "Voir l'état de la station : station status."
  ((restored <= current)) ||
    die "La sauvegarde vient de la version ${version:-inconnue} : sa base est au schéma v$restored, que cette station, en $(installed_version), ne sait pas lire. Rien n'a changé." \
      "La remettre sur une station de la même version, ou d'une plus récente : sur une machine neuve, station install --version ${version:-X.Y.Z}."
  # La sauvegarde se remet : la question vient avant le reste, et l'arrêt.
  confirm restore "Remplacer les données de la station de $dir par celles de la sauvegarde ? Celles d'aujourd'hui restent à côté, et l'antenne se coupe le temps de redémarrer. (o/n)"

  # Caddy : ses certificats et son compte, s'il y en a, pour le domaine de
  # cette station. Une sauvegarde d'un autre domaine ne les a pas : la station
  # garde les siens, sans quoi Caddy devrait en demander de nouveaux pendant
  # la restauration.
  saved_domain=$(env_value_in "$in/env" DOMAIN)
  domain=$(env_value DOMAIN)
  if [[ $saved_domain == "$domain" ]]; then
    listing=$(tar -tzf "$in/caddy.tar.gz") ||
      die "Les certificats de Caddy de la sauvegarde ne se lisent pas. Rien n'a changé." "En prendre une autre."
    if grep -qvE '^\./?$' <<<"$listing"; then
      new_caddy=$caddy.restauration-$stamp
      prepared+=("$new_caddy")
      mkdir "$new_caddy"
      tar -xzf "$in/caddy.tar.gz" -C "$new_caddy" ||
        die "Les certificats de Caddy de la sauvegarde ne s'extraient pas : voir le message de tar plus haut. Rien n'a changé." "Vérifier la place, puis relancer."
    fi
  fi
  # Les sons, sous leur nom dans l'archive, à côté de la banque en place.
  if [[ -n $media ]]; then
    new_media=$media_dir.restauration-$stamp
    prepared+=("$new_media")
    mkdir "$new_media"
    say "Restauration : les sons de la sauvegarde, $(human_kb "$media_kb"), à côté de la banque en place."
    tar -xf "$archive" -C "$new_media" "$media" ||
      die "Les sons de la sauvegarde ne s'extraient pas : voir le message de tar plus haut. Rien n'a changé." "Vérifier la place, puis relancer."
  fi
  # .env : celui de cette machine, sa version, son domaine, ses ports et ses
  # secrets ; de la sauvegarde, le fuseau et le compte admin, qui vont avec la
  # base. Les autres différences se disent.
  new_env=$env_file.restauration-$stamp
  prepared+=("$new_env")
  install -m 600 /dev/null "$new_env"
  cat "$env_file" >"$new_env"
  restore_env_value TZ Europe/Paris check_timezone
  restore_env_value RT_ADMIN_USER button check_admin
  restore_env_value RT_ADMIN_PASSWORD "" ""
  while IFS= read -r key; do
    case $key in
      TZ | RT_ADMIN_USER | RT_ADMIN_PASSWORD | BUTTON_VERSION | DOMAIN | *PASSWORD* | *SECRET* | *_KEY) continue ;;
    esac
    [[ $(env_value_in "$in/env" "$key") == "$(env_value_in "$new_env" "$key")" ]] || differs="$differs${differs:+,} $key"
  done < <(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$in/env" "$new_env" | sort -u)

  # Tous les profils s'arrêtent, share compris s'il est lancé à part : sinon,
  # il garderait la banque mise de côté. Ceux qui tournaient repartent.
  say "Restauration : la station s'arrête, le temps d'échanger les données."
  all_profiles
  mapfile -t restart_others < <(compose "${profiles[@]}" ps --services --status running 2>/dev/null)
  station_stopped=$dir
  printf '%s\n' "# station restore, le $(station_date "$(date +%s)") : pas finie, tant que ce fichier est là." \
    "# Chaque ligne : le dossier en place|celui d'avant, mis à côté|celui de la sauvegarde." >"$dir/$JOURNAL"
  compose "${profiles[@]}" stop ||
    die "La station ne s'arrête pas : voir le message de docker compose plus haut." "Voir pourquoi, puis relancer la restauration."
  swap "$data" "$new_data" "$stamp"
  [[ -z $new_caddy ]] || swap "$caddy" "$new_caddy" "$stamp"
  [[ -z $new_media ]] || swap "$media_dir" "$new_media/$media" "$stamp"
  swap "$env_file" "$new_env" "$stamp"
  env_isolate
  # La station garde son domaine : les adresses publiques de la base qui
  # suivaient celui de la sauvegarde passent au sien.
  if [[ -n $saved_domain && -n $domain && $saved_domain != "$domain" ]]; then
    keys=$(engine_domain_settings "$saved_domain" "$domain") ||
      warn "les adresses de Réglages → Station ne suivent pas $domain : les changer dans la console."
  fi
  say "Restauration : la station repart, sur les données de la sauvegarde."
  compose up -d ||
    die "La station ne démarre pas sur la sauvegarde : voir le message de docker compose plus haut." \
      "La restauration s'annule. Voir pourquoi : cd $dir && docker compose logs radiotomate-init."
  restart_others_up ||
    die "Les services lancés à part ne repartent pas : voir le message de docker compose plus haut." \
      "La restauration s'annule. Voir pourquoi, puis relancer station restore."
  tls=$(env_value CADDY_TLS acme)
  if [[ -n $domain && ,$(env_value COMPOSE_PROFILES), == *,vps,* ]]; then
    https_ok ||
      die "https://$domain ne répond pas au bout de $HTTPS_WAIT s, sur la sauvegarde." \
        "La restauration s'annule. Voir pourquoi : cd $dir && docker compose logs caddy."
  fi
  smoke_ok ||
    die "Le contrôle de la station restaurée a échoué : voir plus haut." \
      "La restauration s'annule. Une fois réglé, relancer station restore."
  station_stopped=""
  rm -f "$dir/$JOURNAL"

  # Le .env d'avant garde à côté le mot de passe admin d'une installation qui
  # ne l'a pas affiché : il ne sert plus, et ne s'écrit que dans .env.
  aside=$env_file.avant-restauration-$stamp
  if [[ -f $aside && -n $(env_value_in "$aside" RT_ADMIN_PASSWORD) ]]; then
    env_set_in "$aside" RT_ADMIN_PASSWORD "" restore
  fi
  say "" "La station est restaurée : celle de la sauvegarde du $(station_date "$saved_at"), qui tourne ici en $(installed_version)."
  if ((restored < current)); then
    say "  Sa base, au schéma v$restored, est passée en v$current en démarrant. La copie d'avant est dans $data/backups."
  fi
  say "  Les comptes sont ceux de la sauvegarde : le mot de passe admin de cette installation ne sert plus."
  [[ -z $taken ]] || say "  De la sauvegarde, dans .env :$taken."
  if [[ -n $saved_domain && -n $domain && $saved_domain != "$domain" ]]; then
    if [[ -n $keys ]]; then
      say "  La sauvegarde servait $saved_domain : la station garde $domain et ses certificats, et les adresses de Réglages → Station qui suivaient $saved_domain passent à $domain."
    else
      say "  La sauvegarde servait $saved_domain : la station garde $domain et ses certificats. Vérifier les adresses de Réglages → Station, dans la console."
    fi
    say "  Pour reprendre $saved_domain : station config --domain $saved_domain."
  fi
  [[ -z $differs ]] ||
    say "  Gardés de cette machine, autres dans la sauvegarde :$differs. Leurs valeurs : tar -xOf $archive --occurrence env."
  say "  Les données d'avant restent à côté, à effacer une fois la station vérifiée :"
  for entry in "${swapped[@]}"; do
    aside=${entry#*|}
    aside=${aside%%|*}
    [[ ! -e $aside ]] || say "    $aside"
  done
  swapped=()
}

# Met new à la place de current, et current à côté, en
# current.avant-restauration-<heure>. Chaque échange s'écrit d'abord dans le
# journal ; restore_undo les défait.
swap() { # en place, nouveau, heure
  local aside=$1.avant-restauration-$3
  printf '%s|%s|%s\n' "$1" "$aside" "$2" >>"$dir/$JOURNAL"
  if [[ -e $1 ]]; then
    mv "$1" "$aside" ||
      die "$1 ne se met pas de côté : voir le message plus haut. La restauration s'annule." "Voir pourquoi, puis relancer station restore."
  fi
  swapped+=("$1|$aside|$2")
  mv "$2" "$1" ||
    die "$2 ne prend pas la place de $1 : voir le message plus haut. La restauration s'annule." "Voir pourquoi, puis relancer station restore."
}

# Les services qui tournaient avant la restauration et que up n'a pas
# relancés : ceux d'un profil que .env n'allume pas, comme share lancé à part.
restart_others_up() {
  local running service extra=() profiles=()
  running=" $(compose ps --services --status running 2>/dev/null | tr '\n' ' ') "
  for service in "${restart_others[@]}"; do
    [[ $running == *" $service "* ]] || extra+=("$service")
  done
  ((${#extra[@]})) || return 0
  all_profiles
  compose "${profiles[@]}" up -d "${extra[@]}"
}

# Une restauration arrêtée après l'arrêt de la station : chacun reprend sa
# place, et la station d'avant repart. Le journal reste si un dossier ne
# revient pas.
restore_undo() {
  local dir=$station_stopped env_file=$station_stopped/.env i current aside new left="" profiles=()
  station_stopped=""
  warn "la restauration s'annule : la station d'avant reprend sa place, et repart."
  all_profiles
  compose "${profiles[@]}" stop >/dev/null 2>&1
  for ((i = ${#swapped[@]} - 1; i >= 0; i--)); do
    IFS='|' read -r current aside new <<<"${swapped[i]}"
    if [[ -e $current ]] && ! mv "$current" "$new"; then
      warn "$current ne revient pas en $new : le remettre à la main."
      left=1
    fi
    if [[ -e $aside ]] && ! mv "$aside" "$current"; then
      warn "$aside ne reprend pas sa place, $current : l'y remettre à la main."
      left=1
    fi
  done
  swapped=()
  [[ -n $left ]] || rm -f "$dir/$JOURNAL"
  env_isolate
  if compose up -d >/dev/null 2>&1; then
    restart_others_up >/dev/null 2>&1
  else
    warn "la station d'avant ne repart pas. Voir pourquoi : cd $dir && docker compose up -d."
  fi
}

# --- config ---

cmd_config() {
  local dir="" env_file="" domain="" email="" old="" changed=""
  local -A opts=()
  local args=()
  parse_options "--no-domain-check -h --help" "--dir --domain --email --updates --update-time" "$@"
  if help_asked; then
    usage_command config
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  if [[ -n ${opts[--domain]+x} ]]; then
    domain=${opts[--domain],,}
    check_domain "$domain" || exit 2
  fi
  if [[ -n ${opts[--email]+x} ]]; then
    email=${opts[--email]}
    check_email "$email" || exit 2
  fi
  [[ -z ${opts[--updates]+x} ]] || check_updates "${opts[--updates]}" || exit 2
  [[ -z ${opts[--update-time]+x} ]] || check_update_time "${opts[--update-time]}" || exit 2
  open_station config "${opts[--dir]:-}"
  if [[ -z ${opts[--domain]+x}${opts[--email]+x}${opts[--updates]+x}${opts[--update-time]+x} ]]; then
    config_report
    return 0
  fi
  lock_station config
  work=$(mktemp -d)
  trap cleanup EXIT
  old=$(env_value DOMAIN)
  # Le domaine se vérifie avant tout : s'il ne mène pas ici, rien ne change.
  [[ -z ${opts[--domain]+x} || $domain == "$old" ]] || domain_verify
  [[ -z ${opts[--updates]+x} ]] || config_set BUTTON_UPDATES "${opts[--updates]}"
  [[ -z ${opts[--update-time]+x} ]] || config_set BUTTON_UPDATE_TIME "${opts[--update-time]}"
  [[ -z ${opts[--email]+x} ]] || config_set ACME_EMAIL "$email"
  if [[ -n ${opts[--domain]+x} && $domain != "$old" ]]; then
    domain_apply "$old"
  elif [[ $changed == *ACME_EMAIL* ]] && station_running caddy; then
    # Caddy lit l'e-mail à son démarrage : recréé, il s'en sert pour les
    # prochains certificats.
    compose up -d caddy || die "Caddy ne repart pas : voir le message de docker compose plus haut." "Voir pourquoi : cd $dir && docker compose logs caddy."
    say "Caddy : redémarré, avec l'e-mail ${email:-vide}. Le flux s'est coupé un instant."
  fi
  if [[ -n $changed ]]; then
    say "Changé dans $env_file :$changed."
  else
    say "Rien à changer : $env_file a déjà ces réglages."
  fi
}

# Pose une variable de .env si elle change, et la note.
config_set() { # clé, valeur
  if ! env_has "$1" || [[ $(env_value "$1") != "$2" ]]; then
    env_set "$1" "$2" config
    changed="$changed${changed:+,} $1"
  fi
}

config_report() {
  local domain email
  domain=$(env_value DOMAIN)
  email=$(env_value ACME_EMAIL)
  say "Réglages de la station, dans $env_file :" \
    "  Domaine : ${domain:-aucun}" \
    "  E-mail du compte Let's Encrypt : ${email:-aucun}" \
    "  Mises à jour : $(updates_label)" \
    "Pour en changer : station config --domain DOMAINE, --email E-MAIL, --updates auto|manual ou --update-time HH:MM."
}

# Le nouveau domaine, $domain, mène-t-il ici ? Comme install : Caddy s'arrête
# le temps de libérer le port 80, et cleanup le relance si la vérification
# échoue.
domain_verify() {
  if [[ $(env_value CADDY_TLS acme) == internal ]]; then
    say "Domaine : pas vérifié, Caddy signe lui-même le certificat (CADDY_TLS=internal)."
  elif [[ -n ${opts[--no-domain-check]:-} ]]; then
    warn "le domaine n'est pas vérifié (--no-domain-check). S'il ne mène pas ici, Let's Encrypt le refusera un moment."
  else
    say "Domaine : vérification de $domain. Caddy s'arrête le temps de la faire, et le flux avec lui."
    caddy_stopped=$dir
    compose stop caddy >/dev/null 2>&1 || true
    check_domain_here "$dir/compose.yml"
  fi
}

# Le domaine passe à $domain : .env, Caddy recréé avec lui, puis les adresses
# publiques des réglages Station qui suivaient l'ancien.
domain_apply() { # ancien domaine
  local old=$1 keys tls
  tls=$(env_value CADDY_TLS acme)
  env_set DOMAIN "$domain" config
  changed="$changed${changed:+,} DOMAIN"
  compose up -d caddy ||
    die "Caddy ne repart pas avec $domain : voir le message de docker compose plus haut." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Pour revenir à l'ancien domaine : station config --domain $old."
  caddy_stopped=""
  https_ok ||
    die "https://$domain ne répond pas au bout de $HTTPS_WAIT s : le certificat manque encore." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Pour revenir à l'ancien domaine : station config --domain $old."
  if keys=$(engine_domain_settings "$old" "$domain"); then
    if [[ -n $keys ]]; then
      say "Réglages Station : $(tr '\n' ',' <<<"$keys" | sed 's/,$//; s/,/, /g'), passés à $domain."
    else
      say "Réglages Station : aucune adresse ne suivait l'ancien domaine${old:+, $old}. Les vérifier dans la console, Réglages → Station."
    fi
  else
    warn "les réglages Station ne suivent pas : changer leurs adresses dans la console, Réglages → Station."
  fi
  say "Domaine : $domain, au lieu de ${old:-aucun}. https://$domain répond." \
    "  Les encodeurs du direct se branchent maintenant sur $domain, port $(env_value HARBOR_PORT 6800)."
}

# --- hold, unhold ---

cmd_hold() {
  local dir="" env_file=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command hold
    return 0
  fi
  open_station hold "${opts[--dir]:-}"
  if [[ -f $dir/HOLD ]]; then
    say "Les mises à jour sont déjà bloquées, par $dir/HOLD :"
    sed 's/^/  /' "$dir/HOLD"
    return 0
  fi
  hold_write "Bloquées par station hold" "${args[*]:-aucune donnée}"
  say "Mises à jour bloquées : aucune ne passe tant que $dir/HOLD est là. Les débloquer : station unhold."
}

# HOLD bloque les mises à jour, avec la date et la raison, jusqu'à ce qu'une
# personne le retire : station unhold. MAJ-05 le pose aussi, après un retour
# arrière.
hold_write() { # qui, raison
  printf '%s, le %s.\nRaison : %s\nPour les débloquer : station unhold.\n' \
    "$1" "$(station_date "$(date +%s)")" "$2" >"$dir/HOLD"
}

cmd_unhold() {
  local dir="" env_file=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command unhold
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  open_station unhold "${opts[--dir]:-}"
  if [[ ! -f $dir/HOLD ]]; then
    say "Les mises à jour ne sont pas bloquées."
    return 0
  fi
  say "Mises à jour débloquées. $dir/HOLD disait :"
  sed 's/^/  /' "$dir/HOLD"
  rm -f "$dir/HOLD"
}

# --- cli ---

cmd_cli() {
  local dir="" env_file="" tty=()
  # Seul --dir, en tête, est à station : le reste va au moteur.
  while (($#)); do
    case $1 in
      --dir=*)
        dir=${1#*=}
        shift
        ;;
      --dir)
        (($# >= 2)) || usage_error "--dir attend une valeur."
        dir=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
  done
  open_station cli "$dir"
  docker_ok || die "Docker ne répond pas : station cli passe par le moteur." "Voir pourquoi : systemctl status docker."
  station_running radiotomate-interface ||
    die "Le moteur ne tourne pas : station cli passe par lui." "Voir pourquoi : station status. Puis le démarrer : cd $dir && docker compose up -d."
  [[ -t 0 && -t 1 ]] || tty=(-T)
  compose exec "${tty[@]}" radiotomate-interface radiotomate "$@"
}

# --- uninstall ---

cmd_uninstall() {
  local dir="" env_file="" purge assume_yes="" aborted="Rien n'est désinstallé." file
  local -A opts=()
  local args=()
  parse_options "--purge --yes -h --help" "--dir" "$@"
  if help_asked; then
    usage_command uninstall
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  purge=${opts[--purge]:-}
  assume_yes=${opts[--yes]:-}
  station_dir "${opts[--dir]:-}"
  need_root uninstall
  [[ -f $env_file || -f $dir/compose.yml ]] ||
    die "Pas de station dans $dir : ni .env, ni compose.yml." "Une station ailleurs : station uninstall --dir DOSSIER."
  # Effacer un dossier de premier niveau, comme /opt, n'est pas l'affaire de
  # cette commande.
  [[ -z $purge || $dir == /?*/?* ]] ||
    die "station uninstall --purge n'efface pas $dir, un dossier de premier niveau." "Effacer à la main ce qui doit l'être."
  env_isolate
  if [[ -z $purge && ! -f $dir/compose.yml ]]; then
    say "La station de $dir est déjà désinstallée : restent .env et ses données. Pour tout effacer : station uninstall --purge."
    return 0
  fi
  if [[ -n $purge ]]; then
    uninstall_purge_report
    confirm_word uninstall effacer "Pour tout effacer, taper effacer :"
  else
    say "Désinstaller la station de $dir : ses conteneurs, ses images, les fichiers de sa version et la commande station s'en vont." \
      "Restent .env, data/, media/ et backups/ : station install les reprend, pour la même station."
    confirm uninstall "Désinstaller ? (o/n)"
  fi
  lock_station uninstall

  if [[ -f $dir/compose.yml ]]; then
    local profiles=() images=() image down=(down --remove-orphans)
    all_profiles
    mapfile -t images < <(compose "${profiles[@]}" config --images 2>/dev/null | sort -u)
    [[ -z $purge ]] || down+=(--volumes)
    say "Désinstallation : arrêt de la station."
    compose "${profiles[@]}" "${down[@]}" ||
      die "La station ne s'arrête pas : voir le message de docker compose plus haut." "Voir pourquoi, puis relancer station uninstall."
    # Une image qu'un autre conteneur prend encore reste.
    for image in "${images[@]}"; do
      docker image rm "$image" >/dev/null 2>&1 || true
    done
  fi
  # Ce que le projet garde encore, par son étiquette : après une
  # désinstallation qui gardait les données, compose.yml n'est plus là.
  [[ -z $purge ]] || project_leftovers
  if [[ -L $BIN && $(readlink "$BIN") == "$dir/station" ]]; then
    rm -f "$BIN"
  fi
  if [[ -n $purge ]]; then
    rm -rf "${dir:?}"
    say "" "La station est effacée : $dir n'existe plus. Docker reste installé."
  else
    for file in "${VERSION_FILES[@]}"; do
      rm -rf "${dir:?}/$file"
    done
    say "" "La station est désinstallée. Restent, dans $dir : .env, data/, media/ et backups/." \
      "  La réinstaller, la même : station install --dir $dir, avec le script d'une version publiée. Docker reste installé."
  fi
}

# Les conteneurs et les volumes du projet, que compose.yml ne nomme plus.
project_leftovers() {
  local ids=()
  mapfile -t ids < <(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)
  ((${#ids[@]} == 0)) || docker rm -f "${ids[@]}" >/dev/null 2>&1 || true
  mapfile -t ids < <(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)
  ((${#ids[@]} == 0)) || docker volume rm "${ids[@]}" >/dev/null 2>&1 ||
    warn "des volumes du projet $PROJECT restent : docker volume ls, puis docker volume rm."
}

# Ce que --purge efface, et ce qu'il laisse, hors du dossier.
uninstall_purge_report() {
  local key path outside="" count=0 media
  if [[ -d $dir/backups ]]; then
    count=$(find "$dir/backups" -maxdepth 1 -name 'button-*.tar' | wc -l)
  fi
  media=$(env_path BUTTON_MEDIA ./media)
  say "Tout effacer : la station de $dir, ses conteneurs, ses images, ses volumes, et son dossier entier. Rien ne se récupère ensuite :" \
    "  .env, avec ses secrets ;" \
    "  data/ : la base, avec les comptes, les horloges, l'Agenda et les réglages ;"
  if [[ $media == "$dir"/* && -d $media ]]; then
    say "  ${media#"$dir"/}/ : la banque de sons, $(human_kb "$(size_kb "$media")") ;"
  fi
  say "  backups/ : $((count)) sauvegarde(s)."
  for key in "${DATA_DIRS[@]}" CLOUD_SYNC_CONFIG:./data/rclone; do
    path=$(env_path "${key%%:*}" "${key#*:}")
    [[ $path == "$dir"/* ]] || outside="$outside ${key%%:*} ($path)"
  done
  [[ -z $outside ]] || say "Hors du dossier, rien ne s'efface :$outside."
  say "Une sauvegarde d'abord, copiée hors de cette machine : station backup --with-media."
}

main() {
  local command=${1:-help}
  (($# == 0)) || shift
  case $command in
    install | status | logs | backup | restore | config | hold | unhold | cli | uninstall)
      help_topic=$command
      "cmd_$command" "$@"
      ;;
    help | -h | --help)
      if (($#)); then
        usage_command "$1"
      else
        usage
      fi
      ;;
    *) usage_error "Commande inconnue : $command." ;;
  esac
}

# Lu par les tests avec source, le script ne fait que définir ses fonctions.
# Lu sur l'entrée standard (curl … | bash -s install), il n'a pas de nom.
if [[ -z ${BASH_SOURCE[0]:-} || ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
