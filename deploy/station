}

# Un dépôt de restic que la commande sait régler, S3 ou SFTP, qui tient sur
# une ligne de .env, sans guillemets ni rien que docker compose y lirait.
check_remote() {
  local s3='^s3:(https?://)?[^/]+/[^/].*$'
  if [[ ${#1} -gt 512 || $1 == *[[:space:][:cntrl:]\"\'\$\#\\\`]* ]]; then
    echo "  « $1 » : un dépôt s'écrit sur une ligne, sans espace, guillemet, \$, # ni \\." >&2
    return 1
  fi
  [[ ! $1 =~ $s3 && $1 != sftp:?*@?*:?* ]] || return 0
  echo "  « $1 » n'est pas un dépôt S3 ou SFTP : s3:https://HÔTE/BUCKET/CHEMIN, ou sftp:COMPTE@HÔTE:/CHEMIN, ou sftp://COMPTE@HÔTE:PORT//CHEMIN." >&2
  return 1
}

# La clé d'accès d'un stockage S3 : son identifiant, que les fournisseurs
# écrivent en lettres et chiffres.
check_access_key() {
  # Pas de {1,256} : la libc de musl n'en accepte que 255.
  [[ ${#1} -le 256 && $1 =~ ^[A-Za-z0-9._~+/=-]+$ ]] && return 0
  echo "  « $1 » : une clé d'accès S3 s'écrit en lettres et chiffres, sans espace." >&2
  return 1
}

# Une valeur de .env, entre apostrophes si elle a un caractère que docker
# compose, qui lit aussi .env, comprendrait : $, #, un espace. Elle ne peut
# pas avoir d'apostrophe : secret_from et les contrôles la refusent.
env_quote() { # valeur
  if [[ $1 =~ ^[A-Za-z0-9._~+/=:@,%-]*$ ]]; then
    printf '%s\n' "$1"
  else
    printf "'%s'\n" "$1"
  fi
}

# Un secret lu dans un fichier, sa première ligne, sans les espaces autour :
# un mot de passe ou une clé, jamais sur la ligne de commande, que ps montre.
# .env le garde entre apostrophes, s'il le faut (remote_set) : il ne peut
# pas en avoir une.
secret_from() { # fichier, ce qu'il est, que faire d'un caractère refusé ou rien
  local value=""
  [[ -r $1 ]] || die "$2 ne se lit pas dans $1." "Donner un fichier lisible par root, qui le contient sur sa première ligne."
  IFS= read -r value <"$1" || true
  value=$(trim "$value")
  [[ -n $value ]] || die "$2 manque dans $1 : sa première ligne est vide." "L'y mettre, puis relancer."
  [[ ${#value} -le 1024 && $value != *[[:cntrl:]]* && $value != *\'* ]] ||
    die "$2, dans $1, a un caractère que .env ne garde pas : une apostrophe, ou un caractère de contrôle." \
      "${3:-Pour un dépôt neuf, en choisir un autre ; pour un dépôt qui existe, en ajouter un sans eux, avec restic key add.}"
  printf '%s\n' "$value"
}

# Une valeur de la sauvegarde hors de la machine, ou des alertes, dans .env,
# si elle change, et la note.
remote_set() { # clé, valeur
  local value
  # Rien à vider qui ne soit pas là.
  [[ -n $2 ]] || env_has "$1" || return 0
  value=$(env_quote "$2")
  if ! env_has "$1" || [[ $(env_value "$1") != "$2" ]]; then
    env_set "$1" "$value" config
    changed="$changed${changed:+,} $1"
  fi
}

# Ce que config change du dépôt de la sauvegarde hors de la machine, vérifié
# avant que rien ne s'écrive : le dépôt, son mot de passe et ses clés, ceux
# donnés, sinon ceux de .env, dans les variables de cmd_config. restic s'y
# connecte (remote_probe) quand l'un d'eux est donné. Un dépôt neuf, sans
# mot de passe, en reçoit un tiré au hasard (generated). Un dépôt vide, "",
# arrête la sauvegarde : rien à vérifier.
remote_verify() {
  [[ -n ${opts[--backup-remote]+x}${opts[--backup-password-file]+x}${opts[--backup-s3-access-key]+x}${opts[--backup-s3-secret-key-file]+x} ]] ||
    return 0
  remote=${opts[--backup-remote]-$(env_value BUTTON_BACKUP_REMOTE)}
  if [[ -z $remote ]]; then
    [[ -n ${opts[--backup-remote]+x} ]] ||
      die "Aucun dépôt n'est réglé pour la sauvegarde hors de la machine. Rien n'est changé." \
        "Le donner avec le reste : station config --backup-remote DÉPÔT."
    return 0
  fi
  remote_password=$(env_value BUTTON_BACKUP_PASSWORD)
  if [[ -n ${opts[--backup-password-file]+x} ]]; then
    remote_password=$(secret_from "${opts[--backup-password-file]}" "Le mot de passe du dépôt")
  fi
  remote_access_key=${opts[--backup-s3-access-key]-$(env_value BUTTON_BACKUP_S3_ACCESS_KEY)}
  remote_secret_key=$(env_value BUTTON_BACKUP_S3_SECRET_KEY)
  if [[ -n ${opts[--backup-s3-secret-key-file]+x} ]]; then
    remote_secret_key=$(secret_from "${opts[--backup-s3-secret-key-file]}" "La clé secrète S3")
  fi
  if [[ $remote == s3:* && (-z $remote_access_key || -z $remote_secret_key) ]]; then
    die "Un dépôt S3 demande ses clés : --backup-s3-access-key CLÉ et --backup-s3-secret-key-file FICHIER. Rien n'est changé." \
      "Les créer chez le fournisseur du stockage, pour ce seul bucket si possible. Puis relancer."
  fi
  if [[ $remote == s3:http://* && ! $remote =~ ^s3:http://(localhost|127\.0\.0\.1|\[::1\])[:/] ]]; then
    warn "le dépôt $remote se joint en http : ses données sont chiffrées par restic, mais le transport ne l'est pas. Préférer https."
  fi
  if [[ -z $remote_password ]]; then
    remote_password=$(secret)
    generated=1
  fi
  remote_probe
  probed=1
}

# Les réglages de la sauvegarde hors de la machine dans .env, une fois
# vérifiés, puis ses minuteurs. Le mot de passe d'un dépôt neuf ne s'affiche
# qu'une fois, et seulement dans un terminal : il reste dans .env, où la
# sauvegarde de chaque nuit le lit.
remote_apply() {
  local off="" before
  [[ -n ${opts[--backup-remote]+x}${opts[--backup-password-file]+x}${opts[--backup-s3-access-key]+x}${opts[--backup-s3-secret-key-file]+x}${opts[--backup-media]+x}${opts[--backup-time]+x} ]] ||
    return 0
  if [[ -n ${opts[--backup-remote]+x} && -z ${opts[--backup-remote]} ]]; then
    off=1
    remote_set BUTTON_BACKUP_REMOTE ""
  fi
  if [[ -n $probed ]]; then
    before=$(env_value BUTTON_BACKUP_REMOTE)
    remote_set BUTTON_BACKUP_REMOTE "$remote"
    remote_set BUTTON_BACKUP_PASSWORD "$remote_password"
    if [[ $remote == s3:* ]]; then
      remote_set BUTTON_BACKUP_S3_ACCESS_KEY "$remote_access_key"
      remote_set BUTTON_BACKUP_S3_SECRET_KEY "$remote_secret_key"
    fi
    # Un autre dépôt : le jour du réglage, d'où status compte les jours sans
    # sauvegarde. Une station qui ne s'est jamais sauvegardée, devant un dépôt
    # qui existait déjà, est neuve : ses minuteurs attendent qu'elle soit
    # remise, ou sauvegardée exprès. Le même dépôt, revérifié, ne change rien.
    if [[ $remote != "$before" ]]; then
      remote_log "$dir" réglage fait - "$remote"
      install -d -m 700 "$dir/data/restic"
      if [[ -z $fresh && -z $(remote_last sauvegarde faite) ]]; then
        : >"$dir/data/restic/$REMOTE_PENDING"
      else
        rm -f "$dir/data/restic/$REMOTE_PENDING"
      fi
    fi
  fi
  [[ -z ${opts[--backup-media]+x} ]] || remote_set BUTTON_BACKUP_MEDIA "${opts[--backup-media]}"
  [[ -z ${opts[--backup-time]+x} ]] || remote_set BUTTON_BACKUP_TIME "${opts[--backup-time]}"
  remote_timers ||
    die "Les réglages de la sauvegarde hors de la machine sont dans .env, mais ses minuteurs ne se posent pas : voir plus haut." \
      "Une fois systemd réglé, relancer : station install les repose. D'ici là, la lancer à la main : station backup --remote."
  if [[ -n $off ]]; then
    say "Sauvegarde hors de la machine : arrêtée. Le dépôt garde ses sauvegardes, et .env son mot de passe, BUTTON_BACKUP_PASSWORD."
    return 0
  fi
  [[ -n $probed ]] || return 0
  if [[ -n $fresh ]]; then
    say "Dépôt : créé, vide, à $remote. restic chiffre tout ce qui y entre, avec son mot de passe."
  else
    say "Dépôt : $remote, ouvert avec son mot de passe. Ses sauvegardes : station restore --remote --list."
  fi
  if [[ -f $dir/data/restic/$REMOTE_PENDING ]]; then
    say "La sauvegarde de la nuit attend : ce dépôt existait déjà, et cette station ne s'est jamais sauvegardée. Remettre la station de l'une de ses sauvegardes, station restore --remote, ou sauvegarder celle-ci, station backup --remote. Elle commence ensuite : sinon, cette station, neuve, deviendrait la dernière sauvegarde du dépôt."
    return 0
  fi
  if [[ -n $generated ]]; then
    if terminal; then
      say "" "Mot de passe du dépôt : $remote_password" \
        "  À noter maintenant, hors de cette machine, avec l'adresse du dépôt : sans lui, ses sauvegardes ne se lisent pas, et une machine neuve ne les remet pas. Il reste dans $env_file, BUTTON_BACKUP_PASSWORD." ""
    else
      say "Mot de passe du dépôt : pas affiché, la sortie n'est pas un terminal. Il est dans $env_file, BUTTON_BACKUP_PASSWORD : le noter hors de cette machine, sans quoi ses sauvegardes ne se lisent pas."
    fi
  fi
  say "La première sauvegarde part cette nuit, ou maintenant : station backup --remote. Avec les sons, elle peut durer des heures ; les suivantes n'envoient que ce qui a changé."
}

# Le nouveau domaine, $domain, mène-t-il ici ? Comme install : Caddy s'arrête
# le temps de libérer le port 80, et cleanup le relance si la vérification
# échoue.
domain_verify() {
  if [[ $(env_value CADDY_TLS acme) == internal ]]; then
    say "Domaine : pas vérifié, Caddy signe lui-même le certificat (CADDY_TLS=internal)."
  elif [[ -n ${opts[--no-domain-check]:-} ]]; then
    warn "le domaine n'est pas vérifié (--no-domain-check). S'il ne mène pas ici, Let's Encrypt le refusera un moment."
  else
    say "Domaine : vérification de $domain. Caddy s'arrête le temps de la faire, et le flux avec lui."
    caddy_stopped=$dir
    compose stop caddy >/dev/null 2>&1 || true
    check_domain_here "$dir/compose.yml"
  fi
}

# Le domaine passe à $domain : .env, Caddy recréé avec lui, puis les adresses
# publiques des réglages Station qui suivaient l'ancien.
domain_apply() { # ancien domaine
  local old=$1 keys tls
  tls=$(env_value CADDY_TLS acme)
  env_set DOMAIN "$domain" config
  changed="$changed${changed:+,} DOMAIN"
  compose up -d caddy ||
    die "Caddy ne repart pas avec $domain : voir le message de docker compose plus haut." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Pour revenir à l'ancien domaine : station config --domain $old."
  caddy_stopped=""
  https_ok ||
    die "https://$domain ne répond pas au bout de $HTTPS_WAIT s : le certificat manque encore." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Pour revenir à l'ancien domaine : station config --domain $old."
  if keys=$(engine_domain_settings "$old" "$domain"); then
    if [[ -n $keys ]]; then
      say "Réglages Station : $(tr '\n' ',' <<<"$keys" | sed 's/,$//; s/,/, /g'), passés à $domain."
    else
      say "Réglages Station : aucune adresse ne suivait l'ancien domaine${old:+, $old}. Les vérifier dans la console, Réglages → Station."
    fi
  else
    warn "les réglages Station ne suivent pas : changer leurs adresses dans la console, Réglages → Station."
  fi
  say "Domaine : $domain, au lieu de ${old:-aucun}. https://$domain répond." \
    "  Les encodeurs du direct se branchent maintenant sur $domain, port $(env_value HARBOR_PORT 6800)."
}

# --- hold, unhold ---

cmd_hold() {
  local dir="" env_file=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command hold
    return 0
  fi
  open_station hold "${opts[--dir]:-}"
  if [[ -f $dir/HOLD ]]; then
    say "Les mises à jour sont déjà bloquées, par $dir/HOLD :"
    sed 's/^/  /' "$dir/HOLD"
    return 0
  fi
  hold_write "Bloquées par station hold" "${args[*]:-aucune donnée}"
  say "Mises à jour bloquées : aucune ne passe tant que $dir/HOLD est là. Les débloquer : station unhold."
}

# HOLD bloque les mises à jour, avec la date et la raison, jusqu'à ce qu'une
# personne le retire : station unhold. Un retour arrière le pose aussi, celui
# d'une mise à jour ratée comme celui de station rollback.
hold_write() { # qui, raison
  printf '%s, le %s.\nRaison : %s\nPour les débloquer : station unhold.\n' \
    "$1" "$(station_date "$(date +%s)")" "$2" >"$dir/HOLD"
}

cmd_unhold() {
  local dir="" env_file=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command unhold
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  open_station unhold "${opts[--dir]:-}"
  if [[ ! -f $dir/HOLD ]]; then
    say "Les mises à jour ne sont pas bloquées."
    return 0
  fi
  say "Mises à jour débloquées. $dir/HOLD disait :"
  sed 's/^/  /' "$dir/HOLD"
  rm -f "$dir/HOLD"
}

# --- requests ---

# Les demandes de la console (MAJ-07). La console ne touche jamais Docker
# (ADR 0004) : « Mettre à jour maintenant » écrit une demande dans le moteur,
# dans RT_DATA/updates. Chaque minute, button-demandes.timer lance cette
# commande. Quand rien n'attend, elle ne regarde que si ce fichier est là. Sinon,
# elle lit la demande par docker compose exec, lance station update --yes,
# comme une personne le ferait, puis écrit le résultat par le même chemin,
# d'après updates.log. Elle ne lit ni n'écrit elle-même aucun fichier du
# moteur : ce qu'il dit ne sort jamais de sa vérification. Coupées
# (BUTTON_CONSOLE_REQUESTS=no), les demandes ne partent plus : la commande ne
# fait que le dire au moteur, et finir une mise à jour qu'elle avait lancée.
cmd_requests() {
  local dir="" env_file="" from="" data pushed="" request_id="" request_state=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir --from" "$@"
  if help_asked; then
    usage_command requests
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  from=${opts[--from]:-}
  if [[ -n $from ]]; then
    [[ $from == /* ]] || from=$PWD/$from
    [[ -f $from ]] || usage_error "--from : $from n'existe pas."
  fi
  open_station requests "${opts[--dir]:-}"
  # Un seul passage à la fois, celui du minuteur ou un lancé à la main : le
  # second s'en va.
  mkdir -p "${REQUESTS_LOCK%/*}"
  exec 8>>"$REQUESTS_LOCK"
  if ! flock -n 8; then
    by_timer || say "Les demandes de la console sont déjà prises, par un autre passage."
    return 0
  fi
  # Docker arrêté, ou le moteur : chaque docker compose exec échoue, et le
  # passage suivant reprend.
  data=$(env_path RT_DATA ./data/radiotomate)
  requests_sync
  if [[ -z $pushed && ! -e $data/updates/request.json && ! -f $dir/$REQUEST_MARK ]]; then
    requests_idle
    return 0
  fi
  [[ -n $pushed ]] || requests_show || return 0
  if [[ -z $request_id ]]; then
    # Une marque sans demande : le moteur a déjà le résultat.
    rm -f "${dir:?}/$REQUEST_MARK"
    requests_idle
    return 0
  fi
  if [[ $request_state == running ]]; then
    # Lancée par un passage qui s'est arrêté en route, demandes coupées ou non :
    # updates.log dit la suite.
    requests_resume
  elif requests_on; then
    requests_run
  fi
  # Le moteur sait tout de suite ce que la mise à jour a changé : updates.log,
  # HOLD, la version.
  requests_sync force
  requests_on || requests_idle
}

# Lancée par son minuteur, sous systemd, qui pose INVOCATION_ID : rien au
# journal, chaque minute, quand rien n'attend. sudo ne le passe pas.
by_timer() {
  [[ -n ${INVOCATION_ID:-} ]]
}

# Rien à faire : la commande le dit, sauf sous son minuteur.
requests_idle() {
  if by_timer; then
    return 0
  elif requests_on; then
    say "Aucune demande de la console n'attend."
  else
    say "Les demandes de la console sont coupées : BUTTON_CONSOLE_REQUESTS=no, dans $env_file. Les rallumer : $(self_command) config --console-requests yes."
  fi
}

# Les demandes de la console se prennent, sauf BUTTON_CONSOLE_REQUESTS=no.
requests_on() {
  [[ $(env_value BUTTON_CONSOLE_REQUESTS yes) != no ]]
}

# Une commande du moteur qui tourne, radiotomate, dans le conteneur de
# l'interface, en son nom : avec un délai, REQUESTS_WAIT, et une réponse
# bornée, REQUESTS_READ. Ce qu'il dit sur sa sortie d'erreur ne s'affiche pas,
# et le reste se vérifie toujours ensuite. Elle ne garde aucun des deux verrous
# (8, 9) : le timeout de busybox laisse un processus qui veille son délai.
engine_exec() { # arguments de radiotomate…
  (cd "$dir" && timeout "$REQUESTS_WAIT" docker compose exec -T radiotomate-interface radiotomate "$@") 2>/dev/null 8>&- 9>&- |
    head -c "$REQUESTS_READ"
}

# Ce que dit le moteur, sur une ligne : la première, sans caractère de
# contrôle, 300 caractères au plus. Il ne forge ainsi ni ligne de
# updates.log, ni séquence d'échappement dans un terminal.
one_line() { # texte
  local text=${1%%$'\n'*}
  text=$(LC_ALL=C tr -d '\000-\037\177' <<<"$text")
  printf '%s' "${text:0:300}"
}

# Une commande de radiotomate maintenance updates : show, wait, start, finish
# ou host. Le texte donné va sur son entrée standard.
requests_engine() { # texte, arguments…
  local text=$1
  shift
  printf '%s' "$text" | engine_exec maintenance updates "$@"
}

# La demande ouverte, telle que le moteur la dit, sur une ligne : son
# identifiant, douze chiffres hexadécimaux, et son état, pending ou running.
# Tout le reste compte pour aucune.
requests_parse() { # ligne
  local id="" state=""
  request_id=""
  request_state=""
  read -r id state _ <<<"$1" || true
  [[ $id =~ ^[0-9a-f]{12}$ && ($state == pending || $state == running) ]] || return 0
  request_id=$id
  request_state=$state
}

requests_show() {
  local line
  line=$(requests_engine "" show) || return 1
  requests_parse "$line"
}

# Ce que la machine dit d'elle au moteur, que la console montre : si elle
# prend les demandes, sa version et celle de sa commande, HOLD, les dernières
# lignes de updates.log, les mises à jour automatiques. Seulement quand
# l'empreinte de ces fichiers change, ou au bout d'une heure, ce qui dit au
# moteur que la machine répond encore ; toujours avec force. Puis la demande
# ouverte : pushed, une fois dit.
requests_sync() { # force, ou rien
  local now last=0 saved="" line
  now=$(date +%s)
  if [[ -z ${1:-} && -f $REQUESTS_STATE ]]; then
    { read -r last || true; saved=$(cat); } <"$REQUESTS_STATE"
    [[ $last =~ ^[0-9]+$ ]] || last=0
    if [[ $saved == "$(requests_stamp)" ]] && ((now - last < REQUESTS_EVERY)); then
      return 0
    fi
  fi
  line=$(requests_host_json | engine_exec maintenance updates host) || return 0
  pushed=1
  requests_parse "$line"
  # Le moteur vient de récrire host.json : l'empreinte se prend après.
  mkdir -p "${REQUESTS_STATE%/*}"
  if ! printf '%s\n%s\n' "$now" "$(requests_stamp)" >"$REQUESTS_STATE.part" 2>/dev/null ||
    ! mv -f "$REQUESTS_STATE.part" "$REQUESTS_STATE" 2>/dev/null; then
    rm -f "$REQUESTS_STATE.part"
  fi
  return 0
}

# L'empreinte de ce que la machine dit au moteur : la taille, l'heure et
# l'inode de chaque fichier, host.json du moteur compris, qu'une restauration
# remplace. Un stat seulement, qui ne suit pas un lien et ne lit rien de ce que
# le moteur écrit.
requests_stamp() {
  stat -c '%n %s %Y %i' -- "$dir/HOLD" "$dir/updates.log" "$env_file" "$dir/VERSION" \
    "$(env_path RT_DATA ./data/radiotomate)/updates/host.json" 2>/dev/null || true
}

# L'état de la machine, en JSON, pour radiotomate maintenance updates host.
requests_host_json() {
  local hold="" line items=()
  [[ ! -f $dir/HOLD ]] || hold=$(head -c 2000 "$dir/HOLD")
  if [[ -f $dir/updates.log ]]; then
    while IFS= read -r line; do
      items+=("$(json_string "$line")")
    done < <({ grep -v '^#' "$dir/updates.log" || true; } | tail -n 10)
  fi
  printf '{"requests":%s,"command":%s,"version":%s,"repo":%s,"hold":%s,"updates":[%s],"nightly":%s,"time":%s,"zone":%s}\n' \
    "$(json_string "$(requests_on && echo yes || echo no)")" \
    "$(json_string "$(head -c 64 "$dir/VERSION" 2>/dev/null || true)")" \
    "$(json_string "$(env_value BUTTON_VERSION)")" \
    "$(json_string "$REPO")" \
    "$(json_string "$hold")" \
    "$(
      IFS=,
      printf '%s' "${items[*]}"
    )" \
    "$(json_string "$(env_value BUTTON_UPDATES auto)")" \
    "$(json_string "$(env_value BUTTON_UPDATE_TIME "$UPDATE_TIME")")" \
    "$(json_string "$(env_value TZ Europe/Paris)")"
}

# Les lignes de updates.log, commentaire compris : la mise à jour lancée y
# ajoute la sienne.
updates_lines() {
  if [[ -f $dir/updates.log ]]; then
    wc -l <"$dir/updates.log" | tr -d ' '
  else
    echo 0
  fi
}

# Les lignes de updates.log écrites après les n premières. Une mise à jour
# n'en écrit qu'une : la première est la sienne, et celles d'un retour arrière
# à la main, ou d'une autre mise à jour, viennent après.
updates_since() { # n
  [[ -f $dir/updates.log ]] || return 0
  tail -n "+$(($1 + 1))" "$dir/updates.log" | { grep -v '^#' || true; }
}

# Ce qui fait attendre la demande, dit sur la sortie, ou faux : une autre
# commande station, comme la sauvegarde de la nuit, puis la fenêtre du moteur,
# comme pour station update. Une fenêtre qui ne se lit pas ne fait pas
# attendre : station update la relit, et le dit. Le verrou des commandes ne
# s'essaie qu'un instant : une commande lancée à ce moment-là attend une
# seconde (lock_station).
requests_waits() {
  local answer status=0
  mkdir -p "${LOCK%/*}"
  if ! flock -n "$LOCK" true 2>/dev/null; then
    echo "Une autre commande station tourne sur la machine, comme la sauvegarde de la nuit : la mise à jour part quand elle a fini."
    return 0
  fi
  answer=$(engine_exec maintenance window </dev/null) || status=$?
  answer=$(one_line "$answer")
  if [[ $status == 1 && $answer == "occupée : "* ]]; then
    printf '%s\n' "${answer#occupée : }"
    return 0
  fi
  return 1
}

# Une mise à jour arrêtée par l'antenne, sa sauvegarde faite, il y a moins de
# REQUESTS_PAUSE : la demande attend, dit sur la sortie. Sinon, faux. Sans
# cela, le moteur, qui dit la fenêtre, ferait refaire une sauvegarde chaque
# minute. updates.log est à root, et ce qu'y écrit le moteur tient sur une
# ligne (one_line, log_field).
requests_paused() {
  local made="" _from _to result=""
  [[ -f $dir/updates.log ]] || return 1
  IFS=$'\t' read -r made _from _to result _ < <({ grep -v '^#' "$dir/updates.log" || true; } | tail -n 1) || true
  [[ $made =~ ^[0-9]+$ && $result == arrêtée ]] || return 1
  (($(date +%s) - made < REQUESTS_PAUSE)) || return 1
  echo "La dernière tentative s'est arrêtée devant l'antenne, sa sauvegarde faite : la suivante part au plus tôt le $(station_date $((made + REQUESTS_PAUSE))), quand l'antenne le permet."
}

# La plus haute version publiée passe une majeure, au-dessus de la version de
# la station : elle ne part pas d'une demande, dit sur la sortie. Sinon, faux.
# Sans GitHub, rien ne se dit : station update le revérifie.
requests_major() {
  local installed latest
  [[ -z $from ]] || return 1
  installed=$(env_value BUTTON_VERSION)
  check_version "$installed" >/dev/null 2>&1 || return 1
  latest=$(latest_version 10 2>/dev/null) || return 1
  check_version "$latest" >/dev/null 2>&1 || return 1
  ((${latest%%.*} > ${installed%%.*})) || return 1
  echo "La mise à jour passe la $((${installed%%.*} + 1)).0.0, une version majeure : elle demande une action à la station avant de la prendre, et ne part pas d'une demande de la console. Une fois l'action faite, sur la machine : sudo station update --major."
}

# Une demande qui attend : la mise à jour, lancée comme par une personne. Ce
# qui la refuse d'abord : HOLD, une restauration pas finie, une majeure. Ce
# qui la fait attendre : une tentative arrêtée il y a peu, une autre commande,
# l'antenne. La marque dit qu'elle a commencé. STATION_REQUEST dit à la mise à
# jour qu'elle vient de la console : elle ne fait de place dans backups/
# qu'une fois faite.
requests_run() {
  local reason lines started before log options=(--yes --dir "$dir")
  if [[ -f $dir/HOLD ]]; then
    requests_close refused "Les mises à jour sont bloquées sur la machine, par HOLD : $(head -c 1500 "$dir/HOLD")"
    return 0
  fi
  if [[ -f $dir/$JOURNAL ]]; then
    requests_close refused "Une restauration ne s'est pas finie sur la machine : sudo station status dit quoi faire."
    return 0
  fi
  if reason=$(requests_paused) || reason=$(requests_waits); then
    requests_engine "$reason" wait "$request_id" >/dev/null || true
    return 0
  fi
  if reason=$(requests_major); then
    requests_close refused "$reason"
    return 0
  fi
  # Retirée depuis la console entre-temps : rien à faire.
  requests_engine "" start "$request_id" >/dev/null || return 0
  lines=$(updates_lines)
  started=$(date +%s)
  before=$(env_value BUTTON_VERSION)
  install -m 600 /dev/null "$dir/$REQUEST_MARK"
  printf '%s\t%s\t%s\n' "$request_id" "$started" "$lines" >"$dir/$REQUEST_MARK"
  [[ -z $from ]] || options+=(--from "$from")
  say "Demande de la console : mise à jour de la station de $dir, de $before à la plus haute version publiée."
  log=$(mktemp)
  # Ce qu'elle dit va aussi au journal, comme elle le dit. Le verrou des
  # demandes reste à ce passage : elle ne le garde pas.
  { STATION_REQUEST=1 bash "$dir/station" update "${options[@]}" </dev/null 8>&- 2>&1 ||
    echo "$?" >"$log.code"; } | tee "$log" || true
  requests_outcome "$(cat "$log.code" 2>/dev/null || echo 0)" "$log" "$before"
  rm -f "$log" "$log.code"
}

# Ce qu'a donné la mise à jour lancée, d'après la ligne que updates.log a
# reçue après celles que note la marque (lines). Sans ligne, elle s'est
# arrêtée avant de commencer : rien à faire ; une autre commande, qui a le
# verrou (LOCK_BUSY), ou l'antenne, qui font attendre ; ou un refus, que ses
# derniers mots disent. Rien n'a changé.
requests_outcome() { # code, sortie, version d'avant
  local line reason after
  line=$(updates_since "$lines" | sed -n 1p)
  if [[ -n $line ]]; then
    requests_result "$line"
    return 0
  fi
  if [[ $1 == 0 ]]; then
    after=$(env_value BUTTON_VERSION)
    if [[ $after != "$3" ]]; then
      requests_close "done" "updates.log ne s'écrit pas : voir la place sur le disque, sudo station status." "$3" "$after"
    else
      requests_close up_to_date "$(requests_last_words "$2")"
    fi
    return 0
  fi
  if [[ $1 == "$LOCK_BUSY" ]]; then
    reason="Une autre commande station tourne sur la machine, comme la sauvegarde de la nuit : la mise à jour part quand elle a fini."
  elif ! reason=$(requests_waits); then
    requests_close failed "Rien n'a changé. $(requests_last_words "$2")"
    return 0
  fi
  requests_wait_again "$reason"
}

# La demande lancée attend de nouveau, et pourquoi. La marque le note
# d'abord : si le moteur ne le prend pas, le passage suivant le lui redit.
# Coupées entre-temps, les demandes la refusent.
requests_wait_again() { # raison
  if ! requests_on; then
    requests_close refused "Les demandes de la console sont coupées sur la machine."
    return 0
  fi
  printf '%s\t%s\t%s\tattente\n' "$request_id" "$started" "$lines" >"$dir/$REQUEST_MARK"
  if requests_engine "$1" wait "$request_id" >/dev/null; then
    rm -f "${dir:?}/$REQUEST_MARK"
  fi
  return 0
}

# Le résultat d'une ligne de updates.log, au moteur. Arrêtée par l'antenne,
# une fois sa sauvegarde faite, la demande attend de nouveau.
requests_result() { # ligne de updates.log
  local _made from to result _backup detail
  IFS=$'\t' read -r _made from to result _backup detail <<<"$1" || true
  case $result in
    faite) requests_close "done" "$detail" "$from" "$to" ;;
    annulée) requests_close rolled_back "$detail" "$from" "$to" ;;
    arrêtée)
      requests_wait_again "Arrêtée par l'antenne, sa sauvegarde faite : $detail. Elle repart dès que l'antenne le permet, une heure après au plus tôt."
      ;;
    échouée)
      if [[ $detail == *"le retour en "*" a échoué"* ]]; then
        requests_close failed "Le retour à la $from a échoué aussi : la station est à réparer, sur la machine (sudo station status). Échouée $detail." "$from" "$to"
      else
        requests_close failed "Rien n'a changé : la station tourne toujours en $from. Échouée $detail." "$from" "$to"
      fi
      ;;
    *) requests_close failed "updates.log dit : $result, $detail." "$from" "$to" ;;
  esac
}

# Une demande que le moteur dit en cours, au début d'un passage : celui qui
# l'avait lancée s'est arrêté, la machine qui redémarre, ou le service tué ;
# ou le moteur n'a pas pris son attente. updates.log dit ce qu'est devenue la
# mise à jour, d'après la marque.
requests_resume() {
  local mark="" started="" lines="" state="" line
  if [[ -f $dir/$REQUEST_MARK ]]; then
    IFS=$'\t' read -r mark started lines state <"$dir/$REQUEST_MARK" || true
  fi
  if [[ $mark != "$request_id" || ! $lines =~ ^[0-9]+$ ]]; then
    requests_close interrupted "La machine n'a pas trace de cette mise à jour : la station a peut-être été remise d'une sauvegarde. Voir sur la machine : sudo station status."
    return 0
  fi
  line=$(updates_since "$lines" | sed -n 1p)
  if [[ -n $line ]]; then
    requests_result "$line"
  elif [[ $state == attente ]]; then
    requests_wait_again "La mise à jour n'a pas commencé : la machine réessaie chaque minute."
  else
    requests_close interrupted "La mise à jour s'est arrêtée sans rien noter, le $(station_date "$started") : la machine a redémarré, ou la commande a été arrêtée. Voir sur la machine : sudo station status."
  fi
}

# Les derniers mots d'une commande : ses trois dernières lignes, en une.
requests_last_words() { # sortie
  { grep -v '^[[:space:]]*$' "$1" || true; } | tail -n 3 | tr '\n' ' ' | head -c 1500
}

# La demande close, dans le moteur, avec son résultat, et les versions
# d'avant et d'après. La marque ne s'en va qu'une fois le moteur prévenu :
# sinon, le passage suivant le lui redit, d'après updates.log.
requests_close() { # résultat, détail, version d'avant, nouvelle
  local options=()
  [[ -z ${3:-} ]] || options+=(--from "$3")
  [[ -z ${4:-} ]] || options+=(--to "$4")
  if requests_engine "$2" finish "$request_id" "$1" "${options[@]}" >/dev/null; then
    rm -f "${dir:?}/$REQUEST_MARK"
    case $1 in
      "done") say "Demande de la console : faite." ;;
      rolled_back) say "Demande de la console : annulée, la station est revenue à la version d'avant." ;;
      up_to_date) say "Demande de la console : rien à faire, la station est à jour." ;;
      refused) say "Demande de la console : refusée. $2" ;;
      interrupted) say "Demande de la console : interrompue. $2" ;;
      *) say "Demande de la console : échouée. $2" ;;
    esac
  else
    warn "le moteur ne prend pas le résultat de la demande ($1) : le prochain passage le lui redira."
  fi
}

# Une demande ouverte, refusée, avec sa raison : avant d'échanger les données
# d'une restauration, ou de désinstaller, et après une installation. Sinon, la
# station la prendrait, une fois revenue, sans que personne ne l'ait redemandée.
# Sans moteur qui réponde, rien.
requests_forget() { # raison
  local request_id="" request_state=""
  requests_show || return 0
  [[ -n $request_id ]] || return 0
  rm -f "${dir:?}/$REQUEST_MARK"
  requests_engine "$1" finish "$request_id" refused >/dev/null || true
  return 0
}

# Le minuteur des demandes de la console : chaque minute, station requests.
# Comme ceux de la sauvegarde hors de la machine, ses fichiers se réécrivent
# seulement s'ils changent, et se gardent tels quels aux retours arrière
# (keep) : leur ligne ExecStart ne change plus, pour que la commande d'une
# version d'avant la lise. Ils s'en vont devant une commande station qui ne
# connaît pas les demandes, comme celle d'une 0.2.0. BUTTON_CONSOLE_REQUESTS=no
# ne l'arrête pas : il ne fait plus que le dire au moteur.
requests_timer() { # keep, ou rien
  local command changed="" repo=""
  if ! grep -q '^cmd_requests()' "$dir/station" 2>/dev/null; then
    requests_timer_off
    return 0
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    warn "systemd manque : les demandes de la console, comme « Mettre à jour maintenant », ne se prennent pas seules. Les prendre à la main : station requests."
    return 1
  fi
  if [[ ${1:-} != keep ]]; then
    command=$(systemd_quote "$dir/station")
    # Le dépôt d'un fork, que la mise à jour demandée doit prendre aussi.
    [[ $REPO == lazbutton/button ]] || repo="
Environment=BUTTON_REPO=$REPO"
    unit_write button-demandes.service "# Les demandes de la console, comme « Mettre à jour maintenant », que lance
# button-demandes.timer chaque minute. Écrit par la commande station de $dir :
# station config --console-requests les coupe ou les rallume.
[Unit]
Description=BUTTON : les demandes de la console
Documentation=https://github.com/$REPO/blob/main/docs/deploiement.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# systemd ne pose pas HOME pour un service de root : docker y lit le jeton
# du registre, dans /root/.docker.
Environment=HOME=/root$repo
ExecStart=$command requests --dir $(systemd_quote "$dir")
# Le temps d'une mise à jour, et de son retour arrière. Arrêté en route, à
# l'arrêt de la machine par exemple, le service laisse au retour arrière le
# temps de finir.
TimeoutStartSec=3h
TimeoutStopSec=30min
# Chaque minute, rien au journal quand rien n'attend : ni le départ ni la fin
# du service, que systemd note en info. Ce que dit la commande passe.
SyslogLevel=notice
LogLevelMax=notice"
    unit_write button-demandes.timer "# Chaque minute, les demandes de la console. Écrit par la commande station :
# station config --console-requests les coupe ou les rallume.
[Unit]
Description=BUTTON : les demandes de la console, chaque minute

[Timer]
OnCalendar=minutely
AccuracySec=5s

[Install]
WantedBy=timers.target"
  fi
  if [[ -n $changed ]] && ! systemctl daemon-reload >/dev/null 2>&1; then
    warn "systemd ne relit pas le minuteur des demandes de la console : voir systemctl status button-demandes.timer."
    return 1
  fi
  if ! systemctl enable --now button-demandes.timer >/dev/null 2>&1; then
    warn "systemd ne prend pas le minuteur des demandes de la console : voir systemctl status button-demandes.timer."
    return 1
  fi
  [[ -z $changed ]] ||
    say "Demandes de la console : prises chaque minute, par le minuteur button-demandes de systemd."
}

# Le minuteur des demandes de la console s'en va, s'il est là.
requests_timer_off() {
  local name present=()
  for name in "${REQUEST_UNITS[@]}"; do
    [[ ! -e $UNITS/$name ]] || present+=("$UNITS/$name")
  done
  ((${#present[@]})) || return 0
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now button-demandes.timer >/dev/null 2>&1 || true
  fi
  rm -f "${present[@]}"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
  return 0
}

# Les demandes de la console, pour status et config.
requests_label() {
  if ! requests_on; then
    printf 'coupées (station config --console-requests yes les rallume)\n'
  elif [[ ! -e $UNITS/button-demandes.timer ]]; then
    printf 'sans minuteur : station install le pose\n'
  else
    printf 'prises chaque minute\n'
  fi
}

# --- cli ---

cmd_cli() {
  local dir="" env_file="" tty=()
  # Seul --dir, en tête, est à station : le reste va au moteur.
  while (($#)); do
    case $1 in
      --dir=*)
        dir=${1#*=}
        shift
        ;;
      --dir)
        (($# >= 2)) || usage_error "--dir attend une valeur."
        dir=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
  done
  open_station cli "$dir"
  docker_ok || die "Docker ne répond pas : station cli passe par le moteur." "Voir pourquoi : systemctl status docker."
  station_running radiotomate-interface ||
    die "Le moteur ne tourne pas : station cli passe par lui." "Voir pourquoi : station status. Puis le démarrer : cd $dir && docker compose up -d."
  [[ -t 0 && -t 1 ]] || tty=(-T)
  compose exec "${tty[@]}" radiotomate-interface radiotomate "$@"
}

# --- uninstall ---

cmd_uninstall() {
  local dir="" env_file="" purge assume_yes="" aborted="Rien n'est désinstallé." file
  local -A opts=()
  local args=()
  parse_options "--purge --yes -h --help" "--dir" "$@"
  if help_asked; then
    usage_command uninstall
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  purge=${opts[--purge]:-}
  assume_yes=${opts[--yes]:-}
  station_dir "${opts[--dir]:-}"
  need_root uninstall
  [[ -f $env_file || -f $dir/compose.yml ]] ||
    die "Pas de station dans $dir : ni .env, ni compose.yml." "Une station ailleurs : station uninstall --dir DOSSIER."
  # Effacer un dossier de premier niveau, comme /opt, n'est pas l'affaire de
  # cette commande.
  [[ -z $purge || $dir == /?*/?* ]] ||
    die "station uninstall --purge n'efface pas $dir, un dossier de premier niveau." "Effacer à la main ce qui doit l'être."
  env_isolate
  if [[ -z $purge && ! -f $dir/compose.yml ]]; then
    say "La station de $dir est déjà désinstallée : restent .env et ses données. Pour tout effacer : station uninstall --purge."
    return 0
  fi
  if [[ -n $purge ]]; then
    uninstall_purge_report
    confirm_word uninstall effacer "Pour tout effacer, taper effacer :"
  else
    say "Désinstaller la station de $dir : ses conteneurs, ses images, les fichiers de sa version et la commande station s'en vont." \
      "Restent .env, data/, media/ et backups/ : station install les reprend, pour la même station."
    [[ -z $(env_value BUTTON_BACKUP_REMOTE) ]] ||
      say "La sauvegarde hors de la machine s'arrête avec la commande ; station install la reprend."
    confirm uninstall "Désinstaller ? (o/n)"
  fi
  lock_station uninstall

  if [[ -f $dir/compose.yml ]]; then
    local profiles=() images=() image down=(down --remove-orphans)
    # Restée dans les données, une demande ouverte mettrait à jour la station
    # réinstallée, sans que personne ne l'ait redemandée.
    requests_forget "La station a été désinstallée : la redemander une fois réinstallée."
    all_profiles
    mapfile -t images < <(compose "${profiles[@]}" config --images 2>/dev/null | sort -u)
    [[ -z $purge ]] || down+=(--volumes)
    say "Désinstallation : arrêt de la station."
    compose "${profiles[@]}" "${down[@]}" ||
      die "La station ne s'arrête pas : voir le message de docker compose plus haut." "Voir pourquoi, puis relancer station uninstall."
    # Une image qu'un autre conteneur prend encore reste. Celle de restic
    # n'est pas dans compose.yml.
    for image in "${images[@]}" "$RESTIC_IMAGE"; do
      docker image rm "$image" >/dev/null 2>&1 || true
    done
  fi
  # La sauvegarde hors de la machine ne part plus : la commande s'en va.
  # station install remet ses minuteurs, si .env la règle encore. Les demandes
  # de la console non plus.
  remote_timers_off
  requests_timer_off
  rm -f "$dir/$REQUEST_MARK" "$REQUESTS_STATE"
  # Ce que le projet garde encore, par son étiquette : après une
  # désinstallation qui gardait les données, compose.yml n'est plus là.
  [[ -z $purge ]] || project_leftovers
  if [[ -L $BIN && $(readlink "$BIN") == "$dir/station" ]]; then
    rm -f "$BIN"
  fi
  if [[ -n $purge ]]; then
    rm -rf "${dir:?}"
    say "" "La station est effacée : $dir n'existe plus. Docker reste installé."
  else
    for file in "${VERSION_FILES[@]}"; do
      rm -rf "${dir:?}/$file"
    done
    say "" "La station est désinstallée. Restent, dans $dir : .env, data/, media/ et backups/." \
      "  La réinstaller, la même : station install --dir $dir, avec le script d'une version publiée. Docker reste installé."
  fi
}

# Les conteneurs et les volumes du projet, que compose.yml ne nomme plus.
project_leftovers() {
  local ids=()
  mapfile -t ids < <(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)
  ((${#ids[@]} == 0)) || docker rm -f "${ids[@]}" >/dev/null 2>&1 || true
  mapfile -t ids < <(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)
  ((${#ids[@]} == 0)) || docker volume rm "${ids[@]}" >/dev/null 2>&1 ||
    warn "des volumes du projet $PROJECT restent : docker volume ls, puis docker volume rm."
}

# Ce que --purge efface, et ce qu'il laisse, hors du dossier.
uninstall_purge_report() {
  local key path outside="" count=0 media remote
  if [[ -d $dir/backups ]]; then
    count=$(find "$dir/backups" -maxdepth 1 -name 'button-*.tar' | wc -l)
  fi
  media=$(env_path BUTTON_MEDIA ./media)
  say "Tout effacer : la station de $dir, ses conteneurs, ses images, ses volumes, et son dossier entier. Rien ne se récupère ensuite :" \
    "  .env, avec ses secrets ;" \
    "  data/ : la base, avec les comptes, les horloges, l'Agenda et les réglages ;"
  if [[ $media == "$dir"/* && -d $media ]]; then
    say "  ${media#"$dir"/}/ : la banque de sons, $(human_kb "$(size_kb "$media")") ;"
  fi
  say "  backups/ : $((count)) sauvegarde(s)."
  for key in "${DATA_DIRS[@]}" CLOUD_SYNC_CONFIG:./data/rclone; do
    path=$(env_path "${key%%:*}" "${key#*:}")
    [[ $path == "$dir"/* ]] || outside="$outside ${key%%:*} ($path)"
  done
  [[ -z $outside ]] || say "Hors du dossier, rien ne s'efface :$outside."
  remote=$(env_value BUTTON_BACKUP_REMOTE)
  if [[ -n $remote ]]; then
    say "Les sauvegardes hors de la machine restent dans leur dépôt, $remote. Son mot de passe s'efface avec .env : le noter d'abord, BUTTON_BACKUP_PASSWORD, sans quoi elles ne se lisent plus."
  else
    say "Une sauvegarde d'abord, copiée hors de cette machine : station backup --with-media."
  fi
}

main() {
  local command=${1:-help}
  (($# == 0)) || shift
  case $command in
    install | update | rollback | status | logs | backup | restore | config | hold | unhold | requests | cli | uninstall)
      help_topic=$command
      "cmd_$command" "$@"
      ;;
    help | -h | --help)
      if (($#)); then
        usage_command "$1"
      else
        usage
      fi
      ;;
    *) usage_error "Commande inconnue : $command." ;;
  esac
}

# Lu par les tests avec source, le script ne fait que définir ses fonctions.
# Lu sur l'entrée standard (curl … | bash -s install), il n'a pas de nom.
if [[ -z ${BASH_SOURCE[0]:-} || ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
