# La version du schéma de la base en place, ou rien si elle ne se lit pas,
# puis l'état d'une copie de RT_DATA/backups, comme celles qu'une migration
# fait d'abord : ok, ou ce que disent integrity_check ou SQLite. Le schéma de
# la copie se lit dans son nom (copy_schema) : une copie abîmée le garde.
engine_copy_check() { # nom de la copie
  engine_run -e "BUTTON_COPY=$1" --entrypoint python3 radiotomate-init - <<'PY'
# copie : la version du schéma de la base en place, puis l'état de la copie.
import os
import sqlite3
from contextlib import closing

try:
    with closing(sqlite3.connect("/data/radiotomate.db")) as con:
        row = con.execute("select value from settings where key = 'SCHEMA_VERSION'").fetchone()
    print(row[0] if row else "")
except sqlite3.Error:
    print("")
try:
    # En lecture seule : une copie qui manque ne se crée pas, vide.
    copy = "file:/data/backups/" + os.environ["BUTTON_COPY"] + "?mode=ro"
    with closing(sqlite3.connect(copy, uri=True)) as con:
        state = " ".join(str(row[0]) for row in con.execute("pragma integrity_check"))
except sqlite3.Error as error:
    state = str(error) or "illisible"
print(state.replace("\n", " ")[:200])
PY
}

# Une copie de RT_DATA/backups remise à la place de la base, moteur arrêté :
# restore-radiotomate.sh, dans l'image du moteur, garde à côté la base qu'elle
# remplace, dans backups/avant-restauration-….db. Le script est donné : celui
# d'une 0.2.0 demande sqlite3, que l'image n'a pas.
engine_restore_copy() { # nom de la copie, script de restauration
  engine_run -v "$2:/restore-radiotomate.sh:ro" \
    --entrypoint bash radiotomate-init /restore-radiotomate.sh "/data/backups/$1" /data </dev/null >/dev/null
}

# Les adresses publiques des réglages Station qui suivaient l'ancien domaine
# passent au nouveau. Celles qu'un admin a changées dans la console restent.
# Elles se forment comme dans station_settings. Écrit les clés changées.
engine_domain_settings() { # ancien domaine, nouveau
  engine_run -e "BUTTON_OLD=$1" -e "BUTTON_NEW=$2" -e "BUTTON_MOUNT=$(stream_mount)" \
    --entrypoint python3 radiotomate-init - <<'PY'
# domaine : les adresses publiques des réglages Station, de l'ancien au nouveau.
import os
import sqlite3
from contextlib import closing

old, new = os.environ["BUTTON_OLD"], os.environ["BUTTON_NEW"]
addresses = {
    "station.public_stream_url": "https://{}/" + os.environ["BUTTON_MOUNT"],
    "station.now_url": "https://{}/now.json",
    "station.status_url": "https://{}/status-json.xsl",
    "station.harbor_host": "{}",
}
with closing(sqlite3.connect("/data/radiotomate.db", timeout=30)) as con, con:
    for key, address in addresses.items():
        changed = con.execute(
            "update settings set value = ? where key = ? and value = ?",
            (address.format(new), key, address.format(old)),
        ).rowcount
        if changed:
            print(key)
PY
}

# --- status ---

cmd_status() {
  local dir="" env_file="" domain healthy=1
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command status
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  open_station status "${opts[--dir]:-}"
  domain=$(env_value DOMAIN)
  say "Station : $dir${domain:+, https://$domain}"
  journal_report || healthy=""
  version_report
  updates_report
  services_report || healthy=""
  disk_report
  next_live_report
  backup_report
  [[ -n $healthy ]]
}

# Une restauration coupée en plein échange, par un arrêt de la machine.
journal_report() {
  [[ -f $dir/$JOURNAL ]] || return 0
  warn "une restauration ne s'est pas finie. $dir/$JOURNAL dit, ligne à ligne, le dossier en place, celui d'avant, mis à côté, et celui de la sauvegarde :"
  grep -v '^#' "$dir/$JOURNAL" | sed 's/^/  /' >&2
  say "  Pour revenir à la station d'avant : cd $dir && docker compose stop, remettre chaque dossier d'avant à sa place, effacer $JOURNAL, puis docker compose up -d. Ou relancer station restore."
  return 1
}

version_report() {
  local installed latest
  installed=$(installed_version)
  latest=$(latest_version 5 2>/dev/null) || latest=""
  if [[ -z $latest ]]; then
    say "Version : $installed. La plus haute publiée ne se lit pas : GitHub ne répond pas."
  elif [[ $latest == "$installed" ]]; then
    say "Version : $installed, la plus haute publiée."
  else
    say "Version : $installed ; la plus haute publiée : $latest, https://github.com/$REPO/releases"
  fi
}

# Les mises à jour, comme install les note : automatiques seulement avec
# BUTTON_UPDATES=auto, ou sans la ligne.
updates_label() {
  local time
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    time=$(env_value BUTTON_UPDATE_TIME)
    printf 'automatiques, à %s (%s)\n' "${time:-$UPDATE_TIME}" "$(env_value TZ Europe/Paris)"
  else
    printf 'à la main\n'
  fi
}

updates_report() {
  local line made from to result _backup detail
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    say "Mises à jour : $(updates_label), dès que station update saura se lancer seule. D'ici là, à la main : station update."
  else
    say "Mises à jour : à la main, par station update."
  fi
  line=$(grep -v '^#' "$dir/updates.log" 2>/dev/null | tail -n 1) || line=""
  IFS=$'\t' read -r made from to result _backup detail <<<"$line"
  if [[ $made =~ ^[0-9]+$ ]]; then
    say "  La dernière : le $(station_date "$made"), de $from à $to, $result${detail:+, $detail}."
  fi
  if [[ -f $dir/HOLD ]]; then
    say "  Bloquées, par $dir/HOLD :"
    sed 's/^/    /' "$dir/HOLD"
  fi
}

# Chaque service attendu, avec son état. Échoue si l'un ne va pas.
services_report() {
  local services states service line state health code label bad=""
  if ! docker_ok; then
    say "Services : inconnus, Docker ne répond pas. Voir pourquoi : systemctl status docker."
    return 1
  fi
  services=$(compose config --services 2>/dev/null | sort) || services=""
  states=$(compose ps -a --format '{{.Name}}|{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2>/dev/null) || states=""
  if [[ -z $services ]]; then
    say "Services : la liste ne se lit pas. Voir pourquoi : cd $dir && docker compose config."
    return 1
  fi
  say "Services :"
  while IFS= read -r service; do
    # Le conteneur du service, pas celui d'un docker compose run.
    line=$(awk -F '|' -v service="$service" '$2 == service && $1 !~ /-run-/ { print; exit }' <<<"$states")
    IFS='|' read -r _ _ state health code <<<"$line"
    case $state/$health in
      running/healthy) label="sain" ;;
      running/) label="en marche" ;;
      running/starting) label="démarre" ;;
      running/unhealthy) label="en panne : son contrôle de santé échoue" ;;
      restarting/*) label="redémarre sans cesse" ;;
      exited/*)
        label="arrêté, code $code"
        [[ $service != radiotomate-init || $code != 0 ]] || label="fait"
        ;;
      /) label="absent : pas de conteneur" ;;
      *) label=$state ;;
    esac
    case $label in
      sain | "en marche" | fait) ;;
      *) bad="$bad${bad:+,} $service" ;;
    esac
    printf '  %-22s %s\n' "$service" "$label"
  done <<<"$services"
  [[ -n $bad ]] || return 0
  if [[ -z $states ]]; then
    say "  La station ne tourne pas. La démarrer : cd $dir && docker compose up -d."
  else
    say "  Ne vont pas :$bad. Leur journal : station logs SERVICE."
  fi
  return 1
}

disk_report() {
  local path line free total mount seen=" "
  for path in "$dir" "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"; do
    line=$(df_line "$path")
    read -r free total mount <<<"$line"
    if [[ ! $free =~ ^[0-9]+$ || ! $total =~ ^[0-9]+$ ]]; then
      say "Disque : la place de $path ne se lit pas."
      continue
    fi
    [[ $seen != *" $mount "* ]] || continue
    seen="$seen$mount "
    say "Disque : $(human_kb "$free") libres sur $(human_kb "$total"), sur $mount$([[ $path == "$dir" ]] || echo ', pour Docker')."
    if ((free < MIN_FREE_GB * 1048576)); then
      warn "moins de $MIN_FREE_GB Go libres sur $mount : en libérer, ou agrandir le disque."
    fi
  done
}

next_live_report() {
  local live
  if ! docker_ok; then
    say "Prochain direct : inconnu, Docker ne répond pas."
  elif ! station_running radiotomate-interface; then
    say "Prochain direct : inconnu, le moteur ne tourne pas."
  elif live=$(compose exec -T radiotomate-interface radiotomate maintenance next-live </dev/null 2>/dev/null) && [[ -n $live ]]; then
    say "Prochain direct : $live."
  else
    say "Prochain direct : inconnu, le moteur ne le dit pas : il ne répond pas, ou sa version n'a pas radiotomate maintenance next-live."
  fi
}

backup_report() {
  local line made archive size media
  line=$(grep -v '^#' "$dir/backups.log" 2>/dev/null | tail -n 1) || line=""
  IFS=$'\t' read -r made archive size media <<<"$line"
  if [[ ! $made =~ ^[0-9]+$ || ! $size =~ ^[0-9]+$ ]]; then
    say "Dernière sauvegarde : aucune. En faire une : station backup."
    return
  fi
  say "Dernière sauvegarde : le $(station_date "$made"), il y a $(since "$made"), $(human_kb "$size")$([[ $media != 1 ]] || echo ', avec les sons') : $archive$([[ -f $archive ]] || echo ", qui n'y est plus")."
}

# --- logs ---

cmd_logs() {
  local dir="" env_file="" option tail=(--tail 200) args=()
  while (($#)); do
    option=$1
    shift
    case $option in
      --dir=*) dir=${option#*=} ;;
      --dir)
        (($#)) || usage_error "--dir attend une valeur."
        dir=$1
        shift
        ;;
      -h | --help)
        usage_command logs
        return 0
        ;;
      -n | --tail | --tail=* | --since | --since=* | --until | --until=*)
        tail=()
        args+=("$option")
        ;;
      *) args+=("$option") ;;
    esac
  done
  open_station logs "$dir"
  compose logs "${tail[@]}" "${args[@]}"
}

# --- backup ---

cmd_backup() {
  local dir="" env_file="" archive
  local -A opts=()
  local args=()
  parse_options "--with-media -h --help" "--dir" "$@"
  if help_asked; then
    usage_command backup
    return 0
  fi
  ((${#args[@]} <= 1)) || usage_error "Argument inattendu : ${args[1]}. Une seule archive."
  open_station backup "${opts[--dir]:-}"
  lock_station backup
  trap cleanup EXIT
  archive=${args[0]:-}
  backup_target
  backup_station "$archive" "${opts[--with-media]:-}"
}

# Où écrire l'archive : le fichier donné ; dans le dossier donné ; sinon dans
# backups/, dans le dossier de la station. Son nom dit l'heure, en UTC. Une
# sauvegarde ne s'écrit jamais par-dessus un fichier.
backup_target() {
  local name tries=0
  name=button-$(date -u +%Y%m%dT%H%M%SZ).tar
  if [[ -z $archive ]]; then
    install -d -m 700 "$dir/backups"
    archive=$dir/backups/$name
    # Une autre sauvegarde de la même seconde, celle de station backup juste
    # avant station update par exemple : celle-ci prend la seconde suivante.
    while [[ -e $archive || -e $archive.part ]] && ((tries++ < 3)); do
      sleep 1
      archive=$dir/backups/button-$(date -u +%Y%m%dT%H%M%SZ).tar
    done
  elif [[ -d $archive ]]; then
    archive=${archive%/}/$name
  fi
  [[ $archive == /* ]] || archive=$PWD/$archive
  [[ -d ${archive%/*} ]] ||
    die "Le dossier ${archive%/*} n'existe pas." "Le créer, ou donner un autre chemin à station backup."
  [[ ! -e $archive && ! -e $archive.part ]] ||
    die "$archive existe déjà : une sauvegarde ne s'écrit jamais par-dessus un fichier." "Donner un autre nom, ou un dossier."
}

# La sauvegarde de la station, dans archive, en droits 600 : de quoi la
# remettre, ici ou sur une autre machine, par station restore, même d'une
# version plus récente. L'antenne continue. Une ligne de backups.log la note.
# station update la fait avant chaque mise à jour. Tout s'écrit à côté de
# l'archive : son disque est le seul dont la place compte.
backup_station() { # archive, avec les sons (1) ou non, script de sauvegarde ou rien
  local archive=$1 with_media=$2 script=${3:-$dir/scripts/backup-radiotomate.sh}
  local stage data caddy media="" data_kb caddy_kb media_kb=0 size_kb
  data=$(env_path RT_DATA ./data/radiotomate)
  caddy=$(env_path CADDY_DATA ./data/caddy)
  [[ -f $data/radiotomate.db ]] ||
    die "La station n'a pas de base : $data/radiotomate.db manque." \
      "Finir l'installation : station install. Ou vérifier RT_DATA, dans $env_file."
  [[ -f $script ]] ||
    die "$script manque." "station install le remet. Puis relancer."
  if [[ -n $with_media ]]; then
    # La banque elle-même, au bout d'un lien : tar ne suit pas un lien.
    media=$(real_path "$(env_path BUTTON_MEDIA ./media)")
    [[ -d $media ]] || die "La banque de sons, $media, n'existe pas." "Vérifier BUTTON_MEDIA, dans $env_file."
    media_name_ok "${media##*/}" ||
      die "La banque de sons, $media, ne peut pas entrer dans une archive sous ce nom." \
        "La renommer, et BUTTON_MEDIA avec elle, dans $env_file : sans tiret en tête, et pas MANIFEST, SHA256SUMS, radiotomate.tar.gz, env ni caddy.tar.gz."
    media_kb=$(size_kb "$media")
  fi
  # Au plus : RT_DATA hors des copies de la base, deux fois, le temps de le
  # copier puis de le compresser ; Caddy ; les sons.
  data_kb=$(($(size_kb "$data") - $(size_kb "$data/backups")))
  caddy_kb=$(size_kb "$caddy")
  space_for "${archive%/*}" $((2 * data_kb + caddy_kb + media_kb)) \
    "Libérer de la place, ou écrire la sauvegarde ailleurs : station backup /un/autre/dossier."
  # L'archive naît vide, en 600, avant le reste : une ACL par défaut sur le
  # dossier passe outre le umask, mais pas le mode donné à la création. Un
  # dossier qui ne garde pas les droits, comme un partage Windows, la
  # laisserait lisible par d'autres, avec les secrets de .env.
  partial=$archive.part
  if ! install -m 600 /dev/null "$partial" 2>/dev/null || [[ $(stat -c %a "$partial") != 600 ]]; then
    die "${archive%/*} ne garde pas les droits des fichiers : l'archive, qui porte les secrets de .env, y serait lisible par d'autres." \
      "L'écrire sur un disque de cette machine, station backup /un/autre/dossier, puis la copier là."
  fi

  work=$(mktemp -d "${archive%/*}/.station-XXXXXX")
  stage=$work/sauvegarde
  mkdir "$stage" "$work/tmp"
  say "Sauvegarde : la base, sans couper l'antenne."
  backup_stage "$stage" "$data_kb" "$media" "$media_kb" "$script"
  backup_pack "$stage" "$archive" "$media"

  size_kb=$(size_kb "$archive")
  if [[ ! -f $dir/backups.log ]]; then
    printf '%s\n' "# Les sauvegardes de station backup, une par ligne : l'heure, en secondes depuis 1970, l'archive, sa taille en Ko, et 1 si elle a les sons." \
      >"$dir/backups.log"
  fi
  printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$archive" "$size_kb" "${with_media:-0}" >>"$dir/backups.log"
  say "Sauvegarde : $archive, $(human_kb "$size_kb"), $([[ -n $media ]] && echo 'avec les sons' || echo 'sans les sons')." \
    "  En droits 600, à root : elle porte les secrets de .env. En garder une copie hors de cette machine : voir docs/exploitation/sauvegarde.md."
}

# Ce qu'une sauvegarde porte, hors des sons, dans un dossier : MANIFEST, qui
# dit son format, sa date, la version de la station, et le nom de la banque
# de sons si elle y est ; SHA256SUMS, les sommes des autres fichiers ;
# radiotomate.tar.gz, l'archive de backup-radiotomate.sh ; env, le .env de la
# station, sans le mot de passe admin ; caddy.tar.gz, ses certificats et son
# compte Let's Encrypt. Une sauvegarde hors de la machine (SAV-01) peut
# envoyer ce dossier tel quel.
backup_stage() { # dossier, taille de RT_DATA en Ko, banque de sons ou rien, sa taille, script
  local stage=$1 caddy status=0
  engine_backup "$stage" "$work/tmp" "${5:-}" ||
    die "La base ne se sauvegarde pas : voir le message plus haut." "Voir l'état de la station, station status, puis relancer."
  # Le mot de passe admin ne s'écrit que dans .env, jusqu'à son affichage.
  install -m 600 /dev/null "$stage/env"
  sed 's/^RT_ADMIN_PASSWORD=.*/RT_ADMIN_PASSWORD=/' "$env_file" >"$stage/env"
  caddy=$(env_path CADDY_DATA ./data/caddy)
  if [[ ! -d $caddy ]]; then
    caddy=$work/vide
    mkdir "$caddy"
  fi
  # 1 : le tar de GNU a vu un fichier changer, un verrou de Caddy par exemple.
  tar -czf "$stage/caddy.tar.gz" -C "$caddy" . || status=$?
  ((status <= 1)) ||
    die "Les certificats de Caddy ne se copient pas : voir le message de tar plus haut." "Vérifier $caddy et la place, puis relancer."
  cat >"$stage/MANIFEST" <<EOF
# Une sauvegarde de station BUTTON, faite par station backup : station restore
# la remet. Les sommes de ses fichiers sont dans SHA256SUMS, sauf celles des sons.
format=$BACKUP_FORMAT
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
time=$(date +%s)
version=$(installed_version)
data_kb=$2
media=${3##*/}
media_kb=$4
EOF
  (cd "$stage" && sha256sum "${BACKUP_FILES[@]}" >SHA256SUMS)
}

# L'archive : MANIFEST, SHA256SUMS, les autres fichiers, puis les sons. Une
# tar sans compression : ses fichiers le sont déjà, les sons aussi, et
# restore lit MANIFEST sans lire le reste. Elle s'écrit dans partial, que
# backup_station a créé en 600, puis prend son nom.
backup_pack() { # dossier, archive, banque de sons ou rien
  local stage=$1 archive=$2 media=$3 parent status=0 members=()
  members=(-C "$stage" MANIFEST SHA256SUMS "${BACKUP_FILES[@]:1}")
  if [[ -n $media ]]; then
    parent=${media%/*}
    members+=(-C "${parent:-/}" "${media##*/}")
  fi
  say "Sauvegarde : l'archive$([[ -z $media ]] || echo ', avec les sons'), dans ${archive%/*}."
  tar -cf - "${members[@]}" >"$partial" || status=$?
  if ((status == 1)) && [[ -n $media ]]; then
    # Le tar de GNU : des fichiers ont changé pendant qu'il les lisait.
    warn "des sons ont changé pendant la sauvegarde, déposés ou rangés : elle les a tels que tar les a lus."
  elif ((status != 0)); then
    die "L'archive ne s'écrit pas : voir le message de tar plus haut." "Vérifier la place, et le dossier ${archive%/*}. Puis relancer."
  fi
  mv -f "$partial" "$archive"
  partial=""
}

# --- restore ---

cmd_restore() {
  local dir="" env_file="" archive assume_yes="" aborted="Rien n'est changé."
  local -A opts=()
  local args=()
  parse_options "--yes --without-media -h --help" "--dir" "$@"
  if help_asked; then
    usage_command restore
    return 0
  fi
  ((${#args[@]} == 1)) || usage_error "station restore attend une archive, et une seule : station restore ARCHIVE."
  archive=${args[0]}
  [[ $archive == /* ]] || archive=$PWD/$archive
  assume_yes=${opts[--yes]:-}
  open_station restore "${opts[--dir]:-}"
  confirm_possible restore
  [[ -f $archive && -r $archive ]] ||
    die "$archive n'existe pas, ou ne se lit pas." "Donner le chemin d'une archive de station backup."
  lock_station restore
  trap cleanup EXIT
  restore_station "$archive" "${opts[--without-media]:-}"
}

# Une valeur du MANIFEST de la sauvegarde.
manifest_value() { # clé
  sed -n "s/^$1=//p" "$work/sauvegarde/MANIFEST" | tail -n 1
}

# Un nombre du MANIFEST, 0 s'il n'en est pas un : rien d'autre d'une archive
# ne se calcule.
manifest_number() { # clé
  local value
  value=$(manifest_value "$1")
  [[ $value =~ ^[0-9]{1,15}$ ]] || value=0
  printf '%s\n' "$value"
}

# Une valeur, ou une variable posée, dans un autre .env que celui de la station.
env_value_in() { # .env, clé, défaut
  local env_file=$1
  shift
  env_value "$@"
}

env_set_in() { # .env, clé, valeur, commande
  local env_file=$1
  shift
  env_set "$@"
}

# Ouvre la sauvegarde dans un dossier : MANIFEST et SHA256SUMS d'abord, au
# début de l'archive, puis les fichiers que SHA256SUMS nomme, vérifiés. Le
# format se lit avant le reste : une archive d'un format plus ancien se lit
# aussi. Les sons restent dans l'archive.
restore_unpack() { # archive, dossier
  local archive=$1 in=$2 format name listed=()
  tar -xf "$archive" -C "$in" --occurrence MANIFEST SHA256SUMS 2>"$work/tar.log" ||
    die "$archive n'est pas une sauvegarde de station, ou elle est abîmée : $(head -n 1 "$work/tar.log")" \
      "Prendre une archive faite par station backup."
  format=$(manifest_value format)
  [[ $format =~ ^[0-9]+$ ]] ||
    die "$archive n'a pas de MANIFEST lisible : ce n'est pas une sauvegarde de station." "Prendre une archive faite par station backup."
  ((format <= BACKUP_FORMAT)) ||
    die "Cette sauvegarde est au format $format, plus récent que celui de cette commande, $BACKUP_FORMAT." \
      "Prendre la commande station de la version de la sauvegarde, ou d'une plus récente, puis relancer."
  while read -r _ name; do
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
      die "La sauvegarde est abîmée : SHA256SUMS nomme « $name »." "En prendre une autre."
    listed+=("$name")
  done <"$in/SHA256SUMS"
  tar -xf "$archive" -C "$in" --occurrence "${listed[@]}" 2>"$work/tar.log" ||
    die "La sauvegarde est abîmée : $(head -n 1 "$work/tar.log")" "En prendre une autre."
  (cd "$in" && sha256sum -c SHA256SUMS >/dev/null 2>&1) ||
    die "La sauvegarde est abîmée : un de ses fichiers ne correspond pas à sa somme, dans SHA256SUMS." "En prendre une autre."
  for name in "${BACKUP_FILES[@]}"; do
    [[ -f $in/$name ]] || die "La sauvegarde est abîmée : il y manque $name." "En prendre une autre."
  done
}

# Une variable de .env qui va avec la base : celle de la sauvegarde, à la
# place de celle de cette machine, si son contrôle la prend.
restore_env_value() { # clé, défaut, contrôle ou rien
  local value
  value=$(env_value_in "$in/env" "$1" "$2")
  [[ $value != "$(env_value_in "$new_env" "$1" "$2")" ]] || return 0
  if [[ -n $3 ]] && ! "$3" "$value" 2>/dev/null; then
    warn "$1 de la sauvegarde, « $value », ne vaut pas sur cette machine : .env garde le sien."
    return 0
  fi
  env_set_in "$new_env" "$1" "$value" restore
  [[ $1 == RT_ADMIN_PASSWORD ]] || taken="$taken${taken:+,} $1=$value"
}

# Remet une sauvegarde de station backup. Tout se prépare à côté, pendant que
# l'antenne continue : la base vérifiée, Caddy, les sons, .env. Puis la
# station s'arrête, chacun prend la place du sien, et elle repart. Si elle ne
# repart pas, cleanup remet celle d'avant (restore_undo).
restore_station() { # archive, sans les sons (1) ou non
  local archive=$1 without_media=$2 in stamp version saved_at media media_kb data_kb path
  local data caddy media_dir new_data new_caddy="" new_media="" new_env schemas current restored
  local listing saved_domain differs="" taken="" key domain tls entry aside keys="" profiles=()
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # Les dossiers réels, au bout d'un lien.
  data=$(real_path "$(env_path RT_DATA ./data/radiotomate)")
  caddy=$(real_path "$(env_path CADDY_DATA ./data/caddy)")
  media_dir=$(real_path "$(env_path BUTTON_MEDIA ./media)")
  [[ -f $data/radiotomate.db ]] ||
    die "La station de $dir n'a pas encore de base : $data/radiotomate.db manque." \
      "Finir l'installation, station install, puis relancer la restauration."
  [[ -f $dir/scripts/restore-radiotomate.sh ]] ||
    die "$dir/scripts/restore-radiotomate.sh manque." "station install le remet. Puis relancer."
  # Le travail, sur le disque des données : la base s'y ouvre.
  work=$(mktemp -d "${data%/*}/.station-XXXXXX")
  in=$work/sauvegarde
  mkdir "$in" "$work/tmp"
  say "Restauration : lecture de $archive."
  restore_unpack "$archive" "$in"
  version=$(manifest_value version)
  saved_at=$(manifest_number time)
  media=$(manifest_value media)
  media_kb=$(manifest_number media_kb)
  data_kb=$(manifest_number data_kb)
  [[ -z $media ]] || media_name_ok "$media" ||
    die "Le MANIFEST de la sauvegarde nomme mal la banque de sons : « $media »." "En prendre une autre."
  if [[ -n $media && -n $without_media ]]; then
    say "Restauration : sans les sons de la sauvegarde (--without-media), la banque en place reste."
    media=""
  fi
  # Un point de montage ne se déplace pas : restore ne le remplace pas.
  for path in "$data" "$caddy"; do
    if mounted "$path"; then
      die "$path est un point de montage : restore ne sait pas le remplacer. Rien n'a changé." \
        "Restaurer à la main, avec les scripts : voir docs/exploitation/sauvegarde.md, « Avec les scripts »."
    fi
  done
  if [[ -n $media ]] && mounted "$media_dir"; then
    die "La banque de sons, $media_dir, est un point de montage : restore ne sait pas la remplacer. Rien n'a changé." \
      "Restaurer sans les sons, station restore --without-media, puis y remettre ceux de la sauvegarde : tar -xf ARCHIVE -C $media_dir --strip-components=1 $media."
  fi
  say "Sauvegarde du $(station_date "$saved_at"), d'une station en version ${version:-inconnue}$([[ -z $media ]] || echo ', avec ses sons')."
  # La place : la base deux fois à côté de la sienne, le temps de la vérifier ;
  # les sons à côté de la banque.
  if [[ -n $media && $(mount_of "$data") == "$(mount_of "$media_dir")" ]]; then
    space_for "$data" $((2 * data_kb + media_kb)) "Libérer de la place, ou agrandir le disque. Puis relancer."
  else
    space_for "$data" $((2 * data_kb)) "Libérer de la place, ou agrandir le disque. Puis relancer."
    [[ -z $media ]] || space_for "$media_dir" "$media_kb" "Libérer de la place, ou agrandir le disque. Puis relancer."
  fi

  # La base, vérifiée, à côté de celle en place, sur le même disque.
  new_data=$data.restauration-$stamp
  prepared+=("$new_data")
  mkdir "$new_data"
  say "Restauration : la base de la sauvegarde, vérifiée, à côté de celle en place."
  engine_restore "$in/radiotomate.tar.gz" "$new_data" "$work/tmp" ||
    die "La base de la sauvegarde ne se remet pas : voir le message plus haut. Rien n'a changé." "En prendre une autre."
  schemas=$(engine_schemas "$new_data") ||
    die "La version du schéma des bases ne se lit pas : voir le message plus haut. Rien n'a changé." "Voir l'état de la station : station status."
  current=$(sed -n 1p <<<"$schemas")
  restored=$(sed -n 2p <<<"$schemas")
  [[ $current =~ ^[0-9]+$ && $restored =~ ^[0-9]+$ ]] ||
    die "La version du schéma des bases ne se lit pas : « $current », « $restored ». Rien n'a changé." "Voir l'état de la station : station status."
  ((restored <= current)) ||
    die "La sauvegarde vient de la version ${version:-inconnue} : sa base est au schéma v$restored, que cette station, en $(installed_version), ne sait pas lire. Rien n'a changé." \
      "La remettre sur une station de la même version, ou d'une plus récente : sur une machine neuve, station install --version ${version:-X.Y.Z}."
  # La sauvegarde se remet : la question vient avant le reste, et l'arrêt.
  confirm restore "Remplacer les données de la station de $dir par celles de la sauvegarde ? Celles d'aujourd'hui restent à côté, et l'antenne se coupe le temps de redémarrer. (o/n)"

  # Caddy : ses certificats et son compte, s'il y en a, pour le domaine de
  # cette station. Une sauvegarde d'un autre domaine ne les a pas : la station
  # garde les siens, sans quoi Caddy devrait en demander de nouveaux pendant
  # la restauration.
  saved_domain=$(env_value_in "$in/env" DOMAIN)
  domain=$(env_value DOMAIN)
  if [[ $saved_domain == "$domain" ]]; then
    listing=$(tar -tzf "$in/caddy.tar.gz") ||
      die "Les certificats de Caddy de la sauvegarde ne se lisent pas. Rien n'a changé." "En prendre une autre."
    if grep -qvE '^\./?$' <<<"$listing"; then
      new_caddy=$caddy.restauration-$stamp
      prepared+=("$new_caddy")
      mkdir "$new_caddy"
      tar -xzf "$in/caddy.tar.gz" -C "$new_caddy" ||
        die "Les certificats de Caddy de la sauvegarde ne s'extraient pas : voir le message de tar plus haut. Rien n'a changé." "Vérifier la place, puis relancer."
    fi
  fi
  # Les sons, sous leur nom dans l'archive, à côté de la banque en place.
  if [[ -n $media ]]; then
    new_media=$media_dir.restauration-$stamp
    prepared+=("$new_media")
    mkdir "$new_media"
    say "Restauration : les sons de la sauvegarde, $(human_kb "$media_kb"), à côté de la banque en place."
    tar -xf "$archive" -C "$new_media" "$media" ||
      die "Les sons de la sauvegarde ne s'extraient pas : voir le message de tar plus haut. Rien n'a changé." "Vérifier la place, puis relancer."
  fi
  # .env : celui de cette machine, sa version, son domaine, ses ports et ses
  # secrets ; de la sauvegarde, le fuseau et le compte admin, qui vont avec la
  # base. Les autres différences se disent.
  new_env=$env_file.restauration-$stamp
  prepared+=("$new_env")
  install -m 600 /dev/null "$new_env"
  cat "$env_file" >"$new_env"
  restore_env_value TZ Europe/Paris check_timezone
  restore_env_value RT_ADMIN_USER button check_admin
  restore_env_value RT_ADMIN_PASSWORD "" ""
  while IFS= read -r key; do
    case $key in
      TZ | RT_ADMIN_USER | RT_ADMIN_PASSWORD | BUTTON_VERSION | DOMAIN | *PASSWORD* | *SECRET* | *_KEY) continue ;;
    esac
    [[ $(env_value_in "$in/env" "$key") == "$(env_value_in "$new_env" "$key")" ]] || differs="$differs${differs:+,} $key"
  done < <(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$in/env" "$new_env" | sort -u)

  # Tous les profils s'arrêtent, share compris s'il est lancé à part : sinon,
  # il garderait la banque mise de côté. Ceux qui tournaient repartent.
  say "Restauration : la station s'arrête, le temps d'échanger les données."
  all_profiles
  mapfile -t restart_others < <(compose "${profiles[@]}" ps --services --status running 2>/dev/null)
  station_stopped=$dir
  printf '%s\n' "# station restore, le $(station_date "$(date +%s)") : pas finie, tant que ce fichier est là." \
    "# Chaque ligne : le dossier en place|celui d'avant, mis à côté|celui de la sauvegarde." >"$dir/$JOURNAL"
  compose "${profiles[@]}" stop ||
    die "La station ne s'arrête pas : voir le message de docker compose plus haut." "Voir pourquoi, puis relancer la restauration."
  swap "$data" "$new_data" "$stamp"
  [[ -z $new_caddy ]] || swap "$caddy" "$new_caddy" "$stamp"
  [[ -z $new_media ]] || swap "$media_dir" "$new_media/$media" "$stamp"
  swap "$env_file" "$new_env" "$stamp"
  env_isolate
  # La station garde son domaine : les adresses publiques de la base qui
  # suivaient celui de la sauvegarde passent au sien.
  if [[ -n $saved_domain && -n $domain && $saved_domain != "$domain" ]]; then
    keys=$(engine_domain_settings "$saved_domain" "$domain") ||
      warn "les adresses de Réglages → Station ne suivent pas $domain : les changer dans la console."
  fi
  say "Restauration : la station repart, sur les données de la sauvegarde."
  compose up -d ||
    die "La station ne démarre pas sur la sauvegarde : voir le message de docker compose plus haut." \
      "La restauration s'annule. Voir pourquoi : cd $dir && docker compose logs radiotomate-init."
  restart_others_up ||
    die "Les services lancés à part ne repartent pas : voir le message de docker compose plus haut." \
      "La restauration s'annule. Voir pourquoi, puis relancer station restore."
  tls=$(env_value CADDY_TLS acme)
  if [[ -n $domain && ,$(env_value COMPOSE_PROFILES), == *,vps,* ]]; then
    https_ok ||
      die "https://$domain ne répond pas au bout de $HTTPS_WAIT s, sur la sauvegarde." \
        "La restauration s'annule. Voir pourquoi : cd $dir && docker compose logs caddy."
  fi
  smoke_ok ||
    die "Le contrôle de la station restaurée a échoué : voir plus haut." \
      "La restauration s'annule. Une fois réglé, relancer station restore."
  station_stopped=""
  rm -f "$dir/$JOURNAL"
  record_versions

  # Le .env d'avant garde à côté le mot de passe admin d'une installation qui
  # ne l'a pas affiché : il ne sert plus, et ne s'écrit que dans .env.
  aside=$env_file.avant-restauration-$stamp
  if [[ -f $aside && -n $(env_value_in "$aside" RT_ADMIN_PASSWORD) ]]; then
    env_set_in "$aside" RT_ADMIN_PASSWORD "" restore
  fi
  say "" "La station est restaurée : celle de la sauvegarde du $(station_date "$saved_at"), qui tourne ici en $(installed_version)."
  if ((restored < current)); then
    say "  Sa base, au schéma v$restored, est passée en v$current en démarrant. La copie d'avant est dans $data/backups."
  fi
  say "  Les comptes sont ceux de la sauvegarde : le mot de passe admin de cette installation ne sert plus."
  [[ -z $taken ]] || say "  De la sauvegarde, dans .env :$taken."
  if [[ -n $saved_domain && -n $domain && $saved_domain != "$domain" ]]; then
    if [[ -n $keys ]]; then
      say "  La sauvegarde servait $saved_domain : la station garde $domain et ses certificats, et les adresses de Réglages → Station qui suivaient $saved_domain passent à $domain."
    else
      say "  La sauvegarde servait $saved_domain : la station garde $domain et ses certificats. Vérifier les adresses de Réglages → Station, dans la console."
    fi
    say "  Pour reprendre $saved_domain : station config --domain $saved_domain."
  fi
  [[ -z $differs ]] ||
    say "  Gardés de cette machine, autres dans la sauvegarde :$differs. Leurs valeurs : tar -xOf $archive --occurrence env."
  say "  Les données d'avant restent à côté, à effacer une fois la station vérifiée :"
  for entry in "${swapped[@]}"; do
    aside=${entry#*|}
    aside=${aside%%|*}
    [[ ! -e $aside ]] || say "    $aside"
  done
  swapped=()
}

# Met new à la place de current, et current à côté, en
# current.avant-restauration-<heure>. Chaque échange s'écrit d'abord dans le
# journal ; restore_undo les défait.
swap() { # en place, nouveau, heure
  local aside=$1.avant-restauration-$3
  printf '%s|%s|%s\n' "$1" "$aside" "$2" >>"$dir/$JOURNAL"
  if [[ -e $1 ]]; then
    mv "$1" "$aside" ||
      die "$1 ne se met pas de côté : voir le message plus haut. La restauration s'annule." "Voir pourquoi, puis relancer station restore."
  fi
  swapped+=("$1|$aside|$2")
  mv "$2" "$1" ||
    die "$2 ne prend pas la place de $1 : voir le message plus haut. La restauration s'annule." "Voir pourquoi, puis relancer station restore."
}

# Les services qui tournaient avant la restauration et que up n'a pas
# relancés : ceux d'un profil que .env n'allume pas, comme share lancé à part.
restart_others_up() {
  local running service extra=() profiles=()
  running=" $(compose ps --services --status running 2>/dev/null | tr '\n' ' ') "
  for service in "${restart_others[@]}"; do
    [[ $running == *" $service "* ]] || extra+=("$service")
  done
  ((${#extra[@]})) || return 0
  all_profiles
  compose "${profiles[@]}" up -d "${extra[@]}"
}

# Une restauration arrêtée après l'arrêt de la station : chacun reprend sa
# place, et la station d'avant repart. Le journal reste si un dossier ne
# revient pas.
restore_undo() {
  local dir=$station_stopped env_file=$station_stopped/.env i current aside new left="" profiles=()
  station_stopped=""
  warn "la restauration s'annule : la station d'avant reprend sa place, et repart."
  all_profiles
  compose "${profiles[@]}" stop >/dev/null 2>&1
  for ((i = ${#swapped[@]} - 1; i >= 0; i--)); do
    IFS='|' read -r current aside new <<<"${swapped[i]}"
    if [[ -e $current ]] && ! mv "$current" "$new"; then
      warn "$current ne revient pas en $new : le remettre à la main."
      left=1
    fi
    if [[ -e $aside ]] && ! mv "$aside" "$current"; then
      warn "$aside ne reprend pas sa place, $current : l'y remettre à la main."
      left=1
    fi
  done
  swapped=()
  [[ -n $left ]] || rm -f "$dir/$JOURNAL"
  env_isolate
  if compose up -d >/dev/null 2>&1; then
    restart_others_up >/dev/null 2>&1
  else
    warn "la station d'avant ne repart pas. Voir pourquoi : cd $dir && docker compose up -d."
  fi
}

# --- update ---

cmd_update() {
  local dir="" env_file="" assume_yes="" aborted="Rien n'est changé." installed target="" from="" packed option
  local -A opts=()
  local args=() forwarded=()
  parse_options "--yes --major --force -h --help" "--dir --version --from" "$@"
  if help_asked; then
    usage_command update
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  assume_yes=${opts[--yes]:-}
  target=${opts[--version]:-}
  from=${opts[--from]:-}
  [[ -z $target ]] || check_version "$target" || exit 2
  if [[ -n $from ]]; then
    [[ $from == /* ]] || from=$PWD/$from
    [[ -f $from ]] || usage_error "--from : $from n'existe pas."
  fi
  open_station update "${opts[--dir]:-}"
  [[ -f $dir/VERSION ]] ||
    die "La station de $dir n'a pas de fichier VERSION : elle n'a pas été installée par station install." \
      "La mettre à jour à la main : voir docs/deploiement.md, « Mettre à jour »."
  update_blocked
  installed=$(env_value BUTTON_VERSION)
  [[ -n $installed ]] ||
    die "BUTTON_VERSION manque dans $env_file." "Y remettre la version de la station, celle du fichier VERSION du dossier, puis relancer."
  docker_ok || die "Docker ne répond pas : la station ne se met pas à jour sans lui." "Voir pourquoi : systemctl status docker. Puis relancer."
  trap cleanup EXIT
  work=$(mktemp -d)
  if [[ -n $from ]]; then
    unpack "$from"
    packed=$(<"$work/files/VERSION")
    [[ $packed == main ]] || check_version "$packed" >/dev/null 2>&1 ||
      die "$from se dit de la version « $packed »." "Prendre station.tar.gz d'une version publiée."
    [[ -z $target || $target == "$packed" ]] ||
      die "$from est la version $packed, pas $target." "Prendre l'archive de la version $target, ou retirer --version."
    target=$packed
    update_compare quiet || return 0
  else
    if [[ -z $target ]]; then
      target=$(latest_version)
      check_version "$target" >/dev/null 2>&1 ||
        die "GitHub donne une version inattendue, « $target » : ne pas mettre à jour, et le signaler."
    fi
    update_compare quiet || return 0
    fetch_version "$target"
    unpack "$work/station.tar.gz"
    [[ $(<"$work/files/VERSION") == "$target" ]] ||
      die "L'archive de la version $target se dit $(<"$work/files/VERSION")." "Archive inattendue : ne pas mettre à jour, et le signaler."
    from=$work/station.tar.gz
  fi
  if update_handoff_needed; then
    for option in --yes --major --force; do
      [[ -z ${opts[$option]:-} ]] || forwarded+=("$option")
    done
    say "Mise à jour : la commande station de la version $target prend la main."
    STATION_SELF=$(self_command) STATION_UPDATE_HANDOFF=1 \
      bash "$work/files/station" update --from "$from" --dir "$dir" "${forwarded[@]}"
    return
  fi

  lock_station update
  update_blocked
  update_compare || return 0
  say "BUTTON : mise à jour de la station de $dir, de $installed à $target."
  update_major
  if [[ -n ${opts[--force]:-} ]]; then
    say "Fenêtre : pas vérifiée (--force). L'antenne se coupera, même pendant un direct."
  else
    update_window
  fi
  if interactive; then
    confirm update "Mettre la station à jour, de $installed à $target ? Une sauvegarde d'abord, puis l'antenne se coupe le temps de redémarrer. (o/n)"
  fi
  update_station
}

# Ce qui bloque toute mise à jour : HOLD, ou une restauration pas finie.
update_blocked() {
  if [[ -f $dir/HOLD ]]; then
    warn "les mises à jour sont bloquées, par $dir/HOLD :"
    sed 's/^/  /' "$dir/HOLD" >&2
    die "Rien n'est changé."
  fi
  [[ ! -f $dir/$JOURNAL ]] ||
    die "Une restauration ne s'est pas finie : $dir/$JOURNAL est encore là. Rien n'est changé." \
      "Voir quoi faire : station status. Puis relancer."
}

# a < b, deux versions X.Y.Z déjà vérifiées : en nombres, et 0.10.0 passe
# après 0.9.0.
version_below() { # a, b
  local IFS=. a b i
  read -r -a a <<<"$1"
  read -r -a b <<<"$2"
  for i in 0 1 2; do
    if ((10#${a[i]} != 10#${b[i]})); then
      ((10#${a[i]} < 10#${b[i]}))
      return
    fi
  done
  return 1
}

# La version visée, $target, face à celle de la station, $installed. Rien à
# faire : 1. Une version plus ancienne ne se prend pas, ni une version depuis
# main : sa base peut avoir un schéma plus récent. main ne se prend que depuis
# une archive, pour un essai.
update_compare() { # quiet, ou rien
  if [[ $target == "$installed" && $target != main ]]; then
    say "La station est déjà en $installed. Rien à faire."
    # Une mise à jour dont le retour arrière a échoué peut avoir déjà posé la
    # version.
    if [[ $(grep -v '^#' "$dir/updates.log" 2>/dev/null | tail -n 1 | cut -f3,4) == "$installed"$'\t'échouée ]]; then
      warn "la mise à jour vers $installed a échoué : voir station status. station rollback revient à la version d'avant ; station install répare celle-ci."
    fi
    return 1
  fi
  if [[ $installed == main ]]; then
    [[ $target == main ]] ||
      die "La station suit main, pour un essai : sa base peut avoir un schéma plus récent que celui de la version $target. Rien n'est changé." \
        "Repasser à une version publiée se fait à la main : voir docs/deploiement.md, « Revenir en arrière »."
    return 0
  fi
  check_version "$installed" >/dev/null 2>&1 ||
    die "BUTTON_VERSION vaut « $installed », dans $env_file : station update ne met à jour qu'une station épinglée sur une version X.Y.Z, comme l'installe station install." \
      "Y remettre la version de la station, celle du fichier VERSION du dossier, puis relancer."
  if [[ $target == main ]]; then
    [[ -n ${1:-} ]] ||
      warn "main n'est pas une version publiée : pour un essai, jamais à l'antenne. En revenir se fait à la main."
    return 0
  fi
  if version_below "$target" "$installed"; then
    die "La version $target est plus ancienne que celle de la station, $installed : station update ne fait que monter. Rien n'est changé." \
      "Revenir en arrière : voir docs/deploiement.md, « Revenir en arrière »."
  fi
}

# Une version majeure demande une action à la station avant de la prendre :
# station update la cite, d'après le CHANGELOG.md de la version visée, pour
# chaque majeure qu'elle passe, puis s'arrête. --major la prend, l'action
# faite. Les deux versions sont déjà vérifiées : des nombres.
update_major() {
  local from_major=${installed%%.*} to_major=${target%%.*} major action
  [[ $target != main && $installed != main ]] && ((to_major > from_major)) || return 0
  if [[ -n ${opts[--major]:-} ]]; then
    say "Version majeure : l'action que demandent ses notes est faite (--major)."
    return 0
  fi
  say "La version $target est une majeure : elle demande une action à la station avant de la prendre."
  for ((major = from_major + 1; major <= to_major; major++)); do
    action=$(major_action "$major.0.0" "$work/files/CHANGELOG.md")
    if [[ -n $action ]]; then
      say "La $major.0.0 demande :" "  ${action//$'\n'/$'\n'  }"
    else
      say "La $major.0.0 : voir ses notes, https://github.com/$REPO/releases/tag/v$major.0.0"
    fi
  done
  die "" "Rien n'est changé. Une fois l'action faite : $(self_command) update --major."
}

# Le paragraphe « Mise en service » d'une version dans un CHANGELOG.md, en
# texte : sans gras, et ses liens en adresses complètes, à cette version.
major_action() { # version, CHANGELOG.md
  [[ -f $2 ]] || return 0
  awk -v version="$1" '
    /^ *(```|~~~)/ { fenced = !fenced }
    !fenced && /^## / { split(substr($0, 4), words, " "); inside = (words[1] == version); found = 0; next }
    inside && !found && /^\*\*Mise en service\.\*\*/ { found = 1; sub(/^\*\*Mise en service\.\*\* */, "") }
    found && /^ *$/ { exit }
    found { print }
  ' "$2" | sed -E -e 's/\*\*//g' -e 's#\]\((https?://[^)]*)\)# (\1)#g' \
    -e "s#\\]\\(([^)]*)\\)# (https://github.com/$REPO/blob/v$1/\\1)#g" -e 's/\[//g'
}

# La fenêtre de la mise à jour, que dit le moteur qui tourne : ni direct ni
# diffusion de l'Agenda à l'antenne, ni d'ici 30 minutes. Un moteur d'avant
# radiotomate maintenance window, ou qui ne répond pas, la laisse inconnue :
# la mise à jour se fait, et le dit.
update_window() { # quiet, ou rien
  local answer status=0
  if ! station_running radiotomate-interface; then
    [[ -n ${1:-} ]] || say "Fenêtre : pas vérifiée, le moteur ne tourne pas : l'antenne est déjà coupée."
    return 0
  fi
  answer=$(compose exec -T radiotomate-interface radiotomate maintenance window </dev/null 2>/dev/null) || status=$?
  if [[ $status == 1 && $answer == "occupée : "* ]]; then
    # Vu une fois la sauvegarde faite et les images tirées : la mise à jour
    # s'arrête là, et updates.log le note.
    if ((${#updating[@]})); then
      update_log arrêtée "${answer#occupée : }"
      updating=()
      die "Pas de mise à jour maintenant : ${answer#occupée : }. L'antenne se couperait pendant. La station reste en $installed, avec la sauvegarde d'avant${env_added:+, et ce que .env a reçu :$env_added}." \
        "Relancer plus tard, ou mettre à jour quand même : $(self_command) update --force."
    fi
    die "Pas de mise à jour maintenant : ${answer#occupée : }. L'antenne se couperait pendant. Rien n'est changé." \
      "Relancer plus tard, ou mettre à jour quand même : $(self_command) update --force."
  elif [[ $status == 0 && $answer == "libre : "* ]]; then
    [[ -n ${1:-} ]] || say "Fenêtre : libre, ${answer#libre : }."
  elif [[ -z ${1:-} ]]; then
    warn "la fenêtre n'est pas vérifiée : le moteur ne la dit pas, il ne répond pas, ou sa version n'a pas radiotomate maintenance window. Vérifier qu'aucun direct ne commence bientôt."
  fi
}

# La commande à citer dans un message : station, celle de la station, ou le
# script lancé, comme bash station pour la première mise à jour d'une 0.2.0,
# dont la commande n'a pas update. Une commande qui passe la main dit la sienne.
self_command() {
  local script=${BASH_SOURCE[0]:-}
  if [[ -n ${STATION_SELF:-} ]]; then
    printf '%s\n' "$STATION_SELF"
  elif [[ -n $script && $(readlink -f "$script" 2>/dev/null) == "$(readlink -f "$dir/station" 2>/dev/null)" ]]; then
    echo station
  else
    printf 'bash %s\n' "${script:-station}"
  fi
}

# La mise à jour se fait par la commande station de la version visée : elle
# seule sait ce que sa version demande, à .env par exemple. Une autre lui
# passe la main, avec ses options et l'archive vérifiée. Vrai si elle doit la
# passer : son propre script n'est pas celui de l'archive.
update_handoff_needed() {
  local script=${BASH_SOURCE[0]:-}
  [[ -z ${STATION_UPDATE_HANDOFF:-} ]] || return 1
  [[ -n $script && -f $script ]] || return 0
  ! cmp -s "$script" "$work/files/station"
}

# La mise à jour, une fois tout vérifié : la sauvegarde, .env, les images,
# tirées pendant que l'antenne joue, les fichiers, le redémarrage, puis le
# contrôle. updates.log la note, faite, ou échouée, par cleanup, qui la défait
# une fois ses fichiers touchés (update_undo).
update_station() {
  local archive="" kept="" env_added="" env_left_out="" profiles=() mounting=()
  local started cut failure=""
  # Les fichiers de la version, à part : backup_station prend work.
  staged=$work
  work=""
  update_started=$(date +%s)
  previous=""
  replaced=()
  added=()
  files_stamp=""
  others=()
  updating=("$dir" "$installed" "$target" "")
  update_stage="la sauvegarde"
  if previous_files "$installed"; then
    previous=$staged/avant/files
  elif [[ $installed != main ]]; then
    warn "les fichiers de la version $installed ne se téléchargent pas : chaque fichier que la mise à jour remplace sera gardé à côté."
  fi
  backup_target
  # Le script de sauvegarde de la version visée, qui tourne dans l'image
  # d'avant : celui d'une 0.2.0 demande sqlite3, que l'image n'a pas.
  backup_station "$archive" "" "$staged/files/scripts/backup-radiotomate.sh"
  updating[3]=$archive
  backup_rotate "$archive"

  update_stage="les images"
  update_env
  update_pull
  [[ -n ${opts[--force]:-} ]] || update_window quiet

  update_stage="les fichiers"
  update_files
  env_set BUTTON_VERSION "$target" update
  make_data_dirs
  link_command
  env_isolate
  mounted_by_containers

  update_stage="le redémarrage"
  say "Mise à jour : la station repart en $target. L'antenne se coupe le temps du redémarrage."
  started=$SECONDS
  restart_station "$target" || die "$failure"

  update_stage="le contrôle"
  check_station "$target" || die "$failure"
  # Faite : rien de ce qui suit ne la défait.
  cut=$((SECONDS - started))
  update_log faite "redémarrée et contrôlée en $cut s"
  updating=()
  update_stage=""
  record_versions

  say "" "La station est à jour : $target, au lieu de $installed. Le contrôle passe."
  say "  Redémarrée et contrôlée en $cut s, coupure de l'antenne comprise."
  say "  La sauvegarde d'avant : $archive."
  [[ -z $env_added ]] || say "  Ajouté à .env :$env_added."
  [[ -z $env_left_out ]] ||
    say "  Retirés de .env, et que la version d'avant connaissait : ils n'y reviennent pas :$env_left_out."
  [[ -z $kept ]] ||
    say "  Changés sur cette station, gardés à côté, en .local-… :$kept. Les changements d'une station vont dans compose.override.yml."
}

# Redémarre la station sur ses fichiers et la version de .env, après une mise
# à jour ou un retour arrière : les trois services du moteur ensemble, puis le
# reste, puis les services d'un autre profil qui tournaient (others), puis
# ceux qu'up ne recrée pas et qui montent un fichier changé (mounting). Ne
# s'arrête pas sur un échec : failure dit ce qui ne repart pas.
restart_station() { # version
  if ! compose up -d --force-recreate "${ENGINE_SERVICES[@]}"; then
    failure="Le moteur ne repart pas en $1 : voir le message de docker compose plus haut."
    return 1
  fi
  if ! compose up -d; then
    failure="La station ne repart pas en $1 : voir le message de docker compose plus haut."
    return 1
  fi
  if ((${#others[@]})) && ! compose "${profiles[@]}" up -d "${others[@]}"; then
    failure="Les services lancés à part ne repartent pas en $1 : voir le message de docker compose plus haut."
    return 1
  fi
  if ! remount; then
    failure="Les services qui montent un fichier changé de la version ne repartent pas : voir le message de docker compose plus haut."
    return 1
  fi
}

# Le contrôle, après une mise à jour ou un retour arrière : l'adresse de la
# station en HTTPS, si Caddy la sert, puis smoke.sh. Ne s'arrête pas sur un
# échec : failure dit ce qui ne va pas.
check_station() { # version
  local tls domain
  tls=$(env_value CADDY_TLS acme)
  domain=$(env_value DOMAIN)
  if [[ -n $domain && ,$(env_value COMPOSE_PROFILES), == *,vps,* ]] && ! https_ok; then
    failure="https://$domain ne répond pas au bout de $HTTPS_WAIT s, en $1. Voir pourquoi : cd $dir && docker compose logs caddy."
    return 1
  fi
  if ! smoke_ok; then
    failure="Le contrôle de la station a échoué en $1 : voir plus haut."
    return 1
  fi
}

# Une mise à jour qui n'aboutit pas, une fois ses fichiers touchés : cleanup
# l'appelle, et la station revient seule à la version d'avant. Si la station a
# redémarré, la base d'avant la mise à jour doit-elle revenir, et le peut-elle ?
# Cela se voit avant de rien défaire : sinon, la station reste à la version
# nouvelle, qui tourne peut-être encore. Puis ses fichiers, tels qu'ils étaient,
# et sa version dans .env. Si la station a redémarré : les services venus avec
# la mise à jour s'en vont, la base d'avant revient si le schéma a migré, car
# la version d'avant ne lit pas un schéma plus récent, et les images d'avant
# repartent, pour tous les services. Puis le contrôle. Quoi qu'il arrive, une
# ligne dans updates.log, HOLD, qui bloque les mises à jour suivantes, et
# l'alerte. Rien ne l'arrête en route : elle ne fait que dire ses échecs.
update_undo() {
  local dir=${updating[0]} env_file=${updating[0]}/.env installed=${updating[1]} target=${updating[2]}
  local stage=$update_stage failure="" base="" logs="" copy="" copy_schema="" reverted="" stopped="" state
  local profiles=() mounting=()
  warn "la mise à jour s'annule : la station revient en $installed."
  [[ -n $work && -d $work ]] || work=$(mktemp -d)
  if [[ $stage != "les fichiers" ]]; then
    ! keep_failed_logs || logs=$dir/$FAILED_LOGS
    all_profiles
    undo_database_check
  fi
  if [[ -z $failure ]]; then
    if ! undo_files; then
      failure="Des fichiers de la version $installed ne reviennent pas : voir plus haut."
    elif ! env_set BUTTON_VERSION "$installed" update; then
      failure="BUTTON_VERSION ne revient pas à $installed, dans $env_file."
    else
      reverted=1
    fi
    env_isolate
  fi
  if [[ -n $reverted && $stage != "les fichiers" ]]; then
    drop_new_services
    mounted_by_containers
    if [[ -z $copy ]] || undo_database_restore "$staged/files/scripts/restore-radiotomate.sh"; then
      say "Retour arrière : la station repart en $installed."
      restart_station "$installed" && check_station "$installed" && record_versions
    fi
  fi
  if [[ -z $failure ]]; then
    update_log annulée "pendant $stage ; revenue en $installed${base:+, $base}"
    hold_write "Bloquées par station update" \
      "la mise à jour de $installed à $target a échoué pendant $stage, et la station est revenue en $installed${logs:+. Les journaux de la $target : $logs}."
    station_alert "Mise à jour annulée" \
      "la mise à jour de $installed à $target a échoué pendant $stage : la station est revenue en $installed, et HOLD bloque les suivantes."
    if [[ $stage == "les fichiers" ]]; then
      say "" "La station tourne toujours en $installed, qui n'a pas redémarré : ses fichiers sont revenus. La mise à jour vers $target est annulée."
    else
      say "" "La station est revenue en $installed : le contrôle passe. La mise à jour vers $target est annulée."
    fi
    [[ -z $base ]] || say "  ${base^} ; la base de la $target reste à côté, dans $(env_path RT_DATA ./data/radiotomate)/backups."
    [[ -z $logs ]] || say "  Les journaux de la $target, pour voir pourquoi : $logs."
    say "  Les mises à jour sont bloquées par $dir/HOLD. Les débloquer, une fois la cause trouvée : $(self_command) unhold."
  else
    update_log échouée "pendant $stage ; le retour en $installed a échoué : $failure"
    hold_write "Bloquées par station update" \
      "la mise à jour de $installed à $target a échoué pendant $stage, et le retour en $installed aussi : $failure"
    station_alert "Mise à jour ratée, station à réparer" \
      "la mise à jour de $installed à $target a échoué pendant $stage, et le retour en $installed aussi : $failure"
    if [[ -n $stopped ]]; then
      state="La station est arrêtée."
    elif [[ -z $reverted ]]; then
      state="La station reste en $target, comme la mise à jour l'a laissée : elle tourne peut-être encore."
    else
      state="La station est peut-être coupée."
    fi
    warn "le retour en $installed a échoué : $failure"
    printf '%s\n' "  $state Voir son état : $(self_command) status${logs:+ ; les journaux de la $target : $logs}." \
      "  Une fois la cause réglée, $(self_command) rollback refait le retour en $installed." \
      "  La sauvegarde d'avant la mise à jour : ${updating[3]:--}." >&2
  fi
}

# Les fichiers d'avant la mise à jour reprennent leur place, chacun par un
# renommage, comme update_files les a posés : la copie .local-… qu'elle a
# gardée d'un fichier que la station avait changé, sinon celui de la version
# d'avant. Un fichier qui n'était pas là s'en va. Ce que la mise à jour n'a
# pas fini de poser, une copie partielle, ou la copie .local-… d'un fichier
# resté tel quel, s'en va aussi.
undo_files() {
  local file path mode left=""
  for file in "${replaced[@]}"; do
    if [[ " ${added[*]} " == *" $file "* ]]; then
      rm -f "$dir/$file" || left="$left $file"
    elif [[ -n $files_stamp && -e $dir/$file.local-$files_stamp ]]; then
      mv -f "$dir/$file.local-$files_stamp" "$dir/$file" || left="$left $file"
    elif [[ -n $previous && -f $previous/$file ]]; then
      mode=$(stat -c %a "$previous/$file")
      { install -D -m "$mode" "$previous/$file" "$dir/$file.station-$$" &&
        mv -f "$dir/$file.station-$$" "$dir/$file"; } || left="$left $file"
    else
      left="$left $file"
    fi
  done
  while IFS= read -r path; do
    file=${path#"$staged/files/"}
    rm -f "$dir/$file.station-$$"
    if [[ -n $files_stamp && -e $dir/$file.local-$files_stamp ]] && cmp -s "$dir/$file" "$dir/$file.local-$files_stamp"; then
      rm -f "$dir/$file.local-$files_stamp"
    fi
  done < <(find "$staged/files" -type f)
  [[ -n $left ]] || return 0
  warn "ces fichiers ne reviennent pas à la version $installed :$left."
  return 1
}

# Les journaux des conteneurs depuis le début de la mise à jour, dans
# FAILED_LOGS, en 600 : le retour arrière recrée les conteneurs, et les leurs
# partent avec eux.
keep_failed_logs() {
  local file=$dir/$FAILED_LOGS profiles=()
  all_profiles
  install -m 600 /dev/null "$file.part" 2>/dev/null || return 1
  compose "${profiles[@]}" logs --no-color --timestamps --since "$(date -u -d "@$update_started" +%Y-%m-%dT%H:%M:%SZ)" \
    >"$file.part" 2>&1 || true
  mv -f "$file.part" "$file"
}

# Avant de rien défaire : la base d'avant la mise à jour doit-elle revenir, et
# le peut-elle ? copy nomme la copie à remettre, si le schéma a migré depuis
# le début de la mise à jour : celle que la migration a faite. Une copie
# abîmée, ou la place qui manque à côté de la base pour l'y remettre, l'en
# empêchent : failure le dit. Un contrôle qui ne se fait pas n'empêche rien :
# le script de restauration vérifie encore la copie.
undo_database_check() {
  local found checks current saved integrity data need
  found=$(db_copy_since "$update_started")
  [[ -n $found ]] || return 0
  saved=$(copy_schema "$found")
  checks=$(engine_copy_check "$found") || checks=""
  current=$(sed -n 1p <<<"$checks")
  integrity=$(sed -n 2p <<<"$checks")
  # La première migration a échoué, sans rien laisser : la base n'a pas bougé.
  if [[ $current =~ ^[0-9]+$ ]] && ((current <= saved)); then
    say "Retour arrière : la base est restée au schéma v$current, que la version $installed lit."
    return 0
  fi
  if [[ -n $integrity && $integrity != ok ]]; then
    failure="La copie de la base d'avant la mise à jour, $found, est abîmée : $integrity. La base ne peut pas revenir."
    return 1
  fi
  data=$(env_path RT_DATA ./data/radiotomate)
  need=$(($(size_kb "$data/backups/$found") + COPY_MARGIN_KB))
  if ! room_for "$data" "$need"; then
    failure="Il manque de la place à côté de la base pour y remettre celle d'avant la mise à jour, $(human_kb "$need") : la base ne peut pas revenir. Libérer de la place."
    return 1
  fi
  copy=$found
  copy_schema=$saved
}

# La base d'avant la mise à jour remise, la station arrêtée, tous ses profils :
# rien ne garde la base ouverte. Le script de restauration est celui de la
# version nouvelle, qui tourne dans l'image d'avant, les fichiers d'avant
# posés : celui d'une 0.2.0 demande sqlite3, que l'image n'a pas.
undo_database_restore() { # script de restauration
  if ! compose "${profiles[@]}" stop >/dev/null 2>&1; then
    failure="La station ne s'arrête pas : la base d'avant la mise à jour ne se remet pas sans cela."
    return 1
  fi
  stopped=1
  if ! engine_restore_copy "$copy" "$1"; then
    failure="La base d'avant la mise à jour, $copy, ne se remet pas : voir le message plus haut."
    return 1
  fi
  base="avec la base d'avant la mise à jour : ce qui s'est écrit depuis le $(station_date "$(copy_time "$copy")") est perdu"
  say "Retour arrière : la base d'avant la mise à jour, au schéma v${copy_schema:-inconnu}, est remise."
}

# Les conteneurs d'un service que la version d'avant n'a pas, venus avec la
# mise à jour : ils s'arrêtent et s'en vont, leurs volumes restent. Sans la
# liste des services de la version d'avant, rien ne s'en va.
drop_new_services() {
  local known ids=() id service gone=""
  known=$(compose "${profiles[@]}" config --services 2>/dev/null) || return 0
  [[ -n $known ]] || return 0
  known=" $(tr '\n' ' ' <<<"$known") "
  mapfile -t ids < <(docker ps -aq --no-trunc --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.oneoff=False 2>/dev/null)
  ((${#ids[@]})) || return 0
  while IFS='|' read -r id service; do
    [[ -z $service || $known == *" $service "* ]] && continue
    ! docker rm -f "$id" >/dev/null 2>&1 || gone="$gone $service"
  done < <(docker inspect --format '{{.Id}}|{{index .Config.Labels "com.docker.compose.service"}}' "${ids[@]}" 2>/dev/null)
  [[ -z $gone ]] || say "Retour arrière : retirés, venus avec la mise à jour :$gone."
}

# La copie de la base qu'une migration a faite depuis cette heure, dans
# RT_DATA/backups : la plus ancienne, celle d'avant la première migration.
# Son nom dit son heure, en UTC. Rien, s'il n'y en a pas.
db_copy_since() { # secondes depuis 1970
  local since path name stamp best=""
  since=$(date -u -d "@$1" +%Y%m%dT%H%M%SZ)
  for path in "$(env_path RT_DATA ./data/radiotomate)"/backups/avant-v*-*.db; do
    name=${path##*/}
    [[ $name =~ ^avant-v[0-9]+-([0-9]{8}T[0-9]{6}Z)\.db$ ]] || continue
    stamp=${BASH_REMATCH[1]}
    [[ ! $stamp < $since ]] || continue
    [[ -n $best && ! $stamp < ${best%% *} ]] || best="$stamp $name"
  done
  printf '%s\n' "${best#* }"
}

# Le schéma d'une copie de la base, d'après son nom : avant-v19-… est la base
# d'avant la migration v19, au schéma v18. db_copy_since a vérifié le nom.
copy_schema() { # avant-vNN-AAAAMMJJTHHMMSSZ.db
  local number=${1#avant-v}
  number=${number%%-*}
  printf '%s\n' "$((10#$number - 1))"
}

# L'heure d'une copie de la base, en secondes depuis 1970, d'après son nom.
copy_time() { # avant-vNN-AAAAMMJJTHHMMSSZ.db
  local stamp=${1##*-}
  stamp=${stamp%Z.db}
  date -u -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s
}

# Une alerte aux personnes de la station : une mise à jour annulée, un retour
# arrière. Elle part, pour l'instant, dans le journal du système :
# journalctl -t button. SUR-01 l'enverra aussi, d'ici, sur un téléphone et
# par e-mail. Une alerte qui ne part pas n'arrête rien.
station_alert() { # sujet, message
  logger -t button -p user.warning -- "$1 : $2" >/dev/null 2>&1 || true
}

# Les fichiers d'une version publiée, celle que la station quitte, dans
# $staged/avant/files : de quoi reconnaître ce que la station a changé
# elle-même, et ce qu'un retour arrière remet.
previous_files() { # version
  local base="https://github.com/$REPO/releases/download/v$1" name expected
  check_version "$1" >/dev/null 2>&1 || return 1
  mkdir -p "$staged/avant/files"
  for name in station.tar.gz SHA256SUMS; do
    curl --disable -fsSL --retry 3 --max-time 120 -o "$staged/avant/$name" "$base/$name" 2>/dev/null || return 1
  done
  expected=$(awk '$2 == "station.tar.gz" { print $1 }' "$staged/avant/SHA256SUMS")
  [[ -n $expected && $(sha256sum "$staged/avant/station.tar.gz" | cut -d' ' -f1) == "$expected" ]] || return 1
  tar -xzf "$staged/avant/station.tar.gz" -C "$staged/avant/files" 2>/dev/null
}

# Les KEEP_BACKUPS dernières archives de backups/ restent, les plus anciennes
# s'effacent : celles de station backup aussi, quand elle écrit là. Leur nom
# dit leur heure, en UTC : l'ordre des noms est celui des heures. Celle qui
# vient de s'écrire reste, même quand une horloge en avance en a fait de plus
# récentes.
backup_rotate() { # l'archive qui vient de s'écrire
  local expired=()
  mapfile -t expired < <(find "$dir/backups" -maxdepth 1 -type f -name 'button-*.tar' ! -path "$1" | sort -r |
    tail -n "+$KEEP_BACKUPS")
  ((${#expired[@]})) || return 0
  rm -f -- "${expired[@]}"
  say "Sauvegardes : les $KEEP_BACKUPS dernières restent dans $dir/backups ; ${#expired[@]} plus ancienne(s) effacée(s)."
}

# .env : ce que la version visée y demande en plus, avec sa valeur par défaut,
# par le write_env de la version, avant de tirer ses images : son compose.yml
# peut en avoir besoin. Le nouveau seulement (env_add) : sans les fichiers de
# la version d'avant, rien que les secrets qui manquent. Rien de posé ne
# change ; la version, BUTTON_VERSION, change avec les fichiers.
update_env() {
  local version=$target first="" domain email timezone admin updates tls env_by=update
  local env_new_only=1 env_known=""
  [[ -z $previous || ! -f $previous/.env.example ]] || env_known=$previous/.env.example
  domain=$(env_value DOMAIN)
  email=$(env_value ACME_EMAIL)
  timezone=$(env_value TZ Europe/Paris)
  admin=$(env_value RT_ADMIN_USER admin)
  updates=$(env_value BUTTON_UPDATES auto)
  tls=$(env_value CADDY_TLS acme)
  write_env
}

# Les images de la version, tirées pendant que l'antenne joue encore : avec
# le compose.yml de la version, le compose.override.yml de la station et son
# .env, à la version près. Aussi celles des services d'un autre profil qui
# tournent, comme share lancé à part : ils repartiront avec la station.
update_pull() {
  local files=(-f "$staged/files/compose.yml") unchanged
  local again="Images privées : docker login ghcr.io, avec un jeton GitHub qui a read:packages. Sinon, vérifier l'accès de la machine à ghcr.io. Puis relancer."
  unchanged="La station tourne toujours en $installed${env_added:+, mais .env a reçu :$env_added}."
  [[ ! -f $dir/compose.override.yml ]] || files+=(-f "$dir/compose.override.yml")
  all_profiles
  others_running ||
    die "docker compose ne lit pas la station : $failure $unchanged" \
      "Voir pourquoi : cd $dir && docker compose config. Puis relancer."
  say "Mise à jour : les images de la version $target, pendant que l'antenne joue."
  (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" pull) ||
    die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. $unchanged" "$again"
  if ((${#others[@]})); then
    (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" "${profiles[@]}" pull "${others[@]}") ||
      die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. $unchanged" "$again"
  fi
}

# Les fichiers de la version remplacent ceux du dossier, chacun par un
# renommage : bash lit encore, sans le relire en entier, le script qui l'a
# lancé. Un fichier que la station a changé elle-même, autre que celui de la
# version qu'elle quitte, est gardé à côté, en .local-…, comme le fait
# install. Sans les fichiers de cette version, chaque fichier remplacé l'est.
# Ce qui est remplacé se note dans replaced, et dans added ce qui n'était pas
# là : de quoi les remettre (undo_files).
update_files() {
  local file mode
  files_stamp=$(date +%Y%m%d-%H%M%S)
  while IFS= read -r file; do
    file=${file#"$staged/files/"}
    mode=$(stat -c %a "$staged/files/$file")
    if [[ -e $dir/$file ]] && cmp -s "$staged/files/$file" "$dir/$file"; then
      chmod "$mode" "$dir/$file"
      continue
    fi
    if [[ -e $dir/$file ]] && { [[ -z $previous ]] || ! cmp -s "$dir/$file" "$previous/$file"; }; then
      cp -p "$dir/$file" "$dir/$file.local-$files_stamp"
      kept="$kept $file"
    fi
    [[ -e $dir/$file ]] || added+=("$file")
    install -D -m "$mode" "$staged/files/$file" "$dir/$file.station-$$"
    mv -f "$dir/$file.station-$$" "$dir/$file"
    replaced+=("$file")
  done < <(find "$staged/files" -type f | sort)
}

# Les services d'un autre profil qui tournent, comme share lancé à part, dans
# others : ils repartent avec la station. Avec les profils de l'appelant,
# tous (all_profiles). Si docker compose ne lit pas la station, failure dit
# pourquoi.
others_running() {
  local running active service
  running=$(compose "${profiles[@]}" ps --services --status running 2>/dev/null) || running=""
  if ! active=$(compose config --services 2>&1); then
    failure=$(head -n 1 <<<"$active")
    return 1
  fi
  active=" $(tr '\n' ' ' <<<"$active") "
  others=()
  while IFS= read -r service; do
    [[ -z $service || $active == *" $service "* ]] || others+=("$service")
  done <<<"$running"
}

# Les conteneurs qui tournent et montent un fichier que la version vient de
# remplacer, dans mounting, « id|service » : un fichier monté seul reste
# l'ancien dans le conteneur, jusqu'à sa recréation.
mounted_by_containers() {
  local ids=() id service mounts file real
  ((${#replaced[@]})) || return 0
  real=$(real_path "$dir")
  mapfile -t ids < <(docker ps -q --no-trunc --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.oneoff=False 2>/dev/null)
  ((${#ids[@]})) || return 0
  while IFS='|' read -r id service mounts; do
    for file in "${replaced[@]}"; do
      if [[ " $mounts " == *" $dir/$file "* || " $mounts " == *" $real/$file "* ]]; then
        mounting+=("$id|$service")
        break
      fi
    done
  done < <(docker inspect --format '{{.Id}}|{{index .Config.Labels "com.docker.compose.service"}}|{{range .Mounts}}{{.Source}} {{end}}' \
    "${ids[@]}" 2>/dev/null)
}

# Ceux que up n'a pas recréés, d'une image épinglée comme Caddy ou rclone :
# recréés à leur tour, sans leurs dépendances, avec le fichier de la version.
# Sinon, un Caddyfile changé ne servirait qu'au démarrage suivant.
remount() {
  local running entry service stale=" "
  ((${#mounting[@]})) || return 0
  running=" $(docker ps -q --no-trunc --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null | tr '\n' ' ') "
  for entry in "${mounting[@]}"; do
    service=${entry#*|}
    [[ $running != *" ${entry%%|*} "* || $stale == *" $service "* ]] || stale="$stale$service "
  done
  [[ -n ${stale// /} ]] || return 0
  say "Mise à jour : recréés avec les fichiers de la version :${stale% }."
  # Les noms viennent du relevé : un mot chacun.
  # shellcheck disable=SC2086
  compose "${profiles[@]}" up -d --force-recreate --no-deps $stale
}

# Une ligne de updates.log, dans le dossier de la station : l'heure de son
# début, la version d'avant, la nouvelle, le résultat, la sauvegarde d'avant,
# et ce qu'il faut en savoir. status dit la dernière. Le résultat d'une mise à
# jour : faite, arrêtée, annulée, quand elle est revenue seule à la version
# d'avant, ou échouée ; celui de station rollback : retour arrière, ou retour
# arrière échoué. rollback y cherche la mise à jour à défaire, et la copie de
# la base faite depuis son début.
update_log() { # résultat, détail
  local log=${updating[0]}/updates.log
  if [[ ! -f $log ]]; then
    printf '%s\n' "# Les mises à jour de station update, et les retours arrière, une par ligne : l'heure de son début, en secondes depuis 1970, la version d'avant, la nouvelle, le résultat, la sauvegarde d'avant, et ce qu'il faut en savoir." \
      >"$log"
  fi
  # Un champ vide se lirait mal : read fond deux tabulations qui se suivent.
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${update_started:-$(date +%s)}" "${updating[1]}" "${updating[2]}" "$1" \
    "${updating[3]:--}" "$2" >>"$log"
}

# La version de chaque service qui tourne, d'après Docker, dans versions.json,
# dans RT_DATA : l'interface n'a pas accès à Docker, et GET
# /system/version.json la lit là. Le fichier ne change qu'avec les versions :
# son heure dit depuis quand elles tournent, et une relance d'install ne
# change rien. Un échec ne fait qu'avertir.
record_versions() {
  local data file ids=() service image label version items=() body
  data=$(env_path RT_DATA ./data/radiotomate)
  [[ -d $data ]] || return 0
  mapfile -t ids < <(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.oneoff=False 2>/dev/null)
  if ((${#ids[@]})); then
    while IFS='|' read -r service image label; do
      [[ $service =~ ^[a-z0-9][a-z0-9_.-]*$ ]] || continue
      [[ $image =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || image=""
      [[ $label =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || label=""
      items+=("{\"service\":\"$service\",\"image\":\"$image\",\"version\":\"$label\"}")
    done < <(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}|{{.Config.Image}}|{{index .Config.Labels "org.opencontainers.image.version"}}' \
      "${ids[@]}" 2>/dev/null | sort -u)
  fi
  version=$(env_value BUTTON_VERSION)
  [[ $version =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || version=""
  body="\"version\":\"$version\",\"services\":[$(
    IFS=,
    printf '%s' "${items[*]}"
  )]"
  file=$data/versions.json
  if [[ -f $file ]] && grep -qF -- "$body" "$file"; then
    return 0
  fi
  if ! { printf '{"recorded_at":"%s",%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$body" >"$file.part" &&
    chmod 644 "$file.part" && mv -f "$file.part" "$file"; } 2>/dev/null; then
    rm -f "$file.part"
    warn "la version des services ne s'écrit pas dans $file : la console ne la dira pas."
  fi
}

# --- rollback ---

cmd_rollback() {
  local dir="" env_file="" assume_yes="" aborted="Rien n'est changé." installed target="" leaving="" undone="" from="" packed
  local -A opts=()
  local args=()
  parse_options "--yes -h --help" "--dir --from" "$@"
  if help_asked; then
    usage_command rollback
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  assume_yes=${opts[--yes]:-}
  from=${opts[--from]:-}
  if [[ -n $from ]]; then
    [[ $from == /* ]] || from=$PWD/$from
    [[ -f $from ]] || usage_error "--from : $from n'existe pas."
  fi
  open_station rollback "${opts[--dir]:-}"
  [[ -f $dir/VERSION ]] ||
    die "La station de $dir n'a pas de fichier VERSION : elle n'a pas été installée par station install." \
      "Revenir en arrière à la main : voir docs/deploiement.md, « Revenir en arrière »."
  [[ ! -f $dir/$JOURNAL ]] ||
    die "Une restauration ne s'est pas finie : $dir/$JOURNAL est encore là. Rien n'est changé." \
      "Voir quoi faire : station status. Puis relancer."
  lock_station rollback
  installed=$(env_value BUTTON_VERSION)
  rollback_target || return 0
  docker_ok || die "Docker ne répond pas : la station ne revient pas en arrière sans lui." "Voir pourquoi : systemctl status docker. Puis relancer."
  confirm_possible rollback
  trap cleanup EXIT
  work=$(mktemp -d)
  if [[ -n $from ]]; then
    unpack "$from"
    packed=$(<"$work/files/VERSION")
    [[ $packed == "$target" ]] ||
      die "$from est la version $packed, et la version d'avant la dernière mise à jour la $target. Rien n'est changé." \
        "Prendre l'archive de la version $target."
  else
    check_version "$target" >/dev/null 2>&1 ||
      die "La version d'avant la dernière mise à jour, $target, n'est pas une version publiée : ses fichiers ne se téléchargent pas. Rien n'est changé." \
        "Donner son archive : station rollback --from station.tar.gz."
    fetch_version "$target" "Rien n'est changé. Vérifier l'accès de la machine à github.com, puis relancer ; ou donner l'archive de la version $target : station rollback --from station.tar.gz."
    unpack "$work/station.tar.gz"
    [[ $(<"$work/files/VERSION") == "$target" ]] ||
      die "L'archive de la version $target se dit $(<"$work/files/VERSION")." "Archive inattendue : ne pas l'utiliser, et le signaler."
  fi
  rollback_station
}

# La mise à jour à défaire, d'après updates.log : la dernière encore en place.
# Les lignes lues depuis la fin passent celles qui n'ont rien laissé : une
# mise à jour arrêtée, annulée, ou échouée avant ses fichiers, et un retour
# arrière raté, qui se reprend. Une mise à jour faite, ou échouée une fois ses
# fichiers touchés, se défait ; un retour arrière réussi l'a déjà défaite. Sa
# version d'avant dans target, celle qu'elle a posée dans leaving, l'heure de
# son début dans undone. Sinon, dit qu'il n'y a rien à défaire, et rend 1.
rollback_target() {
  local line made from to result _backup detail found=""
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS=$'\t' read -r made from to result _backup detail <<<"$line" || true
    case $result in
      "retour arrière")
        say "Rien à défaire : la dernière mise à jour, de $to à $from, est déjà défaite."
        return 1
        ;;
      "retour arrière échoué" | arrêtée | annulée) ;;
      échouée)
        case $detail in
          "pendant la sauvegarde"* | "pendant les images"*) ;;
          *)
            found=1
            break
            ;;
        esac
        ;;
      faite)
        found=1
        break
        ;;
      *)
        die "$dir/updates.log a une ligne au résultat inattendu, « $result ». Rien n'est changé." \
          "Voir updates.log, et l'état de la station : station status."
        ;;
    esac
  done < <(grep -v '^#' "$dir/updates.log" 2>/dev/null | tac)
  if [[ -z $found ]]; then
    say "Rien à défaire : $dir/updates.log ne note aucune mise à jour en place."
    return 1
  fi
  [[ $made =~ ^[0-9]+$ ]] ||
    die "$dir/updates.log a une ligne sans heure : « $made ». Rien n'est changé." "Voir updates.log."
  [[ $from == main ]] || check_version "$from" >/dev/null 2>&1 ||
    die "$dir/updates.log nomme une version inattendue, « $from ». Rien n'est changé." "Voir updates.log."
  [[ $installed == "$to" || $installed == "$from" ]] ||
    die "La station est en ${installed:-une version inconnue}, et la dernière mise à jour allait de $from à $to : rollback ne sait pas d'où revenir. Rien n'est changé." \
      "Voir updates.log, et l'état de la station : station status."
  target=$from
  leaving=$to
  undone=$made
}

# Le retour arrière à la main, vers target, la version d'avant la dernière
# mise à jour, dont les fichiers sont dans $work/files. Comme update, sans
# sauvegarde ni fenêtre : la base d'avant la mise à jour revient si le schéma
# a migré depuis, une fois confirmé. Tout ce qui pourrait l'arrêter en route se
# vérifie avant : la copie de la base, le script qui la remet, la place, les
# images, et le schéma que lira la version d'avant. HOLD se pose avant de rien
# changer.
rollback_station() {
  local kept="" profiles=() mounting=() failure="" base="" copy schemas current saved integrity known after
  local lost="" script="" need question
  # Les fichiers de la version d'avant, à part, comme update.
  staged=$work
  work=$(mktemp -d)
  update_started=$(date +%s)
  previous=""
  replaced=()
  added=()
  files_stamp=""
  # Les fichiers de la version quittée : de quoi reconnaître ce que la station
  # a changé elle-même, et son script de restauration.
  if previous_files "$leaving"; then
    previous=$staged/avant/files
  fi
  all_profiles
  others_running ||
    die "docker compose ne lit pas la station : $failure Rien n'est changé." "Voir pourquoi : cd $dir && docker compose config. Puis relancer."
  # La base : la copie qu'en a faite la mise à jour, si son schéma a migré.
  copy=$(db_copy_since "$undone")
  if [[ -n $copy ]]; then
    saved=$(copy_schema "$copy")
    schemas=$(engine_copy_check "$copy") ||
      die "La version du schéma de la base ne se lit pas : voir le message plus haut. Rien n'est changé." "Voir l'état de la station : station status."
    current=$(sed -n 1p <<<"$schemas")
    integrity=$(sed -n 2p <<<"$schemas")
    [[ $current =~ ^[0-9]+$ ]] ||
      die "La version du schéma de la base en place ne se lit pas. Rien n'est changé." "Voir l'état de la station : station status."
    if ((current > saved)); then
      [[ $integrity == ok ]] ||
        die "La copie de la base d'avant la mise à jour, $copy, est abîmée : $integrity. Rien n'est changé." \
          "Revenir à la main, en redescendant le schéma : voir docs/deploiement.md, « Revenir en arrière »."
      lost=$(copy_time "$copy")
      script=$(restore_script) ||
        die "Aucun script de restauration à portée ne sait se passer de sqlite3, que l'image du moteur n'a pas : ni celui de la version $leaving, ni celui du dossier. Rien n'est changé." \
          "Prendre la commande de la version $leaving, sur https://github.com/$REPO/releases, puis relancer avec elle."
      need=$(($(size_kb "$(env_path RT_DATA ./data/radiotomate)/backups/$copy") + COPY_MARGIN_KB))
      room_for "$(env_path RT_DATA ./data/radiotomate)" "$need" ||
        die "Il manque de la place à côté de la base pour y remettre celle d'avant la mise à jour, $(human_kb "$need"). Rien n'est changé." \
          "Libérer de la place, puis relancer."
    fi
  fi
  rollback_images
  # La base que trouvera la version d'avant, la copie ou celle en place : elle
  # doit la lire.
  schemas=$(engine_target_schemas) ||
    die "Le moteur de la version $target ne dit pas jusqu'à quel schéma il lit : voir le message plus haut. Rien n'est changé." \
      "Voir l'état de la station : station status."
  current=$(sed -n 1p <<<"$schemas")
  known=$(sed -n 2p <<<"$schemas")
  [[ $current =~ ^[0-9]+$ && $known =~ ^[0-9]+$ ]] ||
    die "La version du schéma de la base ne se lit pas : « $current », « $known ». Rien n'est changé." "Voir l'état de la station : station status."
  after=$current
  [[ -z $lost ]] || after=$saved
  if ((after > known)); then
    if [[ -z $lost ]]; then
      die "La base est au schéma v$after, et la version $target ne lit que jusqu'au v$known : la copie de la base d'avant la mise à jour n'est plus dans $(env_path RT_DATA ./data/radiotomate)/backups. Rien n'est changé." \
        "Revenir à la main, en redescendant le schéma avec l'image de la $leaving : voir docs/deploiement.md, « Revenir en arrière »."
    fi
    die "La copie de la base d'avant la mise à jour, $copy, est au schéma v$after, et la version $target ne lit que jusqu'au v$known. Rien n'est changé." \
      "Revenir à la main : voir docs/deploiement.md, « Revenir en arrière »."
  fi
  question="Revenir de $leaving à $target ?"
  if [[ -n $lost ]]; then
    question="$question La base revient à celle d'avant la mise à jour, du $(station_date "$lost") : ce qui s'est écrit depuis, il y a $(since "$lost"), sera perdu, et la base d'aujourd'hui gardée à côté."
  fi
  confirm rollback "$question L'antenne se coupe le temps de redémarrer. (o/n)"

  # Dès lors, un échec se note, et les mises à jour restent bloquées.
  updating=("$dir" "$leaving" "$target" "-")
  update_stage="les fichiers"
  rolling_back=1
  if [[ ! -f $dir/HOLD ]]; then
    hold_write "Bloquées par station rollback" \
      "retour de $leaving à $target, à la main. La version $leaving ne se reprend qu'une fois HOLD retiré."
  fi
  say "Retour arrière : de $leaving à $target."
  update_files
  env_set BUTTON_VERSION "$target" rollback
  make_data_dirs
  link_command
  env_isolate
  drop_new_services
  mounted_by_containers

  update_stage="le redémarrage"
  if [[ -n $lost ]]; then
    say "Retour arrière : la station s'arrête, le temps de remettre la base d'avant la mise à jour."
    compose "${profiles[@]}" stop ||
      die "La station ne s'arrête pas : voir le message de docker compose plus haut. Elle est peut-être coupée."
    engine_restore_copy "$copy" "$script" ||
      die "La base d'avant la mise à jour, $copy, ne se remet pas : voir le message plus haut. La station est arrêtée."
    base="avec la base d'avant la mise à jour : ce qui s'est écrit depuis le $(station_date "$lost") est perdu"
  fi
  say "Retour arrière : la station repart en $target. L'antenne se coupe le temps du redémarrage."
  restart_station "$target" || die "$failure"
  update_stage="le contrôle"
  check_station "$target" || die "$failure"
  update_log "retour arrière" "à la main${base:+ ; $base}"
  updating=()
  update_stage=""
  rolling_back=""
  record_versions
  station_alert "Mise à jour défaite" \
    "station rollback a ramené la station de $leaving à $target, à la main : HOLD bloque les mises à jour suivantes."

  say "" "La station est revenue en $target, au lieu de $leaving : le contrôle passe."
  [[ -z $base ]] || say "  ${base^} ; la base de la $leaving reste à côté, dans $(env_path RT_DATA ./data/radiotomate)/backups."
  say "  Les mises à jour sont bloquées par $dir/HOLD. Les débloquer, une fois la cause trouvée : $(self_command) unhold."
  [[ -z $kept ]] ||
    say "  Changés sur cette station, gardés à côté, en .local-… :$kept. Les changements d'une station vont dans compose.override.yml."
}

# Le script de restauration d'un retour arrière à la main, copié à part : le
# premier qui sait se passer de sqlite3, que l'image du moteur n'a pas, parmi
# ceux de la version quittée, du dossier, et de la version d'avant. Celui d'une
# 0.2.0 ne le sait pas ; à la reprise d'un retour raté, le dossier porte déjà
# les fichiers d'avant.
restore_script() {
  local candidate
  for candidate in "$staged/avant/files/scripts/restore-radiotomate.sh" "$dir/scripts/restore-radiotomate.sh" \
    "$staged/files/scripts/restore-radiotomate.sh"; do
    if [[ -f $candidate ]] && grep -q python3 "$candidate"; then
      cp "$candidate" "$work/restore-radiotomate.sh"
      printf '%s\n' "$work/restore-radiotomate.sh"
      return 0
    fi
  done
  return 1
}

# La version du schéma de la base en place, puis la plus haute que connaît
# l'image du moteur de la version d'avant, target, déjà sur la machine : une
# base plus récente, elle ne la lirait pas.
engine_target_schemas() {
  local files=(-f "$staged/files/compose.yml")
  [[ ! -f $dir/compose.override.yml ]] || files+=(-f "$dir/compose.override.yml")
  (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" \
    run --rm --no-deps -T --entrypoint python3 radiotomate-init - 2>"$work/moteur.log") <<'PY' || {
# version : la version du schéma de la base en place, puis la plus haute que connaît cette image.
import pkgutil
import sqlite3
from contextlib import closing

import radiotomate.commands.update as update

with closing(sqlite3.connect("/data/radiotomate.db")) as con:
    row = con.execute("select value from settings where key = 'SCHEMA_VERSION'").fetchone()
print(row[0] if row else "")
print(max(int(module.name[1:]) for module in pkgutil.iter_modules(update.__path__) if module.name[1:].isdigit()))
PY
    cat "$work/moteur.log" >&2
    return 1
  }
}

# Les images de la version d'avant, pour un retour arrière à la main, celles
# de ses services et des services lancés à part (others) : celles qui manquent
# se tirent pendant que l'antenne joue encore. Les autres servent telles
# quelles, sans réseau.
rollback_images() {
  local files=(-f "$staged/files/compose.yml") list image missing=""
  [[ ! -f $dir/compose.override.yml ]] || files+=(-f "$dir/compose.override.yml")
  list=$(cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" config --images 2>"$work/compose.log") ||
    die "docker compose ne lit pas les fichiers de la version $target : $(head -n 1 "$work/compose.log") Rien n'est changé." \
      "Prendre une autre archive de la version $target, avec --from. Sinon, le signaler."
  if ((${#others[@]})); then
    list+=$'\n'$(cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" "${profiles[@]}" \
      config --images "${others[@]}" 2>/dev/null) || true
  fi
  while IFS= read -r image; do
    [[ -z $image ]] || docker image inspect "$image" >/dev/null 2>&1 || missing="$missing $image"
  done <<<"$list"
  [[ -n $missing ]] || return 0
  say "Retour arrière : les images de la version $target qui manquent, tirées pendant que l'antenne joue :$missing."
  local again="Images privées : docker login ghcr.io, avec un jeton GitHub qui a read:packages. Sinon, vérifier l'accès de la machine à ghcr.io. Puis relancer."
  (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" pull) ||
    die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. Rien n'est changé." "$again"
  if ((${#others[@]})); then
    (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" "${profiles[@]}" pull "${others[@]}") ||
      die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. Rien n'est changé." "$again"
  fi
}

# Un retour arrière de station rollback qui n'a pas fini : cleanup le note,
# sans revenir sur ses pas, et dit comment le reprendre. HOLD est déjà posé.
rollback_failed() {
  local dir=${updating[0]} from=${updating[1]} to=${updating[2]}
  update_log "retour arrière échoué" "pendant $update_stage"
  station_alert "Retour arrière raté" \
    "station rollback, de $from à $to, a échoué pendant $update_stage : la station est peut-être coupée."
  printf '%s\n' "Le retour arrière n'est pas fini : updates.log le note, et HOLD bloque les mises à jour." \
    "  Une fois la cause trouvée, le reprendre : station rollback. Si la commande de la station ne l'a pas, prendre celle de la version $from, sur https://github.com/$REPO/releases." >&2
  updating=()
  rolling_back=""
}

# --- config ---

cmd_config() {
  local dir="" env_file="" domain="" email="" old="" changed=""
  local -A opts=()
  local args=()
  parse_options "--no-domain-check -h --help" "--dir --domain --email --updates --update-time" "$@"
  if help_asked; then
    usage_command config
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  if [[ -n ${opts[--domain]+x} ]]; then
    domain=${opts[--domain],,}
    check_domain "$domain" || exit 2
  fi
  if [[ -n ${opts[--email]+x} ]]; then
    email=${opts[--email]}
    check_email "$email" || exit 2
  fi
  [[ -z ${opts[--updates]+x} ]] || check_updates "${opts[--updates]}" || exit 2
  [[ -z ${opts[--update-time]+x} ]] || check_update_time "${opts[--update-time]}" || exit 2
  open_station config "${opts[--dir]:-}"
  if [[ -z ${opts[--domain]+x}${opts[--email]+x}${opts[--updates]+x}${opts[--update-time]+x} ]]; then
    config_report
    return 0
  fi
  lock_station config
  work=$(mktemp -d)
  trap cleanup EXIT
  old=$(env_value DOMAIN)
  # Le domaine se vérifie avant tout : s'il ne mène pas ici, rien ne change.
  [[ -z ${opts[--domain]+x} || $domain == "$old" ]] || domain_verify
  [[ -z ${opts[--updates]+x} ]] || config_set BUTTON_UPDATES "${opts[--updates]}"
  [[ -z ${opts[--update-time]+x} ]] || config_set BUTTON_UPDATE_TIME "${opts[--update-time]}"
  [[ -z ${opts[--email]+x} ]] || config_set ACME_EMAIL "$email"
  if [[ -n ${opts[--domain]+x} && $domain != "$old" ]]; then
    domain_apply "$old"
  elif [[ $changed == *ACME_EMAIL* ]] && station_running caddy; then
    # Caddy lit l'e-mail à son démarrage : recréé, il s'en sert pour les
    # prochains certificats.
    compose up -d caddy || die "Caddy ne repart pas : voir le message de docker compose plus haut." "Voir pourquoi : cd $dir && docker compose logs caddy."
    say "Caddy : redémarré, avec l'e-mail ${email:-vide}. Le flux s'est coupé un instant."
  fi
  if [[ -n $changed ]]; then
    say "Changé dans $env_file :$changed."
  else
    say "Rien à changer : $env_file a déjà ces réglages."
  fi
}

# Pose une variable de .env si elle change, et la note.
config_set() { # clé, valeur
  if ! env_has "$1" || [[ $(env_value "$1") != "$2" ]]; then
    env_set "$1" "$2" config
    changed="$changed${changed:+,} $1"
  fi
}

config_report() {
  local domain email
  domain=$(env_value DOMAIN)
  email=$(env_value ACME_EMAIL)
  say "Réglages de la station, dans $env_file :" \
    "  Domaine : ${domain:-aucun}" \
    "  E-mail du compte Let's Encrypt : ${email:-aucun}" \
    "  Mises à jour : $(updates_label)" \
    "Pour en changer : station config --domain DOMAINE, --email E-MAIL, --updates auto|manual ou --update-time HH:MM."
}

# Le nouveau domaine, $domain, mène-t-il ici ? Comme install : Caddy s'arrête
# le temps de libérer le port 80, et cleanup le relance si la vérification
# échoue.
domain_verify() {
  if [[ $(env_value CADDY_TLS acme) == internal ]]; then
    say "Domaine : pas vérifié, Caddy signe lui-même le certificat (CADDY_TLS=internal)."
  elif [[ -n ${opts[--no-domain-check]:-} ]]; then
    warn "le domaine n'est pas vérifié (--no-domain-check). S'il ne mène pas ici, Let's Encrypt le refusera un moment."
  else
    say "Domaine : vérification de $domain. Caddy s'arrête le temps de la faire, et le flux avec lui."
    caddy_stopped=$dir
    compose stop caddy >/dev/null 2>&1 || true
    check_domain_here "$dir/compose.yml"
  fi
}

# Le domaine passe à $domain : .env, Caddy recréé avec lui, puis les adresses
# publiques des réglages Station qui suivaient l'ancien.
domain_apply() { # ancien domaine
  local old=$1 keys tls
  tls=$(env_value CADDY_TLS acme)
  env_set DOMAIN "$domain" config
  changed="$changed${changed:+,} DOMAIN"
  compose up -d caddy ||
    die "Caddy ne repart pas avec $domain : voir le message de docker compose plus haut." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Pour revenir à l'ancien domaine : station config --domain $old."
  caddy_stopped=""
  https_ok ||
    die "https://$domain ne répond pas au bout de $HTTPS_WAIT s : le certificat manque encore." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Pour revenir à l'ancien domaine : station config --domain $old."
  if keys=$(engine_domain_settings "$old" "$domain"); then
    if [[ -n $keys ]]; then
      say "Réglages Station : $(tr '\n' ',' <<<"$keys" | sed 's/,$//; s/,/, /g'), passés à $domain."
    else
      say "Réglages Station : aucune adresse ne suivait l'ancien domaine${old:+, $old}. Les vérifier dans la console, Réglages → Station."
    fi
  else
    warn "les réglages Station ne suivent pas : changer leurs adresses dans la console, Réglages → Station."
  fi
  say "Domaine : $domain, au lieu de ${old:-aucun}. https://$domain répond." \
    "  Les encodeurs du direct se branchent maintenant sur $domain, port $(env_value HARBOR_PORT 6800)."
}

# --- hold, unhold ---

cmd_hold() {
  local dir="" env_file=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command hold
    return 0
  fi
  open_station hold "${opts[--dir]:-}"
  if [[ -f $dir/HOLD ]]; then
    say "Les mises à jour sont déjà bloquées, par $dir/HOLD :"
    sed 's/^/  /' "$dir/HOLD"
    return 0
  fi
  hold_write "Bloquées par station hold" "${args[*]:-aucune donnée}"
  say "Mises à jour bloquées : aucune ne passe tant que $dir/HOLD est là. Les débloquer : station unhold."
}

# HOLD bloque les mises à jour, avec la date et la raison, jusqu'à ce qu'une
# personne le retire : station unhold. Un retour arrière le pose aussi, celui
# d'une mise à jour ratée comme celui de station rollback.
hold_write() { # qui, raison
  printf '%s, le %s.\nRaison : %s\nPour les débloquer : station unhold.\n' \
    "$1" "$(station_date "$(date +%s)")" "$2" >"$dir/HOLD"
}

cmd_unhold() {
  local dir="" env_file=""
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command unhold
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  open_station unhold "${opts[--dir]:-}"
  if [[ ! -f $dir/HOLD ]]; then
    say "Les mises à jour ne sont pas bloquées."
    return 0
  fi
  say "Mises à jour débloquées. $dir/HOLD disait :"
  sed 's/^/  /' "$dir/HOLD"
  rm -f "$dir/HOLD"
}

# --- cli ---

cmd_cli() {
  local dir="" env_file="" tty=()
  # Seul --dir, en tête, est à station : le reste va au moteur.
  while (($#)); do
    case $1 in
      --dir=*)
        dir=${1#*=}
        shift
        ;;
      --dir)
        (($# >= 2)) || usage_error "--dir attend une valeur."
        dir=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
  done
  open_station cli "$dir"
  docker_ok || die "Docker ne répond pas : station cli passe par le moteur." "Voir pourquoi : systemctl status docker."
  station_running radiotomate-interface ||
    die "Le moteur ne tourne pas : station cli passe par lui." "Voir pourquoi : station status. Puis le démarrer : cd $dir && docker compose up -d."
  [[ -t 0 && -t 1 ]] || tty=(-T)
  compose exec "${tty[@]}" radiotomate-interface radiotomate "$@"
}

# --- uninstall ---

cmd_uninstall() {
  local dir="" env_file="" purge assume_yes="" aborted="Rien n'est désinstallé." file
  local -A opts=()
  local args=()
  parse_options "--purge --yes -h --help" "--dir" "$@"
  if help_asked; then
    usage_command uninstall
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  purge=${opts[--purge]:-}
  assume_yes=${opts[--yes]:-}
  station_dir "${opts[--dir]:-}"
  need_root uninstall
  [[ -f $env_file || -f $dir/compose.yml ]] ||
    die "Pas de station dans $dir : ni .env, ni compose.yml." "Une station ailleurs : station uninstall --dir DOSSIER."
  # Effacer un dossier de premier niveau, comme /opt, n'est pas l'affaire de
  # cette commande.
  [[ -z $purge || $dir == /?*/?* ]] ||
    die "station uninstall --purge n'efface pas $dir, un dossier de premier niveau." "Effacer à la main ce qui doit l'être."
  env_isolate
  if [[ -z $purge && ! -f $dir/compose.yml ]]; then
    say "La station de $dir est déjà désinstallée : restent .env et ses données. Pour tout effacer : station uninstall --purge."
    return 0
  fi
  if [[ -n $purge ]]; then
    uninstall_purge_report
    confirm_word uninstall effacer "Pour tout effacer, taper effacer :"
  else
    say "Désinstaller la station de $dir : ses conteneurs, ses images, les fichiers de sa version et la commande station s'en vont." \
      "Restent .env, data/, media/ et backups/ : station install les reprend, pour la même station."
    confirm uninstall "Désinstaller ? (o/n)"
  fi
  lock_station uninstall

  if [[ -f $dir/compose.yml ]]; then
    local profiles=() images=() image down=(down --remove-orphans)
    all_profiles
    mapfile -t images < <(compose "${profiles[@]}" config --images 2>/dev/null | sort -u)
    [[ -z $purge ]] || down+=(--volumes)
    say "Désinstallation : arrêt de la station."
    compose "${profiles[@]}" "${down[@]}" ||
      die "La station ne s'arrête pas : voir le message de docker compose plus haut." "Voir pourquoi, puis relancer station uninstall."
    # Une image qu'un autre conteneur prend encore reste.
    for image in "${images[@]}"; do
      docker image rm "$image" >/dev/null 2>&1 || true
    done
  fi
  # Ce que le projet garde encore, par son étiquette : après une
  # désinstallation qui gardait les données, compose.yml n'est plus là.
  [[ -z $purge ]] || project_leftovers
  if [[ -L $BIN && $(readlink "$BIN") == "$dir/station" ]]; then
    rm -f "$BIN"
  fi
  if [[ -n $purge ]]; then
    rm -rf "${dir:?}"
    say "" "La station est effacée : $dir n'existe plus. Docker reste installé."
  else
    for file in "${VERSION_FILES[@]}"; do
      rm -rf "${dir:?}/$file"
    done
    say "" "La station est désinstallée. Restent, dans $dir : .env, data/, media/ et backups/." \
      "  La réinstaller, la même : station install --dir $dir, avec le script d'une version publiée. Docker reste installé."
  fi
}

# Les conteneurs et les volumes du projet, que compose.yml ne nomme plus.
project_leftovers() {
  local ids=()
  mapfile -t ids < <(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)
  ((${#ids[@]} == 0)) || docker rm -f "${ids[@]}" >/dev/null 2>&1 || true
  mapfile -t ids < <(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)
  ((${#ids[@]} == 0)) || docker volume rm "${ids[@]}" >/dev/null 2>&1 ||
    warn "des volumes du projet $PROJECT restent : docker volume ls, puis docker volume rm."
}

# Ce que --purge efface, et ce qu'il laisse, hors du dossier.
uninstall_purge_report() {
  local key path outside="" count=0 media
  if [[ -d $dir/backups ]]; then
    count=$(find "$dir/backups" -maxdepth 1 -name 'button-*.tar' | wc -l)
  fi
  media=$(env_path BUTTON_MEDIA ./media)
  say "Tout effacer : la station de $dir, ses conteneurs, ses images, ses volumes, et son dossier entier. Rien ne se récupère ensuite :" \
    "  .env, avec ses secrets ;" \
    "  data/ : la base, avec les comptes, les horloges, l'Agenda et les réglages ;"
  if [[ $media == "$dir"/* && -d $media ]]; then
    say "  ${media#"$dir"/}/ : la banque de sons, $(human_kb "$(size_kb "$media")") ;"
  fi
  say "  backups/ : $((count)) sauvegarde(s)."
  for key in "${DATA_DIRS[@]}" CLOUD_SYNC_CONFIG:./data/rclone; do
    path=$(env_path "${key%%:*}" "${key#*:}")
    [[ $path == "$dir"/* ]] || outside="$outside ${key%%:*} ($path)"
  done
  [[ -z $outside ]] || say "Hors du dossier, rien ne s'efface :$outside."
  say "Une sauvegarde d'abord, copiée hors de cette machine : station backup --with-media."
}

main() {
  local command=${1:-help}
  (($# == 0)) || shift
  case $command in
    install | update | rollback | status | logs | backup | restore | config | hold | unhold | cli | uninstall)
      help_topic=$command
      "cmd_$command" "$@"
      ;;
    help | -h | --help)
      if (($#)); then
        usage_command "$1"
      else
        usage
      fi
      ;;
    *) usage_error "Commande inconnue : $command." ;;
  esac
}

# Lu par les tests avec source, le script ne fait que définir ses fonctions.
# Lu sur l'entrée standard (curl … | bash -s install), il n'a pas de nom.
if [[ -z ${BASH_SOURCE[0]:-} || ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
