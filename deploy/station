#!/usr/bin/env bash
# station : installer une station BUTTON sur un VPS, puis l'exploiter. En root.
#   station install [options]   installer la station, ou la réparer
#   station update [options]    la mettre à jour
#   station rollback [options]  défaire la dernière mise à jour
#   station status              son état ; logs, backup, restore, config,
#                               hold, unhold, cli et uninstall : station help
# Sur un VPS neuf, ce script se télécharge seul, depuis la plus haute version
# publiée. Il prend les fichiers de la station dans la même version, vérifiés
# par leur somme :
#   curl -fsSLO https://github.com/lazbutton/button/releases/latest/download/station
#   sudo bash station install
# Ensuite, il est dans le dossier de la station, et /usr/local/bin/station y
# mène. Voir docs/deploiement.md, « Installer sur un VPS » et « Exploiter la
# station ».
#
# Une commande, une fonction cmd_<nom>, avec les mêmes aides.
set -euo pipefail

# Le dépôt dont chaque version publiée joint station, station.tar.gz et
# SHA256SUMS : scripts/version.py station. BUTTON_REPO : celui d'un fork.
REPO=${BUTTON_REPO:-lazbutton/button}
# Pour les tests : une racine à la place de /, pour les fichiers du système.
ROOT=${STATION_ROOT:-}
# Le dossier d'une station, sauf --dir, et la commande posée sur la machine.
DEFAULT_DIR=$ROOT/opt/button
BIN=$ROOT/usr/local/bin/station
# La place libre demandée, en Go : les images en prennent 3 environ, et la
# banque de sons grandit. INS-04 mesurera mieux.
MIN_FREE_GB=10
# L'attente du certificat, en secondes. Celle de la santé du moteur est celle
# de smoke.sh, 300 s ici, ou SMOKE_WAIT.
HTTPS_WAIT=180
# Le conteneur qui répond sur le port 80 pendant la vérification du domaine.
PROBE=button-verification-domaine
# Le format des archives de station backup. restore lit celui-ci et les plus
# anciens : une version plus récente de la commande lit encore une archive
# d'aujourd'hui, et un format nouveau prend le numéro suivant. Dans chaque
# format, l'archive commence par MANIFEST, qui le dit, puis SHA256SUMS, qui
# nomme les autres fichiers : voir backup_station.
BACKUP_FORMAT=1
# Les fichiers d'une archive de ce format, que SHA256SUMS couvre. Puis, avec
# les sons, la banque, sous son nom.
BACKUP_FILES=(MANIFEST radiotomate.tar.gz env caddy.tar.gz)
# La marge de place demandée par une sauvegarde ou une restauration, en Ko.
SPACE_MARGIN_KB=1048576
# Celle d'une copie de la base, remise à sa place par un retour arrière.
COPY_MARGIN_KB=10240
# Les dossiers de données de la station, que compose.yml monte : la variable
# de .env, et son défaut.
DATA_DIRS=(RT_DATA:./data/radiotomate NOWPLAYING_DATA:./data/nowplaying MEILI_DATA:./data/meilisearch
  CADDY_DATA:./data/caddy BUTTON_MEDIA:./media)
# Les fichiers qu'une version pose dans le dossier, ceux de station.tar.gz :
# station_files, dans scripts/version.py, que test_version.py compare à
# cette liste. uninstall les retire.
VERSION_FILES=(VERSION compose.yml Caddyfile .env.example CHANGELOG.md station scripts)
# Les archives de backups/ que garde station update : les plus récentes.
KEEP_BACKUPS=5
# Les trois services du moteur, recréés ensemble par une mise à jour : les
# deux derniers partagent le réseau du premier, qui ne redémarre jamais seul.
ENGINE_SERVICES=(radiotomate-playout radiotomate-interface radiotomate-scheduler)
# Les journaux d'une mise à jour qui n'aboutit pas, gardés dans le dossier de
# la station avant que le retour arrière ne recrée ses conteneurs : ils
# partiraient avec eux. Réécrit à chaque échec.
FAILED_LOGS="updates-failed.log"
# Le projet Compose, name dans compose.yml : ses conteneurs et ses volumes
# portent son nom.
PROJECT=button
# Le verrou des commandes qui changent la station, install comprise, hors de
# son dossier, qui peut ne pas exister encore. Dans /run, à root : pas dans
# /run/lock, où tous les comptes écrivent.
LOCK=$ROOT/run/button-station.lock
# Une restauration en cours d'échange l'écrit dans le dossier de la station,
# et l'efface à la fin : resté là, il dit quoi remettre (status le montre).
JOURNAL=restauration-en-cours
# L'heure des mises à jour automatiques, à celle de la station (TZ), quand
# BUTTON_UPDATE_TIME manque à .env. Elles viendront avec MAJ-06, qui la lira.
UPDATE_TIME=04:00
# La sauvegarde hors de la machine (SAV-01) : restic, dans son image
# officielle, épinglée, tirée de Docker Hub. L'hôte n'a besoin que de Docker,
# et chaque station a la même version. Dependabot ne la suit pas : la monter
# à la main, avec ses notes de version.
RESTIC_IMAGE=docker.io/restic/restic:0.19.1
# Ce que le dépôt garde : 7 sauvegardes quotidiennes, 4 hebdomadaires et 6
# mensuelles.
REMOTE_KEEP=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)
# Le nom d'hôte des sauvegardes dans le dépôt : le même d'une machine à
# l'autre, pour que la rotation compte ensemble celles d'avant et d'après un
# changement de machine.
REMOTE_HOST=button
# L'heure de la sauvegarde de la nuit, à celle de la station, quand
# BUTTON_BACKUP_TIME manque à .env : avant celle des mises à jour. Puis
# l'heure du test de restauration, le 1er de chaque mois.
BACKUP_TIME=03:00
REMOTE_TEST_TIME=05:00
# Les minuteurs systemd de la nuit et du mois, et leurs services.
UNITS=$ROOT/etc/systemd/system
REMOTE_UNITS=(button-sauvegarde.timer button-test-restauration.timer button-sauvegarde.service
  button-test-restauration.service)
# Le journal des sauvegardes hors de la machine et des tests, que status lit.
REMOTE_LOG=backups-remote.log
# Une station qui reprend un dépôt qui existait déjà, sans s'être jamais
# sauvegardée : ce fichier de data/restic retient ses minuteurs jusqu'à ce
# qu'elle soit remise d'une sauvegarde, ou sauvegardée. Sinon, la nuit, elle
# deviendrait, neuve et vide, la dernière sauvegarde du dépôt.
REMOTE_PENDING=en-attente
# Les alertes sur un téléphone et par e-mail (SUR-01) : le serveur ntfy où
# install propose un sujet, tiré au hasard, et le journal des alertes de la
# commande, dans le dossier de la station, que status lit.
NTFY_SERVER=https://ntfy.sh
ALERTS_LOG=alerts.log
# Un envoi à ntfy : chaque essai dure au plus ALERT_NTFY_WAIT secondes, et
# ALERT_NTFY_PAUSE les sépare. Trois essais tiennent en moins d'une minute.
ALERT_NTFY_WAIT=15
ALERT_NTFY_PAUSE=2
# Le message d'un essai des alertes.
ALERT_TEST_TEXT="les alertes de la station arriveront ici : un silence à l'antenne, un disque presque plein, une mise à jour annulée, une sauvegarde ratée."
# Les demandes de la console (MAJ-07), comme « Mettre à jour maintenant » : la
# console ne touche jamais Docker (ADR 0004). Elle écrit la demande dans le
# moteur, et station requests la prend, chaque minute, par ce minuteur et son
# service : BUTTON_CONSOLE_REQUESTS=no, dans .env, les arrête.
REQUEST_UNITS=(button-demandes.timer button-demandes.service)
# Le verrou de station requests, à part de celui des commandes : la mise à jour
# qu'il lance prend le sien.
REQUESTS_LOCK=$ROOT/run/button-demandes.lock
# Ce que station requests a dit de la machine au moteur, la dernière fois :
# l'heure, puis l'empreinte de ce qui le change. Il ne le redit qu'une fois
# changé, ou au bout d'une heure. Effacé au redémarrage de la machine, il se
# redit au premier passage.
REQUESTS_STATE=$ROOT/run/button-demandes.etat
REQUESTS_EVERY=3600
# Une demande en cours, dans le dossier de la station : son identifiant,
# l'heure de son début et le nombre de lignes de updates.log d'avant. Restée
# là, la mise à jour s'est arrêtée sans que la commande dise au moteur comment :
# le passage suivant le lui dit, d'après updates.log.
REQUEST_MARK=demande-en-cours
# Le délai qu'a le moteur pour répondre à station requests, en secondes, et ce
# qu'elle lit au plus de sa réponse, en octets.
REQUESTS_WAIT=60
REQUESTS_READ=4096
# Après une mise à jour arrêtée par l'antenne, sa sauvegarde faite, une demande
# de la console attend ce temps, en secondes, avant d'en lancer une autre :
# chacune refait une sauvegarde, et le moteur dit la fenêtre.
REQUESTS_PAUSE=3600
# Le code de sortie d'une commande station qui trouve le verrou pris : station
# requests sait alors que sa mise à jour attend, et n'a pas échoué.
LOCK_BUSY=75
# Ce que cleanup défait en sortant : le dossier de travail ; celui des
# fichiers d'une version, que station update garde à part ; le conteneur de
# la vérification du domaine s'il tourne encore ; Caddy, arrêté pour elle ;
# une archive à moitié écrite ; une restauration interrompue ; ce qu'elle
# préparait ; une mise à jour qui n'a pas fini, que updates.log note, et qui
# revient à la version d'avant une fois ses fichiers touchés (update_undo).
# caddy_stopped, station_stopped et updating portent le dossier de la
# station : cleanup ne voit pas toujours les variables locales des commandes,
# et plus aucune après une erreur que set -e arrête.
work=""
staged=""
probe_started=""
caddy_stopped=""
partial=""
station_stopped=""
swapped=()
prepared=()
restart_others=()
# Une mise à jour en cours : le dossier de la station, la version d'avant, la
# nouvelle, la sauvegarde d'avant, puis l'étape où elle en est.
updating=()
update_stage=""
# De quoi la défaire (update_undo) : l'heure de son début ; les fichiers de la
# version d'avant, téléchargés ; ceux qu'elle a remplacés, et parmi eux ceux
# qui n'étaient pas là ; le suffixe des copies .local-… qu'elle a gardées ; les
# services d'un autre profil qui tournaient.
update_started=""
previous=""
replaced=()
added=()
files_stamp=""
others=()
# Un retour arrière de station rollback, en cours : cleanup note son échec,
# sans revenir sur ses pas.
rolling_back=""
# Une sauvegarde hors de la machine, ou un test de restauration, en cours :
# le dossier de la station, sauvegarde ou test, et son nom. S'il s'arrête en
# erreur, cleanup le note dans backups-remote.log et donne l'alerte
# (remote_failed), avec le message du dernier die.
remote_job=()
died=""
# Sans --yes, une question se pose au clavier. Une interruption au clavier
# dit ce message.
assume_yes=""
aborted="Installation interrompue : rien n'est écrit. Relancer station install."

say() { printf '%s\n' "$@"; }
warn() { printf 'Attention : %s\n' "$@" >&2; }
# Un échec : ce qui ne va pas, puis quoi faire. died le garde, pour l'alerte
# d'une sauvegarde hors de la machine.
die() {
  died="$*"
  printf '%s\n' "$@" >&2
  exit 1
}
# L'aide à lire : celle de la commande en cours, que main pose.
help_topic=""
usage_error() {
  printf '%s\n' "$1" "Voir : station help${help_topic:+ $help_topic}." >&2
  exit 2
}

usage() {
  cat <<'EOF'
Usage : station COMMANDE [options]

La commande d'une station BUTTON sur un VPS, en root.

  install        installer la station, ou la réparer
  update         la mettre à jour, vers la plus haute version publiée
  rollback       défaire la dernière mise à jour
  status         son état : version, services, disque, prochain direct
  logs           ses journaux
  backup         la sauvegarder, sans couper l'antenne, ici ou hors de la machine
  restore        remettre une sauvegarde, ici ou sur une autre machine
  config         voir ou changer le domaine, l'e-mail, les mises à jour, la
                 sauvegarde hors de la machine, les alertes, les demandes de
                 la console
  hold, unhold   bloquer, débloquer les mises à jour
  requests       prendre les demandes de la console, comme « Mettre à jour
                 maintenant » : un minuteur le fait chaque minute
  cli            une commande du moteur, radiotomate
  uninstall      la désinstaller

L'aide d'une commande : station help COMMANDE. Chacune prend --dir DOSSIER,
pour une station ailleurs que dans le dossier de la commande ou /opt/button.

Voir docs/deploiement.md, « Exploiter la station ».
EOF
}

# L'aide d'une commande.
usage_command() { # commande
  case $1 in
    install) usage_install ;;
    update)
      cat <<'EOF'
Usage : station update [options] [--dir DOSSIER]

Met la station à la plus haute version publiée : une sauvegarde d'abord, dans
backups/, qui garde les cinq dernières ; puis les fichiers de la version,
vérifiés par leur somme, et ses images, tirées pendant que l'antenne joue.
.env et compose.override.yml restent ; ce que la version y demande en plus
s'ajoute. L'antenne se coupe le temps de redémarrer. Puis le contrôle de la
station, et une ligne dans updates.log.

Si la station ne redémarre pas, ou que le contrôle échoue, elle revient seule
à la version d'avant : ses fichiers, ses images, et la base d'avant la mise à
jour si le schéma a migré. Puis HOLD bloque les mises à jour suivantes.

Pas de mise à jour quand HOLD la bloque, ni quand un direct ou une diffusion
de l'Agenda est à l'antenne ou commence dans les 30 minutes. Une version
majeure demande une action, que la commande cite, avant de la prendre.

  --version X.Y.Z   une autre version publiée, plus récente, que la plus haute
  --from ARCHIVE    les fichiers de la version depuis cette archive,
                    station.tar.gz, plutôt que de GitHub
  --major           prendre une version majeure, une fois faite l'action que
                    demandent ses notes
  --force           mettre à jour même si un direct ou une diffusion de
                    l'Agenda est à l'antenne ou commence bientôt
  --yes             sans confirmation, pour un script

Voir docs/deploiement.md, « Mettre à jour ».
EOF
      ;;
    rollback)
      cat <<'EOF'
Usage : station rollback [--from ARCHIVE] [--yes] [--dir DOSSIER]

Défait la dernière mise à jour, celle que note updates.log : la station
revient à la version d'avant, ses fichiers et ses images. Si la mise à jour a
migré le schéma de la base, la base d'avant la mise à jour revient aussi : ce
qui s'est écrit depuis est perdu, et la base d'aujourd'hui reste à côté.
L'antenne se coupe le temps de redémarrer. Puis le contrôle, une ligne dans
updates.log, et HOLD, qui bloque les mises à jour suivantes.

Une mise à jour qui ne redémarre pas, ou que le contrôle refuse, revient déjà
seule : rollback sert quand la nouvelle version déçoit ensuite.

  --from ARCHIVE    les fichiers de la version d'avant depuis cette archive,
                    station.tar.gz, plutôt que de GitHub
  --yes             sans confirmation, pour un script

Voir docs/deploiement.md, « Revenir en arrière ».
EOF
      ;;
    status)
      cat <<'EOF'
Usage : station status [--dir DOSSIER]

L'état de la station, sans rien changer : sa version et la plus haute
publiée, ses services, la place sur le disque, le prochain direct, la
dernière sauvegarde, les mises à jour, bloquées ou non, et ses alertes, avec
la dernière. Sort en erreur quand un service ne va pas.
EOF
      ;;
    logs)
      cat <<'EOF'
Usage : station logs [SERVICE…] [options] [--dir DOSSIER]

Les journaux de la station, ou de ses services nommés : les 200 dernières
lignes. Les options vont à docker compose logs : -f les suit, --tail 50 ou
--since 1h en prennent d'autres. Les services : station status.
EOF
      ;;
    backup)
      cat <<'EOF'
Usage : station backup [ARCHIVE] [--with-media] [--dir DOSSIER]
        station backup --remote [--dir DOSSIER]

Sauvegarde la station sans couper l'antenne : la base, avec les comptes, les
horloges, l'Agenda et les réglages, radiotomate.yaml, .env et les certificats
de Caddy. --with-media y met aussi la banque de sons.

ARCHIVE : le fichier à écrire, ou un dossier où l'écrire. Sinon, backups/,
dans le dossier de la station, sous le nom button-AAAAMMJJTHHMMSSZ.tar.
L'archive est en droits 600, à root : elle porte les secrets de .env, hors du
mot de passe admin. Elle se remet par station restore.

--remote : la même sauvegarde, hors de la machine, dans le dépôt de restic
que règle station config --backup-remote, chiffrée avant l'envoi. Avec les
sons, sauf station config --backup-media no. Le dépôt en garde 7
quotidiennes, 4 hebdomadaires et 6 mensuelles. Un minuteur la fait chaque
nuit ; elle se remet par station restore --remote.
EOF
      ;;
    restore)
      cat <<'EOF'
Usage : station restore ARCHIVE [--without-media] [--yes] [--dir DOSSIER]
        station restore --remote [ID] [--without-media] [--yes] [--dir DOSSIER]
        station restore --remote --list [--dir DOSSIER]
        station restore --remote --test [ID] [--dir DOSSIER]

Remet une sauvegarde de station backup, sur cette station ou sur une autre
machine, après station install. La base, les certificats de Caddy et, s'ils y
sont, les sons, remplacent ceux de la station : les données en place sont
gardées à côté. De .env, seuls le fuseau (TZ) et le compte admin viennent de
la sauvegarde : le reste est celui de cette machine, domaine compris. L'antenne
se coupe le temps de redémarrer. Si la station ne repart pas, celle d'avant
revient.

--remote : depuis le dépôt de la sauvegarde hors de la machine, que règle
station config --backup-remote : la dernière sauvegarde, ou celle dont l'ID
est donné. --list les montre, avec leur ID. --test en restaure une dans un
dossier temporaire, sans les sons, et vérifie sa base, sans rien changer :
le minuteur le fait le 1er de chaque mois.
--without-media : garder la banque de sons en place, même si la sauvegarde en a.
--yes : sans confirmation, pour un script.
EOF
      ;;
    config)
      cat <<'EOF'
Usage : station config [options] [--dir DOSSIER]

Sans option : les réglages de la station. Avec, les change dans .env :
  --domain DOMAINE        le domaine, qui mène déjà à cette machine
  --email E-MAIL          l'e-mail du compte Let's Encrypt, "" pour aucun
  --updates auto|manual   les mises à jour automatiques
  --update-time HH:MM     leur heure, à celle de la station (04:00)
  --no-domain-check       ne pas vérifier que le domaine mène ici

La sauvegarde hors de la machine, chaque nuit, par restic :
  --backup-remote DÉPÔT   son dépôt, chez un autre fournisseur que celui de
                          cette machine : s3:https://HÔTE/BUCKET/CHEMIN, ou
                          sftp:COMPTE@HÔTE:/CHEMIN ; "" l'arrête
  --backup-s3-access-key CLÉ           la clé d'accès d'un dépôt S3
  --backup-s3-secret-key-file FICHIER  sa clé secrète, dans un fichier
  --backup-password-file FICHIER       le mot de passe d'un dépôt qui existe
                          déjà ; sans lui, un dépôt neuf en reçoit un, tiré
                          au hasard, à noter
  --backup-media yes|no   les sons dans la sauvegarde (yes)
  --backup-time HH:MM     son heure, à celle de la station (03:00)

Le dépôt se vérifie avant que rien ne change : restic s'y connecte, avec le
mot de passe, et le crée s'il n'existe pas. Un dépôt SFTP demande que le
stockage autorise la clé SSH de la station, que la commande montre.

Les alertes, sur un téléphone et par e-mail : un silence, un disque presque
plein, une mise à jour annulée, une sauvegarde ratée.
  --alert-ntfy ADRESSE    ntfy : un serveur seul, comme https://ntfy.sh, où
                          un sujet se tire au hasard, ou un sujet,
                          https://SERVEUR/SUJET ; "" l'arrête
  --alert-ntfy-token-file FICHIER      le jeton d'un sujet protégé ; "" le retire
  --alert-email ADRESSES  les e-mails qui les reçoivent, séparés par des
                          virgules ; "" l'arrête
  --alert-smtp HÔTE:PORT  le serveur qui les envoie : 465 en TLS, sinon
                          STARTTLS, exigé (587)
  --alert-smtp-user COMPTE             son compte ; "" pour un serveur sans compte
  --alert-smtp-password-file FICHIER   son mot de passe, dans un fichier
  --alert-from ADRESSE    l'expéditeur ; sans lui, ou "", le compte, s'il est
                          une adresse, sinon button@ le domaine
  --alert-test            envoyer un essai, par chaque canal réglé

Un canal qui change reçoit d'abord un essai : s'il ne part pas, rien ne
change. Un jeton ou un compte ne part jamais vers un autre serveur. Les
alertes d'antenne suivent sans couper l'antenne.

  --console-requests yes|no   les demandes de la console, comme « Mettre à
                          jour maintenant », que la machine prend chaque
                          minute (yes) ; no les arrête

Changer le domaine ou l'e-mail redémarre Caddy : le flux se coupe un instant.
EOF
      ;;
    hold | unhold)
      cat <<'EOF'
Usage : station hold [RAISON…] [--dir DOSSIER]
        station unhold [--dir DOSSIER]

hold bloque les mises à jour : il pose le fichier HOLD dans le dossier de la
station, avec la date et la raison. unhold le retire.
EOF
      ;;
    requests)
      cat <<'EOF'
Usage : station requests [--from ARCHIVE] [--dir DOSSIER]

Prend les demandes de la console, que le minuteur button-demandes regarde
chaque minute : « Mettre à jour maintenant », dans Réglages → Mises à jour. La
console ne touche jamais la machine : elle écrit sa demande dans le moteur, et
cette commande la lit par docker compose exec, lance station update --yes,
puis écrit le résultat par le même chemin.

Une demande attend tant qu'un direct ou une diffusion de l'Agenda est à
l'antenne ou commence dans les 30 minutes, et tant qu'une autre commande
station tourne, comme la sauvegarde de la nuit. HOLD la refuse. Une version
majeure ne part pas d'une demande : station update --major, sur la machine.

Elle dit aussi au moteur ce que la console montre de la machine : HOLD, les
dernières lignes de updates.log, et si elle prend les demandes. Sans rien de
neuf, elle ne fait rien. station config --console-requests no coupe les
demandes : elle ne fait plus que le dire au moteur.

  --from ARCHIVE    la version depuis cette archive, station.tar.gz, comme
                    station update --from : pour un essai

Voir docs/deploiement.md, « Depuis la console ».
EOF
      ;;
    cli)
      cat <<'EOF'
Usage : station cli [--dir DOSSIER] COMMANDE…

Une commande du moteur, radiotomate, dans son conteneur. Par exemple :
  station cli users add studio --admin
  station cli maintenance next-live
Les commandes du moteur : station cli --help.
EOF
      ;;
    uninstall)
      cat <<'EOF'
Usage : station uninstall [--purge] [--yes] [--dir DOSSIER]

Désinstalle la station : ses conteneurs, ses images, les fichiers de sa
version et la commande station s'en vont. Restent .env, data/, media/ et
backups/ : station install les reprend.

--purge efface tout le dossier, données et sauvegardes comprises.
--yes : sans confirmation, pour un script.
EOF
      ;;
    *) usage_error "Commande inconnue : $1." ;;
  esac
}

usage_install() {
  cat <<'EOF'
Usage : station install [options]

Installe une station BUTTON sur cette machine, en root : Debian 12 ou 13, ou
Ubuntu 24.04, en x86-64. Relancée, la commande répare ce qui manque, sans
changer ni .env, ni les données, ni la version.

Les réponses, demandées au clavier quand l'option manque :
  --name NOM                  le nom de la station, dans la console (BUTTON)
  --domain DOMAINE            son domaine, qui pointe déjà sur cette machine
  --email E-MAIL              l'e-mail du compte Let's Encrypt (aucun)
  --timezone FUSEAU           le fuseau de la station (Europe/Paris)
  --admin IDENTIFIANT         l'identifiant du compte admin (admin)
  --updates auto|manual       les mises à jour automatiques (auto)
  --alert-ntfy ADRESSE        les alertes sur un téléphone, par ntfy :
                              https://ntfy.sh, où un sujet se tire au hasard
                              (au clavier, proposé ; sinon, aucune)
  --alert-email ADRESSES      les alertes par e-mail, avec --alert-smtp
                              HÔTE:PORT, --alert-smtp-user COMPTE et
                              --alert-smtp-password-file FICHIER (aucun)

Les alertes partent dès l'installation, après un essai par chaque canal. Le
jeton d'un sujet ntfy protégé et l'expéditeur des e-mails ont aussi leur
option, comme pour station config, qui les change ensuite : station help
config.

Les autres options :
  --version X.Y.Z             une version publiée, au lieu de la plus haute
  --dir DOSSIER               le dossier de la station (/opt/button)
  --github-token-file FICHIER un jeton GitHub qui lit les images privées
                              (read:packages), pour docker login
  --from ARCHIVE              les fichiers de la station depuis cette archive,
                              station.tar.gz, plutôt que de GitHub
  --tls internal              un certificat de Caddy, pour un essai : les
                              navigateurs le refusent
  --no-domain-check           ne pas vérifier que le domaine mène ici
  --yes                       ne rien demander : les options, sinon les
                              valeurs par défaut, et Docker installé s'il manque

Voir docs/deploiement.md, « Installer sur un VPS ».
EOF
}

# Une question se pose au clavier seulement : sans terminal, ou avec --yes,
# les options et les valeurs par défaut répondent.
interactive() { [[ -z $assume_yes && -t 0 ]]; }
# Le mot de passe admin ne s'affiche que dans un terminal : jamais dans un
# journal, ni dans la sortie d'une CI.
terminal() { [[ -t 1 ]]; }

trim() {
  local text=$1
  text=${text#"${text%%[![:space:]]*}"}
  printf '%s' "${text%"${text##*[![:space:]]}"}"
}

# ask <question> <défaut> <contrôle> : la réponse lue au clavier, ou le défaut
# sur Entrée, reposée tant que le contrôle la refuse. Le contrôle dit pourquoi.
ask() {
  local answer
  while :; do
    printf '  %s%s : ' "$1" "${2:+ [$2]}" >&2
    IFS= read -r answer || die "" "$aborted"
    answer=$(trim "$answer")
    answer=${answer:-$2}
    if "$3" "$answer"; then
      printf '%s\n' "$answer"
      return 0
    fi
  done
}

check_yes_no() {
  case ${1,,} in
    o | oui | y | yes | n | non | no) return 0 ;;
  esac
  echo "  Répondre o ou n." >&2
  return 1
}

check_name() {
  if [[ -z $1 || ${#1} -gt 80 || $1 == *[[:cntrl:]]* ]]; then
    echo "  Le nom : une ligne, de 80 caractères au plus." >&2
    return 1
  fi
}

check_domain() {
  local label='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
  local name="^$label(\\.$label)+\$"
  if [[ ${#1} -gt 253 || ! ${1,,} =~ $name ]]; then
    echo "  « $1 » n'est pas un nom de domaine. Le nom seul, comme radio.example, sans http:// ni chemin." >&2
    return 1
  fi
  if [[ $1 =~ \.[0-9]+$ ]]; then
    echo "  « $1 » est une adresse IP : Let's Encrypt ne certifie que des noms de domaine." >&2
    return 1
  fi
}

check_email() {
  local address='^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'
  [[ -z $1 || $1 =~ $address ]] && return 0
  echo "  « $1 » n'est pas un e-mail. Rien, pour un compte Let's Encrypt sans e-mail." >&2
  return 1
}

check_timezone() {
  local zone='^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$'
  [[ $1 =~ $zone && -f $ROOT/usr/share/zoneinfo/$1 ]] && return 0
  echo "  « $1 » n'est pas un fuseau connu de cette machine, comme Europe/Paris ou America/Montreal." >&2
  return 1
}

check_admin() {
  local id='^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$'
  [[ $1 =~ $id ]] && return 0
  echo "  « $1 » : un identifiant de 32 caractères au plus, en lettres, chiffres, point, tiret ou soulignement." >&2
  return 1
}

check_updates() {
  [[ $1 == auto || $1 == manual ]] && return 0
  echo "  « $1 » : auto ou manual." >&2
  return 1
}

check_update_time() {
  [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && return 0
  echo "  « $1 » : une heure s'écrit HH:MM, comme 04:00." >&2
  return 1
}

check_yes_or_no() { # valeur, option
  [[ $1 == yes || $1 == no ]] && return 0
  echo "  $2 « $1 » : yes ou no." >&2
  return 1
}

check_version() {
  local number='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
  [[ $1 =~ $number ]] && return 0
  echo "  « $1 » : une version s'écrit X.Y.Z, comme 0.1.0. main ne s'installe que depuis une archive : voir --from." >&2
  return 1
}

# --- .env ---

# La valeur d'une variable de .env, la dernière, sans les guillemets autour ;
# le défaut quand la ligne manque. Vide quand elle est vide.
env_value() { # clé, défaut
  local line
  line=$(grep -E "^$1=" "$env_file" 2>/dev/null | tail -n 1) || true
  if [[ -z $line ]]; then
    printf '%s\n' "${2:-}"
    return 0
  fi
  line=${line#*=}
  if [[ ${#line} -ge 2 && ($line == \"*\" || $line == \'*\') ]]; then
    line=${line:1:${#line}-2}
  fi
  printf '%s\n' "$line"
}

# Le mount public du flux, celui qu'écrit init-radiotomate.sh : ICECAST_MOUNT
# dans .env, sans son / du début, et radio.mp3 sans elle, comme compose.yml.
# Le dossier d'une version d'avant cette variable, comme la 0.2.0, qu'un retour
# arrière peut remettre, sert button.mp3, en dur.
stream_mount() {
  local mount
  if [[ -f $dir/compose.yml ]] && ! grep -q ICECAST_MOUNT "$dir/compose.yml"; then
    echo button.mp3
    return 0
  fi
  mount=$(env_value ICECAST_MOUNT "")
  mount=${mount#/}
  printf '%s\n' "${mount:-radio.mp3}"
}

env_has() { grep -qE "^$1=" "$env_file" 2>/dev/null; }

# Une variable qui manque à .env, à la fin, sous une ligne qui date l'ajout et
# dit quelle commande l'a ajoutée : install, sauf env_by. station update
# (env_new_only) n'ajoute que le nouveau : un secret qui manque, sans lequel
# rien ne démarre, ou une variable que la version d'avant ne connaissait pas,
# absente de son .env.example (env_known). Une variable connue que .env n'a
# plus a été retirée exprès, COMPOSE_PROFILES derrière un autre proxy par
# exemple : elle ne revient pas, et se note dans env_left_out.
env_add() { # clé, valeur
  if [[ -n ${env_new_only:-} && $1 != *PASSWORD* && $1 != *SECRET* && $1 != *_KEY ]] &&
    { [[ -z ${env_known:-} ]] || grep -qE "^#? *$1=" "$env_known"; }; then
    env_left_out="${env_left_out:-} $1"
    return 0
  fi
  if [[ -z $env_added ]]; then
    printf '\n# Ajouté par station %s, le %s.\n' "${env_by:-install}" "$(date +%F)" >>"$env_file"
  fi
  printf '%s=%s\n' "$1" "$2" >>"$env_file"
  env_added="$env_added $1"
}

# Change la valeur d'une variable déjà dans .env, sans toucher au reste.
env_replace() { # clé, valeur
  local tmp
  tmp=$(mktemp "$env_file.XXXXXX")
  KEY=$1 VALUE=$2 awk 'index($0, ENVIRON["KEY"] "=") == 1 { print ENVIRON["KEY"] "=" ENVIRON["VALUE"]; next } { print }' \
    "$env_file" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$env_file"
}

# Pose une variable de .env : change sa valeur, ou l'ajoute à la fin, sous
# une ligne qui dit quelle commande l'a ajoutée.
env_set() { # clé, valeur, commande
  if env_has "$1"; then
    env_replace "$1" "$2"
    return $?
  fi
  [[ -z $(tail -c 1 "$env_file") ]] || printf '\n' >>"$env_file"
  printf '\n# Ajouté par station %s, le %s.\n%s=%s\n' "$3" "$(date +%F)" "$1" "$2" >>"$env_file"
}

# Un chemin de .env, comme RT_DATA, relatif au dossier de la station, sans
# barre oblique finale.
env_path() { # clé, défaut
  local path
  path=$(env_value "$1" "$2")
  [[ $path == /* ]] || path=$dir/${path#./}
  while [[ $path == ?*/ ]]; do path=${path%/}; done
  printf '%s\n' "$path"
}

# Un secret de machine, que personne ne tape : 48 caractères.
secret() {
  local value
  value=$(openssl rand -hex 24)
  [[ ${#value} -eq 48 ]] || die "openssl ne tire pas de secret." "Vérifier openssl (openssl rand -hex 24), puis relancer."
  printf '%s\n' "$value"
}

# Le mot de passe admin, tapé par une personne : 24 caractères, sans + ni /.
password() {
  local value
  value=$(openssl rand -base64 18 | tr '+/' '-_')
  [[ ${#value} -eq 24 ]] || die "openssl ne tire pas de mot de passe." "Vérifier openssl (openssl rand -base64 18), puis relancer."
  printf '%s\n' "$value"
}

# Ce que .env règle ne vient jamais de l'environnement de la commande : docker
# compose le préférerait à .env, et sudo garde TZ, par exemple.
env_isolate() {
  local key
  unset COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_ENV_FILES
  [[ -f $env_file ]] || return 0
  while IFS='=' read -r key _; do
    case $key in
      PATH | HOME) ;;
      *) unset "$key" ;;
    esac
  done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$env_file")
}

compose() { (cd "$dir" && docker compose "$@"); }

# --- Vérifications ---

check_machine() {
  local os_release=$ROOT/etc/os-release id version codename arch
  [[ $(id -u) == 0 ]] ||
    die "station install demande les droits root." "Relancer avec sudo : sudo bash station install."
  [[ -r $os_release ]] || die "$os_release est illisible : système inconnu." "Une station s'installe sur Debian 12 ou 13, ou sur Ubuntu 24.04."
  id=$(sed -n 's/^ID=//p' "$os_release" | tr -d '"')
  version=$(sed -n 's/^VERSION_ID=//p' "$os_release" | tr -d '"')
  codename=$(sed -n 's/^VERSION_CODENAME=//p' "$os_release" | tr -d '"')
  case "$id $version" in
    "debian 12" | "debian 13" | "ubuntu 24.04") ;;
    *)
      die "Système non pris en charge : ${id:-inconnu} ${version:-}." \
        "Une station s'installe sur Debian 12 ou 13, ou sur Ubuntu 24.04 : prendre l'un d'eux à la création du VPS."
      ;;
  esac
  os_id=$id
  os_codename=$codename
  arch=$(uname -m)
  [[ $arch == x86_64 ]] ||
    die "Processeur $arch : les images de BUTTON ne sont construites que pour x86-64 (amd64)." "Prendre un VPS x86-64."
  local tool missing=""
  for tool in curl openssl tar sha256sum ss; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
  done
  [[ -z $missing ]] ||
    die "Outils absents :$missing." "Les installer, par exemple : apt-get install -y curl openssl tar coreutils iproute2. Puis relancer."
  say "Machine : $id $version ($codename), x86-64."
}

# Docker et Compose v2, depuis le dépôt de Docker, comme le dit sa
# documentation : https://docs.docker.com/engine/install/
install_docker() {
  local apt=$ROOT/etc/apt failed="L'installation de Docker a échoué : voir le message d'apt-get plus haut."
  local again="Une fois réglé, relancer station install, ou installer Docker à la main : https://docs.docker.com/engine/install/"
  export DEBIAN_FRONTEND=noninteractive
  say "Docker : installation depuis download.docker.com."
  apt-get update -qq </dev/null || die "$failed" "$again"
  apt-get install -y -qq ca-certificates curl </dev/null >/dev/null || die "$failed" "$again"
  install -m 0755 -d "$apt/keyrings"
  curl --disable -fsSL "https://download.docker.com/linux/$os_id/gpg" -o "$apt/keyrings/docker.asc" ||
    die "La clé du dépôt de Docker ne se télécharge pas." "Vérifier l'accès de la machine à download.docker.com, puis relancer."
  chmod a+r "$apt/keyrings/docker.asc"
  mkdir -p "$apt/sources.list.d"
  cat >"$apt/sources.list.d/docker.sources" <<EOF
Types: deb
URIs: https://download.docker.com/linux/$os_id
Suites: $os_codename
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  apt-get update -qq </dev/null || die "$failed" "$again"
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin \
    </dev/null >/dev/null || die "$failed" "$again"
  systemctl enable --now docker >/dev/null 2>&1 || true
}

check_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    if [[ -z $assume_yes ]]; then
      if ! interactive; then
        die "Docker n'est pas installé." "Relancer avec --yes pour l'installer depuis le dépôt de Docker, ou l'installer d'abord : https://docs.docker.com/engine/install/"
      fi
      local answer
      answer=$(ask "Docker n'est pas installé. L'installer depuis le dépôt de Docker ? (o/n)" o check_yes_no)
      [[ ${answer,,} == [oy]* ]] ||
        die "Rien n'est installé : une station a besoin de Docker." "L'installer (https://docs.docker.com/engine/install/), puis relancer."
    fi
    install_docker
  fi
  docker compose version >/dev/null 2>&1 ||
    die "Docker est là, mais pas Compose v2 (docker compose)." "Installer le paquet docker-compose-plugin du dépôt de Docker (https://docs.docker.com/compose/install/linux/), puis relancer."
  if ! docker info >/dev/null 2>&1; then
    systemctl enable --now docker >/dev/null 2>&1 || true
    docker info >/dev/null 2>&1 ||
      die "Docker ne répond pas." "Voir pourquoi : systemctl status docker. Puis relancer."
  fi
  say "Docker : $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo présent), Compose $(docker compose version --short 2>/dev/null || echo v2)."
}

# Le plus proche dossier qui existe : celui de la station n'existe pas encore.
existing_parent() {
  local path=$1
  until [[ -e $path || $path == / || -z $path ]]; do path=${path%/*}; done
  printf '%s\n' "${path:-/}"
}

# Les droits d'un dossier créé dans celui-ci sous umask 077 : 700, sauf si une
# ACL par défaut passe outre le umask.
inherited_mode() { # dossier
  local probe=$1/.station-droits-$$
  (umask 077 && mkdir "$probe") ||
    die "Un dossier d'essai ne se crée pas dans $1." "Vérifier ses droits et sa place, puis relancer."
  stat -c %a "$probe"
  rmdir "$probe"
}

# Une ACL par défaut sur le dossier qui reçoit la station, comme celle de /opt
# sur un runner de GitHub, passe outre le umask. Si elle ouvre en écriture au
# groupe ou aux autres comptes, le dossier de la station ne la garde pas :
# root y lance station, et docker compose y lit compose.yml et .env. Elle s'en
# retire avec setfacl (make_station_dir) ; sans setfacl, rien ne s'installe.
check_acl() {
  local parent mode
  parent=$(existing_parent "$dir")
  mode=$(inherited_mode "$parent")
  [[ $mode =~ ^[0-7]+$ ]] ||
    die "Les droits d'un dossier d'essai, dans $parent, ne se lisent pas." "Vérifier $parent, puis relancer."
  ((8#$mode & 8#022)) || return 0
  command -v setfacl >/dev/null 2>&1 ||
    die "Une ACL par défaut sur $parent passe outre le umask : le dossier de la station y naîtrait en $mode, ouvert en écriture à d'autres comptes. Rien n'est écrit." \
      "Installer setfacl, qui retirera cette ACL du dossier de la station : apt-get install acl. Puis relancer. Ou choisir un autre dossier, avec --dir."
  acl_from=$parent
  say "Droits : une ACL par défaut sur $parent passe outre le umask. Le dossier de la station ne la garde pas : il reste à root, en 755."
}

# Une installation neuve s'arrête faute de place, même relancée après une
# interruption. Une station qui a déjà sa base, et dont la banque a grandi, se
# répare quand même : la place manque, mais elle tourne.
check_disk() {
  local path free low=""
  for path in "$dir" "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"; do
    path=$(existing_parent "$path")
    free=$(df -Pk "$path" 2>/dev/null | awk 'NR == 2 { print int($4 / 1048576) }') || free=""
    if [[ -z $free ]]; then
      warn "la place libre de $path ne se lit pas (df -Pk $path) : non vérifiée."
    elif ((free < MIN_FREE_GB)); then
      low="$low $path ($free Go)"
    fi
  done
  if [[ -z $low ]]; then
    say "Place : $MIN_FREE_GB Go libres au moins."
  elif [[ -f $env_file && -f $(env_path RT_DATA ./data/radiotomate)/radiotomate.db ]]; then
    warn "peu de place libre :$low. Une station neuve en demande $MIN_FREE_GB Go : libérer de la place, ou agrandir le disque."
  else
    die "Place libre insuffisante :$low. Il en faut $MIN_FREE_GB Go au moins : les images en prennent 3 environ, et la banque de sons grandit." \
      "Libérer de la place, ou agrandir le disque, puis relancer."
  fi
}

# Docker répond : sinon, docker compose ps ne voit aucun conteneur, et la
# station aurait l'air arrêtée.
docker_ok() {
  docker info >/dev/null 2>&1
}

# Les conteneurs de la station de ce dossier qui tournent : tous, ou ceux du
# service donné. Une relance ne vérifie pas les ports qu'ils tiennent.
station_running() { # [service]
  [[ -f $dir/compose.yml && -f $env_file ]] || return 1
  [[ -n $(compose ps -q --status running "$@" 2>/dev/null) ]]
}

check_ports() {
  local spec proto port listener taken=""
  local harbor
  harbor=$(env_value HARBOR_PORT 6800)
  for spec in tcp/80 tcp/443 udp/443 "tcp/${harbor##*:}"; do
    proto=${spec%/*}
    port=${spec#*/}
    listener=$(ss -H -l -n -p "--$proto" "sport = :$port" 2>/dev/null | head -n 1) || true
    [[ -n $listener ]] || continue
    listener=$(grep -o 'users:(("[^"]*' <<<"$listener" | cut -d'"' -f2) || true
    taken="$taken
  $port ($proto) : ${listener:-un autre programme}"
  done
  [[ -z $taken ]] ||
    die "Ports déjà pris :$taken" \
      "Caddy a besoin de 80 et 443, le direct de $harbor. Arrêter ce qui les tient, par exemple systemctl disable --now apache2, puis relancer."
  say "Ports : 80, 443 et $harbor libres."
}

# --- Les fichiers de la version ---

# La plus haute version publiée : celle où mène la page « latest » de GitHub,
# que version.yml ne donne qu'à la version qui prend stable.
latest_version() { # [attente en secondes, 30]
  local answer url
  answer=$(curl --disable -sS -o /dev/null --max-time "${1:-30}" -w '%{http_code} %{redirect_url}' \
    "https://github.com/$REPO/releases/latest") ||
    die "GitHub ne répond pas." "Vérifier l'accès de la machine à github.com, puis relancer."
  url=${answer#* }
  case $url in
    */releases/tag/v*) printf '%s\n' "${url##*/releases/tag/v}" ;;
    */releases) die "Aucune version publiée de BUTTON ($REPO)." "Pour un essai, installer depuis une archive : voir --from." ;;
    *) die "GitHub répond ${answer%% *} pour la dernière version de $REPO." "Réessayer dans un moment." ;;
  esac
}

# Télécharge station.tar.gz et SHA256SUMS de la version, puis compare. Le
# second argument dit quoi faire si un fichier ne se télécharge pas.
fetch_version() { # version, que faire sinon
  local base="https://github.com/$REPO/releases/download/v$1" name expected actual
  for name in station.tar.gz SHA256SUMS; do
    curl --disable -fsSL --retry 3 --max-time 120 -o "$work/$name" "$base/$name" ||
      die "La version $1 n'a pas de fichier $name sur GitHub : elle n'existe pas, elle date d'avant la commande station, ou GitHub ne répond pas." \
        "${2:-Les versions publiées : https://github.com/$REPO/releases. En prendre une plus récente avec --version ; pour un essai, installer depuis une archive avec --from.}"
  done
  expected=$(awk '$2 == "station.tar.gz" { print $1 }' "$work/SHA256SUMS")
  actual=$(sha256sum "$work/station.tar.gz" | cut -d' ' -f1)
  [[ -n $expected && $actual == "$expected" ]] ||
    die "station.tar.gz de la version $1 ne correspond pas à sa somme, dans SHA256SUMS : rien n'est écrit." \
      "Relancer : un téléchargement peut s'abîmer. Si l'erreur revient, ne pas installer, et le signaler."
}

# Ouvre l'archive dans $work/files, et vérifie ce qu'elle porte.
unpack() { # archive
  local name
  mkdir -p "$work/files"
  tar -xzf "$1" -C "$work/files" ||
    die "$1 ne s'ouvre pas : archive abîmée, ou qui n'est pas station.tar.gz." "La télécharger à nouveau, puis relancer."
  for name in VERSION compose.yml Caddyfile station scripts/smoke.sh; do
    [[ -f $work/files/$name ]] ||
      die "$name manque dans $1 : ce n'est pas l'archive d'une station." "Prendre station.tar.gz d'une version publiée, ou le fabriquer : python3 scripts/version.py station main <dossier>."
  done
}

# Le domaine mène-t-il à cette machine, sur le port 80 ? Avant que Caddy
# demande un certificat : Let's Encrypt refuse un domaine un moment après
# quelques échecs. Un conteneur répond un jeton tiré au hasard sur le port 80,
# et chaque adresse du domaine, A et AAAA, doit le rendre. Les adresses se
# lisent dans un conteneur : dans le DNS, et non dans /etc/hosts. L'image est
# celle de Caddy, lue dans le compose.yml donné.
check_domain_here() { # compose.yml
  local image addresses address target answer token wrong=""
  image=$(sed -n 's/^ *image: *\(caddy:[^ ]*\) *$/\1/p' "$1" | head -n 1)
  [[ -n $image ]] || die "Le compose.yml de la version n'a pas d'image caddy." "Archive inattendue : la télécharger à nouveau."
  docker image inspect "$image" >/dev/null 2>&1 || docker pull -q "$image" >/dev/null ||
    die "L'image $image ne se tire pas." "Vérifier l'accès de la machine à Docker Hub, puis relancer."
  # Les deux réponses à la suite, chacune après sa ligne « Server: ».
  # shellcheck disable=SC2016
  addresses=$(docker run --rm "$image" sh -c 'nslookup -type=a "$1"; nslookup -type=aaaa "$1"' _ "$domain" 2>/dev/null |
    awk '/^Server:/ { answer = 0 } /^Name:/ { answer = 1; next } answer && /^Address:/ { print $2 }') || true
  [[ -n $addresses ]] ||
    die "Le domaine $domain ne mène à aucune adresse." \
      "Chez le registraire du domaine, créer un enregistrement A vers l'adresse IPv4 de cette machine, attendre qu'il se propage, puis relancer."
  token=$(openssl rand -hex 16)
  docker rm -f "$PROBE" >/dev/null 2>&1 || true
  docker run -d --rm --name "$PROBE" -p 80:80 "$image" caddy respond --listen :80 --body "$token" >/dev/null ||
    die "Le port 80 ne s'ouvre pas pour la vérification." "Voir ce qui le tient : ss -ltnp 'sport = :80'. Puis relancer."
  probe_started=1
  for address in $addresses; do
    target=$address
    [[ $address != *:* ]] || target="[$address]"
    # Les reprises laissent au conteneur le temps d'écouter.
    answer=$(curl --disable -sS --connect-timeout 5 --max-time 10 --retry 3 --retry-delay 1 --retry-connrefused \
      --resolve "$domain:80:$target" "http://$domain/.well-known/button-$token" 2>/dev/null) || answer=""
    [[ $answer == "$token" ]] || wrong="$wrong $address"
  done
  docker rm -f "$PROBE" >/dev/null 2>&1 || true
  probe_started=""
  [[ -z $wrong ]] ||
    die "Le domaine $domain mène à${wrong}, qui ne répond pas comme cette machine sur le port 80." \
      "Vérifier ses enregistrements A et AAAA chez le registraire, et le pare-feu de l'hébergeur pour le port 80. Un changement du DNS peut mettre une heure à se propager. Puis relancer."
  say "Domaine : $domain mène à cette machine ($(tr '\n' ' ' <<<"$addresses" | sed 's/ $//'))."
}

# --- Le dossier de la station ---

# Le dossier de la station, avec ceux qui manquent au-dessus. Sous une ACL par
# défaut qui les ouvre en écriture (check_acl), chacun la perd et reste à root,
# en 755 : ce qui s'y crée ensuite, par les conteneurs aussi, suit le umask.
make_station_dir() {
  local path=$dir created=()
  until [[ -e $path || -z $path ]]; do
    created+=("$path")
    path=${path%/*}
  done
  mkdir -p "$dir"
  [[ -n $acl_from ]] || return 0
  # Une station déjà là : son propre dossier.
  ((${#created[@]})) || created=("$dir")
  for path in "${created[@]}"; do
    setfacl -k -b "$path" ||
      die "setfacl ne retire pas l'ACL de $path." "La retirer à la main, setfacl -k -b $path && chmod 755 $path, puis relancer."
    chmod 755 "$path"
  done
}

# Les fichiers de la version : ce qui manque est posé, ce qui a changé est
# remis, et l'ancien gardé à côté. Rien d'autre du dossier n'est touché.
install_files() {
  local file mode stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  while IFS= read -r file; do
    file=${file#"$work/files/"}
    mode=$(stat -c %a "$work/files/$file")
    if [[ ! -e $dir/$file ]]; then
      install -D -m "$mode" "$work/files/$file" "$dir/$file"
      files_added="$files_added $file"
    elif ! cmp -s "$work/files/$file" "$dir/$file"; then
      mv -f "$dir/$file" "$dir/$file.local-$stamp"
      install -D -m "$mode" "$work/files/$file" "$dir/$file"
      files_restored="$files_restored $file"
    else
      chmod "$mode" "$dir/$file"
    fi
  done < <(find "$work/files" -type f | sort)
}

# .env : créé à la première installation, en droits 600. Ensuite, seule une
# variable qui manque s'ajoute : une valeur posée n'est jamais changée, sauf
# un mot de passe admin vide quand la base n'existe pas encore.
write_env() {
  local key value
  if [[ ! -e $env_file ]]; then
    local admin_password source_password admin_icecast nowplaying meili
    admin_password=$(password)
    source_password=$(secret)
    admin_icecast=$(secret)
    nowplaying=$(secret)
    meili=$(secret)
    # Vide et en 600 avant le moindre secret : une ACL par défaut sur le
    # dossier, comme celle de /opt sur un runner de GitHub, passe outre le
    # umask, mais pas le mode donné à la création.
    install -m 600 /dev/null "$env_file"
    cat >"$env_file" <<EOF
# La station, réglée par station install le $(date +%F). Les secrets sont ici :
# droits 600, et ce fichier n'entre dans aucun dépôt. Toutes les variables :
# .env.example, dans ce dossier. Une relance de station install n'y change
# rien : elle ajoute seulement ce qui manque.

# La version des images, la même que celle du dossier (VERSION).
BUTTON_VERSION=$version

# Sur Internet : Caddy devant la console, le flux et now.json, avec un
# certificat pour DOMAIN. Les autres ports n'écoutent que sur la machine.
COMPOSE_PROFILES=vps
DOMAIN=$domain
ACME_EMAIL=$email
BIND_ADDRESS=127.0.0.1
TZ=$timezone

# Le compte admin, créé au premier démarrage. Son mot de passe s'efface d'ici
# une fois affiché : il se change ensuite dans la console, Mon compte.
RT_ADMIN_USER=$admin
RT_ADMIN_PASSWORD=$admin_password

# Les secrets de machine, que personne ne tape.
ICECAST_SOURCE_PASSWORD=$source_password
ICECAST_ADMIN_PASSWORD=$admin_icecast
RT_NOWPLAYING_SECRET=$nowplaying
MEILI_MASTER_KEY=$meili

# Les mises à jour : auto, ou manual. station update les fait à la main ;
# auto, elles se feront seules, quand station update saura se lancer seule.
BUTTON_UPDATES=$updates
EOF
    alert_env_block >>"$env_file"
    if [[ $tls == internal ]]; then
      printf '\n# Un certificat de Caddy, pour un essai : les navigateurs le refusent.\nCADDY_TLS=internal\n' >>"$env_file"
    fi
    return 0
  fi
  chmod 600 "$env_file"
  env_has BUTTON_VERSION || env_add BUTTON_VERSION "$version"
  env_has COMPOSE_PROFILES || env_add COMPOSE_PROFILES vps
  env_has DOMAIN || env_add DOMAIN "$domain"
  env_has ACME_EMAIL || env_add ACME_EMAIL "$email"
  env_has BIND_ADDRESS || env_add BIND_ADDRESS 127.0.0.1
  env_has TZ || env_add TZ "$timezone"
  env_has RT_ADMIN_USER || env_add RT_ADMIN_USER "$admin"
  # Sans base, radiotomate-init crée le compte admin : il lui faut un mot de
  # passe, que la fin de l'installation affichera.
  if [[ -n $first && -z $(env_value RT_ADMIN_PASSWORD) ]]; then
    value=$(password)
    if env_has RT_ADMIN_PASSWORD; then
      env_replace RT_ADMIN_PASSWORD "$value"
      env_added="$env_added RT_ADMIN_PASSWORD"
    else
      env_add RT_ADMIN_PASSWORD "$value"
    fi
  fi
  for key in ICECAST_SOURCE_PASSWORD ICECAST_ADMIN_PASSWORD RT_NOWPLAYING_SECRET MEILI_MASTER_KEY; do
    if ! env_has "$key"; then
      value=$(secret)
      env_add "$key" "$value"
    fi
  done
  env_has BUTTON_UPDATES || env_add BUTTON_UPDATES "$updates"
}

make_data_dirs() {
  local key
  for key in "${DATA_DIRS[@]}"; do
    mkdir -p "$(env_path "${key%%:*}" "${key#*:}")"
  done
}

# /usr/local/bin/station mène au script du dossier : une mise à jour du
# dossier met aussi la commande à jour.
link_command() {
  local target=$dir/station
  if [[ -L $BIN ]]; then
    [[ $(readlink "$BIN") != "$target" ]] || return 0
    warn "$BIN menait à $(readlink "$BIN") : il mène maintenant à $target."
  elif [[ -e $BIN ]]; then
    warn "$BIN existe et n'est pas un lien : laissé tel quel. La commande de cette station est $target."
    return 0
  fi
  mkdir -p "${BIN%/*}"
  ln -sfn "$target" "$BIN"
}

ghcr_login() {
  local registry host user
  [[ -r $token_file ]] || die "Jeton illisible : $token_file." "Donner le chemin d'un fichier qui contient le jeton GitHub, lisible par root."
  registry=$(env_value BUTTON_IMAGES ghcr.io/lazbutton)
  host=${registry%%/*}
  user=${registry#*/}
  user=${user%%/*}
  tr -d '[:space:]' <"$token_file" | docker login "$host" --username "$user" --password-stdin >/dev/null ||
    die "$host refuse le jeton de $token_file." "Il doit lire les images (read:packages) et ne pas avoir expiré. En créer un autre, puis relancer."
  say "Registre : connecté à $host. Docker garde le jeton dans /root/.docker/config.json, pour les mises à jour."
}

# --- Démarrer et contrôler ---

# https://$domain répond-il, avec son certificat ? Jusqu'à HTTPS_WAIT s.
https_ok() {
  local args=(--disable -sS -o /dev/null --max-time 10) deadline=$((SECONDS + HTTPS_WAIT))
  if [[ $tls == internal ]]; then
    args+=(--cacert "$(env_path CADDY_DATA ./data/caddy)/pki/authorities/local/root.crt" --resolve "$domain:443:127.0.0.1")
  fi
  until curl "${args[@]}" "https://$domain/" 2>/dev/null; do
    ((SECONDS < deadline)) || return 1
    sleep 5
  done
}

wait_https() {
  https_ok ||
    die "https://$domain ne répond pas au bout de $HTTPS_WAIT s : le certificat manque encore." \
      "Voir pourquoi : cd $dir && docker compose logs caddy. Puis relancer station install."
  say "HTTPS : https://$domain répond."
}

# Le contrôle de la station, smoke.sh : par ses adresses publiques, en HTTPS,
# ou par les ports de la machine.
smoke_ok() {
  local console stream
  if [[ $tls == internal || -z $domain ]]; then
    # Les navigateurs, et curl, refusent le certificat de Caddy ; une station
    # sans domaine n'a que ses ports.
    console=http://127.0.0.1:$(env_value CONSOLE_PORT 30126)
    stream=http://127.0.0.1:$(env_value ICECAST_PORT 18000)/$(stream_mount)
  else
    console=https://$domain
    stream=https://$domain/$(stream_mount)
  fi
  (cd "$dir" && SMOKE_WAIT=${SMOKE_WAIT:-300} scripts/smoke.sh "$console" "$stream")
}

smoke() {
  smoke_ok ||
    die "" "Le contrôle de la station a échoué : voir plus haut. Une fois réglé, relancer station install, qui reprend où il en était."
}

# Le nom et les adresses publiques, dans les réglages Station du moteur : sans
# eux, la console reprendrait ceux de sa marque par défaut. Une seule fois, sur
# une station qui n'a encore aucun réglage Station : une ligne posée n'est
# jamais changée, et une ligne qu'un admin a retirée ne revient pas. Ensuite,
# ils se changent dans la console, Réglages → Station.
station_settings() {
  local harbor written
  harbor=$(env_value HARBOR_PORT 6800)
  [[ $harbor =~ ^[0-9]+$ ]] || harbor=""
  written=$(compose exec -T -e "BUTTON_NAME=$name" -e "BUTTON_DOMAIN=$domain" -e "BUTTON_HARBOR_PORT=$harbor" -e "BUTTON_MOUNT=$(stream_mount)" \
    radiotomate-interface python3 - <<'PY'
import os
import sqlite3
from contextlib import closing

domain = os.environ["BUTTON_DOMAIN"]
values = {
    "station.name": os.environ.get("BUTTON_NAME", ""),
    "station.public_stream_url": f"https://{domain}/{os.environ['BUTTON_MOUNT']}",
    "station.now_url": f"https://{domain}/now.json",
    "station.status_url": f"https://{domain}/status-json.xsl",
    "station.harbor_host": domain,
    "station.harbor_port": os.environ.get("BUTTON_HARBOR_PORT", ""),
}
with closing(sqlite3.connect("/data/radiotomate.db")) as con, con:
    if con.execute("select 1 from settings where key like 'station.%' limit 1").fetchone():
        raise SystemExit(0)
    for key, value in values.items():
        added = con.execute(
            "insert or ignore into settings (key, value) values (?, ?)", (key, value)
        ).rowcount if value else 0
        if added:
            print(key)
PY
  ) || die "Les réglages de la station ne s'écrivent pas." "Voir : cd $dir && docker compose logs radiotomate-interface. Puis relancer station install."
  if [[ -n $written ]]; then
    say "Réglages Station : nom et adresses publiques posés."
  fi
}

# Le mot de passe admin, une seule fois, dans un terminal. Il s'efface ensuite
# de .env, et radiotomate-init repasse sans lui : sinon, un compte admin
# supprimé reviendrait avec ce mot de passe (docs/deploiement.md, « Les secrets »).
admin_password() {
  local password restarted=1
  password=$(env_value RT_ADMIN_PASSWORD)
  if ! terminal; then
    say "Mot de passe admin : pas affiché, la sortie n'est pas un terminal. Il reste dans $env_file, en droits 600, jusqu'à ce que station install l'affiche, une fois, dans un terminal."
    return 0
  fi
  env_replace RT_ADMIN_PASSWORD ""
  compose up -d >/dev/null 2>&1 || restarted=""
  say "" "Compte admin : $(env_value RT_ADMIN_USER admin)" \
    "Mot de passe : $password" \
    "  Affiché cette fois seulement : le noter maintenant. Il se change dans la console, Mon compte."
  [[ -n $restarted ]] ||
    die "La station ne repart pas sans le mot de passe dans .env." "Voir : cd $dir && docker compose logs radiotomate-init. Puis relancer station install."
}

cleanup() {
  # Le code de sortie de la commande, lu avant toute autre commande.
  local status=$?
  # Ce qui reste à défaire va jusqu'au bout : ni une erreur, ni un message qui
  # ne s'écrit plus (terminal fermé, | tee arrêté), ni un second Ctrl-C ne
  # l'arrêtent.
  set +e
  trap '' INT TERM HUP PIPE
  # Une sauvegarde hors de la machine, ou un test, qui s'arrête en erreur.
  if ((${#remote_job[@]})) && ((status != 0)); then
    remote_failed "$status"
  fi
  remote_job=()
  [[ -z ${probe_started:-} ]] || docker rm -f "$PROBE" >/dev/null 2>&1 || true
  if [[ -n ${caddy_stopped:-} ]]; then
    (cd "$caddy_stopped" && docker compose up -d caddy >/dev/null 2>&1) ||
      warn "Caddy ne repart pas : cd $caddy_stopped && docker compose up -d caddy."
  fi
  [[ -z ${partial:-} ]] || rm -f "$partial"
  if [[ -n ${station_stopped:-} ]]; then
    restore_undo
  fi
  if ((${#updating[@]})) && [[ -n ${rolling_back:-} ]]; then
    rollback_failed
  elif ((${#updating[@]})); then
    # Une fois les fichiers touchés, la station revient à la version d'avant.
    case $update_stage in
      "les fichiers" | "le redémarrage" | "le contrôle") update_undo ;;
      *) update_log échouée "pendant $update_stage" ;;
    esac
    updating=()
  fi
  local path
  for path in "${prepared[@]}"; do
    rm -rf "$path"
  done
  [[ -z ${work:-} ]] || rm -rf "$work"
  [[ -z ${staged:-} ]] || rm -rf "$staged"
  return 0
}

# --- install ---

cmd_install() {
  local dir="" name="" domain="" email="" timezone="" admin="" updates="" version="" from=""
  local token_file="" tls="" assume_yes="" domain_check=1
  local given=" " option value
  # Les options des alertes, comme celles de station config, et leurs réglages.
  local -A opts=()
  local alert_station="" alert_ntfy="" alert_ntfy_token="" alert_email="" alert_from="" alert_sender=""
  local alert_smtp="" alert_smtp_user="" alert_smtp_password=""
  while (($#)); do
    option=$1
    case $option in
      --yes | --no-domain-check | -h | --help) shift ;;
      --*=*)
        value=${option#*=}
        option=${option%%=*}
        shift
        ;;
      --*)
        (($# >= 2)) || usage_error "$option attend une valeur."
        value=$2
        shift 2
        ;;
      *) usage_error "Argument inattendu : $option." ;;
    esac
    case $option in
      --dir) dir=$value ;;
      --name) name=$(trim "$value") ;;
      --domain) domain=${value,,} ;;
      --email) email=$value ;;
      --timezone) timezone=$value ;;
      --admin) admin=$value ;;
      --updates) updates=$value ;;
      --version) version=$value ;;
      --from) from=$value ;;
      --github-token-file) token_file=$value ;;
      --tls) tls=$value ;;
      --yes) assume_yes=1 ;;
      --no-domain-check) domain_check="" ;;
      --alert-ntfy | --alert-ntfy-token-file | --alert-email | --alert-smtp | --alert-smtp-user | \
        --alert-smtp-password-file | --alert-from) opts[$option]=$value ;;
      -h | --help)
        usage_install
        return 0
        ;;
      *) usage_error "Option inconnue : $option." ;;
    esac
    given="$given${option#--} "
  done
  alert_check_options
  [[ -z $tls || $tls == internal || $tls == acme ]] || usage_error "--tls vaut internal, ou acme, la valeur par défaut."
  [[ -z $dir || $dir == /* ]] || usage_error "--dir attend un chemin absolu, comme /opt/button."
  [[ -z $from || -f $from ]] || usage_error "--from : $from n'existe pas."
  if [[ -n $version && $version != stable && -z $from ]]; then
    check_version "$version" || exit 2
  fi

  dir=${dir:-$(default_dir)}
  dir=${dir%/}
  local env_file=$dir/.env env_added="" files_added="" files_restored="" os_id="" os_codename="" acl_from=""
  trap cleanup EXIT
  env_isolate

  say "BUTTON : installation de la station, dans $dir."
  check_machine
  lock_station install
  check_acl
  check_docker
  # Le reste d'une vérification du domaine interrompue tiendrait le port 80.
  docker rm -f "$PROBE" >/dev/null 2>&1 || true
  check_disk
  # running : Caddy tourne, la station a son certificat et ses images. Une
  # station qui tourne sans lui, Caddy tombé par exemple, tient encore le
  # port du direct : ses ports ne se vérifient pas non plus.
  local running=""
  if station_running caddy; then
    running=1
    say "Ports : la station tourne déjà, avec son Caddy."
  elif station_running; then
    say "Ports : la station tourne déjà, sans son Caddy."
  else
    check_ports
  fi

  # Une installation n'est finie qu'une fois le mot de passe admin affiché, et
  # effacé de .env. Jusque-là, le nom de la station se demande encore, et les
  # réglages Station se posent. Une base absente demande aussi un compte admin.
  local first=""
  if [[ ! -f $env_file || -n $(env_value RT_ADMIN_PASSWORD) ||
    ! -f $(env_path RT_DATA ./data/radiotomate)/radiotomate.db ]]; then
    first=1
  fi
  if [[ -f $env_file ]]; then
    say "Réponses : celles de $env_file, déjà là."
  elif interactive; then
    local answer missing=""
    # Les alertes se demandent quand aucune de leurs options n'est donnée.
    alert_options_given || missing=1
    for answer in name domain email timezone admin updates; do
      [[ $given == *" $answer "* ]] || missing=1
    done
    [[ -z $missing ]] || say "" "Quelques questions. Entrée garde la valeur entre crochets."
  fi
  if [[ -n $first ]]; then
    name=$(choose "" name "$name" BUTTON check_name "Nom de la station")
  elif [[ $given == *" name "* ]]; then
    warn "--name n'est pas pris : la station est installée, son nom se change dans la console, Réglages → Station."
  fi
  domain=$(choose DOMAIN domain "$domain" "" check_domain "Domaine, qui pointe déjà sur cette machine")
  domain=${domain,,}
  email=$(choose ACME_EMAIL email "$email" "" check_email "E-mail du compte Let's Encrypt, facultatif")
  timezone=$(choose TZ timezone "$timezone" Europe/Paris check_timezone "Fuseau de la station")
  admin=$(choose RT_ADMIN_USER admin "$admin" admin check_admin "Identifiant du compte admin")
  updates=$(choose_updates)
  # Les alertes se règlent à la première installation : ensuite, station
  # config les change.
  local alerts_first=""
  if [[ ! -f $env_file ]]; then
    alerts_first=1
    alert_questions
  elif alert_options_given; then
    warn "les options --alert-… ne sont pas prises : la station est installée, et station config change ses alertes."
  fi
  if [[ -f $env_file ]]; then
    local current_tls
    current_tls=$(env_value CADDY_TLS acme)
    if [[ -n $tls && $tls != "$current_tls" ]]; then
      warn "--tls $tls n'est pas pris : la station a déjà CADDY_TLS=$current_tls, que station install ne change pas."
    fi
    tls=$current_tls
  fi
  tls=${tls:-acme}

  work=$(mktemp -d)
  if [[ -f $env_file ]]; then
    local installed
    installed=$(env_value BUTTON_VERSION)
    [[ -n $installed ]] ||
      die "BUTTON_VERSION manque dans $env_file." "Y remettre la version de la station, celle du fichier VERSION du dossier, puis relancer."
    if [[ -n $version && $version != "$installed" ]]; then
      warn "--version $version n'est pas prise : la station est en $installed, et station install ne change pas de version."
    fi
    version=$installed
  fi
  if [[ -n $from ]]; then
    unpack "$from"
    local packed
    packed=$(<"$work/files/VERSION")
    [[ -z $version || $version == "$packed" ]] ||
      die "$from est la version $packed, et la station la $version." "Prendre l'archive de la version $version."
    version=$packed
    say "Version : $version, depuis $from."
  else
    if [[ -z $version || $version == stable ]]; then
      version=$(latest_version)
      check_version "$version" || die "GitHub donne une version inattendue : ne pas installer, et le signaler."
      say "Version : $version, la plus haute publiée."
    else
      check_version "$version" ||
        die "La station est en $version : seule une archive de cette version la répare, avec --from."
      say "Version : $version."
    fi
    fetch_version "$version"
    unpack "$work/station.tar.gz"
    [[ $(<"$work/files/VERSION") == "$version" ]] ||
      die "L'archive de la version $version se dit $(<"$work/files/VERSION")." "Archive inattendue : ne pas installer, et le signaler."
  fi

  if [[ $tls == internal ]]; then
    say "Domaine : pas vérifié, Caddy signe lui-même le certificat (--tls internal)."
  elif [[ -n $running ]]; then
    say "Domaine : pas vérifié, la station a déjà son certificat."
  elif [[ -z $domain_check ]]; then
    warn "le domaine n'est pas vérifié (--no-domain-check). S'il ne mène pas ici, Let's Encrypt le refusera un moment."
  else
    check_domain_here "$work/files/compose.yml"
  fi
  # Un essai par chaque canal des alertes, avant de rien écrire.
  [[ -z $alerts_first ]] || alert_verify

  make_station_dir
  install_files
  write_env
  make_data_dirs
  link_command
  env_isolate
  if [[ -n $files_added$files_restored$env_added ]]; then
    say "Dossier : $dir, à la version $version."
    [[ -z $files_restored ]] || say "  Remis à la version :$files_restored. L'ancien est gardé à côté, en .local-… : les changements d'une station vont dans compose.override.yml."
    [[ -z $env_added ]] || say "  Ajouté à .env :$env_added."
  else
    say "Dossier : $dir, rien à réparer."
  fi

  [[ -z $token_file ]] || ghcr_login
  # Une station qui tourne garde ses images : seule une image qui manque se
  # tire, par up. Sinon, une relance prendrait la dernière caddy:2.11-alpine,
  # et recréerait Caddy.
  say "Démarrage : les images de la version $version."
  if [[ -z $running ]]; then
    compose pull ||
      die "Les images de la version $version ne se tirent pas." \
        "Images privées : relancer avec --github-token-file, un jeton GitHub qui a read:packages. Sinon, vérifier l'accès de la machine à ghcr.io, puis relancer."
  fi
  compose up -d ||
    die "La station ne démarre pas : voir le message de docker compose plus haut." \
      "Si radiotomate-init a échoué : cd $dir && docker compose logs radiotomate-init. Puis relancer station install."
  wait_https
  smoke
  if [[ -n $first ]]; then
    station_settings
  fi

  say "" "La station tourne : l'antenne joue."
  say "  Console : https://$domain$([[ $tls != internal ]] || echo ', avec un certificat que les navigateurs refusent')"
  say "  Flux : https://$domain/$(stream_mount)"
  say "  Direct : $domain, port $(env_value HARBOR_PORT 6800), avec le jeton d'encodeur de chaque compte"
  say "  Dossier : $dir, et la commande : station"
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    say "  Mises à jour : station update, et automatiques dès qu'elle saura se lancer seule"
  else
    say "  Mises à jour : à la main, par station update"
  fi
  alert_summary
  record_versions
  # Les minuteurs de la sauvegarde hors de la machine, si .env la règle :
  # après une désinstallation qui a gardé les données, par exemple. Puis celui
  # des demandes de la console, sans une demande restée d'avant : personne ne
  # l'a redemandée.
  remote_timers || true
  requests_forget "La station a été réinstallée, ou réparée : la redemander, si elle sert encore."
  requests_timer || true
  if [[ -n $first ]]; then
    admin_password
  fi
}

# choose <clé de .env> <option> <valeur de l'option> <défaut> <contrôle> <question>
# La valeur de .env si elle y est ; sinon celle de l'option ; sinon la réponse
# au clavier ; sinon le défaut. Une option qui contredit .env ne change rien.
# Sans défaut ni clavier, l'option est obligatoire.
choose() {
  local key=$1 option=$2 value=$3 default=$4 check=$5 question=$6 current
  if [[ -n $key && -f $env_file ]] && env_has "$key"; then
    current=$(env_value "$key")
    if [[ $given == *" $option "* && $value != "$current" ]]; then
      warn "--$option $value n'est pas pris : la station a déjà $key=$current, que station install ne change pas."
    fi
    printf '%s\n' "$current"
  elif [[ $given == *" $option "* ]]; then
    "$check" "$value" || exit 2
    printf '%s\n' "$value"
  elif interactive; then
    ask "$question" "$default" "$check"
  elif [[ -n $default || $option == email ]]; then
    printf '%s\n' "$default"
  else
    die "--$option manque : sans terminal, ou avec --yes, rien ne se demande." "Relancer avec --$option, par exemple --domain radio.example."
  fi
}

# Comme choose, mais la question se répond par oui ou non.
choose_updates() {
  local answer
  if { [[ -f $env_file ]] && env_has BUTTON_UPDATES; } || [[ $given == *" updates "* ]] || ! interactive; then
    choose BUTTON_UPDATES updates "$updates" auto check_updates ""
    return $?
  fi
  answer=$(ask "Mises à jour automatiques, dès que station update saura se lancer seule ? (o/n)" o check_yes_no)
  if [[ ${answer,,} == [oy]* ]]; then echo auto; else echo manual; fi
}

# Le dossier de la station : celui de ce script s'il est déjà celui d'une
# station, puisque la commande posée sur la machine y mène ; sinon celui où
# mène cette commande, pour le script téléchargé, relancé ; sinon /opt/button.
default_dir() {
  local script folder
  for script in "${BASH_SOURCE[0]:-}" "$BIN"; do
    script=$(readlink -f "$script" 2>/dev/null) || continue
    folder=${script%/*}
    if [[ -f $folder/VERSION && -f $folder/compose.yml ]]; then
      printf '%s\n' "$folder"
      return 0
    fi
  done
  printf '%s\n' "$DEFAULT_DIR"
}

# --- Exploiter la station ---

# Les options d'une commande : un drapeau connu, ou une option connue suivie
# de sa valeur, --nom VALEUR ou --nom=VALEUR. Elles vont dans le tableau
# associatif opts de la commande, les autres arguments dans args.
parse_options() { # "drapeaux…", "options à valeur…", arguments…
  local flags=" $1 " valued=" $2 " option
  shift 2
  while (($#)); do
    option=$1
    shift
    case $option in
      --*=*)
        [[ $valued == *" ${option%%=*} "* ]] || usage_error "Option inconnue : ${option%%=*}."
        opts[${option%%=*}]=${option#*=}
        ;;
      -*)
        if [[ $flags == *" $option "* ]]; then
          opts[$option]=1
        elif [[ $valued == *" $option "* ]]; then
          (($#)) || usage_error "$option attend une valeur."
          opts[$option]=$1
          shift
        else
          usage_error "Option inconnue : $option."
        fi
        ;;
      *) args+=("$option") ;;
    esac
  done
}

help_asked() { [[ -n ${opts[-h]:-}${opts[--help]:-} ]]; }

# Le dossier de la station d'une commande : --dir, sinon default_dir.
station_dir() { # --dir donné, ou rien
  [[ -z $1 || $1 == /* ]] || usage_error "--dir attend un chemin absolu, comme /opt/button."
  dir=${1:-$(default_dir)}
  dir=${dir%/}
  env_file=$dir/.env
}

need_root() { # commande
  [[ $(id -u) == 0 ]] ||
    die "station $1 demande les droits root." "Relancer avec sudo : sudo station $1."
}

need_station() { # commande
  local missing=""
  [[ -f $dir/compose.yml ]] || missing="$missing compose.yml"
  [[ -f $env_file ]] || missing="$missing .env"
  [[ -z $missing ]] ||
    die "Pas de station dans $dir : il y manque$missing." \
      "L'installer, ou la réparer : station install. Une station ailleurs : station $1 --dir DOSSIER."
}

# Le début de chaque commande : son dossier, root, sa station, puis .env seul
# règle docker compose.
open_station() { # commande, --dir donné, ou rien
  station_dir "$2"
  need_root "$1"
  need_station "$1"
  env_isolate
}

# Une commande qui change la station la prend pour elle seule : une
# restauration, une réparation par install et une mise à jour (MAJ-04) ne se
# croisent pas. Le verrou tombe avec la commande. STATION_LOCK_WAIT, en
# secondes, fait attendre qu'il se libère : les minuteurs de la sauvegarde
# hors de la machine le posent, plutôt que d'échouer pendant une mise à jour.
# Sans elle, une seconde : station requests le prend un instant, pour voir
# s'il est libre. Pris, la commande sort avec LOCK_BUSY.
lock_station() { # commande
  local wait=${STATION_LOCK_WAIT:-}
  mkdir -p "${LOCK%/*}"
  exec 9>>"$LOCK"
  flock -n 9 && return 0
  if [[ $wait =~ ^[0-9]{1,6}$ ]] && ((wait > 0)); then
    say "Une autre commande station tourne : station $1 attend qu'elle finisse, $([[ $wait -ge 120 ]] && echo "$((wait / 60)) min" || echo "$wait s") au plus."
    flock -w "$wait" 9 && return 0
  elif flock -w 1 9; then
    return 0
  fi
  died="Une autre commande station tourne déjà sur cette machine."
  printf '%s\n' "$died" "Attendre qu'elle finisse, puis relancer station $1." >&2
  exit "$LOCK_BUSY"
}

# La version de la station : celle que .env épingle, sinon celle du dossier.
installed_version() {
  local version
  version=$(env_value BUTTON_VERSION)
  if [[ -z $version && -f $dir/VERSION ]]; then
    version=$(<"$dir/VERSION")
  fi
  printf '%s\n' "${version:-inconnue}"
}

# Une taille en Ko, lisible : 850 Ko, 12 Mo, 3,4 Go.
human_kb() {
  awk -v kb="$1" 'BEGIN {
    if (kb < 1024) { printf "%d Ko\n", kb; exit }
    if (kb < 1048576) { printf "%d Mo\n", kb / 1024; exit }
    size = sprintf(kb < 10485760 ? "%.1f" : "%d", kb / 1048576)
    sub(/\./, ",", size)
    print size " Go"
  }'
}

# Une heure, à celle de la station (TZ de .env) : 10/11/2026 à 13:00.
station_date() { # secondes depuis 1970
  TZ=$(env_value TZ Europe/Paris) date -d "@$1" '+%d/%m/%Y à %H:%M'
}

# Le temps passé depuis, en mots : 12 min, 5 h, 3 jours.
since() { # secondes depuis 1970
  local seconds=$(($(date +%s) - $1))
  if ((seconds < 3600)); then
    echo "$((seconds < 60 ? 1 : seconds / 60)) min"
  elif ((seconds < 2 * 86400)); then
    echo "$((seconds / 3600)) h"
  else
    echo "$((seconds / 86400)) jours"
  fi
}

# La place libre et la taille, en Ko, et le point de montage, là où vit ce
# chemin, ou son plus proche parent.
df_line() { # chemin
  df -Pk "$(existing_parent "$1")" 2>/dev/null | awk 'NR == 2 { print $4, $2, $6 }'
}

mount_of() { # chemin
  local line
  line=$(df_line "$1")
  printf '%s\n' "${line##* }"
}

# Assez de place, là où vit ce chemin, pour y écrire tant de Ko, et la marge ?
space_for() { # chemin, Ko, que faire sinon
  local line free need=$(($2 + SPACE_MARGIN_KB))
  line=$(df_line "$1")
  free=${line%% *}
  [[ $free =~ ^[0-9]+$ ]] || return 0
  ((free >= need)) ||
    die "Pas assez de place pour $1 : $(human_kb "$free") libres, il en faut $(human_kb "$need")." "$3"
}

# Assez de place, là où vit ce chemin, pour y écrire tant de Ko ? Comme
# space_for, sans arrêter la commande : le retour arrière le demande.
room_for() { # chemin, Ko
  local line free
  line=$(df_line "$1")
  free=${line%% *}
  [[ $free =~ ^[0-9]+$ ]] || return 0
  ((free >= $2))
}

# La taille de ces chemins, en Ko, 0 pour un chemin absent. Un fichier qui
# bouge pendant le calcul, déposé ou rangé, ne l'arrête pas.
size_kb() { # chemin…
  local kb
  kb=$(du -skc "$@" 2>/dev/null | tail -n 1 | cut -f1) || true
  [[ $kb =~ ^[0-9]+$ ]] || kb=0
  printf '%s\n' "$kb"
}

# Le dossier réel, au bout d'un lien symbolique : celui que tar lit, et que
# restore remplace.
real_path() { # chemin
  readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"
}

# Un point de montage ne se déplace pas, ni ne se remplace par un dossier.
mounted() { # chemin
  command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$1"
}

# Le nom de la banque de sons dans une archive : celui de son dossier, sans
# barre oblique ni tiret en tête, et pas celui d'un autre fichier de l'archive.
media_name_ok() { # nom
  local member
  [[ -n $1 && $1 != */* && $1 != -* && $1 != . && $1 != .. && $1 != *$'\n'* ]] || return 1
  for member in SHA256SUMS "${BACKUP_FILES[@]}"; do
    [[ $1 != "$member" ]] || return 1
  done
}

# Tous les profils de compose.yml, en options, dans le tableau profiles de
# l'appelant : un conteneur de share ou de cloud lancé à part compte aussi.
all_profiles() {
  local profile
  profiles=()
  while IFS= read -r profile; do
    [[ -z $profile ]] || profiles+=(--profile "$profile")
  done < <(compose config --profiles 2>/dev/null)
}

# Sans terminal ni --yes, ce qui se confirme ne se fait pas : à vérifier
# avant le travail, que la question vienne au début ou à la fin.
confirm_possible() { # commande
  [[ -n $assume_yes ]] || interactive ||
    die "Sans terminal, station $1 attend --yes pour se faire." "Relancer avec --yes, une fois sûr."
}

# Oui ou non, au clavier ; --yes répond oui.
confirm() { # commande, question
  [[ -z $assume_yes ]] || return 0
  confirm_possible "$1"
  local answer
  answer=$(ask "$2" n check_yes_no)
  [[ ${answer,,} == [oy]* ]] || die "" "$aborted"
}

# Un mot à taper, pour ce qui ne se défait pas ; --yes le tape.
confirm_word() { # commande, mot, question
  [[ -z $assume_yes ]] || return 0
  confirm_possible "$1"
  local answer
  printf '  %s ' "$3" >&2
  IFS= read -r answer || die "" "$aborted"
  [[ $(trim "$answer") == "$2" ]] || die "" "$aborted"
}

# Un programme dans l'image du moteur, avec ses données : un conteneur de
# radiotomate-init, en root, qui ne démarre rien d'autre, que la station tourne
# ou non. L'image a bash, tar et Python : l'hôte n'a besoin ni de sqlite3, ni de
# Python. Ce qu'il écrit sur sa sortie d'erreur ne s'affiche que s'il échoue.
# Il lit l'entrée standard : un script qui n'en a pas besoin reçoit /dev/null,
# et ne prend rien de ce qui se tape au clavier.
engine_run() { # options de docker compose run…
  compose run --rm --no-deps -T "$@" 2>"$work/moteur.log" || {
    cat "$work/moteur.log" >&2
    return 1
  }
}

# backup-radiotomate.sh, dans l'image du moteur : la base, copiée sans couper
# l'antenne, radiotomate.yaml et le reste de RT_DATA, avec leurs sommes. Sa
# copie de travail va dans le dossier donné, pas dans le /tmp du conteneur.
# Le script est celui du dossier de la station, ou celui d'une autre version :
# update prend celui de la version visée, car celui d'une 0.2.0 demande
# sqlite3, que l'image du moteur n'a pas.
engine_backup() { # dossier où écrire radiotomate.tar.gz, dossier de travail, script ou rien
  engine_run -v "${3:-$dir/scripts/backup-radiotomate.sh}:/backup-radiotomate.sh:ro" -v "$1:/sauvegarde" \
    -v "$2:/travail" -e TMPDIR=/travail \
    --entrypoint bash radiotomate-init /backup-radiotomate.sh /data /sauvegarde/radiotomate.tar.gz </dev/null >/dev/null
}

# restore-radiotomate.sh, dans l'image du moteur : l'archive de la base, ses
# sommes et la base vérifiées, dans un dossier vide.
engine_restore() { # radiotomate.tar.gz, dossier vide, dossier de travail
  engine_run -v "$dir/scripts/restore-radiotomate.sh:/restore-radiotomate.sh:ro" \
    -v "$1:/sauvegarde.tar.gz:ro" -v "$2:/cible" -v "$3:/travail" -e TMPDIR=/travail \
    --entrypoint bash radiotomate-init /restore-radiotomate.sh /sauvegarde.tar.gz /cible </dev/null >/dev/null
}

# La version du schéma de la base en place, puis celle de la base d'un dossier.
engine_schemas() { # dossier
  engine_run -v "$1:/cible" --entrypoint python3 radiotomate-init - <<'PY'
# schémas : la version de la base en place, puis celle de la base remise.
import sqlite3
from contextlib import closing

for path in ("/data/radiotomate.db", "/cible/radiotomate.db"):
    with closing(sqlite3.connect(path)) as con:
        row = con.execute("select value from settings where key = 'SCHEMA_VERSION'").fetchone()
    print(row[0] if row else "")
PY
}

# La version du schéma de la base en place, ou rien si elle ne se lit pas,
# puis l'état d'une copie de RT_DATA/backups, comme celles qu'une migration
# fait d'abord : ok, ou ce que disent integrity_check ou SQLite. Le schéma de
# la copie se lit dans son nom (copy_schema) : une copie abîmée le garde.
engine_copy_check() { # nom de la copie
  engine_run -e "BUTTON_COPY=$1" --entrypoint python3 radiotomate-init - <<'PY'
# copie : la version du schéma de la base en place, puis l'état de la copie.
import os
import sqlite3
from contextlib import closing

try:
    with closing(sqlite3.connect("/data/radiotomate.db")) as con:
        row = con.execute("select value from settings where key = 'SCHEMA_VERSION'").fetchone()
    print(row[0] if row else "")
except sqlite3.Error:
    print("")
try:
    # En lecture seule : une copie qui manque ne se crée pas, vide.
    copy = "file:/data/backups/" + os.environ["BUTTON_COPY"] + "?mode=ro"
    with closing(sqlite3.connect(copy, uri=True)) as con:
        state = " ".join(str(row[0]) for row in con.execute("pragma integrity_check"))
except sqlite3.Error as error:
    state = str(error) or "illisible"
print(state.replace("\n", " ")[:200])
PY
}

# Une copie de RT_DATA/backups remise à la place de la base, moteur arrêté :
# restore-radiotomate.sh, dans l'image du moteur, garde à côté la base qu'elle
# remplace, dans backups/avant-restauration-….db. Le script est donné : celui
# d'une 0.2.0 demande sqlite3, que l'image n'a pas.
engine_restore_copy() { # nom de la copie, script de restauration
  engine_run -v "$2:/restore-radiotomate.sh:ro" \
    --entrypoint bash radiotomate-init /restore-radiotomate.sh "/data/backups/$1" /data </dev/null >/dev/null
}

# Les adresses publiques des réglages Station qui suivaient l'ancien domaine
# passent au nouveau. Celles qu'un admin a changées dans la console restent.
# Elles se forment comme dans station_settings. Écrit les clés changées.
engine_domain_settings() { # ancien domaine, nouveau
  engine_run -e "BUTTON_OLD=$1" -e "BUTTON_NEW=$2" -e "BUTTON_MOUNT=$(stream_mount)" \
    --entrypoint python3 radiotomate-init - <<'PY'
# domaine : les adresses publiques des réglages Station, de l'ancien au nouveau.
import os
import sqlite3
from contextlib import closing

old, new = os.environ["BUTTON_OLD"], os.environ["BUTTON_NEW"]
addresses = {
    "station.public_stream_url": "https://{}/" + os.environ["BUTTON_MOUNT"],
    "station.now_url": "https://{}/now.json",
    "station.status_url": "https://{}/status-json.xsl",
    "station.harbor_host": "{}",
}
with closing(sqlite3.connect("/data/radiotomate.db", timeout=30)) as con, con:
    for key, address in addresses.items():
        changed = con.execute(
            "update settings set value = ? where key = ? and value = ?",
            (address.format(new), key, address.format(old)),
        ).rowcount
        if changed:
            print(key)
PY
}

# --- status ---

cmd_status() {
  local dir="" env_file="" domain healthy=1
  local -A opts=()
  local args=()
  parse_options "-h --help" "--dir" "$@"
  if help_asked; then
    usage_command status
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  open_station status "${opts[--dir]:-}"
  domain=$(env_value DOMAIN)
  say "Station : $dir${domain:+, https://$domain}"
  journal_report || healthy=""
  version_report
  updates_report
  services_report || healthy=""
  disk_report
  next_live_report
  backup_report
  remote_report
  alerts_report
  [[ -n $healthy ]]
}

# Une restauration coupée en plein échange, par un arrêt de la machine.
journal_report() {
  [[ -f $dir/$JOURNAL ]] || return 0
  warn "une restauration ne s'est pas finie. $dir/$JOURNAL dit, ligne à ligne, le dossier en place, celui d'avant, mis à côté, et celui de la sauvegarde :"
  grep -v '^#' "$dir/$JOURNAL" | sed 's/^/  /' >&2
  say "  Pour revenir à la station d'avant : cd $dir && docker compose stop, remettre chaque dossier d'avant à sa place, effacer $JOURNAL, puis docker compose up -d. Ou relancer station restore."
  return 1
}

version_report() {
  local installed latest
  installed=$(installed_version)
  latest=$(latest_version 5 2>/dev/null) || latest=""
  if [[ -z $latest ]]; then
    say "Version : $installed. La plus haute publiée ne se lit pas : GitHub ne répond pas."
  elif [[ $latest == "$installed" ]]; then
    say "Version : $installed, la plus haute publiée."
  else
    say "Version : $installed ; la plus haute publiée : $latest, https://github.com/$REPO/releases"
  fi
}

# Les mises à jour, comme install les note : automatiques seulement avec
# BUTTON_UPDATES=auto, ou sans la ligne.
updates_label() {
  local time
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    time=$(env_value BUTTON_UPDATE_TIME)
    printf 'automatiques, à %s (%s)\n' "${time:-$UPDATE_TIME}" "$(env_value TZ Europe/Paris)"
  else
    printf 'à la main\n'
  fi
}

updates_report() {
  local line made from to result _backup detail
  if [[ $(env_value BUTTON_UPDATES auto) == auto ]]; then
    say "Mises à jour : $(updates_label), dès que station update saura se lancer seule. D'ici là, à la main : station update."
  else
    say "Mises à jour : à la main, par station update."
  fi
  line=$(grep -v '^#' "$dir/updates.log" 2>/dev/null | tail -n 1) || line=""
  IFS=$'\t' read -r made from to result _backup detail <<<"$line"
  if [[ $made =~ ^[0-9]+$ ]]; then
    say "  La dernière : le $(station_date "$made"), de $from à $to, $result${detail:+, $detail}."
  fi
  if [[ -f $dir/HOLD ]]; then
    say "  Bloquées, par $dir/HOLD :"
    sed 's/^/    /' "$dir/HOLD"
  fi
  say "  Depuis la console, Réglages → Mises à jour : $(requests_label)."
  if [[ -e $UNITS/button-demandes.timer ]] && command -v systemctl >/dev/null 2>&1 &&
    ! systemctl is-active --quiet button-demandes.timer 2>/dev/null; then
    warn "le minuteur des demandes de la console ne tourne pas : le bouton de la console ne demande rien. Le relancer : station config --console-requests yes."
  fi
  if [[ -f $dir/$REQUEST_MARK ]]; then
    say "  Une mise à jour demandée depuis la console est en cours, ou s'est arrêtée sans finir : station requests le dira à la console."
  fi
}

# Chaque service attendu, avec son état. Échoue si l'un ne va pas.
services_report() {
  local services states service line state health code label bad=""
  if ! docker_ok; then
    say "Services : inconnus, Docker ne répond pas. Voir pourquoi : systemctl status docker."
    return 1
  fi
  services=$(compose config --services 2>/dev/null | sort) || services=""
  states=$(compose ps -a --format '{{.Name}}|{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2>/dev/null) || states=""
  if [[ -z $services ]]; then
    say "Services : la liste ne se lit pas. Voir pourquoi : cd $dir && docker compose config."
    return 1
  fi
  say "Services :"
  while IFS= read -r service; do
    # Le conteneur du service, pas celui d'un docker compose run.
    line=$(awk -F '|' -v service="$service" '$2 == service && $1 !~ /-run-/ { print; exit }' <<<"$states")
    IFS='|' read -r _ _ state health code <<<"$line"
    case $state/$health in
      running/healthy) label="sain" ;;
      running/) label="en marche" ;;
      running/starting) label="démarre" ;;
      running/unhealthy) label="en panne : son contrôle de santé échoue" ;;
      restarting/*) label="redémarre sans cesse" ;;
      exited/*)
        label="arrêté, code $code"
        [[ $service != radiotomate-init || $code != 0 ]] || label="fait"
        ;;
      /) label="absent : pas de conteneur" ;;
      *) label=$state ;;
    esac
    case $label in
      sain | "en marche" | fait) ;;
      *) bad="$bad${bad:+,} $service" ;;
    esac
    printf '  %-22s %s\n' "$service" "$label"
  done <<<"$services"
  [[ -n $bad ]] || return 0
  if [[ -z $states ]]; then
    say "  La station ne tourne pas. La démarrer : cd $dir && docker compose up -d."
  else
    say "  Ne vont pas :$bad. Leur journal : station logs SERVICE."
  fi
  return 1
}

disk_report() {
  local path line free total mount seen=" "
  for path in "$dir" "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"; do
    line=$(df_line "$path")
    read -r free total mount <<<"$line"
    if [[ ! $free =~ ^[0-9]+$ || ! $total =~ ^[0-9]+$ ]]; then
      say "Disque : la place de $path ne se lit pas."
      continue
    fi
    [[ $seen != *" $mount "* ]] || continue
    seen="$seen$mount "
    say "Disque : $(human_kb "$free") libres sur $(human_kb "$total"), sur $mount$([[ $path == "$dir" ]] || echo ', pour Docker')."
    if ((free < MIN_FREE_GB * 1048576)); then
      warn "moins de $MIN_FREE_GB Go libres sur $mount : en libérer, ou agrandir le disque."
    fi
  done
}

next_live_report() {
  local live
  if ! docker_ok; then
    say "Prochain direct : inconnu, Docker ne répond pas."
  elif ! station_running radiotomate-interface; then
    say "Prochain direct : inconnu, le moteur ne tourne pas."
  elif live=$(compose exec -T radiotomate-interface radiotomate maintenance next-live </dev/null 2>/dev/null) && [[ -n $live ]]; then
    say "Prochain direct : $live."
  else
    say "Prochain direct : inconnu, le moteur ne le dit pas : il ne répond pas, ou sa version n'a pas radiotomate maintenance next-live."
  fi
}

backup_report() {
  local line made archive size media
  line=$(grep -v '^#' "$dir/backups.log" 2>/dev/null | tail -n 1) || line=""
  IFS=$'\t' read -r made archive size media <<<"$line"
  if [[ ! $made =~ ^[0-9]+$ || ! $size =~ ^[0-9]+$ ]]; then
    say "Dernière sauvegarde : aucune. En faire une : station backup."
    return 0
  fi
  say "Dernière sauvegarde : le $(station_date "$made"), il y a $(since "$made"), $(human_kb "$size")$([[ $media != 1 ]] || echo ', avec les sons') : $archive$([[ -f $archive ]] || echo ", qui n'y est plus")."
}

# --- logs ---

cmd_logs() {
  local dir="" env_file="" option tail=(--tail 200) args=()
  while (($#)); do
    option=$1
    shift
    case $option in
      --dir=*) dir=${option#*=} ;;
      --dir)
        (($#)) || usage_error "--dir attend une valeur."
        dir=$1
        shift
        ;;
      -h | --help)
        usage_command logs
        return 0
        ;;
      -n | --tail | --tail=* | --since | --since=* | --until | --until=*)
        tail=()
        args+=("$option")
        ;;
      *) args+=("$option") ;;
    esac
  done
  open_station logs "$dir"
  compose logs "${tail[@]}" "${args[@]}"
}

# --- backup ---

cmd_backup() {
  local dir="" env_file="" archive
  local -A opts=()
  local args=()
  parse_options "--with-media --remote -h --help" "--dir" "$@"
  if help_asked; then
    usage_command backup
    return 0
  fi
  if [[ -n ${opts[--remote]:-} ]]; then
    ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}. station backup --remote n'écrit pas d'archive : elle va dans le dépôt."
    [[ -z ${opts[--with-media]:-} ]] ||
      usage_error "--with-media ne va pas avec --remote : les sons de la sauvegarde hors de la machine se règlent par station config --backup-media."
    open_station backup "${opts[--dir]:-}"
    # L'échec se note et donne l'alerte, même celui du verrou.
    remote_job=("$dir" sauvegarde "la sauvegarde hors de la machine")
    trap cleanup EXIT
    lock_station backup
    backup_remote
    return 0
  fi
  ((${#args[@]} <= 1)) || usage_error "Argument inattendu : ${args[1]}. Une seule archive."
  open_station backup "${opts[--dir]:-}"
  lock_station backup
  trap cleanup EXIT
  archive=${args[0]:-}
  backup_target
  backup_station "$archive" "${opts[--with-media]:-}"
}

# Où écrire l'archive : le fichier donné ; dans le dossier donné ; sinon dans
# backups/, dans le dossier de la station. Son nom dit l'heure, en UTC. Une
# sauvegarde ne s'écrit jamais par-dessus un fichier.
backup_target() {
  local name tries=0
  name=button-$(date -u +%Y%m%dT%H%M%SZ).tar
  if [[ -z $archive ]]; then
    install -d -m 700 "$dir/backups"
    archive=$dir/backups/$name
    # Une autre sauvegarde de la même seconde, celle de station backup juste
    # avant station update par exemple : celle-ci prend la seconde suivante.
    while [[ -e $archive || -e $archive.part ]] && ((tries++ < 3)); do
      sleep 1
      archive=$dir/backups/button-$(date -u +%Y%m%dT%H%M%SZ).tar
    done
  elif [[ -d $archive ]]; then
    archive=${archive%/}/$name
  fi
  [[ $archive == /* ]] || archive=$PWD/$archive
  [[ -d ${archive%/*} ]] ||
    die "Le dossier ${archive%/*} n'existe pas." "Le créer, ou donner un autre chemin à station backup."
  [[ ! -e $archive && ! -e $archive.part ]] ||
    die "$archive existe déjà : une sauvegarde ne s'écrit jamais par-dessus un fichier." "Donner un autre nom, ou un dossier."
}

# La sauvegarde de la station, dans archive, en droits 600 : de quoi la
# remettre, ici ou sur une autre machine, par station restore, même d'une
# version plus récente. L'antenne continue. Une ligne de backups.log la note.
# station update la fait avant chaque mise à jour. Tout s'écrit à côté de
# l'archive : son disque est le seul dont la place compte.
backup_station() { # archive, avec les sons (1) ou non, script de sauvegarde ou rien
  local archive=$1 with_media=$2 script=${3:-$dir/scripts/backup-radiotomate.sh}
  local stage data caddy media="" data_kb caddy_kb media_kb=0 size_kb
  data=$(env_path RT_DATA ./data/radiotomate)
  caddy=$(env_path CADDY_DATA ./data/caddy)
  [[ -f $data/radiotomate.db ]] ||
    die "La station n'a pas de base : $data/radiotomate.db manque." \
      "Finir l'installation : station install. Ou vérifier RT_DATA, dans $env_file."
  [[ -f $script ]] ||
    die "$script manque." "station install le remet. Puis relancer."
  if [[ -n $with_media ]]; then
    # La banque elle-même, au bout d'un lien : tar ne suit pas un lien.
    media=$(real_path "$(env_path BUTTON_MEDIA ./media)")
    [[ -d $media ]] || die "La banque de sons, $media, n'existe pas." "Vérifier BUTTON_MEDIA, dans $env_file."
    media_name_ok "${media##*/}" ||
      die "La banque de sons, $media, ne peut pas entrer dans une archive sous ce nom." \
        "La renommer, et BUTTON_MEDIA avec elle, dans $env_file : sans tiret en tête, et pas MANIFEST, SHA256SUMS, radiotomate.tar.gz, env ni caddy.tar.gz."
    media_kb=$(size_kb "$media")
  fi
  # Au plus : RT_DATA hors des copies de la base, deux fois, le temps de le
  # copier puis de le compresser ; Caddy ; les sons.
  data_kb=$(($(size_kb "$data") - $(size_kb "$data/backups")))
  caddy_kb=$(size_kb "$caddy")
  space_for "${archive%/*}" $((2 * data_kb + caddy_kb + media_kb)) \
    "Libérer de la place, ou écrire la sauvegarde ailleurs : station backup /un/autre/dossier."
  # L'archive naît vide, en 600, avant le reste : une ACL par défaut sur le
  # dossier passe outre le umask, mais pas le mode donné à la création. Un
  # dossier qui ne garde pas les droits, comme un partage Windows, la
  # laisserait lisible par d'autres, avec les secrets de .env.
  partial=$archive.part
  if ! install -m 600 /dev/null "$partial" 2>/dev/null || [[ $(stat -c %a "$partial") != 600 ]]; then
    die "${archive%/*} ne garde pas les droits des fichiers : l'archive, qui porte les secrets de .env, y serait lisible par d'autres." \
      "L'écrire sur un disque de cette machine, station backup /un/autre/dossier, puis la copier là."
  fi

  work=$(mktemp -d "${archive%/*}/.station-XXXXXX")
  stage=$work/sauvegarde
  mkdir "$stage" "$work/tmp"
  say "Sauvegarde : la base, sans couper l'antenne."
  backup_stage "$stage" "$data_kb" "$media" "$media_kb" "$script"
  backup_pack "$stage" "$archive" "$media"

  size_kb=$(size_kb "$archive")
  if [[ ! -f $dir/backups.log ]]; then
    printf '%s\n' "# Les sauvegardes de station backup, une par ligne : l'heure, en secondes depuis 1970, l'archive, sa taille en Ko, et 1 si elle a les sons." \
      >"$dir/backups.log"
  fi
  printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$archive" "$size_kb" "${with_media:-0}" >>"$dir/backups.log"
  say "Sauvegarde : $archive, $(human_kb "$size_kb"), $([[ -n $media ]] && echo 'avec les sons' || echo 'sans les sons')." \
    "  En droits 600, à root : elle porte les secrets de .env. En garder une copie hors de cette machine : voir docs/exploitation/sauvegarde.md."
}

# Ce qu'une sauvegarde porte, hors des sons, dans un dossier : MANIFEST, qui
# dit son format, sa date, la version de la station, et le nom de la banque
# de sons si elle y est ; SHA256SUMS, les sommes des autres fichiers ;
# radiotomate.tar.gz, l'archive de backup-radiotomate.sh ; env, le .env de la
# station, sans le mot de passe admin ; caddy.tar.gz, ses certificats et son
# compte Let's Encrypt. Une sauvegarde hors de la machine (SAV-01) peut
# envoyer ce dossier tel quel.
backup_stage() { # dossier, taille de RT_DATA en Ko, banque de sons ou rien, sa taille, script
  local stage=$1 caddy status=0
  engine_backup "$stage" "$work/tmp" "${5:-}" ||
    die "La base ne se sauvegarde pas : voir le message plus haut." "Voir l'état de la station, station status, puis relancer."
  # Le mot de passe admin ne s'écrit que dans .env, jusqu'à son affichage.
  install -m 600 /dev/null "$stage/env"
  sed 's/^RT_ADMIN_PASSWORD=.*/RT_ADMIN_PASSWORD=/' "$env_file" >"$stage/env"
  caddy=$(env_path CADDY_DATA ./data/caddy)
  if [[ ! -d $caddy ]]; then
    caddy=$work/vide
    mkdir "$caddy"
  fi
  # 1 : le tar de GNU a vu un fichier changer, un verrou de Caddy par exemple.
  tar -czf "$stage/caddy.tar.gz" -C "$caddy" . || status=$?
  ((status <= 1)) ||
    die "Les certificats de Caddy ne se copient pas : voir le message de tar plus haut." "Vérifier $caddy et la place, puis relancer."
  cat >"$stage/MANIFEST" <<EOF
# Une sauvegarde de station BUTTON, faite par station backup : station restore
# la remet. Les sommes de ses fichiers sont dans SHA256SUMS, sauf celles des sons.
format=$BACKUP_FORMAT
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
time=$(date +%s)
version=$(installed_version)
data_kb=$2
media=${3##*/}
media_kb=$4
EOF
  (cd "$stage" && sha256sum "${BACKUP_FILES[@]}" >SHA256SUMS)
}

# L'archive : MANIFEST, SHA256SUMS, les autres fichiers, puis les sons. Une
# tar sans compression : ses fichiers le sont déjà, les sons aussi, et
# restore lit MANIFEST sans lire le reste. Elle s'écrit dans partial, que
# backup_station a créé en 600, puis prend son nom.
backup_pack() { # dossier, archive, banque de sons ou rien
  local stage=$1 archive=$2 media=$3 parent status=0 members=()
  members=(-C "$stage" MANIFEST SHA256SUMS "${BACKUP_FILES[@]:1}")
  if [[ -n $media ]]; then
    parent=${media%/*}
    members+=(-C "${parent:-/}" "${media##*/}")
  fi
  say "Sauvegarde : l'archive$([[ -z $media ]] || echo ', avec les sons'), dans ${archive%/*}."
  tar -cf - "${members[@]}" >"$partial" || status=$?
  if ((status == 1)) && [[ -n $media ]]; then
    # Le tar de GNU : des fichiers ont changé pendant qu'il les lisait.
    warn "des sons ont changé pendant la sauvegarde, déposés ou rangés : elle les a tels que tar les a lus."
  elif ((status != 0)); then
    die "L'archive ne s'écrit pas : voir le message de tar plus haut." "Vérifier la place, et le dossier ${archive%/*}. Puis relancer."
  fi
  mv -f "$partial" "$archive"
  partial=""
}

# --- La sauvegarde hors de la machine (SAV-01) ---

# Les réglages de la sauvegarde hors de la machine, lus dans .env, dans les
# variables de l'appelant : le dépôt de restic, son mot de passe, et les clés
# d'un dépôt S3.
remote_load() {
  remote=$(env_value BUTTON_BACKUP_REMOTE)
  remote_password=$(env_value BUTTON_BACKUP_PASSWORD)
  remote_access_key=$(env_value BUTTON_BACKUP_S3_ACCESS_KEY)
  remote_secret_key=$(env_value BUTTON_BACKUP_S3_SECRET_KEY)
}

# Un dépôt réglé, avec son mot de passe.
remote_ready() {
  [[ -n $remote ]] ||
    die "Aucune sauvegarde hors de la machine n'est réglée sur cette station." \
      "La régler : station config --backup-remote DÉPÔT. Voir docs/exploitation/sauvegarde.md, « Hors de la machine »."
  [[ -n $remote_password ]] ||
    die "Le mot de passe du dépôt, BUTTON_BACKUP_PASSWORD, manque dans $env_file." \
      "Le redonner : station config --backup-remote $remote --backup-password-file FICHIER."
  return 0
}

# L'image de restic, tirée si elle manque.
restic_image() {
  docker image inspect "$RESTIC_IMAGE" >/dev/null 2>&1 || docker pull -q "$RESTIC_IMAGE" >/dev/null ||
    die "L'image de restic, $RESTIC_IMAGE, ne se tire pas." "Vérifier l'accès de la machine à Docker Hub, puis relancer."
}

# restic, dans son image, sur le dépôt de l'appelant (remote, remote_password,
# remote_access_key, remote_secret_key) : sur le réseau de la machine, à
# l'heure de la station, avec son cache et la clé SSH de la station, dans
# data/restic. Les secrets passent par l'environnement de docker, jamais par
# sa ligne de commande, que ps montre. Il cède le processeur et le disque à
# l'antenne (--cpu-shares, nice, ionice, que lit l'entrypoint de l'image), et,
# la mémoire venant à manquer, le noyau le tue avant elle (--oom-score-adj).
# Dans un terminal, il dit où il en est ; derrière un tube, l'appelant le
# décide. Les options de docker run viennent avant --, puis la commande.
restic_run() { # options de docker run…, --, commande de restic…
  local options=() base=$dir/data/restic
  while (($#)) && [[ $1 != -- ]]; do
    options+=("$1")
    shift
  done
  shift
  install -d -m 700 "$base" "$base/cache" "$base/ssh"
  ! terminal || options+=(-e RESTIC_PROGRESS_FPS=0.1)
  RESTIC_REPOSITORY=$remote RESTIC_PASSWORD=$remote_password \
    AWS_ACCESS_KEY_ID=$remote_access_key AWS_SECRET_ACCESS_KEY=$remote_secret_key \
    docker run --rm --network host --cpu-shares 256 --oom-score-adj 500 -e NICE=10 -e IONICE_CLASS=2 -e IONICE_PRIORITY=7 \
    -e RESTIC_REPOSITORY -e RESTIC_PASSWORD -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY \
    -e "TZ=$(env_value TZ Europe/Paris)" -e RESTIC_CACHE_DIR=/cache -v "$base/cache:/cache" -v "$base/ssh:/root/.ssh" \
    "${options[@]}" "$RESTIC_IMAGE" "$@"
}

# restic restore de la sauvegarde $snapshot, la dernière ou celle d'un ID,
# dans un dossier de la machine : ce qu'elle a sous /sauvegarde, que les
# --include choisissent, y revient sous sauvegarde/.
remote_restore() { # dossier, --include …
  local target=$1 host=()
  shift
  [[ $snapshot != latest ]] || host=(--host "$REMOTE_HOST")
  restic_run -v "$target:/cible" -- restore "$snapshot" "${host[@]}" --target /cible "$@"
}

# La sauvegarde du dépôt que lit restore --remote, en mots.
snapshot_label() {
  if [[ $snapshot == latest ]]; then
    echo "la dernière sauvegarde"
  else
    echo "la sauvegarde $snapshot"
  fi
}

# Pour un dépôt SFTP : la clé SSH de la station, tirée une fois dans
# data/restic/ssh, que le stockage doit autoriser, et la configuration de ssh,
# que restic lance dans son conteneur. L'hôte du stockage est retenu à la
# première connexion, puis vérifié à chacune.
remote_ssh() {
  local ssh=$dir/data/restic/ssh config
  install -d -m 700 "$dir/data/restic" "$ssh"
  if [[ ! -s $ssh/id_ed25519 ]]; then
    rm -f "$ssh/id_ed25519" "$ssh/id_ed25519.pub"
    docker run --rm -v "$ssh:/cles" --entrypoint ssh-keygen "$RESTIC_IMAGE" \
      -q -t ed25519 -N '' -C "button-sauvegarde@$(env_value DOMAIN station)" -f /cles/id_ed25519 >/dev/null ||
      die "La clé SSH de la sauvegarde ne se crée pas : voir le message plus haut." "Vérifier Docker, puis relancer."
    say "Clé SSH : créée pour la sauvegarde hors de la machine, $ssh/id_ed25519.pub."
  fi
  config="# Pour restic, dans son conteneur : la clé SSH de la station, et l'hôte du
# stockage, retenu à la première connexion. Écrit par la commande station.
Host *
  IdentityFile /root/.ssh/id_ed25519
  IdentitiesOnly yes
  UserKnownHostsFile /root/.ssh/known_hosts
  StrictHostKeyChecking accept-new
  BatchMode yes
  ServerAliveInterval 60
  ServerAliveCountMax 10"
  if [[ ! -f $ssh/config || $(<"$ssh/config") != "$config" ]]; then
    install -m 600 /dev/null "$ssh/config.station-$$"
    printf '%s\n' "$config" >"$ssh/config.station-$$"
    mv -f "$ssh/config.station-$$" "$ssh/config"
  fi
}

# Le dépôt de station config, vérifié avant que rien ne s'écrive dans .env :
# restic init le crée s'il n'existe pas, sinon s'arrête sur lui, et restic
# cat config l'ouvre avec son mot de passe. init échoue vite quand le
# stockage ne répond pas ou refuse les clés, quand cat config, lui, réessaie
# un quart d'heure. Un dépôt qui existe déjà demande son propre mot de passe :
# celui tiré au hasard (generated) ne vaut que pour un dépôt neuf (fresh).
remote_probe() {
  local status=0
  restic_image
  [[ $remote != sftp:* ]] || remote_ssh
  say "Dépôt : connexion à $remote."
  restic_run -- init >"$work/restic.log" 2>&1 || status=$?
  if ((status == 0)); then
    fresh=1
    return 0
  fi
  grep -qE 'already initialized|already exists' "$work/restic.log" || remote_refused
  [[ -z $generated ]] ||
    die "Le dépôt $remote existe déjà : il a son propre mot de passe. Rien n'est changé." \
      "Donner le mot de passe noté à sa création : station config --backup-remote $remote --backup-password-file FICHIER."
  status=0
  restic_run -- cat config >"$work/restic.log" 2>&1 || status=$?
  case $status in
    0) return 0 ;;
    12)
      die "Ce mot de passe n'ouvre pas le dépôt $remote. Rien n'est changé." \
        "Donner le mot de passe noté à sa création : --backup-password-file FICHIER."
      ;;
  esac
  remote_refused
}

# Le dépôt ne s'ouvre pas : ce que dit restic, et quoi faire. Pour un dépôt
# SFTP, la clé SSH que le stockage doit autoriser.
remote_refused() {
  { grep -v '^ *$' "$work/restic.log" || true; } | tail -n 5 >&2
  if [[ $remote == sftp:* ]]; then
    printf '%s\n' "La clé SSH de la station, que le stockage doit autoriser, dans ses clés autorisées (authorized_keys) :" \
      "  $(cat "$dir/data/restic/ssh/id_ed25519.pub" 2>/dev/null)" >&2
    die "Le dépôt $remote ne s'ouvre pas : voir le message de restic plus haut. Rien n'est changé dans .env." \
      "Vérifier l'adresse, et que le stockage autorise la clé SSH de la station, ci-dessus. Puis relancer la même commande."
  fi
  die "Le dépôt $remote ne s'ouvre pas : voir le message de restic plus haut. Rien n'est changé." \
    "Vérifier l'adresse, le bucket, les clés S3 et l'accès de la machine au stockage. Puis relancer."
}

# La sauvegarde hors de la machine : ce que porte une archive de station
# backup, préparé de même par backup_stage, et la banque de sons, sauf
# BUTTON_BACKUP_MEDIA=no, envoyés par restic dans le dépôt, chiffrés avant
# l'envoi. Dans le dépôt, tout est sous /sauvegarde, la banque sous
# /sauvegarde/media : MANIFEST la nomme media. Elle se lit sur place, sans
# copie, et restic n'envoie que ce que le dépôt n'a pas encore. Puis la
# rotation : le dépôt ne garde que REMOTE_KEEP. L'antenne continue. Une ligne
# de backups-remote.log la note ; un échec donne l'alerte (remote_failed).
backup_remote() {
  local remote remote_password remote_access_key remote_secret_key
  local data media="" media_kb=0 data_kb caddy_kb stage mounts=() status=0 snapshot added detail progress=()
  remote_load
  remote_ready
  # Une station à moitié remise deviendrait la dernière sauvegarde.
  [[ ! -f $dir/$JOURNAL ]] ||
    die "Une restauration ne s'est pas finie : $dir/$JOURNAL est encore là. La sauvegarde hors de la machine ne part pas." \
      "Voir quoi faire : station status. Puis relancer station backup --remote."
  data=$(env_path RT_DATA ./data/radiotomate)
  [[ -f $data/radiotomate.db ]] ||
    die "La station n'a pas de base : $data/radiotomate.db manque." \
      "Finir l'installation : station install. Ou vérifier RT_DATA, dans $env_file."
  [[ -f $dir/scripts/backup-radiotomate.sh ]] ||
    die "$dir/scripts/backup-radiotomate.sh manque." "station install le remet. Puis relancer."
  if [[ $(env_value BUTTON_BACKUP_MEDIA yes) != no ]]; then
    # La banque elle-même, au bout d'un lien.
    media=$(real_path "$(env_path BUTTON_MEDIA ./media)")
    [[ -d $media ]] ||
      die "La banque de sons, $media, n'existe pas." \
        "Vérifier BUTTON_MEDIA, dans $env_file. Ou sauvegarder sans les sons : station config --backup-media no."
    media_kb=$(size_kb "$media")
  fi
  # La place de la sauvegarde préparée, comme pour une archive, sans les sons.
  data_kb=$(($(size_kb "$data") - $(size_kb "$data/backups")))
  caddy_kb=$(size_kb "$(env_path CADDY_DATA ./data/caddy)")
  install -d -m 700 "$dir/backups"
  space_for "$dir/backups" $((2 * data_kb + caddy_kb)) "Libérer de la place, puis relancer."
  restic_image
  [[ $remote != sftp:* ]] || remote_ssh
  work=$(mktemp -d "$dir/backups/.station-XXXXXX")
  stage=$work/sauvegarde
  mkdir "$stage" "$work/tmp"
  say "Sauvegarde hors de la machine : la base, sans couper l'antenne."
  backup_stage "$stage" "$data_kb" "${media:+media}" "$media_kb" ""
  mounts=(-v "$stage:/sauvegarde:ro")
  if [[ -n $media ]]; then
    # Le point de montage de la banque, dans la sauvegarde.
    mkdir "$stage/media"
    mounts+=(-v "$media:/sauvegarde/media:ro")
  fi
  say "Sauvegarde hors de la machine : l'envoi vers $remote, chiffré$([[ -z $media ]] || echo ", avec les sons, $(human_kb "$media_kb")")."
  # Derrière tee, restic ne voit plus le terminal : il dit où il en est s'il
  # y en a un ici.
  ! terminal || progress=(-e RESTIC_PROGRESS_FPS=0.1)
  restic_run "${progress[@]}" "${mounts[@]}" -- backup /sauvegarde --host "$REMOTE_HOST" --tag button \
    --tag "version:$(installed_version)" --tag "$([[ -n $media ]] && echo sons || echo sans-sons)" --retry-lock 10m 2>&1 |
    tee "$work/restic.log" || status=$?
  snapshot=$(sed -n 's/^snapshot \([0-9a-f]\{8,\}\) saved$/\1/p' "$work/restic.log" | tail -n 1)
  # 3 : la sauvegarde est faite, sans des fichiers qui ne se lisaient pas.
  if [[ -z $snapshot ]] || ((status != 0 && status != 3)); then
    die "La sauvegarde hors de la machine n'a pas abouti : voir le message de restic plus haut." \
      "Vérifier l'accès au dépôt : station config --backup-remote $remote le revérifie. Puis relancer station backup --remote."
  fi
  added=$(sed -n 's/^Added to the repository: \(.*\) (\(.*\) stored)$/\1 de neuf, \2 une fois compressés/p' "$work/restic.log" | tail -n 1)
  detail=$added
  if ((status == 3)); then
    warn "des fichiers ne se lisaient pas pendant la sauvegarde, des sons déposés ou rangés entre-temps : la sauvegarde $snapshot est faite sans eux."
    detail="sans des fichiers qui ne se lisaient pas${detail:+ ; $detail}"
  fi
  say "Sauvegarde hors de la machine : la rotation, le dépôt garde 7 sauvegardes quotidiennes, 4 hebdomadaires et 6 mensuelles."
  status=0
  restic_run -- forget --host "$REMOTE_HOST" "${REMOTE_KEEP[@]}" --prune --retry-lock 10m >"$work/rotation.log" 2>&1 || status=$?
  if ((status != 0)); then
    { grep -v '^ *$' "$work/rotation.log" || true; } | tail -n 5 >&2
    detail="${detail:+$detail ; }la rotation a échoué : $(grep -m 1 '^Fatal' "$work/rotation.log" || tail -n 1 "$work/rotation.log")"
    warn "la rotation du dépôt a échoué : la sauvegarde $snapshot est faite, mais le dépôt garde encore les plus anciennes."
    station_alert "Rotation de la sauvegarde hors de la machine ratée" \
      "la sauvegarde $snapshot est faite, dans $remote, mais la rotation du dépôt a échoué : il grossit. Voir journalctl -u button-sauvegarde."
  fi
  remote_log "$dir" sauvegarde faite "$snapshot" "$detail"
  # Sauvegardée exprès, une station qui attendait reprend la nuit.
  if [[ -f $dir/data/restic/$REMOTE_PENDING ]]; then
    rm -f "$dir/data/restic/$REMOTE_PENDING"
    remote_timers || true
  fi
  say "Sauvegarde hors de la machine : faite, $snapshot, dans $remote${added:+ : $added}." \
    "  Elle se remet par station restore --remote ; le dépôt les montre par station restore --remote --list."
}

# backups-remote.log, dans le dossier de la station : une ligne par
# sauvegarde hors de la machine, ou par test de restauration, que status lit.
remote_log() { # dossier, sauvegarde ou test, résultat, ID de la sauvegarde, détail
  local log=$1/$REMOTE_LOG detail
  if [[ ! -f $log ]]; then
    printf '%s\n' "# Les sauvegardes hors de la machine et les tests de restauration, une ligne chacun : l'heure, en secondes depuis 1970, sauvegarde ou test, le résultat, l'ID de la sauvegarde dans le dépôt, et ce qu'il faut en savoir." \
      >"$log"
  fi
  detail=$(tr '\t\n' '  ' <<<"${5:--}")
  # Un champ vide se lirait mal : read fond deux tabulations qui se suivent.
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$2" "$3" "${4:--}" "$(trim "$detail")" >>"$log"
}

# Une sauvegarde hors de la machine, ou un test de restauration, arrêté en
# erreur : cleanup le note dans backups-remote.log, avec le message du
# dernier die, et donne l'alerte. Tout ce qu'il lit est global.
remote_failed() { # code de sortie
  local dir=${remote_job[0]} kind=${remote_job[1]} what=${remote_job[2]} reason result=échouée
  reason=$(trim "${died:-}")
  [[ -n $reason ]] || reason="arrêté, code $1 : voir journalctl -u button-$([[ $kind == test ]] && echo test-restauration || echo sauvegarde)"
  [[ $kind != test ]] || result=échoué
  remote_log "$dir" "$kind" "$result" - "$reason" 2>/dev/null ||
    warn "$dir/$REMOTE_LOG ne s'écrit pas."
  station_alert "${what^} a échoué" "$reason"
  return 0
}

# Les sauvegardes du dépôt, avec leur ID et leur heure, à celle de la station.
remote_list() {
  local remote remote_password remote_access_key remote_secret_key
  remote_load
  remote_ready
  restic_image
  [[ $remote != sftp:* ]] || remote_ssh
  say "Les sauvegardes du dépôt, $remote :"
  restic_run -- snapshots --host "$REMOTE_HOST" ||
    die "Le dépôt ne se lit pas : voir le message de restic plus haut." "Vérifier ses réglages : station config. Puis relancer."
  say "Pour en remettre une : station restore --remote ID. La dernière : station restore --remote."
}

# Le test de restauration du mois : restic check vérifie le dépôt, sans
# relire les données. Puis la sauvegarde, la dernière ou celle d'un ID, se
# restaure dans un dossier temporaire, sans ses sons, et se vérifie comme
# restore la vérifie : son format, ses sommes, sa base par
# restore-radiotomate.sh, le schéma qu'elle porte, et les certificats de
# Caddy. Rien ne change dans la station, qui continue. Une ligne de
# backups-remote.log le note ; un échec donne l'alerte (remote_failed).
remote_test() {
  local remote remote_password remote_access_key remote_secret_key archive=""
  local data in schemas restored version saved_at data_kb
  remote_load
  remote_ready
  data=$(real_path "$(env_path RT_DATA ./data/radiotomate)")
  [[ -f $data/radiotomate.db ]] ||
    die "La station n'a pas de base : $data/radiotomate.db manque." "Finir l'installation : station install."
  [[ -f $dir/scripts/restore-radiotomate.sh ]] ||
    die "$dir/scripts/restore-radiotomate.sh manque." "station install le remet. Puis relancer."
  restic_image
  [[ $remote != sftp:* ]] || remote_ssh
  # Le travail, sur le disque des données, comme une restauration.
  work=$(mktemp -d "${data%/*}/.station-XXXXXX")
  in=$work/sauvegarde
  mkdir "$in" "$work/tmp" "$work/base"
  say "Test de restauration : le dépôt, $remote, vérifié par restic check."
  if ! restic_run -- check --retry-lock 10m >"$work/check.log" 2>&1; then
    { grep -v '^ *$' "$work/check.log" || true; } | tail -n 5 >&2
    die "Le dépôt ne passe pas restic check : $(grep -m 1 '^Fatal' "$work/check.log" || tail -n 1 "$work/check.log")" \
      "Voir docs/exploitation/sauvegarde.md, « Hors de la machine »."
  fi
  say "Test de restauration : $(snapshot_label), sans ses sons, dans un dossier temporaire."
  restore_unpack "$in"
  version=$(manifest_value version)
  saved_at=$(manifest_number time)
  data_kb=$(manifest_number data_kb)
  space_for "$work" $((2 * data_kb)) "Libérer de la place à côté de $data, puis relancer."
  engine_restore "$in/radiotomate.tar.gz" "$work/base" "$work/tmp" ||
    die "La base de la sauvegarde $snapshot ne se remet pas : voir le message plus haut." \
      "En faire une neuve, station backup --remote, puis refaire le test : station restore --remote --test."
  schemas=$(engine_schemas "$work/base") ||
    die "La version du schéma de la base de la sauvegarde $snapshot ne se lit pas : voir le message plus haut." \
      "Voir l'état de la station : station status."
  restored=$(sed -n 2p <<<"$schemas")
  [[ $restored =~ ^[0-9]+$ ]] ||
    die "La base de la sauvegarde $snapshot n'a pas de version de schéma lisible : « $restored »." \
      "En faire une neuve, station backup --remote, puis refaire le test : station restore --remote --test."
  tar -tzf "$in/caddy.tar.gz" >/dev/null 2>&1 ||
    die "Les certificats de Caddy de la sauvegarde $snapshot ne se lisent pas." \
      "En faire une neuve, station backup --remote, puis refaire le test : station restore --remote --test."
  remote_log "$dir" test réussi "$snapshot" \
    "la sauvegarde du $(station_date "$saved_at"), en version ${version:-inconnue}, avec sa base au schéma v$restored"
  say "" "Test de restauration : réussi. La sauvegarde $snapshot, du $(station_date "$saved_at"), d'une station en version ${version:-inconnue}, se remet : ses sommes et sa base sont bonnes, au schéma v$restored." \
    "  Ses sons ne sont pas relus : restic check vérifie que le dépôt les a tous."
}

# La dernière ligne de backups-remote.log d'une sorte, et d'un résultat.
remote_last() { # sauvegarde ou test, résultat ou rien
  { grep -v '^#' "$dir/$REMOTE_LOG" 2>/dev/null || true; } |
    awk -F '\t' -v kind="$1" -v result="${2:-}" '$2 == kind && (result == "" || $3 == result)' | tail -n 1
}

# La sauvegarde hors de la machine, pour status et config : le dépôt, l'heure,
# et les sons ou non.
remote_label() {
  local remote time
  remote=$(env_value BUTTON_BACKUP_REMOTE)
  if [[ -z $remote ]]; then
    echo "aucune"
    return 0
  fi
  time=$(env_value BUTTON_BACKUP_TIME "$BACKUP_TIME")
  printf 'chaque nuit à %s (%s), vers %s, %s\n' "$time" "$(env_value TZ Europe/Paris)" "$remote" \
    "$([[ $(env_value BUTTON_BACKUP_MEDIA yes) == no ]] && echo 'sans les sons' || echo 'avec les sons')"
}

# status : la sauvegarde hors de la machine, la dernière, et le dernier test
# de restauration, d'après backups-remote.log. Avertit quand le minuteur ne
# tourne pas, quand aucune sauvegarde n'a réussi depuis deux jours, depuis le
# réglage du dépôt, et quand le dernier test a échoué, ou date de plus de 35
# jours.
remote_report() {
  local line made result snapshot detail ok set now
  if [[ -z $(env_value BUTTON_BACKUP_REMOTE) ]]; then
    say "Sauvegarde hors de la machine : aucune. La régler : station config --backup-remote. Voir docs/exploitation/sauvegarde.md."
    return 0
  fi
  if [[ -f $dir/data/restic/$REMOTE_PENDING ]]; then
    say "Sauvegarde hors de la machine : en attente, vers $(env_value BUTTON_BACKUP_REMOTE), un dépôt qui existait déjà. Remettre la station de l'une de ses sauvegardes, station restore --remote, ou sauvegarder celle-ci, station backup --remote : la sauvegarde de la nuit commence ensuite."
    return 0
  fi
  now=$(date +%s)
  say "Sauvegarde hors de la machine : $(remote_label)."
  if [[ ! -f $UNITS/button-sauvegarde.timer ]] || ! systemctl is-active --quiet button-sauvegarde.timer 2>/dev/null; then
    warn "le minuteur de la sauvegarde hors de la machine ne tourne pas : elle ne part pas seule chaque nuit. station install le remet."
  fi
  line=$(remote_last sauvegarde)
  IFS=$'\t' read -r made _ result snapshot detail <<<"$line"
  if [[ ! $made =~ ^[0-9]+$ ]]; then
    say "  Aucune encore : la première part à l'heure dite, ou maintenant, par station backup --remote."
  else
    say "  La dernière : le $(station_date "$made"), il y a $(since "$made"), $result${snapshot:+$([[ $snapshot == - ]] || echo " ($snapshot)")}${detail:+$([[ $detail == - ]] || echo " : $detail")}."
  fi
  ok=$(remote_last sauvegarde faite)
  ok=${ok%%$'\t'*}
  set=$(remote_last réglage)
  set=${set%%$'\t'*}
  if [[ $ok =~ ^[0-9]+$ ]]; then
    ((now - ok <= 2 * 86400)) ||
      warn "la dernière sauvegarde hors de la machine réussie date du $(station_date "$ok"), il y a $(since "$ok"). Voir pourquoi : journalctl -u button-sauvegarde."
  elif [[ $set =~ ^[0-9]+$ ]] && ((now - set > 2 * 86400)); then
    warn "aucune sauvegarde hors de la machine n'a réussi depuis son réglage, le $(station_date "$set"). Voir pourquoi : journalctl -u button-sauvegarde."
  elif [[ $made =~ ^[0-9]+$ ]]; then
    warn "aucune sauvegarde hors de la machine n'a encore réussi. Voir pourquoi : journalctl -u button-sauvegarde."
  fi
  line=$(remote_last test)
  IFS=$'\t' read -r made _ result snapshot detail <<<"$line"
  if [[ ! $made =~ ^[0-9]+$ ]]; then
    say "  Test de restauration : aucun encore. Le minuteur le fait le 1er de chaque mois ; le faire maintenant : station restore --remote --test."
    [[ ! $set =~ ^[0-9]+$ ]] || ((now - set <= 35 * 86400)) ||
      warn "aucun test de restauration depuis le réglage de la sauvegarde hors de la machine, le $(station_date "$set"). Le faire : station restore --remote --test."
    return 0
  fi
  say "  Le dernier test de restauration : le $(station_date "$made"), $result${detail:+$([[ $detail == - ]] || echo " : $detail")}."
  if [[ $result != réussi ]]; then
    warn "le dernier test de restauration a échoué. Voir pourquoi : journalctl -u button-test-restauration ; le refaire : station restore --remote --test."
  elif ((now - made > 35 * 86400)); then
    warn "le dernier test de restauration date du $(station_date "$made"), il y a $(since "$made"). Voir pourquoi : journalctl -u button-test-restauration."
  fi
}

# Les minuteurs systemd de la sauvegarde hors de la machine : la sauvegarde
# chaque nuit, à BUTTON_BACKUP_TIME, et le test de restauration le 1er de
# chaque mois, à REMOTE_TEST_TIME, à l'heure de la station. Ils lancent la
# commande station du dossier, qui attend 2 h au plus une autre commande en
# cours (STATION_LOCK_WAIT). Leur ligne ExecStart ne change plus : la commande
# d'une version d'avant, remise par un retour arrière, la lit telle quelle.
# Sans dépôt réglé, ou devant une commande station qui ne connaît pas la
# sauvegarde hors de la machine, comme celle d'une 0.2.0, ils s'en vont.
# Réécrits seulement quand ils changent : l'heure, le fuseau, le dossier ;
# keep les garde tels quels, après un retour arrière. Puis activés, chaque
# fois : un minuteur arrêté à la main, ou qu'un échec n'a pas activé, repart.
# Sauf tant que la station attend de reprendre un dépôt qui existait déjà
# (REMOTE_PENDING). Rend 1 si systemd ne les prend pas.
remote_timers() { # keep, ou rien
  local zone="" time="" command changed=""
  if [[ -z $(env_value BUTTON_BACKUP_REMOTE) ]]; then
    remote_timers_off
    return 0
  fi
  if ! grep -q BUTTON_BACKUP_REMOTE "$dir/station" 2>/dev/null; then
    if [[ -e $UNITS/button-sauvegarde.timer ]]; then
      remote_timers_off
      warn "la commande station de la version $(installed_version) ne connaît pas la sauvegarde hors de la machine : ses minuteurs s'en vont. Ils reviennent avec une version qui la connaît, par station update."
    fi
    return 0
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    warn "systemd manque : la sauvegarde hors de la machine ne part pas seule chaque nuit. La lancer à la main : station backup --remote."
    return 1
  fi
  if [[ ${1:-} != keep ]]; then
    zone=$(env_value TZ Europe/Paris)
    time=$(env_value BUTTON_BACKUP_TIME "$BACKUP_TIME")
    check_update_time "$time" 2>/dev/null || time=$BACKUP_TIME
    command=$(systemd_quote "$dir/station")
    unit_write button-sauvegarde.service "# La sauvegarde hors de la machine, que lance button-sauvegarde.timer. Écrit
# par la commande station de $dir : station config la règle.
[Unit]
Description=BUTTON : la sauvegarde hors de la machine
Documentation=https://github.com/$REPO/blob/main/docs/exploitation/sauvegarde.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# systemd ne pose pas HOME pour un service de root : docker y lit le jeton
# du registre, dans /root/.docker.
Environment=HOME=/root
Environment=STATION_LOCK_WAIT=7200
ExecStart=$command backup --remote --dir $(systemd_quote "$dir")
TimeoutStartSec=20h"
    unit_write button-sauvegarde.timer "# Chaque nuit, la sauvegarde hors de la machine. Écrit par la commande
# station : station config --backup-time change son heure.
[Unit]
Description=BUTTON : la sauvegarde hors de la machine, chaque nuit

[Timer]
OnCalendar=*-*-* $time:00 $zone
Persistent=true

[Install]
WantedBy=timers.target"
    unit_write button-test-restauration.service "# Le test de restauration de la sauvegarde hors de la machine, que lance
# button-test-restauration.timer. Écrit par la commande station de $dir.
[Unit]
Description=BUTTON : le test de restauration de la sauvegarde hors de la machine
Documentation=https://github.com/$REPO/blob/main/docs/exploitation/sauvegarde.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=STATION_LOCK_WAIT=7200
ExecStart=$command restore --remote --test --dir $(systemd_quote "$dir")
TimeoutStartSec=6h"
    unit_write button-test-restauration.timer "# Le 1er de chaque mois, le test de restauration de la sauvegarde hors de la
# machine. Écrit par la commande station.
[Unit]
Description=BUTTON : le test de restauration, chaque mois

[Timer]
OnCalendar=*-*-01 $REMOTE_TEST_TIME:00 $zone
Persistent=true

[Install]
WantedBy=timers.target"
  fi
  if [[ -n $changed ]] && ! systemctl daemon-reload >/dev/null 2>&1; then
    warn "systemd ne relit pas les minuteurs de la sauvegarde hors de la machine : voir systemctl status button-sauvegarde.timer."
    return 1
  fi
  if [[ -f $dir/data/restic/$REMOTE_PENDING ]]; then
    systemctl disable --now button-sauvegarde.timer button-test-restauration.timer >/dev/null 2>&1 || true
    return 0
  fi
  if ! systemctl enable --now button-sauvegarde.timer button-test-restauration.timer >/dev/null 2>&1; then
    warn "systemd ne prend pas les minuteurs de la sauvegarde hors de la machine : voir systemctl status button-sauvegarde.timer."
    return 1
  fi
  [[ -z $changed ]] ||
    say "Sauvegarde hors de la machine : chaque nuit à $time ($zone), et le test de restauration le 1er de chaque mois, à $REMOTE_TEST_TIME, par les minuteurs de systemd."
}

# Les minuteurs de la sauvegarde hors de la machine s'en vont, s'ils sont là,
# avec le dernier passage que Persistent=true retient : sinon, reposés plus
# tard sur la même machine, ils rattraperaient aussitôt une nuit manquée.
remote_timers_off() {
  local name present=()
  for name in "${REMOTE_UNITS[@]}"; do
    [[ ! -e $UNITS/$name ]] || present+=("$UNITS/$name")
  done
  ((${#present[@]})) || return 0
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now button-sauvegarde.timer button-test-restauration.timer >/dev/null 2>&1 || true
    systemctl clean --what=state button-sauvegarde.timer button-test-restauration.timer >/dev/null 2>&1 || true
  fi
  rm -f "${present[@]}"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
  return 0
}

# Un fichier de systemd, réécrit s'il change : changed le note.
unit_write() { # nom, contenu
  local file=$UNITS/$1
  if [[ -f $file && $(<"$file") == "$2" ]]; then
    return 0
  fi
  mkdir -p "$UNITS"
  printf '%s\n' "$2" >"$file.station-$$"
  chmod 644 "$file.station-$$"
  mv -f "$file.station-$$" "$file"
  changed=1
}

# Un chemin dans une ligne de commande de systemd : entre guillemets, avec %
# et $ doublés, que systemd lirait sinon.
systemd_quote() { # chemin
  local text=$1
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  text=${text//%/%%}
  text=${text//\$/\$\$}
  printf '"%s"\n' "$text"
}

# --- restore ---

cmd_restore() {
  local dir="" env_file="" archive="" snapshot="" assume_yes="" aborted="Rien n'est changé."
  local remote="" remote_password="" remote_access_key="" remote_secret_key=""
  local -A opts=()
  local args=()
  parse_options "--yes --without-media --remote --list --test -h --help" "--dir" "$@"
  if help_asked; then
    usage_command restore
    return 0
  fi
  if [[ -n ${opts[--remote]:-} ]]; then
    restore_remote
    return 0
  fi
  [[ -z ${opts[--list]:-}${opts[--test]:-} ]] ||
    usage_error "--list et --test vont avec --remote : station restore --remote --list, ou --test."
  ((${#args[@]} == 1)) || usage_error "station restore attend une archive, et une seule : station restore ARCHIVE."
  archive=${args[0]}
  [[ $archive == /* ]] || archive=$PWD/$archive
  assume_yes=${opts[--yes]:-}
  open_station restore "${opts[--dir]:-}"
  confirm_possible restore
  [[ -f $archive && -r $archive ]] ||
    die "$archive n'existe pas, ou ne se lit pas." "Donner le chemin d'une archive de station backup."
  lock_station restore
  trap cleanup EXIT
  restore_station "$archive" "${opts[--without-media]:-}"
}

# restore --remote : une sauvegarde du dépôt, la dernière ou celle d'un ID ;
# --list les montre ; --test en vérifie une, sans rien changer. Les variables
# sont celles de cmd_restore.
restore_remote() {
  ((${#args[@]} <= 1)) || usage_error "Argument inattendu : ${args[1]}. Une seule sauvegarde, par son ID."
  [[ -z ${opts[--list]:-} || -z ${opts[--test]:-} ]] || usage_error "--list ou --test, pas les deux."
  snapshot=${args[0]:-latest}
  [[ $snapshot == latest || $snapshot =~ ^[0-9a-f]{8,64}$ ]] ||
    usage_error "« $snapshot » n'est pas l'ID d'une sauvegarde du dépôt : 8 chiffres ou lettres de a à f au moins, comme les montre station restore --remote --list."
  if [[ -n ${opts[--list]:-} ]]; then
    ((${#args[@]} == 0)) || usage_error "station restore --remote --list montre toutes les sauvegardes : pas d'ID."
    open_station restore "${opts[--dir]:-}"
    remote_list
    return 0
  fi
  if [[ -n ${opts[--test]:-} ]]; then
    open_station restore "${opts[--dir]:-}"
    # L'échec se note et donne l'alerte, même celui du verrou.
    remote_job=("$dir" test "le test de restauration")
    trap cleanup EXIT
    lock_station restore
    remote_test
    return 0
  fi
  assume_yes=${opts[--yes]:-}
  open_station restore "${opts[--dir]:-}"
  confirm_possible restore
  remote_load
  remote_ready
  lock_station restore
  trap cleanup EXIT
  restic_image
  [[ $remote != sftp:* ]] || remote_ssh
  restore_station "" "${opts[--without-media]:-}"
}

# Une valeur du MANIFEST de la sauvegarde.
manifest_value() { # clé
  sed -n "s/^$1=//p" "$work/sauvegarde/MANIFEST" | tail -n 1
}

# Un nombre du MANIFEST, 0 s'il n'en est pas un : rien d'autre d'une archive
# ne se calcule.
manifest_number() { # clé
  local value
  value=$(manifest_value "$1")
  [[ $value =~ ^[0-9]{1,15}$ ]] || value=0
  printf '%s\n' "$value"
}

# Une valeur, ou une variable posée, dans un autre .env que celui de la station.
env_value_in() { # .env, clé, défaut
  local env_file=$1
  shift
  env_value "$@"
}

env_set_in() { # .env, clé, valeur, commande
  local env_file=$1
  shift
  env_set "$@"
}

# Ouvre la sauvegarde dans un dossier, $work/sauvegarde : MANIFEST et
# SHA256SUMS d'abord, au début de l'archive, puis les fichiers que SHA256SUMS
# nomme, vérifiés. Le format se lit avant le reste : une archive d'un format
# plus ancien se lit aussi. Les sons restent dans l'archive. La sauvegarde est
# l'archive, $archive, ou celle du dépôt, $snapshot (backup_fetch).
restore_unpack() { # dossier
  local in=$1 format name listed=() source=${archive:-} other="Prendre une archive faite par station backup." label
  if [[ -n ${snapshot:-} ]]; then
    label=$(snapshot_label)
    backup_fetch "$in" MANIFEST SHA256SUMS ||
      die "${label^} ne se lit pas dans le dépôt, $remote : $(fetch_error)" \
        "Les sauvegardes du dépôt, avec leur ID : station restore --remote --list."
    # restic restaure sans rien dire un chemin qui manque.
    [[ -f $in/MANIFEST && -f $in/SHA256SUMS ]] ||
      die "La sauvegarde $snapshot du dépôt n'est pas une sauvegarde de station : elle n'a pas de MANIFEST." \
        "Les sauvegardes du dépôt, avec leur ID : station restore --remote --list."
    source="La sauvegarde $snapshot du dépôt"
    other="Les sauvegardes du dépôt, avec leur ID : station restore --remote --list."
  else
    backup_fetch "$in" MANIFEST SHA256SUMS ||
      die "$source n'est pas une sauvegarde de station, ou elle est abîmée : $(fetch_error)" "$other"
  fi
  format=$(manifest_value format)
  [[ $format =~ ^[0-9]+$ ]] ||
    die "$source n'a pas de MANIFEST lisible : ce n'est pas une sauvegarde de station." "$other"
  ((format <= BACKUP_FORMAT)) ||
    die "Cette sauvegarde est au format $format, plus récent que celui de cette commande, $BACKUP_FORMAT." \
      "Prendre la commande station de la version de la sauvegarde, ou d'une plus récente, puis relancer."
  while read -r _ name; do
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
      die "La sauvegarde est abîmée : SHA256SUMS nomme « $name »." "En prendre une autre."
    listed+=("$name")
  done <"$in/SHA256SUMS"
  backup_fetch "$in" "${listed[@]}" ||
    die "La sauvegarde est abîmée : $(fetch_error)" "En prendre une autre."
  (cd "$in" && sha256sum -c SHA256SUMS >/dev/null 2>&1) ||
    die "La sauvegarde est abîmée : un de ses fichiers ne correspond pas à sa somme, dans SHA256SUMS." "En prendre une autre."
  for name in "${BACKUP_FILES[@]}"; do
    [[ -f $in/$name ]] || die "La sauvegarde est abîmée : il y manque $name." "En prendre une autre."
  done
}

# Des fichiers de la sauvegarde, dans le dossier où elle s'ouvre : de
# l'archive, ou de la sauvegarde du dépôt, $snapshot, la dernière ou celle
# d'un ID. Dans le dépôt, ils sont sous /sauvegarde (backup_remote) : restic
# les remet dans le dossier, qui doit s'appeler sauvegarde. La première
# lecture d'une sauvegarde du dépôt pose dans snapshot son ID complet, pour
# que la suite lise la même. Ce que disent tar ou restic va dans
# $work/lecture.log.
backup_fetch() { # dossier, fichier…
  local in=$1 name includes=() id
  shift
  if [[ -z ${snapshot:-} ]]; then
    tar -xf "$archive" -C "$in" --occurrence "$@" 2>"$work/lecture.log"
    return $?
  fi
  for name; do
    includes+=(--include "/sauvegarde/$name")
  done
  remote_restore "${in%/*}" "${includes[@]}" >"$work/lecture.log" 2>&1 || return 1
  id=$(sed -n 's/^restoring snapshot \([0-9a-f]\{8,\}\) of .*/\1/p' "$work/lecture.log" | head -n 1)
  [[ -z $id ]] || snapshot=$id
  return 0
}

# Ce qui dit pourquoi une lecture de la sauvegarde échoue : la ligne Fatal de
# restic, sinon la première, celle de tar.
fetch_error() {
  local line
  line=$(grep -m 1 '^Fatal' "$work/lecture.log" 2>/dev/null) || line=$(head -n 1 "$work/lecture.log" 2>/dev/null) || true
  [[ -n $line ]] || line="sans autre message"
  printf '%s\n' "$line"
}

# Une variable de .env qui va avec la base : celle de la sauvegarde, à la
# place de celle de cette machine, si son contrôle la prend.
restore_env_value() { # clé, défaut, contrôle ou rien
  local value
  value=$(env_value_in "$in/env" "$1" "$2")
  [[ $value != "$(env_value_in "$new_env" "$1" "$2")" ]] || return 0
  if [[ -n $3 ]] && ! "$3" "$value" 2>/dev/null; then
    warn "$1 de la sauvegarde, « $value », ne vaut pas sur cette machine : .env garde le sien."
    return 0
  fi
  env_set_in "$new_env" "$1" "$value" restore
  [[ $1 == RT_ADMIN_PASSWORD ]] || taken="$taken${taken:+,} $1=$value"
}

# Remet une sauvegarde de station backup. Tout se prépare à côté, pendant que
# l'antenne continue : la base vérifiée, Caddy, les sons, .env. Puis la
# station s'arrête, chacun prend la place du sien, et elle repart. Si elle ne
# repart pas, cleanup remet celle d'avant (restore_undo). Sans archive, la
# sauvegarde est celle du dépôt, $snapshot : restore --remote.
restore_station() { # archive ou rien, sans les sons (1) ou non
  local archive=$1 without_media=$2 in stamp version saved_at media media_kb data_kb path
  local data caddy media_dir new_data new_caddy="" new_media="" media_from="" new_env schemas current restored
  local listing saved_domain differs="" taken="" key domain tls entry aside keys="" profiles=() values=""
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # Les dossiers réels, au bout d'un lien.
  data=$(real_path "$(env_path RT_DATA ./data/radiotomate)")
  caddy=$(real_path "$(env_path CADDY_DATA ./data/caddy)")
  media_dir=$(real_path "$(env_path BUTTON_MEDIA ./media)")
  [[ -f $data/radiotomate.db ]] ||
    die "La station de $dir n'a pas encore de base : $data/radiotomate.db manque." \
      "Finir l'installation, station install, puis relancer la restauration."
  [[ -f $dir/scripts/restore-radiotomate.sh ]] ||
    die "$dir/scripts/restore-radiotomate.sh manque." "station install le remet. Puis relancer."
  # Le travail, sur le disque des données : la base s'y ouvre.
  work=$(mktemp -d "${data%/*}/.station-XXXXXX")
  in=$work/sauvegarde
  mkdir "$in" "$work/tmp"
  if [[ -n $archive ]]; then
    say "Restauration : lecture de $archive."
  else
    say "Restauration : lecture de $(snapshot_label) du dépôt, $remote."
  fi
  restore_unpack "$in"
  version=$(manifest_value version)
  saved_at=$(manifest_number time)
  media=$(manifest_value media)
  media_kb=$(manifest_number media_kb)
  data_kb=$(manifest_number data_kb)
  [[ -z $media ]] || media_name_ok "$media" ||
    die "Le MANIFEST de la sauvegarde nomme mal la banque de sons : « $media »." "En prendre une autre."
  if [[ -n $media && -n $without_media ]]; then
    say "Restauration : sans les sons de la sauvegarde (--without-media), la banque en place reste."
    media=""
  fi
  # Un point de montage ne se déplace pas : restore ne le remplace pas.
  for path in "$data" "$caddy"; do
    if mounted "$path"; then
      die "$path est un point de montage : restore ne sait pas le remplacer. Rien n'a changé." \
        "Restaurer à la main, avec les scripts : voir docs/exploitation/sauvegarde.md, « Avec les scripts »."
    fi
  done
  if [[ -n $media ]] && mounted "$media_dir" && [[ -n $archive ]]; then
    die "La banque de sons, $media_dir, est un point de montage : restore ne sait pas la remplacer. Rien n'a changé." \
      "Restaurer sans les sons, station restore --without-media, puis y remettre ceux de la sauvegarde : tar -xf ARCHIVE -C $media_dir --strip-components=1 $media."
  elif [[ -n $media ]] && mounted "$media_dir"; then
    die "La banque de sons, $media_dir, est un point de montage : restore ne sait pas la remplacer. Rien n'a changé." \
      "Restaurer sans les sons, station restore --remote $snapshot --without-media, puis y remettre ceux de la sauvegarde : voir docs/exploitation/sauvegarde.md, « Une banque sur son propre disque »."
  fi
  say "Sauvegarde du $(station_date "$saved_at"), d'une station en version ${version:-inconnue}$([[ -z $media ]] || echo ', avec ses sons')${snapshot:+ : $snapshot, dans le dépôt}."
  # La place : la base deux fois à côté de la sienne, le temps de la vérifier ;
  # les sons à côté de la banque.
  if [[ -n $media && $(mount_of "$data") == "$(mount_of "$media_dir")" ]]; then
    space_for "$data" $((2 * data_kb + media_kb)) "Libérer de la place, ou agrandir le disque. Puis relancer."
  else
    space_for "$data" $((2 * data_kb)) "Libérer de la place, ou agrandir le disque. Puis relancer."
    [[ -z $media ]] || space_for "$media_dir" "$media_kb" "Libérer de la place, ou agrandir le disque. Puis relancer."
  fi

  # La base, vérifiée, à côté de celle en place, sur le même disque.
  new_data=$data.restauration-$stamp
  prepared+=("$new_data")
  mkdir "$new_data"
  say "Restauration : la base de la sauvegarde, vérifiée, à côté de celle en place."
  engine_restore "$in/radiotomate.tar.gz" "$new_data" "$work/tmp" ||
    die "La base de la sauvegarde ne se remet pas : voir le message plus haut. Rien n'a changé." "En prendre une autre."
  schemas=$(engine_schemas "$new_data") ||
    die "La version du schéma des bases ne se lit pas : voir le message plus haut. Rien n'a changé." "Voir l'état de la station : station status."
  current=$(sed -n 1p <<<"$schemas")
  restored=$(sed -n 2p <<<"$schemas")
  [[ $current =~ ^[0-9]+$ && $restored =~ ^[0-9]+$ ]] ||
    die "La version du schéma des bases ne se lit pas : « $current », « $restored ». Rien n'a changé." "Voir l'état de la station : station status."
  ((restored <= current)) ||
    die "La sauvegarde vient de la version ${version:-inconnue} : sa base est au schéma v$restored, que cette station, en $(installed_version), ne sait pas lire. Rien n'a changé." \
      "La remettre sur une station de la même version, ou d'une plus récente : sur une machine neuve, station install --version ${version:-X.Y.Z}."
  # La sauvegarde se remet : la question vient avant le reste, et l'arrêt.
  confirm restore "Remplacer les données de la station de $dir par celles de la sauvegarde ? Celles d'aujourd'hui restent à côté, et l'antenne se coupe le temps de redémarrer. (o/n)"

  # Caddy : ses certificats et son compte, s'il y en a, pour le domaine de
  # cette station. Une sauvegarde d'un autre domaine ne les a pas : la station
  # garde les siens, sans quoi Caddy devrait en demander de nouveaux pendant
  # la restauration.
  saved_domain=$(env_value_in "$in/env" DOMAIN)
  domain=$(env_value DOMAIN)
  if [[ $saved_domain == "$domain" ]]; then
    listing=$(tar -tzf "$in/caddy.tar.gz") ||
      die "Les certificats de Caddy de la sauvegarde ne se lisent pas. Rien n'a changé." "En prendre une autre."
    if grep -qvE '^\./?$' <<<"$listing"; then
      new_caddy=$caddy.restauration-$stamp
      prepared+=("$new_caddy")
      mkdir "$new_caddy"
      tar -xzf "$in/caddy.tar.gz" -C "$new_caddy" ||
        die "Les certificats de Caddy de la sauvegarde ne s'extraient pas : voir le message de tar plus haut. Rien n'a changé." "Vérifier la place, puis relancer."
    fi
  fi
  # Les sons, sous leur nom dans l'archive, à côté de la banque en place. Du
  # dépôt, sous sauvegarde/.
  if [[ -n $media ]]; then
    new_media=$media_dir.restauration-$stamp
    prepared+=("$new_media")
    mkdir "$new_media"
    say "Restauration : les sons de la sauvegarde, $(human_kb "$media_kb"), à côté de la banque en place."
    if [[ -n $archive ]]; then
      tar -xf "$archive" -C "$new_media" "$media" ||
        die "Les sons de la sauvegarde ne s'extraient pas : voir le message de tar plus haut. Rien n'a changé." "Vérifier la place, puis relancer."
      media_from=$new_media/$media
    else
      mkdir "$new_media/sauvegarde"
      remote_restore "$new_media" --include "/sauvegarde/$media" ||
        die "Les sons de la sauvegarde ne se remettent pas : voir le message de restic plus haut. Rien n'a changé." \
          "Vérifier la place, et l'accès au dépôt, puis relancer."
      media_from=$new_media/sauvegarde/$media
      [[ -d $media_from ]] ||
        die "La sauvegarde $snapshot n'a pas les sons que dit son MANIFEST. Rien n'a changé." \
          "En prendre une autre, ou la remettre sans les sons : station restore --remote $snapshot --without-media."
    fi
  fi
  # .env : celui de cette machine, sa version, son domaine, ses ports et ses
  # secrets ; de la sauvegarde, le fuseau et le compte admin, qui vont avec la
  # base. Les autres différences se disent.
  new_env=$env_file.restauration-$stamp
  prepared+=("$new_env")
  install -m 600 /dev/null "$new_env"
  cat "$env_file" >"$new_env"
  restore_env_value TZ Europe/Paris check_timezone
  restore_env_value RT_ADMIN_USER button check_admin
  restore_env_value RT_ADMIN_PASSWORD "" ""
  while IFS= read -r key; do
    case $key in
      TZ | RT_ADMIN_USER | RT_ADMIN_PASSWORD | BUTTON_VERSION | DOMAIN | *PASSWORD* | *SECRET* | *TOKEN* | *_KEY) continue ;;
    esac
    [[ $(env_value_in "$in/env" "$key") == "$(env_value_in "$new_env" "$key")" ]] && continue
    differs="$differs${differs:+,} $key"
    values="$values${values:+, }$key=$(env_value_in "$in/env" "$key")"
  done < <(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$in/env" "$new_env" | sort -u)

  # Une demande de la console ouverte ne survit pas à l'échange : elle date
  # d'avant la sauvegarde.
  requests_forget "La station a été remise d'une sauvegarde : la redemander, si elle sert encore."
  # Tous les profils s'arrêtent, share compris s'il est lancé à part : sinon,
  # il garderait la banque mise de côté. Ceux qui tournaient repartent.
  say "Restauration : la station s'arrête, le temps d'échanger les données."
  all_profiles
  mapfile -t restart_others < <(compose "${profiles[@]}" ps --services --status running 2>/dev/null)
  station_stopped=$dir
  printf '%s\n' "# station restore, le $(station_date "$(date +%s)") : pas finie, tant que ce fichier est là." \
    "# Chaque ligne : le dossier en place|celui d'avant, mis à côté|celui de la sauvegarde." >"$dir/$JOURNAL"
  compose "${profiles[@]}" stop ||
    die "La station ne s'arrête pas : voir le message de docker compose plus haut." "Voir pourquoi, puis relancer la restauration."
  swap "$data" "$new_data" "$stamp"
  [[ -z $new_caddy ]] || swap "$caddy" "$new_caddy" "$stamp"
  [[ -z $new_media ]] || swap "$media_dir" "$media_from" "$stamp"
  swap "$env_file" "$new_env" "$stamp"
  env_isolate
  # La station garde son domaine : les adresses publiques de la base qui
  # suivaient celui de la sauvegarde passent au sien.
  if [[ -n $saved_domain && -n $domain && $saved_domain != "$domain" ]]; then
    keys=$(engine_domain_settings "$saved_domain" "$domain") ||
      warn "les adresses de Réglages → Station ne suivent pas $domain : les changer dans la console."
  fi
  say "Restauration : la station repart, sur les données de la sauvegarde."
  compose up -d ||
    die "La station ne démarre pas sur la sauvegarde : voir le message de docker compose plus haut." \
      "La restauration s'annule. Voir pourquoi : cd $dir && docker compose logs radiotomate-init."
  restart_others_up ||
    die "Les services lancés à part ne repartent pas : voir le message de docker compose plus haut." \
      "La restauration s'annule. Voir pourquoi, puis relancer station restore."
  tls=$(env_value CADDY_TLS acme)
  if [[ -n $domain && ,$(env_value COMPOSE_PROFILES), == *,vps,* ]]; then
    https_ok ||
      die "https://$domain ne répond pas au bout de $HTTPS_WAIT s, sur la sauvegarde." \
        "La restauration s'annule. Voir pourquoi : cd $dir && docker compose logs caddy."
  fi
  smoke_ok ||
    die "Le contrôle de la station restaurée a échoué : voir plus haut." \
      "La restauration s'annule. Une fois réglé, relancer station restore."
  station_stopped=""
  rm -f "$dir/$JOURNAL"
  record_versions
  # Remise, la station n'attend plus pour se sauvegarder la nuit. Le fuseau
  # de la sauvegarde règle aussi l'heure des minuteurs.
  rm -f "$dir/data/restic/$REMOTE_PENDING"
  remote_timers || true
  # Une demande de la console venue avec les données date d'avant : elle ne
  # part pas.
  requests_forget "La station a été remise d'une sauvegarde : la redemander, si elle sert encore."
  requests_timer || true

  # Le .env d'avant garde à côté le mot de passe admin d'une installation qui
  # ne l'a pas affiché : il ne sert plus, et ne s'écrit que dans .env.
  aside=$env_file.avant-restauration-$stamp
  if [[ -f $aside && -n $(env_value_in "$aside" RT_ADMIN_PASSWORD) ]]; then
    env_set_in "$aside" RT_ADMIN_PASSWORD "" restore
  fi
  say "" "La station est restaurée : celle de la sauvegarde du $(station_date "$saved_at"), qui tourne ici en $(installed_version)."
  if ((restored < current)); then
    say "  Sa base, au schéma v$restored, est passée en v$current en démarrant. La copie d'avant est dans $data/backups."
  fi
  say "  Les comptes sont ceux de la sauvegarde : le mot de passe admin de cette installation ne sert plus."
  [[ -z $taken ]] || say "  De la sauvegarde, dans .env :$taken."
  if [[ -n $saved_domain && -n $domain && $saved_domain != "$domain" ]]; then
    if [[ -n $keys ]]; then
      say "  La sauvegarde servait $saved_domain : la station garde $domain et ses certificats, et les adresses de Réglages → Station qui suivaient $saved_domain passent à $domain."
    else
      say "  La sauvegarde servait $saved_domain : la station garde $domain et ses certificats. Vérifier les adresses de Réglages → Station, dans la console."
    fi
    say "  Pour reprendre $saved_domain : station config --domain $saved_domain."
  fi
  if [[ -n $differs && -n $archive ]]; then
    say "  Gardés de cette machine, autres dans la sauvegarde :$differs. Leurs valeurs : tar -xOf $archive --occurrence env."
  elif [[ -n $differs ]]; then
    # Aucun secret : differs les passe.
    say "  Gardés de cette machine, autres dans la sauvegarde :$differs. Leurs valeurs dans la sauvegarde : $values."
  fi
  say "  Les données d'avant restent à côté, à effacer une fois la station vérifiée :"
  for entry in "${swapped[@]}"; do
    aside=${entry#*|}
    aside=${aside%%|*}
    [[ ! -e $aside ]] || say "    $aside"
  done
  swapped=()
}

# Met new à la place de current, et current à côté, en
# current.avant-restauration-<heure>. Chaque échange s'écrit d'abord dans le
# journal ; restore_undo les défait.
swap() { # en place, nouveau, heure
  local aside=$1.avant-restauration-$3
  printf '%s|%s|%s\n' "$1" "$aside" "$2" >>"$dir/$JOURNAL"
  if [[ -e $1 ]]; then
    mv "$1" "$aside" ||
      die "$1 ne se met pas de côté : voir le message plus haut. La restauration s'annule." "Voir pourquoi, puis relancer station restore."
  fi
  swapped+=("$1|$aside|$2")
  mv "$2" "$1" ||
    die "$2 ne prend pas la place de $1 : voir le message plus haut. La restauration s'annule." "Voir pourquoi, puis relancer station restore."
}

# Les services qui tournaient avant la restauration et que up n'a pas
# relancés : ceux d'un profil que .env n'allume pas, comme share lancé à part.
restart_others_up() {
  local running service extra=() profiles=()
  running=" $(compose ps --services --status running 2>/dev/null | tr '\n' ' ') "
  for service in "${restart_others[@]}"; do
    [[ $running == *" $service "* ]] || extra+=("$service")
  done
  ((${#extra[@]})) || return 0
  all_profiles
  compose "${profiles[@]}" up -d "${extra[@]}"
}

# Une restauration arrêtée après l'arrêt de la station : chacun reprend sa
# place, et la station d'avant repart. Le journal reste si un dossier ne
# revient pas.
restore_undo() {
  local dir=$station_stopped env_file=$station_stopped/.env i current aside new left="" profiles=()
  station_stopped=""
  warn "la restauration s'annule : la station d'avant reprend sa place, et repart."
  all_profiles
  compose "${profiles[@]}" stop >/dev/null 2>&1
  for ((i = ${#swapped[@]} - 1; i >= 0; i--)); do
    IFS='|' read -r current aside new <<<"${swapped[i]}"
    if [[ -e $current ]] && ! mv "$current" "$new"; then
      warn "$current ne revient pas en $new : le remettre à la main."
      left=1
    fi
    if [[ -e $aside ]] && ! mv "$aside" "$current"; then
      warn "$aside ne reprend pas sa place, $current : l'y remettre à la main."
      left=1
    fi
  done
  swapped=()
  [[ -n $left ]] || rm -f "$dir/$JOURNAL"
  env_isolate
  if compose up -d >/dev/null 2>&1; then
    restart_others_up >/dev/null 2>&1
  else
    warn "la station d'avant ne repart pas. Voir pourquoi : cd $dir && docker compose up -d."
  fi
}

# --- update ---

cmd_update() {
  local dir="" env_file="" assume_yes="" aborted="Rien n'est changé." installed target="" from="" packed option
  local -A opts=()
  local args=() forwarded=()
  parse_options "--yes --major --force -h --help" "--dir --version --from" "$@"
  if help_asked; then
    usage_command update
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  assume_yes=${opts[--yes]:-}
  target=${opts[--version]:-}
  from=${opts[--from]:-}
  [[ -z $target ]] || check_version "$target" || exit 2
  if [[ -n $from ]]; then
    [[ $from == /* ]] || from=$PWD/$from
    [[ -f $from ]] || usage_error "--from : $from n'existe pas."
  fi
  open_station update "${opts[--dir]:-}"
  [[ -f $dir/VERSION ]] ||
    die "La station de $dir n'a pas de fichier VERSION : elle n'a pas été installée par station install." \
      "La mettre à jour à la main : voir docs/deploiement.md, « Mettre à jour »."
  update_blocked
  installed=$(env_value BUTTON_VERSION)
  [[ -n $installed ]] ||
    die "BUTTON_VERSION manque dans $env_file." "Y remettre la version de la station, celle du fichier VERSION du dossier, puis relancer."
  docker_ok || die "Docker ne répond pas : la station ne se met pas à jour sans lui." "Voir pourquoi : systemctl status docker. Puis relancer."
  trap cleanup EXIT
  work=$(mktemp -d)
  if [[ -n $from ]]; then
    unpack "$from"
    packed=$(<"$work/files/VERSION")
    [[ $packed == main ]] || check_version "$packed" >/dev/null 2>&1 ||
      die "$from se dit de la version « $packed »." "Prendre station.tar.gz d'une version publiée."
    [[ -z $target || $target == "$packed" ]] ||
      die "$from est la version $packed, pas $target." "Prendre l'archive de la version $target, ou retirer --version."
    target=$packed
    update_compare quiet || return 0
  else
    if [[ -z $target ]]; then
      target=$(latest_version)
      check_version "$target" >/dev/null 2>&1 ||
        die "GitHub donne une version inattendue, « $target » : ne pas mettre à jour, et le signaler."
    fi
    update_compare quiet || return 0
    fetch_version "$target"
    unpack "$work/station.tar.gz"
    [[ $(<"$work/files/VERSION") == "$target" ]] ||
      die "L'archive de la version $target se dit $(<"$work/files/VERSION")." "Archive inattendue : ne pas mettre à jour, et le signaler."
    from=$work/station.tar.gz
  fi
  if update_handoff_needed; then
    for option in --yes --major --force; do
      [[ -z ${opts[$option]:-} ]] || forwarded+=("$option")
    done
    say "Mise à jour : la commande station de la version $target prend la main."
    STATION_SELF=$(self_command) STATION_UPDATE_HANDOFF=1 \
      bash "$work/files/station" update --from "$from" --dir "$dir" "${forwarded[@]}"
    return $?
  fi

  lock_station update
  update_blocked
  update_compare || return 0
  say "BUTTON : mise à jour de la station de $dir, de $installed à $target."
  update_major
  if [[ -n ${opts[--force]:-} ]]; then
    say "Fenêtre : pas vérifiée (--force). L'antenne se coupera, même pendant un direct."
  else
    update_window
  fi
  if interactive; then
    confirm update "Mettre la station à jour, de $installed à $target ? Une sauvegarde d'abord, puis l'antenne se coupe le temps de redémarrer. (o/n)"
  fi
  update_station
}

# Ce qui bloque toute mise à jour : HOLD, ou une restauration pas finie.
update_blocked() {
  if [[ -f $dir/HOLD ]]; then
    warn "les mises à jour sont bloquées, par $dir/HOLD :"
    sed 's/^/  /' "$dir/HOLD" >&2
    die "Rien n'est changé."
  fi
  [[ ! -f $dir/$JOURNAL ]] ||
    die "Une restauration ne s'est pas finie : $dir/$JOURNAL est encore là. Rien n'est changé." \
      "Voir quoi faire : station status. Puis relancer."
}

# a < b, deux versions X.Y.Z déjà vérifiées : en nombres, et 0.10.0 passe
# après 0.9.0.
version_below() { # a, b
  local IFS=. a b i
  read -r -a a <<<"$1"
  read -r -a b <<<"$2"
  for i in 0 1 2; do
    if ((10#${a[i]} != 10#${b[i]})); then
      ((10#${a[i]} < 10#${b[i]}))
      return $?
    fi
  done
  return 1
}

# La version visée, $target, face à celle de la station, $installed. Rien à
# faire : 1. Une version plus ancienne ne se prend pas, ni une version depuis
# main : sa base peut avoir un schéma plus récent. main ne se prend que depuis
# une archive, pour un essai.
update_compare() { # quiet, ou rien
  if [[ $target == "$installed" && $target != main ]]; then
    say "La station est déjà en $installed. Rien à faire."
    # Une mise à jour dont le retour arrière a échoué peut avoir déjà posé la
    # version.
    if [[ $(grep -v '^#' "$dir/updates.log" 2>/dev/null | tail -n 1 | cut -f3,4) == "$installed"$'\t'échouée ]]; then
      warn "la mise à jour vers $installed a échoué : voir station status. station rollback revient à la version d'avant ; station install répare celle-ci."
    fi
    return 1
  fi
  if [[ $installed == main ]]; then
    [[ $target == main ]] ||
      die "La station suit main, pour un essai : sa base peut avoir un schéma plus récent que celui de la version $target. Rien n'est changé." \
        "Repasser à une version publiée se fait à la main : voir docs/deploiement.md, « Revenir en arrière »."
    return 0
  fi
  check_version "$installed" >/dev/null 2>&1 ||
    die "BUTTON_VERSION vaut « $installed », dans $env_file : station update ne met à jour qu'une station épinglée sur une version X.Y.Z, comme l'installe station install." \
      "Y remettre la version de la station, celle du fichier VERSION du dossier, puis relancer."
  if [[ $target == main ]]; then
    [[ -n ${1:-} ]] ||
      warn "main n'est pas une version publiée : pour un essai, jamais à l'antenne. En revenir se fait à la main."
    return 0
  fi
  if version_below "$target" "$installed"; then
    die "La version $target est plus ancienne que celle de la station, $installed : station update ne fait que monter. Rien n'est changé." \
      "Revenir en arrière : voir docs/deploiement.md, « Revenir en arrière »."
  fi
}

# Une version majeure demande une action à la station avant de la prendre :
# station update la cite, d'après le CHANGELOG.md de la version visée, pour
# chaque majeure qu'elle passe, puis s'arrête. --major la prend, l'action
# faite. Les deux versions sont déjà vérifiées : des nombres.
update_major() {
  local from_major=${installed%%.*} to_major=${target%%.*} major action
  [[ $target != main && $installed != main ]] && ((to_major > from_major)) || return 0
  if [[ -n ${opts[--major]:-} ]]; then
    say "Version majeure : l'action que demandent ses notes est faite (--major)."
    return 0
  fi
  say "La version $target est une majeure : elle demande une action à la station avant de la prendre."
  for ((major = from_major + 1; major <= to_major; major++)); do
    action=$(major_action "$major.0.0" "$work/files/CHANGELOG.md")
    if [[ -n $action ]]; then
      say "La $major.0.0 demande :" "  ${action//$'\n'/$'\n'  }"
    else
      say "La $major.0.0 : voir ses notes, https://github.com/$REPO/releases/tag/v$major.0.0"
    fi
  done
  # Une fois par version : la mise à jour de la nuit la retrouvera chaque fois.
  alert_sent_before "Version majeure en attente" "la $target " ||
    station_alert "Version majeure en attente" \
      "la $target demande une action avant de la prendre : voir ses notes, https://github.com/$REPO/releases/tag/v$target. Une fois l'action faite : $(self_command) update --major." note
  die "" "Rien n'est changé. Une fois l'action faite : $(self_command) update --major."
}

# Le paragraphe « Mise en service » d'une version dans un CHANGELOG.md, en
# texte : sans gras, et ses liens en adresses complètes, à cette version.
major_action() { # version, CHANGELOG.md
  [[ -f $2 ]] || return 0
  awk -v version="$1" '
    /^ *(```|~~~)/ { fenced = !fenced }
    !fenced && /^## / { split(substr($0, 4), words, " "); inside = (words[1] == version); found = 0; next }
    inside && !found && /^\*\*Mise en service\.\*\*/ { found = 1; sub(/^\*\*Mise en service\.\*\* */, "") }
    found && /^ *$/ { exit }
    found { print }
  ' "$2" | sed -E -e 's/\*\*//g' -e 's#\]\((https?://[^)]*)\)# (\1)#g' \
    -e "s#\\]\\(([^)]*)\\)# (https://github.com/$REPO/blob/v$1/\\1)#g" -e 's/\[//g'
}

# La fenêtre de la mise à jour, que dit le moteur qui tourne : ni direct ni
# diffusion de l'Agenda à l'antenne, ni d'ici 30 minutes. Un moteur d'avant
# radiotomate maintenance window, ou qui ne répond pas, la laisse inconnue :
# la mise à jour se fait, et le dit. Sa réponse tient sur une ligne
# (one_line) : elle va dans updates.log, et à une demande de la console.
update_window() { # quiet, ou rien
  local answer status=0
  if ! station_running radiotomate-interface; then
    [[ -n ${1:-} ]] || say "Fenêtre : pas vérifiée, le moteur ne tourne pas : l'antenne est déjà coupée."
    return 0
  fi
  answer=$(engine_exec maintenance window </dev/null) || status=$?
  answer=$(one_line "$answer")
  if [[ $status == 1 && $answer == "occupée : "* ]]; then
    # Vu une fois la sauvegarde faite et les images tirées : la mise à jour
    # s'arrête là, et updates.log le note.
    if ((${#updating[@]})); then
      update_log arrêtée "${answer#occupée : }"
      updating=()
      die "Pas de mise à jour maintenant : ${answer#occupée : }. L'antenne se couperait pendant. La station reste en $installed, avec la sauvegarde d'avant${env_added:+, et ce que .env a reçu :$env_added}." \
        "Relancer plus tard, ou mettre à jour quand même : $(self_command) update --force."
    fi
    die "Pas de mise à jour maintenant : ${answer#occupée : }. L'antenne se couperait pendant. Rien n'est changé." \
      "Relancer plus tard, ou mettre à jour quand même : $(self_command) update --force."
  elif [[ $status == 0 && $answer == "libre : "* ]]; then
    [[ -n ${1:-} ]] || say "Fenêtre : libre, ${answer#libre : }."
  elif [[ -z ${1:-} ]]; then
    warn "la fenêtre n'est pas vérifiée : le moteur ne la dit pas, il ne répond pas, ou sa version n'a pas radiotomate maintenance window. Vérifier qu'aucun direct ne commence bientôt."
  fi
}

# La commande à citer dans un message : station, celle de la station, ou le
# script lancé, comme bash station pour la première mise à jour d'une 0.2.0,
# dont la commande n'a pas update. Une commande qui passe la main dit la sienne.
self_command() {
  local script=${BASH_SOURCE[0]:-}
  if [[ -n ${STATION_SELF:-} ]]; then
    printf '%s\n' "$STATION_SELF"
  elif [[ -n $script && $(readlink -f "$script" 2>/dev/null) == "$(readlink -f "$dir/station" 2>/dev/null)" ]]; then
    echo station
  else
    printf 'bash %s\n' "${script:-station}"
  fi
}

# La mise à jour se fait par la commande station de la version visée : elle
# seule sait ce que sa version demande, à .env par exemple. Une autre lui
# passe la main, avec ses options et l'archive vérifiée. Vrai si elle doit la
# passer : son propre script n'est pas celui de l'archive.
update_handoff_needed() {
  local script=${BASH_SOURCE[0]:-}
  [[ -z ${STATION_UPDATE_HANDOFF:-} ]] || return 1
  [[ -n $script && -f $script ]] || return 0
  ! cmp -s "$script" "$work/files/station"
}

# La mise à jour, une fois tout vérifié : la sauvegarde, .env, les images,
# tirées pendant que l'antenne joue, les fichiers, le redémarrage, puis le
# contrôle. updates.log la note, faite, ou échouée, par cleanup, qui la défait
# une fois ses fichiers touchés (update_undo).
update_station() {
  local archive="" kept="" env_added="" env_left_out="" profiles=() mounting=()
  local started cut failure=""
  # Les fichiers de la version, à part : backup_station prend work.
  staged=$work
  work=""
  update_started=$(date +%s)
  previous=""
  replaced=()
  added=()
  files_stamp=""
  others=()
  updating=("$dir" "$installed" "$target" "")
  update_stage="la sauvegarde"
  if previous_files "$installed"; then
    previous=$staged/avant/files
  elif [[ $installed != main ]]; then
    warn "les fichiers de la version $installed ne se téléchargent pas : chaque fichier que la mise à jour remplace sera gardé à côté."
  fi
  backup_target
  # Le script de sauvegarde de la version visée, qui tourne dans l'image
  # d'avant : celui d'une 0.2.0 demande sqlite3, que l'image n'a pas.
  backup_station "$archive" "" "$staged/files/scripts/backup-radiotomate.sh"
  updating[3]=$archive
  # Une mise à jour demandée depuis la console (STATION_REQUEST) ne fait de
  # place dans backups/ qu'une fois faite : le moteur, qui dit la fenêtre,
  # pourrait sinon en arrêter une après chaque sauvegarde, et faire effacer
  # les plus anciennes.
  [[ -n ${STATION_REQUEST:-} ]] || backup_rotate "$archive"

  update_stage="les images"
  update_env
  update_pull
  [[ -n ${opts[--force]:-} ]] || update_window quiet

  update_stage="les fichiers"
  update_files
  env_set BUTTON_VERSION "$target" update
  make_data_dirs
  link_command
  env_isolate
  mounted_by_containers

  update_stage="le redémarrage"
  say "Mise à jour : la station repart en $target. L'antenne se coupe le temps du redémarrage."
  started=$SECONDS
  restart_station "$target" || die "$failure"

  update_stage="le contrôle"
  check_station "$target" || die "$failure"
  # Faite : rien de ce qui suit ne la défait, pas même un journal qui ne
  # s'écrit pas.
  cut=$((SECONDS - started))
  update_log faite "redémarrée et contrôlée en $cut s" ||
    warn "updates.log ne s'écrit pas : la mise à jour, faite, n'y est pas notée. Voir la place sur le disque : station status."
  updating=()
  update_stage=""
  [[ -z ${STATION_REQUEST:-} ]] || backup_rotate "$archive" || true
  record_versions
  # Les minuteurs que pose la commande de cette version.
  remote_timers || true
  requests_timer || true
  station_alert "Mise à jour faite" \
    "la station est passée de $installed à $target, et le contrôle passe : l'antenne a repris au bout de $cut s." note

  say "" "La station est à jour : $target, au lieu de $installed. Le contrôle passe."
  say "  Redémarrée et contrôlée en $cut s, coupure de l'antenne comprise."
  say "  La sauvegarde d'avant : $archive."
  [[ -z $env_added ]] || say "  Ajouté à .env :$env_added."
  [[ -z $env_left_out ]] ||
    say "  Retirés de .env, et que la version d'avant connaissait : ils n'y reviennent pas :$env_left_out."
  [[ -z $kept ]] ||
    say "  Changés sur cette station, gardés à côté, en .local-… :$kept. Les changements d'une station vont dans compose.override.yml."
}

# Redémarre la station sur ses fichiers et la version de .env, après une mise
# à jour ou un retour arrière : les trois services du moteur ensemble, puis le
# reste, puis les services d'un autre profil qui tournaient (others), puis
# ceux qu'up ne recrée pas et qui montent un fichier changé (mounting). Ne
# s'arrête pas sur un échec : failure dit ce qui ne repart pas.
restart_station() { # version
  if ! compose up -d --force-recreate "${ENGINE_SERVICES[@]}"; then
    failure="Le moteur ne repart pas en $1 : voir le message de docker compose plus haut."
    return 1
  fi
  if ! compose up -d; then
    failure="La station ne repart pas en $1 : voir le message de docker compose plus haut."
    return 1
  fi
  if ((${#others[@]})) && ! compose "${profiles[@]}" up -d "${others[@]}"; then
    failure="Les services lancés à part ne repartent pas en $1 : voir le message de docker compose plus haut."
    return 1
  fi
  if ! remount; then
    failure="Les services qui montent un fichier changé de la version ne repartent pas : voir le message de docker compose plus haut."
    return 1
  fi
}

# Le contrôle, après une mise à jour ou un retour arrière : l'adresse de la
# station en HTTPS, si Caddy la sert, puis smoke.sh. Ne s'arrête pas sur un
# échec : failure dit ce qui ne va pas.
check_station() { # version
  local tls domain
  tls=$(env_value CADDY_TLS acme)
  domain=$(env_value DOMAIN)
  if [[ -n $domain && ,$(env_value COMPOSE_PROFILES), == *,vps,* ]] && ! https_ok; then
    failure="https://$domain ne répond pas au bout de $HTTPS_WAIT s, en $1. Voir pourquoi : cd $dir && docker compose logs caddy."
    return 1
  fi
  if ! smoke_ok; then
    failure="Le contrôle de la station a échoué en $1 : voir plus haut."
    return 1
  fi
}

# Une mise à jour qui n'aboutit pas, une fois ses fichiers touchés : cleanup
# l'appelle, et la station revient seule à la version d'avant. Si la station a
# redémarré, la base d'avant la mise à jour doit-elle revenir, et le peut-elle ?
# Cela se voit avant de rien défaire : sinon, la station reste à la version
# nouvelle, qui tourne peut-être encore. Puis ses fichiers, tels qu'ils étaient,
# et sa version dans .env. Si la station a redémarré : les services venus avec
# la mise à jour s'en vont, la base d'avant revient si le schéma a migré, car
# la version d'avant ne lit pas un schéma plus récent, et les images d'avant
# repartent, pour tous les services. Puis le contrôle. Quoi qu'il arrive, une
# ligne dans updates.log, HOLD, qui bloque les mises à jour suivantes, et
# l'alerte. Rien ne l'arrête en route : elle ne fait que dire ses échecs.
update_undo() {
  local dir=${updating[0]} env_file=${updating[0]}/.env installed=${updating[1]} target=${updating[2]}
  local stage=$update_stage failure="" base="" logs="" copy="" copy_schema="" reverted="" stopped="" state
  local profiles=() mounting=()
  warn "la mise à jour s'annule : la station revient en $installed."
  [[ -n $work && -d $work ]] || work=$(mktemp -d)
  if [[ $stage != "les fichiers" ]]; then
    ! keep_failed_logs || logs=$dir/$FAILED_LOGS
    undo_database_check
  fi
  if [[ -z $failure ]]; then
    if ! undo_files; then
      failure="Des fichiers de la version $installed ne reviennent pas : voir plus haut."
    elif ! env_set BUTTON_VERSION "$installed" update; then
      failure="BUTTON_VERSION ne revient pas à $installed, dans $env_file."
    else
      reverted=1
    fi
    env_isolate
  fi
  if [[ -n $reverted && $stage != "les fichiers" ]]; then
    # Les profils du compose.yml d'avant, de nouveau en place.
    all_profiles
    drop_new_services
    mounted_by_containers
    if [[ -z $copy ]] || undo_database_restore "$staged/files/scripts/restore-radiotomate.sh"; then
      say "Retour arrière : la station repart en $installed."
      restart_station "$installed" && check_station "$installed" && record_versions
    fi
  fi
  # La commande de la version d'avant ne connaît peut-être pas la sauvegarde
  # hors de la machine : ses minuteurs s'en vont alors. Sinon, ils restent
  # tels quels : ce script n'écrit pas ceux d'une autre version.
  [[ -z $reverted ]] || remote_timers keep || true
  [[ -z $reverted ]] || requests_timer keep || true
  if [[ -z $failure ]]; then
    update_log annulée "pendant $stage ; revenue en $installed${base:+, $base}"
    hold_write "Bloquées par station update" \
      "la mise à jour de $installed à $target a échoué pendant $stage, et la station est revenue en $installed${logs:+. Les journaux de la $target : $logs}."
    station_alert "Mise à jour annulée" \
      "la mise à jour de $installed à $target a échoué pendant $stage : la station est revenue en $installed, et HOLD bloque les suivantes."
    if [[ $stage == "les fichiers" ]]; then
      say "" "La station tourne toujours en $installed, qui n'a pas redémarré : ses fichiers sont revenus. La mise à jour vers $target est annulée."
    else
      say "" "La station est revenue en $installed : le contrôle passe. La mise à jour vers $target est annulée."
    fi
    [[ -z $base ]] || say "  ${base^} ; la base de la $target reste à côté, dans $(env_path RT_DATA ./data/radiotomate)/backups."
    [[ -z $logs ]] || say "  Les journaux de la $target, pour voir pourquoi : $logs."
    say "  Les mises à jour sont bloquées par $dir/HOLD. Les débloquer, une fois la cause trouvée : $(self_command) unhold, ou rm $dir/HOLD."
  else
    update_log échouée "pendant $stage ; le retour en $installed a échoué : $failure"
    hold_write "Bloquées par station update" \
      "la mise à jour de $installed à $target a échoué pendant $stage, et le retour en $installed aussi : $failure"
    station_alert "Mise à jour ratée, station à réparer" \
      "la mise à jour de $installed à $target a échoué pendant $stage, et le retour en $installed aussi : $failure"
    if [[ -n $stopped ]]; then
      state="La station est arrêtée."
    elif [[ -n $reverted ]]; then
      state="La station est peut-être coupée."
    elif [[ $stage == "les fichiers" ]]; then
      state="Ses fichiers sont en partie ceux de la $target, et ses conteneurs, ceux de la $installed, tournent encore."
    elif [[ $stage == "le redémarrage" ]]; then
      state="La station reste en $target, qui n'a pas redémarré : l'antenne est sans doute coupée."
    else
      state="La station reste en $target, qui tourne, mais que le contrôle refuse."
    fi
    warn "le retour en $installed a échoué : $failure"
    printf '%s\n' "  $state Voir son état : $(self_command) status${logs:+ ; les journaux de la $target : $logs}." \
      "  Une fois la cause réglée, $(self_command) rollback refait le retour en $installed." \
      "  La sauvegarde d'avant la mise à jour : ${updating[3]:--}." >&2
  fi
}

# Les fichiers d'avant la mise à jour reprennent leur place, chacun par un
# renommage, comme update_files les a posés : la copie .local-… qu'elle a
# gardée d'un fichier que la station avait changé, sinon celui de la version
# d'avant. Un fichier qui n'était pas là s'en va. Ce que la mise à jour n'a
# pas fini de poser, une copie partielle, ou la copie .local-… d'un fichier
# resté tel quel, s'en va aussi.
undo_files() {
  local file path mode left=""
  for file in "${replaced[@]}"; do
    if [[ " ${added[*]} " == *" $file "* ]]; then
      rm -f "$dir/$file" || left="$left $file"
    elif [[ -n $files_stamp && -e $dir/$file.local-$files_stamp ]]; then
      mv -f "$dir/$file.local-$files_stamp" "$dir/$file" || left="$left $file"
    elif [[ -n $previous && -f $previous/$file ]]; then
      mode=$(stat -c %a "$previous/$file")
      { install -D -m "$mode" "$previous/$file" "$dir/$file.station-$$" &&
        mv -f "$dir/$file.station-$$" "$dir/$file"; } || left="$left $file"
    else
      left="$left $file"
    fi
  done
  while IFS= read -r path; do
    file=${path#"$staged/files/"}
    rm -f "$dir/$file.station-$$"
    if [[ -n $files_stamp && -e $dir/$file.local-$files_stamp ]] && cmp -s "$dir/$file" "$dir/$file.local-$files_stamp"; then
      rm -f "$dir/$file.local-$files_stamp"
    fi
  done < <(find "$staged/files" -type f)
  [[ -n $left ]] || return 0
  warn "ces fichiers ne reviennent pas à la version $installed :$left."
  return 1
}

# Les journaux des conteneurs depuis le début de la mise à jour, dans
# FAILED_LOGS, en 600 : le retour arrière recrée les conteneurs, et les leurs
# partent avec eux.
keep_failed_logs() {
  local file=$dir/$FAILED_LOGS profiles=()
  all_profiles
  install -m 600 /dev/null "$file.part" 2>/dev/null || return 1
  compose "${profiles[@]}" logs --no-color --timestamps --since "$(date -u -d "@$update_started" +%Y-%m-%dT%H:%M:%SZ)" \
    >"$file.part" 2>&1 || true
  mv -f "$file.part" "$file"
}

# Avant de rien défaire : la base d'avant la mise à jour doit-elle revenir, et
# le peut-elle ? copy nomme la copie à remettre, si le schéma a migré depuis
# le début de la mise à jour : celle que la migration a faite. Une copie
# abîmée, ou la place qui manque à côté de la base pour l'y remettre, l'en
# empêchent : failure le dit. Un contrôle qui ne se fait pas n'empêche rien :
# le script de restauration vérifie encore la copie.
undo_database_check() {
  local found checks current saved integrity data need
  found=$(db_copy_since "$update_started")
  [[ -n $found ]] || return 0
  saved=$(copy_schema "$found")
  checks=$(engine_copy_check "$found") || checks=""
  current=$(sed -n 1p <<<"$checks")
  integrity=$(sed -n 2p <<<"$checks")
  # La première migration a échoué, sans rien laisser : la base n'a pas bougé.
  if [[ $current =~ ^[0-9]+$ ]] && ((current <= saved)); then
    say "Retour arrière : la base est restée au schéma v$current, que la version $installed lit."
    return 0
  fi
  if [[ -n $integrity && $integrity != ok ]]; then
    failure="La copie de la base d'avant la mise à jour, $found, est abîmée : $integrity. La base ne peut pas revenir."
    return 1
  fi
  data=$(env_path RT_DATA ./data/radiotomate)
  need=$(($(size_kb "$data/backups/$found") + COPY_MARGIN_KB))
  if ! room_for "$data" "$need"; then
    failure="Il manque de la place à côté de la base pour y remettre celle d'avant la mise à jour, $(human_kb "$need") : la base ne peut pas revenir. Libérer de la place."
    return 1
  fi
  copy=$found
  copy_schema=$saved
}

# La base d'avant la mise à jour remise, la station arrêtée, tous ses profils :
# rien ne garde la base ouverte. Le script de restauration est celui de la
# version nouvelle, qui tourne dans l'image d'avant, les fichiers d'avant
# posés : celui d'une 0.2.0 demande sqlite3, que l'image n'a pas.
undo_database_restore() { # script de restauration
  if ! compose "${profiles[@]}" stop >/dev/null 2>&1; then
    failure="La station ne s'arrête pas : la base d'avant la mise à jour ne se remet pas sans cela."
    return 1
  fi
  stopped=1
  if ! engine_restore_copy "$copy" "$1"; then
    failure="La base d'avant la mise à jour, $copy, ne se remet pas : voir le message plus haut."
    return 1
  fi
  base="avec la base d'avant la mise à jour : ce qui s'est écrit depuis le $(station_date "$(copy_time "$copy")") est perdu"
  say "Retour arrière : la base d'avant la mise à jour, au schéma v${copy_schema:-inconnu}, est remise."
}

# Les conteneurs d'un service que la version d'avant n'a pas, venus avec la
# mise à jour : ils s'arrêtent et s'en vont, leurs volumes restent. Sans la
# liste des services de la version d'avant, rien ne s'en va.
drop_new_services() {
  local known ids=() id service gone=""
  known=$(compose "${profiles[@]}" config --services 2>/dev/null) || return 0
  [[ -n $known ]] || return 0
  known=" $(tr '\n' ' ' <<<"$known") "
  mapfile -t ids < <(docker ps -aq --no-trunc --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.oneoff=False 2>/dev/null)
  ((${#ids[@]})) || return 0
  while IFS='|' read -r id service; do
    [[ -z $service || $known == *" $service "* ]] && continue
    ! docker rm -f "$id" >/dev/null 2>&1 || gone="$gone $service"
  done < <(docker inspect --format '{{.Id}}|{{index .Config.Labels "com.docker.compose.service"}}' "${ids[@]}" 2>/dev/null)
  [[ -z $gone ]] || say "Retour arrière : retirés, venus avec la mise à jour :$gone."
}

# La copie de la base qu'une migration a faite depuis cette heure, dans
# RT_DATA/backups : la plus ancienne, celle d'avant la première migration.
# Son nom dit son heure, en UTC. Rien, s'il n'y en a pas.
db_copy_since() { # secondes depuis 1970
  local since path name stamp best=""
  since=$(date -u -d "@$1" +%Y%m%dT%H%M%SZ)
  for path in "$(env_path RT_DATA ./data/radiotomate)"/backups/avant-v*-*.db; do
    name=${path##*/}
    [[ $name =~ ^avant-v[0-9]+-([0-9]{8}T[0-9]{6}Z)\.db$ ]] || continue
    stamp=${BASH_REMATCH[1]}
    [[ ! $stamp < $since ]] || continue
    [[ -n $best && ! $stamp < ${best%% *} ]] || best="$stamp $name"
  done
  printf '%s\n' "${best#* }"
}

# Le schéma d'une copie de la base, d'après son nom : avant-v19-… est la base
# d'avant la migration v19, au schéma v18. db_copy_since a vérifié le nom.
copy_schema() { # avant-vNN-AAAAMMJJTHHMMSSZ.db
  local number=${1#avant-v}
  number=${number%%-*}
  printf '%s\n' "$((10#$number - 1))"
}

# L'heure d'une copie de la base, en secondes depuis 1970, d'après son nom.
copy_time() { # avant-vNN-AAAAMMJJTHHMMSSZ.db
  local stamp=${1##*-}
  stamp=${stamp%Z.db}
  date -u -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s
}

# Les fichiers d'une version publiée, celle que la station quitte, dans
# $staged/avant/files : de quoi reconnaître ce que la station a changé
# elle-même, et ce qu'un retour arrière remet.
previous_files() { # version
  local base="https://github.com/$REPO/releases/download/v$1" name expected
  check_version "$1" >/dev/null 2>&1 || return 1
  mkdir -p "$staged/avant/files"
  for name in station.tar.gz SHA256SUMS; do
    curl --disable -fsSL --retry 3 --max-time 120 -o "$staged/avant/$name" "$base/$name" 2>/dev/null || return 1
  done
  expected=$(awk '$2 == "station.tar.gz" { print $1 }' "$staged/avant/SHA256SUMS")
  [[ -n $expected && $(sha256sum "$staged/avant/station.tar.gz" | cut -d' ' -f1) == "$expected" ]] || return 1
  tar -xzf "$staged/avant/station.tar.gz" -C "$staged/avant/files" 2>/dev/null
}

# Les KEEP_BACKUPS dernières archives de backups/ restent, les plus anciennes
# s'effacent : celles de station backup aussi, quand elle écrit là. Leur nom
# dit leur heure, en UTC : l'ordre des noms est celui des heures. Celle qui
# vient de s'écrire reste, même quand une horloge en avance en a fait de plus
# récentes.
backup_rotate() { # l'archive qui vient de s'écrire
  local expired=()
  mapfile -t expired < <(find "$dir/backups" -maxdepth 1 -type f -name 'button-*.tar' ! -path "$1" | sort -r |
    tail -n "+$KEEP_BACKUPS")
  ((${#expired[@]})) || return 0
  rm -f -- "${expired[@]}"
  say "Sauvegardes : les $KEEP_BACKUPS dernières restent dans $dir/backups ; ${#expired[@]} plus ancienne(s) effacée(s)."
}

# .env : ce que la version visée y demande en plus, avec sa valeur par défaut,
# par le write_env de la version, avant de tirer ses images : son compose.yml
# peut en avoir besoin. Le nouveau seulement (env_add) : sans les fichiers de
# la version d'avant, rien que les secrets qui manquent. Rien de posé ne
# change ; la version, BUTTON_VERSION, change avec les fichiers.
update_env() {
  local version=$target first="" domain email timezone admin updates tls env_by=update
  local env_new_only=1 env_known=""
  [[ -z $previous || ! -f $previous/.env.example ]] || env_known=$previous/.env.example
  domain=$(env_value DOMAIN)
  email=$(env_value ACME_EMAIL)
  timezone=$(env_value TZ Europe/Paris)
  admin=$(env_value RT_ADMIN_USER admin)
  updates=$(env_value BUTTON_UPDATES auto)
  tls=$(env_value CADDY_TLS acme)
  write_env
}

# Les images de la version, tirées pendant que l'antenne joue encore : avec
# le compose.yml de la version, le compose.override.yml de la station et son
# .env, à la version près. Aussi celles des services d'un autre profil qui
# tournent, comme share lancé à part : ils repartiront avec la station.
update_pull() {
  local files=(-f "$staged/files/compose.yml") unchanged
  local again="Images privées : docker login ghcr.io, avec un jeton GitHub qui a read:packages. Sinon, vérifier l'accès de la machine à ghcr.io. Puis relancer."
  unchanged="La station tourne toujours en $installed${env_added:+, mais .env a reçu :$env_added}."
  [[ ! -f $dir/compose.override.yml ]] || files+=(-f "$dir/compose.override.yml")
  all_profiles
  others_running ||
    die "docker compose ne lit pas la station : $failure $unchanged" \
      "Voir pourquoi : cd $dir && docker compose config. Puis relancer."
  say "Mise à jour : les images de la version $target, pendant que l'antenne joue."
  (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" pull) ||
    die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. $unchanged" "$again"
  if ((${#others[@]})); then
    (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" "${profiles[@]}" pull "${others[@]}") ||
      die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. $unchanged" "$again"
  fi
}

# Les fichiers de la version remplacent ceux du dossier, chacun par un
# renommage : bash lit encore, sans le relire en entier, le script qui l'a
# lancé. Un fichier que la station a changé elle-même, autre que celui de la
# version qu'elle quitte, est gardé à côté, en .local-…, comme le fait
# install. Sans les fichiers de cette version, chaque fichier remplacé l'est.
# Ce qui est remplacé se note dans replaced, et dans added ce qui n'était pas
# là : de quoi les remettre (undo_files).
update_files() {
  local file mode
  files_stamp=$(date +%Y%m%d-%H%M%S)
  while IFS= read -r file; do
    file=${file#"$staged/files/"}
    mode=$(stat -c %a "$staged/files/$file")
    if [[ -e $dir/$file ]] && cmp -s "$staged/files/$file" "$dir/$file"; then
      chmod "$mode" "$dir/$file"
      continue
    fi
    if [[ -e $dir/$file ]] && { [[ -z $previous ]] || ! cmp -s "$dir/$file" "$previous/$file"; }; then
      cp -p "$dir/$file" "$dir/$file.local-$files_stamp"
      kept="$kept $file"
    fi
    [[ -e $dir/$file ]] || added+=("$file")
    install -D -m "$mode" "$staged/files/$file" "$dir/$file.station-$$"
    mv -f "$dir/$file.station-$$" "$dir/$file"
    replaced+=("$file")
  done < <(find "$staged/files" -type f | sort)
}

# Les services d'un autre profil qui tournent, comme share lancé à part, dans
# others : ils repartent avec la station. Avec les profils de l'appelant,
# tous (all_profiles). Si docker compose ne lit pas la station, failure dit
# pourquoi.
others_running() {
  local running active service
  running=$(compose "${profiles[@]}" ps --services --status running 2>/dev/null) || running=""
  if ! active=$(compose config --services 2>&1); then
    failure=$(head -n 1 <<<"$active")
    return 1
  fi
  active=" $(tr '\n' ' ' <<<"$active") "
  others=()
  while IFS= read -r service; do
    [[ -z $service || $active == *" $service "* ]] || others+=("$service")
  done <<<"$running"
}

# Les conteneurs qui tournent et montent un fichier que la version vient de
# remplacer, dans mounting, « id|service » : un fichier monté seul reste
# l'ancien dans le conteneur, jusqu'à sa recréation.
mounted_by_containers() {
  local ids=() id service mounts file real
  ((${#replaced[@]})) || return 0
  real=$(real_path "$dir")
  mapfile -t ids < <(docker ps -q --no-trunc --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.oneoff=False 2>/dev/null)
  ((${#ids[@]})) || return 0
  while IFS='|' read -r id service mounts; do
    for file in "${replaced[@]}"; do
      if [[ " $mounts " == *" $dir/$file "* || " $mounts " == *" $real/$file "* ]]; then
        mounting+=("$id|$service")
        break
      fi
    done
  done < <(docker inspect --format '{{.Id}}|{{index .Config.Labels "com.docker.compose.service"}}|{{range .Mounts}}{{.Source}} {{end}}' \
    "${ids[@]}" 2>/dev/null)
}

# Ceux que up n'a pas recréés, d'une image épinglée comme Caddy ou rclone :
# recréés à leur tour, sans leurs dépendances, avec le fichier de la version.
# Sinon, un Caddyfile changé ne servirait qu'au démarrage suivant.
remount() {
  local running entry service stale=" "
  ((${#mounting[@]})) || return 0
  running=" $(docker ps -q --no-trunc --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null | tr '\n' ' ') "
  for entry in "${mounting[@]}"; do
    service=${entry#*|}
    [[ $running != *" ${entry%%|*} "* || $stale == *" $service "* ]] || stale="$stale$service "
  done
  [[ -n ${stale// /} ]] || return 0
  say "Mise à jour : recréés avec les fichiers de la version :${stale% }."
  # Les noms viennent du relevé : un mot chacun.
  # shellcheck disable=SC2086
  compose "${profiles[@]}" up -d --force-recreate --no-deps $stale
}

# Une ligne de updates.log, dans le dossier de la station : l'heure de son
# début, la version d'avant, la nouvelle, le résultat, la sauvegarde d'avant,
# et ce qu'il faut en savoir. status dit la dernière. Le résultat d'une mise à
# jour : faite, arrêtée, annulée, quand elle est revenue seule à la version
# d'avant, ou échouée ; celui de station rollback : retour arrière, ou retour
# arrière échoué. rollback y cherche la mise à jour à défaire, et la copie de
# la base faite depuis son début.
update_log() { # résultat, détail
  local log=${updating[0]}/updates.log
  if [[ ! -f $log ]]; then
    printf '%s\n' "# Les mises à jour de station update, et les retours arrière, une par ligne : l'heure de son début, en secondes depuis 1970, la version d'avant, la nouvelle, le résultat, la sauvegarde d'avant, et ce qu'il faut en savoir." \
      >"$log"
  fi
  # Un champ vide se lirait mal : read fond deux tabulations qui se suivent.
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${update_started:-$(date +%s)}" "${updating[1]}" "${updating[2]}" "$1" \
    "${updating[3]:--}" "$(log_field "$2")" >>"$log"
}

# Un champ de updates.log, sur une ligne : ni tabulation, ni saut de ligne, ni
# caractère de contrôle, qui forgeraient un champ ou une ligne. Ce que dit le
# moteur, la fenêtre par exemple, y entre.
log_field() { # texte
  printf '%s' "$1" | LC_ALL=C tr '\t\n\r' '   ' | LC_ALL=C tr -d '\000-\037\177'
}

# La version de chaque service qui tourne, d'après Docker, dans versions.json,
# dans RT_DATA : l'interface n'a pas accès à Docker, et GET
# /system/version.json la lit là. Le fichier ne change qu'avec les versions :
# son heure dit depuis quand elles tournent, et une relance d'install ne
# change rien. RT_DATA est au moteur, qui pourrait y poser un lien : un
# conteneur du moteur écrit le fichier (engine_run), jamais root sur l'hôte.
# Un échec ne fait qu'avertir.
record_versions() {
  local work ids=() service image label version items=() body
  [[ -d $(env_path RT_DATA ./data/radiotomate) ]] || return 0
  mapfile -t ids < <(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" \
    --filter label=com.docker.compose.oneoff=False 2>/dev/null)
  if ((${#ids[@]})); then
    while IFS='|' read -r service image label; do
      [[ $service =~ ^[a-z0-9][a-z0-9_.-]*$ ]] || continue
      [[ $image =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || image=""
      [[ $label =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || label=""
      items+=("{\"service\":\"$service\",\"image\":\"$image\",\"version\":\"$label\"}")
    done < <(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}|{{.Config.Image}}|{{index .Config.Labels "org.opencontainers.image.version"}}' \
      "${ids[@]}" 2>/dev/null | sort -u)
  fi
  version=$(env_value BUTTON_VERSION)
  [[ $version =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || version=""
  body="\"version\":\"$version\",\"services\":[$(
    IFS=,
    printf '%s' "${items[*]}"
  )]"
  work=$(mktemp -d)
  if ! engine_run -e "BUTTON_VERSIONS=$body" --entrypoint python3 radiotomate-init - >/dev/null <<'PY'; then
# relevé : versions.json, dans RT_DATA, quand les versions changent.
import json
import os
import stat
import tempfile
from datetime import datetime, timezone

data = os.environ.get("BUTTON_DATA", "/data")
path = os.path.join(data, "versions.json")
body = json.loads("{" + os.environ["BUTTON_VERSIONS"] + "}")
old = None
try:
    # Sans suivre un lien, ni attendre un tube : RT_DATA est au moteur.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if stat.S_ISREG(os.fstat(fd).st_mode):
            old = json.loads(os.read(fd, 1 << 16))
    finally:
        os.close(fd)
except (OSError, ValueError):
    old = None
if isinstance(old, dict) and {key: old.get(key) for key in body} == body:
    raise SystemExit(0)
record = {"recorded_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), **body}
fd, part = tempfile.mkstemp(dir=data, prefix=".versions-")
with os.fdopen(fd, "w", encoding="utf-8") as out:
    out.write(json.dumps(record, separators=(",", ":")) + "\n")
    os.fchmod(out.fileno(), 0o644)
os.replace(part, path)
PY
    warn "la version des services ne s'écrit pas dans versions.json : la console ne la dira pas."
  fi
  rm -rf "${work:?}"
}

# --- rollback ---

cmd_rollback() {
  local dir="" env_file="" assume_yes="" aborted="Rien n'est changé." installed target="" leaving="" undone="" from="" packed
  local -A opts=()
  local args=()
  parse_options "--yes -h --help" "--dir --from" "$@"
  if help_asked; then
    usage_command rollback
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  assume_yes=${opts[--yes]:-}
  from=${opts[--from]:-}
  if [[ -n $from ]]; then
    [[ $from == /* ]] || from=$PWD/$from
    [[ -f $from ]] || usage_error "--from : $from n'existe pas."
  fi
  open_station rollback "${opts[--dir]:-}"
  [[ -f $dir/VERSION ]] ||
    die "La station de $dir n'a pas de fichier VERSION : elle n'a pas été installée par station install." \
      "Revenir en arrière à la main : voir docs/deploiement.md, « Revenir en arrière »."
  [[ ! -f $dir/$JOURNAL ]] ||
    die "Une restauration ne s'est pas finie : $dir/$JOURNAL est encore là. Rien n'est changé." \
      "Voir quoi faire : station status. Puis relancer."
  lock_station rollback
  installed=$(env_value BUTTON_VERSION)
  rollback_target || return 0
  docker_ok || die "Docker ne répond pas : la station ne revient pas en arrière sans lui." "Voir pourquoi : systemctl status docker. Puis relancer."
  confirm_possible rollback
  trap cleanup EXIT
  work=$(mktemp -d)
  if [[ -n $from ]]; then
    unpack "$from"
    packed=$(<"$work/files/VERSION")
    [[ $packed == "$target" ]] ||
      die "$from est la version $packed, et la version d'avant la dernière mise à jour la $target. Rien n'est changé." \
        "Prendre l'archive de la version $target."
  else
    check_version "$target" >/dev/null 2>&1 ||
      die "La version d'avant la dernière mise à jour, $target, n'est pas une version publiée : ses fichiers ne se téléchargent pas. Rien n'est changé." \
        "Donner son archive : station rollback --from station.tar.gz."
    fetch_version "$target" "Rien n'est changé. Vérifier l'accès de la machine à github.com, puis relancer ; ou donner l'archive de la version $target : station rollback --from station.tar.gz."
    unpack "$work/station.tar.gz"
    [[ $(<"$work/files/VERSION") == "$target" ]] ||
      die "L'archive de la version $target se dit $(<"$work/files/VERSION")." "Archive inattendue : ne pas l'utiliser, et le signaler."
  fi
  rollback_station
}

# La mise à jour à défaire, d'après updates.log : la dernière encore en place.
# Les lignes lues depuis la fin passent celles qui n'ont rien laissé : une
# mise à jour arrêtée, annulée, ou échouée avant ses fichiers, et un retour
# arrière raté, qui se reprend. Une mise à jour faite, ou échouée une fois ses
# fichiers touchés, se défait ; un retour arrière réussi l'a déjà défaite. Sa
# version d'avant dans target, celle qu'elle a posée dans leaving, l'heure de
# son début dans undone. Sinon, dit qu'il n'y a rien à défaire, et rend 1.
rollback_target() {
  local line made from to result _backup detail found=""
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS=$'\t' read -r made from to result _backup detail <<<"$line" || true
    case $result in
      "retour arrière")
        say "Rien à défaire : la dernière mise à jour, de $to à $from, est déjà défaite."
        return 1
        ;;
      "retour arrière échoué" | arrêtée | annulée) ;;
      échouée)
        case $detail in
          "pendant la sauvegarde"* | "pendant les images"*) ;;
          *)
            found=1
            break
            ;;
        esac
        ;;
      faite)
        found=1
        break
        ;;
      *)
        die "$dir/updates.log a une ligne au résultat inattendu, « $result ». Rien n'est changé." \
          "Voir updates.log, et l'état de la station : station status."
        ;;
    esac
  done < <(grep -v '^#' "$dir/updates.log" 2>/dev/null | tac)
  if [[ -z $found ]]; then
    say "Rien à défaire : $dir/updates.log ne note aucune mise à jour en place."
    return 1
  fi
  [[ $made =~ ^[0-9]+$ ]] ||
    die "$dir/updates.log a une ligne sans heure : « $made ». Rien n'est changé." "Voir updates.log."
  [[ $from == main ]] || check_version "$from" >/dev/null 2>&1 ||
    die "$dir/updates.log nomme une version inattendue, « $from ». Rien n'est changé." "Voir updates.log."
  [[ $installed == "$to" || $installed == "$from" ]] ||
    die "La station est en ${installed:-une version inconnue}, et la dernière mise à jour allait de $from à $to : rollback ne sait pas d'où revenir. Rien n'est changé." \
      "Voir updates.log, et l'état de la station : station status."
  target=$from
  leaving=$to
  undone=$made
}

# Le retour arrière à la main, vers target, la version d'avant la dernière
# mise à jour, dont les fichiers sont dans $work/files. Comme update, sans
# sauvegarde ni fenêtre : la base d'avant la mise à jour revient si le schéma
# a migré depuis, une fois confirmé. Tout ce qui pourrait l'arrêter en route se
# vérifie avant : la copie de la base, le script qui la remet, la place, les
# images, et le schéma que lira la version d'avant. HOLD se pose avant de rien
# changer.
rollback_station() {
  local kept="" profiles=() mounting=() failure="" base="" copy schemas current saved integrity known after
  local lost="" script="" need question
  # Les fichiers de la version d'avant, à part, comme update.
  staged=$work
  work=$(mktemp -d)
  update_started=$(date +%s)
  previous=""
  replaced=()
  added=()
  files_stamp=""
  # Les fichiers de la version quittée : de quoi reconnaître ce que la station
  # a changé elle-même, et son script de restauration.
  if previous_files "$leaving"; then
    previous=$staged/avant/files
  fi
  all_profiles
  others_running ||
    die "docker compose ne lit pas la station : $failure Rien n'est changé." "Voir pourquoi : cd $dir && docker compose config. Puis relancer."
  # La base : la copie qu'en a faite la mise à jour, si son schéma a migré.
  copy=$(db_copy_since "$undone")
  if [[ -n $copy ]]; then
    saved=$(copy_schema "$copy")
    schemas=$(engine_copy_check "$copy") ||
      die "La version du schéma de la base ne se lit pas : voir le message plus haut. Rien n'est changé." "Voir l'état de la station : station status."
    current=$(sed -n 1p <<<"$schemas")
    integrity=$(sed -n 2p <<<"$schemas")
    [[ $current =~ ^[0-9]+$ ]] ||
      die "La version du schéma de la base en place ne se lit pas. Rien n'est changé." "Voir l'état de la station : station status."
    if ((current > saved)); then
      [[ $integrity == ok ]] ||
        die "La copie de la base d'avant la mise à jour, $copy, est abîmée : $integrity. Rien n'est changé." \
          "Revenir à la main, en redescendant le schéma : voir docs/deploiement.md, « Revenir en arrière »."
      lost=$(copy_time "$copy")
      script=$(restore_script) ||
        die "Aucun script de restauration à portée ne sait se passer de sqlite3, que l'image du moteur n'a pas : ni celui de la version $leaving, ni celui du dossier. Rien n'est changé." \
          "Celui de la version $leaving vient de son archive, sur GitHub : vérifier l'accès de la machine à github.com, puis relancer."
      need=$(($(size_kb "$(env_path RT_DATA ./data/radiotomate)/backups/$copy") + COPY_MARGIN_KB))
      room_for "$(env_path RT_DATA ./data/radiotomate)" "$need" ||
        die "Il manque de la place à côté de la base pour y remettre celle d'avant la mise à jour, $(human_kb "$need"). Rien n'est changé." \
          "Libérer de la place, puis relancer."
    fi
  fi
  rollback_images
  # La base que trouvera la version d'avant, la copie ou celle en place : elle
  # doit la lire.
  schemas=$(engine_target_schemas) ||
    die "Le moteur de la version $target ne dit pas jusqu'à quel schéma il lit : voir le message plus haut. Rien n'est changé." \
      "Voir l'état de la station : station status."
  current=$(sed -n 1p <<<"$schemas")
  known=$(sed -n 2p <<<"$schemas")
  [[ $current =~ ^[0-9]+$ && $known =~ ^[0-9]+$ ]] ||
    die "La version du schéma de la base ne se lit pas : « $current », « $known ». Rien n'est changé." "Voir l'état de la station : station status."
  after=$current
  [[ -z $lost ]] || after=$saved
  if ((after > known)); then
    if [[ -z $lost ]]; then
      die "La base est au schéma v$after, et la version $target ne lit que jusqu'au v$known : la copie de la base d'avant la mise à jour n'est plus dans $(env_path RT_DATA ./data/radiotomate)/backups. Rien n'est changé." \
        "Revenir à la main, en redescendant le schéma avec l'image de la $leaving : voir docs/deploiement.md, « Revenir en arrière »."
    fi
    die "La copie de la base d'avant la mise à jour, $copy, est au schéma v$after, et la version $target ne lit que jusqu'au v$known. Rien n'est changé." \
      "Revenir à la main : voir docs/deploiement.md, « Revenir en arrière »."
  fi
  question="Revenir de $leaving à $target ?"
  if [[ -n $lost ]]; then
    question="$question La base revient à celle d'avant la mise à jour, du $(station_date "$lost") : ce qui s'est écrit depuis, il y a $(since "$lost"), sera perdu, et la base d'aujourd'hui gardée à côté."
  fi
  confirm rollback "$question L'antenne se coupe le temps de redémarrer. (o/n)"

  # Dès lors, un échec se note, et les mises à jour restent bloquées.
  updating=("$dir" "$leaving" "$target" "-")
  update_stage="les fichiers"
  rolling_back=1
  if [[ ! -f $dir/HOLD ]]; then
    hold_write "Bloquées par station rollback" \
      "retour de $leaving à $target, à la main. La version $leaving ne se reprend qu'une fois HOLD retiré."
  fi
  say "Retour arrière : de $leaving à $target."
  update_files
  env_set BUTTON_VERSION "$target" rollback
  make_data_dirs
  link_command
  env_isolate
  drop_new_services
  mounted_by_containers

  update_stage="le redémarrage"
  if [[ -n $lost ]]; then
    say "Retour arrière : la station s'arrête, le temps de remettre la base d'avant la mise à jour."
    compose "${profiles[@]}" stop ||
      die "La station ne s'arrête pas : voir le message de docker compose plus haut. Elle est peut-être coupée."
    engine_restore_copy "$copy" "$script" ||
      die "La base d'avant la mise à jour, $copy, ne se remet pas : voir le message plus haut. La station est arrêtée."
    base="avec la base d'avant la mise à jour : ce qui s'est écrit depuis le $(station_date "$lost") est perdu"
  fi
  say "Retour arrière : la station repart en $target. L'antenne se coupe le temps du redémarrage."
  restart_station "$target" || die "$failure"
  update_stage="le contrôle"
  check_station "$target" || die "$failure"
  update_log "retour arrière" "à la main${base:+ ; $base}" ||
    warn "updates.log ne s'écrit pas : le retour arrière, fait, n'y est pas noté. Voir la place sur le disque : station status."
  updating=()
  update_stage=""
  rolling_back=""
  record_versions
  # Les minuteurs de la sauvegarde hors de la machine s'en vont si la commande
  # de la version d'avant ne la connaît pas ; sinon, ils restent tels quels.
  # De même celui des demandes de la console.
  remote_timers keep || true
  requests_timer keep || true
  station_alert "Mise à jour défaite" \
    "station rollback a ramené la station de $leaving à $target, à la main : HOLD bloque les mises à jour suivantes."

  say "" "La station est revenue en $target, au lieu de $leaving : le contrôle passe."
  [[ -z $base ]] || say "  ${base^} ; la base de la $leaving reste à côté, dans $(env_path RT_DATA ./data/radiotomate)/backups."
  say "  Les mises à jour sont bloquées par $dir/HOLD. Les débloquer, une fois la cause trouvée : $(self_command) unhold, ou rm $dir/HOLD."
  [[ -z $kept ]] ||
    say "  Changés sur cette station, gardés à côté, en .local-… :$kept. Les changements d'une station vont dans compose.override.yml."
}

# Le script de restauration d'un retour arrière à la main, copié à part : le
# premier qui sait se passer de sqlite3, que l'image du moteur n'a pas, parmi
# ceux de la version quittée, du dossier, et de la version d'avant. Celui d'une
# 0.2.0 ne le sait pas ; à la reprise d'un retour raté, le dossier porte déjà
# les fichiers d'avant.
restore_script() {
  local candidate
  for candidate in "$staged/avant/files/scripts/restore-radiotomate.sh" "$dir/scripts/restore-radiotomate.sh" \
    "$staged/files/scripts/restore-radiotomate.sh"; do
    if [[ -f $candidate ]] && grep -q python3 "$candidate"; then
      cp "$candidate" "$work/restore-radiotomate.sh"
      printf '%s\n' "$work/restore-radiotomate.sh"
      return 0
    fi
  done
  return 1
}

# La version du schéma de la base en place, puis la plus haute que connaît
# l'image du moteur de la version d'avant, target, déjà sur la machine : une
# base plus récente, elle ne la lirait pas.
engine_target_schemas() {
  local files=(-f "$staged/files/compose.yml")
  [[ ! -f $dir/compose.override.yml ]] || files+=(-f "$dir/compose.override.yml")
  (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" \
    run --rm --no-deps -T --entrypoint python3 radiotomate-init - 2>"$work/moteur.log") <<'PY' || {
# version : la version du schéma de la base en place, puis la plus haute que connaît cette image.
import pkgutil
import sqlite3
from contextlib import closing

import radiotomate.commands.update as update

with closing(sqlite3.connect("/data/radiotomate.db")) as con:
    row = con.execute("select value from settings where key = 'SCHEMA_VERSION'").fetchone()
print(row[0] if row else "")
print(max(int(module.name[1:]) for module in pkgutil.iter_modules(update.__path__) if module.name[1:].isdigit()))
PY
    cat "$work/moteur.log" >&2
    return 1
  }
}

# Les images de la version d'avant, pour un retour arrière à la main, celles
# de ses services et des services lancés à part (others) : celles qui manquent
# se tirent pendant que l'antenne joue encore. Les autres servent telles
# quelles, sans réseau.
rollback_images() {
  local files=(-f "$staged/files/compose.yml") list image missing=""
  [[ ! -f $dir/compose.override.yml ]] || files+=(-f "$dir/compose.override.yml")
  list=$(cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" config --images 2>"$work/compose.log") ||
    die "docker compose ne lit pas les fichiers de la version $target : $(head -n 1 "$work/compose.log") Rien n'est changé." \
      "Prendre une autre archive de la version $target, avec --from. Sinon, le signaler."
  if ((${#others[@]})); then
    list+=$'\n'$(cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" "${profiles[@]}" \
      config --images "${others[@]}" 2>/dev/null) || true
  fi
  while IFS= read -r image; do
    [[ -z $image ]] || docker image inspect "$image" >/dev/null 2>&1 || missing="$missing $image"
  done <<<"$list"
  [[ -n $missing ]] || return 0
  say "Retour arrière : les images de la version $target qui manquent, tirées pendant que l'antenne joue :$missing."
  local again="Images privées : docker login ghcr.io, avec un jeton GitHub qui a read:packages. Sinon, vérifier l'accès de la machine à ghcr.io. Puis relancer."
  (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" pull) ||
    die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. Rien n'est changé." "$again"
  if ((${#others[@]})); then
    (cd "$dir" && BUTTON_VERSION=$target docker compose "${files[@]}" --project-directory "$dir" "${profiles[@]}" pull "${others[@]}") ||
      die "Les images de la version $target ne se tirent pas : voir le message de docker compose plus haut. Rien n'est changé." "$again"
  fi
}

# Un retour arrière de station rollback qui n'a pas fini : cleanup le note,
# sans revenir sur ses pas, et dit comment le reprendre. HOLD est déjà posé.
rollback_failed() {
  local dir=${updating[0]} from=${updating[1]} to=${updating[2]}
  update_log "retour arrière échoué" "pendant $update_stage"
  station_alert "Retour arrière raté" \
    "station rollback, de $from à $to, a échoué pendant $update_stage : la station est peut-être coupée."
  printf '%s\n' "Le retour arrière n'est pas fini : updates.log le note, et HOLD bloque les mises à jour." \
    "  Une fois la cause trouvée, le reprendre : station rollback. Si la commande de la station ne l'a pas, prendre celle de la version $from, sur https://github.com/$REPO/releases." >&2
  updating=()
  rolling_back=""
}

# --- Les alertes ---

# Une alerte aux personnes de la station : une mise à jour annulée, faite, ou
# une majeure qui attend, un retour arrière, une sauvegarde ratée. Elle part
# dans le journal du système, journalctl -t button, puis par ntfy et par
# e-mail, comme .env les règle, et se note dans alerts.log. Une note, moins
# pressante, comme une mise à jour faite, ne sonne pas sur le téléphone. Elle
# lit le dossier de la station de l'appelant, dir : cleanup ne voit plus les
# variables des commandes. Une alerte qui ne part pas n'arrête rien : elle se
# dit, et status la montre.
station_alert() { # sujet, message, note ou rien
  local level=${3:-alerte} env_file=${dir:-.}/.env channel error sent="" failed=""
  local alert_station="" alert_ntfy="" alert_ntfy_token="" alert_email="" alert_from="" alert_sender=""
  local alert_smtp="" alert_smtp_user="" alert_smtp_password=""
  logger -t button -p "user.$([[ $level == note ]] && echo notice || echo warning)" -- "$1 : $2" >/dev/null 2>&1 || true
  [[ -n ${dir:-} && -f $env_file ]] || return 0
  alert_load
  for channel in ntfy e-mail; do
    alert_on "$channel" || continue
    if error=$(alert_deliver "$channel" "$1" "$2" "$level" 2>&1 >/dev/null); then
      sent="$sent${sent:+, }$channel"
    else
      failed="$failed${failed:+ ; }$channel : $(alert_error "$error")"
    fi
  done
  alert_log "$level" "$1" "$sent" "$failed" "$2"
  [[ -z $failed ]] || warn "l'alerte « $1 » n'est pas partie par $failed. Voir : station status ; un essai : station config --alert-test."
  return 0
}

# Les réglages des alertes, de .env : la station, nommée par son domaine,
# puis ntfy et l'e-mail, et son expéditeur.
alert_load() {
  alert_station=$(env_value DOMAIN)
  alert_ntfy=$(env_value BUTTON_ALERT_NTFY)
  alert_ntfy_token=$(env_value BUTTON_ALERT_NTFY_TOKEN)
  alert_email=$(env_value BUTTON_ALERT_EMAIL)
  alert_from=$(env_value BUTTON_ALERT_FROM)
  alert_smtp=$(env_value BUTTON_ALERT_SMTP)
  alert_smtp_user=$(env_value BUTTON_ALERT_SMTP_USER)
  alert_smtp_password=$(env_value BUTTON_ALERT_SMTP_PASSWORD)
  alert_sender_set
}

# L'expéditeur des e-mails : celui que --alert-from donne, sinon le compte
# SMTP, s'il est une adresse, sinon button@ suivi du domaine de la station.
# radiotomate-init le choisit de même.
alert_sender_set() {
  if [[ -n $alert_from ]]; then
    alert_sender=$alert_from
  elif [[ $alert_smtp_user == *@* ]]; then
    alert_sender=$alert_smtp_user
  else
    alert_sender=button@${alert_station:-localhost}
  fi
}

# Un canal réglé : ntfy, ou l'e-mail.
alert_on() { # ntfy ou e-mail
  if [[ $1 == ntfy ]]; then
    [[ -n $alert_ntfy ]]
  else
    [[ -n $alert_email ]]
  fi
}

# Une alerte, une note ou un essai, par un canal, comme le règlent les
# variables alert_*. Le titre dit la station. Rend 0 si elle part ; sinon,
# ce que dit curl va sur la sortie d'erreur.
alert_deliver() { # ntfy ou e-mail, sujet, message, note, essai ou rien
  local title="$2${alert_station:+ · $alert_station}" text
  text="${3^}"$'\n\n'"La station${alert_station:+ $alert_station}, dans ${dir:-?} sur ${HOSTNAME:-la machine}."
  if [[ $1 == ntfy ]]; then
    alert_ntfy_send "$title" "$text" "${4:-}"
  else
    alert_mail "$title" "$text"$'\n'"Pour ne plus recevoir ces e-mails, sur la machine de la station : station config --alert-email \"\"."
  fi
}

# ntfy : son JSON, posté à la racine du serveur, porte le titre en entier, en
# UTF-8, avec la priorité : haute pour une alerte ou un essai, qui insistent
# sur le téléphone, basse pour une note, qui ne sonne pas. Le jeton d'un sujet
# protégé passe par un fichier de configuration de curl, lu sur un tube :
# jamais sur sa ligne de commande, que ps montre.
#
# Les essais se comptent ici, pas par --retry : curl attendrait le Retry-After
# d'un 429, et ntfy.sh en donne d'un jour entier. Trois au plus, comme les
# règles de --retry : après une panne de nom ou un délai dépassé, ou un 408 ou
# un 5xx, et ALERT_NTFY_PAUSE entre eux ; l'envoi s'arrête donc en moins
# d'une minute. Un 429 ne se réessaie pas après une pause. ntfy.sh limite les
# envois par adresse, et en IPv6 par bloc /64, que des hébergeurs partagent
# entre plusieurs machines : reçu en IPv6, il se réessaie une fois en IPv4,
# où la machine a son adresse à elle. Le message d'un échec va sur la sortie
# d'erreur, et la fonction rend 1.
alert_ntfy_send() { # titre, message, note, essai ou rien
  local priority=4 tag=warning body try answer code ip family=() failure=""
  case $3 in
    note) priority=2 tag=information_source ;;
    essai) tag=bell ;;
  esac
  body=$(printf '{"topic":%s,"title":%s,"message":%s,"priority":%s,"tags":[%s]}' \
    "$(json_string "${alert_ntfy##*/}")" "$(json_string "$1")" "$(json_string "$2")" "$priority" "$(json_string "$tag")")
  for ((try = 1; try <= 3; try++)); do
    answer=$(alert_ntfy_post "$body" "${family[@]}") || true
    code=${answer%%$'\n'*}
    ip=${code#* }
    code=${code%% *}
    [[ $code != 2?? ]] || return 0
    # L'essai en IPv4 qui suit un 429 est le dernier : son échec garde le 429.
    if ((${#family[@]})) || [[ $code == 429 ]]; then
      failure="le serveur ntfy refuse pour l'instant les messages de cette machine (429, trop de messages)"
      [[ $code == 429 && ${#family[@]} -eq 0 && $ip == *:* ]] || break
      family=(-4)
      continue
    fi
    if [[ $code == 000 ]]; then
      failure=${answer#*$'\n'}
    else
      failure="le serveur ntfy répond $code"
    fi
    case $code:$failure in
      "000:curl: (6) "* | "000:curl: (28) "* | 408:* | 50[0234]:*) ;;
      *) break ;;
    esac
    ((try == 3)) || sleep "$ALERT_NTFY_PAUSE"
  done
  printf '%s\n' "${failure:-curl a échoué, sans rien dire}" >&2
  return 1
}

# Un envoi à ntfy, borné par ALERT_NTFY_WAIT. Sans -f : sur la sortie, le code
# HTTP et l'adresse jointe, puis l'erreur de curl, comme il la dirait.
alert_ntfy_post() { # JSON, options de curl
  printf '%s' "$1" |
    curl --disable -s --max-time "$ALERT_NTFY_WAIT" "${@:2}" -o /dev/null \
      -w '%{http_code} %{remote_ip}\ncurl: (%{exitcode}) %{errormsg}' -H 'Content-Type: application/json' \
      -K <(alert_ntfy_config) --data-binary @- "${alert_ntfy%/*}/"
}

alert_ntfy_config() {
  [[ -z $alert_ntfy_token ]] || printf 'header = "Authorization: Bearer %s"\n' "$(curl_quote "$alert_ntfy_token")"
}

# Un e-mail, par curl : TLS dès le début sur le port 465, STARTTLS sur un
# autre, exigé (--ssl-reqd) : sans lui, rien ne part, et le mot de passe ne
# passe jamais en clair. Le compte passe, comme le jeton de ntfy, par un
# fichier de configuration de curl lu sur un tube.
alert_mail() { # titre, message
  local smtp_host=${alert_smtp%:*} smtp_port=${alert_smtp##*:} scheme=smtp address addresses=() rcpts=()
  [[ $alert_smtp == *:* ]] || smtp_port=587
  [[ $smtp_port != 465 ]] || scheme=smtps
  IFS=, read -ra addresses <<<"$alert_email"
  for address in "${addresses[@]}"; do
    address=$(trim "$address")
    [[ -z $address ]] || rcpts+=(--mail-rcpt "$address")
  done
  alert_message "$1" "$2" |
    curl --disable -sS --max-time 60 --connect-timeout 15 --ssl-reqd --crlf --url "$scheme://$smtp_host:$smtp_port" \
      --mail-from "$alert_sender" "${rcpts[@]}" -K <(alert_smtp_config) -T -
}

alert_smtp_config() {
  [[ -z $alert_smtp_user ]] || printf 'user = "%s"\n' "$(curl_quote "$alert_smtp_user:$alert_smtp_password")"
}

# L'e-mail d'une alerte : ses en-têtes, le sujet en mots encodés s'il n'est
# pas en ASCII, puis le texte, en UTF-8 et en base64.
alert_message() { # titre, texte
  local to=${alert_email// /}
  to=${to//,/, }
  printf '%s\n' "From: BUTTON <$alert_sender>" "To: $to" "Subject: $(mime_header "$1")" "Date: $(LC_ALL=C date -R)" \
    "Message-ID: <$(date +%s).$$.$RANDOM@${alert_station:-button.invalid}>" "MIME-Version: 1.0" \
    "Content-Type: text/plain; charset=UTF-8" "Content-Transfer-Encoding: base64" ""
  printf '%s\n' "$2" | base64 -w 76
}

# Un en-tête d'e-mail : tel quel en ASCII. Sinon, les mots en ASCII restent
# tels quels, et chaque suite de mots qui ne le sont pas devient des mots
# encodés (RFC 2047) de 39 octets au plus, soit 64 caractères : un seul tient
# sur la première ligne, « Subject: » compris. Entre deux mots encodés, les
# espaces ne comptent pas : chacun, sauf le dernier d'une suite, garde
# l'espace qui le suit. Les lignes se replient avant 76 caractères.
mime_header() { # texte
  local LC_ALL=C ascii='^[ -~]*$' word words=() run="" tokens=() token line="" out=""
  if [[ $1 =~ $ascii ]]; then
    printf '%s' "$1"
    return 0
  fi
  read -ra words <<<"$1"
  for word in "${words[@]}"; do
    if [[ $word =~ $ascii ]]; then
      [[ -z $run ]] || tokens+=("$(mime_word "${run% }")")
      run=""
      tokens+=("$word")
      continue
    fi
    if [[ -n $run ]] && ((${#run} + ${#word} + 1 > 39)); then
      tokens+=("$(mime_word "$run")")
      run=""
    fi
    run+="$word "
  done
  [[ -z $run ]] || tokens+=("$(mime_word "${run% }")")
  for token in "${tokens[@]}"; do
    if [[ -n $line ]] && ((${#line} + 1 + ${#token} > 66)); then
      out+="$line"$'\n'
      line=" $token"
    else
      line+="${line:+ }$token"
    fi
  done
  printf '%s' "$out$line"
}

mime_word() { # texte
  printf '=?UTF-8?B?%s?=' "$(printf '%s' "$1" | base64 -w 0)"
}

# Un texte en chaîne JSON, entre guillemets. Les caractères de contrôle, hors
# la tabulation et le saut de ligne, s'en vont.
json_string() { # texte
  local text
  text=$(printf '%s' "$1" | LC_ALL=C tr -d '\001-\010\013-\037\177')
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  text=${text//$'\t'/\\t}
  text=${text//$'\n'/\\n}
  printf '"%s"' "$text"
}

# Une valeur entre guillemets dans un fichier de configuration de curl.
curl_quote() { # texte
  local text=${1//\\/\\\\}
  printf '%s' "${text//\"/\\\"}"
}

# Ce que curl dit d'un échec, sur une ligne, sans son point final.
alert_error() { # sortie d'erreur de curl
  local text
  text=$(tr '\n' ' ' <<<"$1")
  text=$(trim "$text")
  text=${text%.}
  printf '%s\n' "${text:-curl a échoué, sans rien dire}"
}

# alerts.log, dans le dossier de la station : une ligne par alerte, ou par
# essai, de la commande, que status lit, et par où elle est partie.
alert_log() { # alerte, note ou essai, sujet, partie par, pas partie par, message
  local log=$dir/$ALERTS_LOG message
  message=$(tr '\t\n' '  ' <<<"$5")
  if [[ ! -f $log ]]; then
    printf '%s\n' "# Les alertes de la commande station, et ses essais, une par ligne : l'heure, en secondes depuis 1970, alerte, note ou essai, le sujet, les canaux par où elle est partie, ceux par où elle n'est pas partie, avec ce que dit curl, et le message." \
      >"$log" 2>/dev/null || true
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" "${3:--}" "${4:--}" "$(trim "$message")" \
    >>"$log" 2>/dev/null || warn "$log ne s'écrit pas."
}

# Une alerte déjà partie, par un canal au moins, d'après alerts.log : ce
# sujet, avec ce texte dans son message. Une alerte qui n'est partie par aucun
# repartira, un canal une fois réglé.
alert_sent_before() { # sujet, texte
  [[ -f $dir/$ALERTS_LOG ]] || return 1
  awk -F '\t' -v subject="$1" -v text="$2" '$3 == subject && $4 != "-" && index($6, text) { found = 1 } END { exit !found }' \
    "$dir/$ALERTS_LOG"
}

# Où partent les alertes, pour status et config. Le sujet ntfy, qui fait lire
# les alertes à qui le connaît, ne s'affiche en entier qu'avec full, et dans
# un terminal.
alerts_label() { # full ou rien
  local ntfy email where=""
  ntfy=$(env_value BUTTON_ALERT_NTFY)
  email=$(env_value BUTTON_ALERT_EMAIL)
  if [[ -n $ntfy ]]; then
    if [[ ${1:-} == full ]] && terminal; then
      where="par ntfy, sujet $ntfy"
    else
      where="par ntfy, sur ${ntfy%/*}"
    fi
  fi
  [[ -z $email ]] || where="$where${where:+, et }par e-mail, à ${email//,/, }"
  printf '%s\n' "${where:-aucune, hors du journal du système}"
}

# status : où partent les alertes, et la dernière de la commande, ou son
# dernier essai, d'après alerts.log. Avertit quand elle n'est pas partie par
# un canal.
alerts_report() {
  local line made level subject sent failed
  say "Alertes : $(alerts_label)."
  if [[ -z $(env_value BUTTON_ALERT_NTFY)$(env_value BUTTON_ALERT_EMAIL) ]]; then
    say "  Sur un téléphone, ou par e-mail : station config --alert-ntfy $NTFY_SERVER, ou --alert-email ADRESSE. Voir docs/exploitation/alertes.md."
  fi
  line=$({ grep -v '^#' "$dir/$ALERTS_LOG" 2>/dev/null || true; } | tail -n 1)
  IFS=$'\t' read -r made level subject sent failed _ <<<"$line"
  [[ $made =~ ^[0-9]+$ ]] || return 0
  say "  La dernière de la commande : le $(station_date "$made"), « $subject »$([[ $sent == - ]] || echo ", partie par $sent")."
  [[ $failed == - ]] ||
    warn "la dernière alerte, « $subject », n'est pas partie par $failed. Un essai : station config --alert-test."
}

# Les options des alertes, vérifiées avant tout : leur forme, et les fichiers
# des secrets. "" vide un réglage. Pour install et config.
alert_check_options() {
  local option
  [[ -z ${opts[--alert-ntfy]:-} ]] || check_ntfy "${opts[--alert-ntfy]}" || exit 2
  [[ -z ${opts[--alert-email]:-} ]] || check_email_list "${opts[--alert-email]}" || exit 2
  [[ -z ${opts[--alert-smtp]+x} ]] || check_smtp "${opts[--alert-smtp]}" || exit 2
  [[ -z ${opts[--alert-smtp-user]+x} ]] || check_smtp_user "${opts[--alert-smtp-user]}" || exit 2
  [[ -z ${opts[--alert-from]:-} ]] || check_email_list "${opts[--alert-from]}" one || exit 2
  for option in --alert-ntfy-token-file --alert-smtp-password-file; do
    [[ -z ${opts[$option]:-} || -f ${opts[$option]} ]] || usage_error "$option : ${opts[$option]} n'existe pas."
  done
  return 0
}

# Une option qui change les alertes : --alert-test n'en change aucune.
alert_options_given() {
  local option
  for option in "${!opts[@]}"; do
    [[ $option != --alert-* || $option == --alert-test ]] || return 0
  done
  return 1
}

# Un serveur que le moteur ne joindrait pas : il tourne dans un conteneur, où
# localhost est le sien. L'essai passerait depuis la machine, et les alertes
# d'antenne échoueraient.
local_host() { # hôte
  case ${1,,} in
    localhost | *.localhost | 127.* | 0.0.0.0) return 0 ;;
  esac
  return 1
}

# Une adresse de ntfy : un serveur, comme https://ntfy.sh, ou un sujet,
# https://SERVEUR/SUJET. ntfy.sh seul vaut https://ntfy.sh.
check_ntfy() {
  local url=$1 host pattern='^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9_-]{1,64})?/?$'
  [[ $url == *://* ]] || url=https://$url
  if [[ ! $url =~ $pattern ]]; then
    echo "  « $1 » n'est pas une adresse de ntfy : $NTFY_SERVER, où un sujet se tire au hasard, ou https://SERVEUR/SUJET, un sujet en lettres, chiffres, - et _." >&2
    return 1
  fi
  host=${url#*://}
  host=${host%%[:/]*}
  if local_host "$host"; then
    echo "  « $1 » : le moteur, dans son conteneur, ne joint pas $host. Donner le nom, ou l'adresse sur le réseau, du serveur ntfy." >&2
    return 1
  fi
}

# Des e-mails séparés par des virgules, ou un seul avec one.
check_email_list() { # adresses, one ou rien
  local address addresses=() one='^[^@[:space:],"<>]+@[^@[:space:],"<>]+\.[^@[:space:],"<>]+$'
  IFS=, read -ra addresses <<<"$1"
  if ((${#addresses[@]} == 0)) || [[ ${#1} -gt 512 || (${2:-} == one && ${#addresses[@]} -gt 1) ]]; then
    echo "  « $1 » : $([[ ${2:-} == one ]] && echo 'un e-mail' || echo 'des e-mails, séparés par des virgules'), comme technique@radio.example." >&2
    return 1
  fi
  for address in "${addresses[@]}"; do
    address=$(trim "$address")
    if [[ ! $address =~ $one ]]; then
      echo "  « $address » n'est pas un e-mail, comme technique@radio.example." >&2
      return 1
    fi
  done
}

# Le serveur SMTP : HÔTE, ou HÔTE:PORT.
check_smtp() {
  local server='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:([0-9]{1,5}))?$'
  if [[ ! $1 =~ $server ]] || ((10#${BASH_REMATCH[3]:-587} < 1 || 10#${BASH_REMATCH[3]:-587} > 65535)); then
    echo "  « $1 » : un serveur SMTP s'écrit HÔTE:PORT, comme smtp.radio.example:587, ou :465 en TLS dès le début." >&2
    return 1
  fi
  if local_host "${1%:*}"; then
    echo "  « $1 » : le moteur, dans son conteneur, ne joint pas ${1%:*}. Donner le nom, ou l'adresse sur le réseau, du serveur SMTP." >&2
    return 1
  fi
}

# Le compte SMTP : une ligne, sans espace, ni guillemet, ni apostrophe, que
# .env ne garderait pas. Vide : un serveur sans compte.
check_smtp_user() {
  [[ ${#1} -le 256 && $1 != *[[:space:][:cntrl:]\'\"]* ]] && return 0
  echo "  « $1 » : un compte SMTP s'écrit sur une ligne, sans espace ni guillemet, comme alertes@radio.example." >&2
  return 1
}

# L'adresse du sujet ntfy : un serveur seul, comme https://ntfy.sh, reçoit un
# sujet tiré au hasard, qui ne se devine pas, car un sujet de ntfy.sh se lit
# par qui le connaît. ntfy.sh seul vaut https://ntfy.sh.
ntfy_url() { # adresse donnée
  local url=$1 topic
  [[ $url == *://* ]] || url=https://$url
  url=${url%/}
  if [[ ${url#*://} != */* ]]; then
    topic=button-$(openssl rand -hex 12)
    [[ ${#topic} -eq 31 ]] || die "openssl ne tire pas de sujet ntfy." "Vérifier openssl (openssl rand -hex 12), puis relancer."
    url+=/$topic
  fi
  printf '%s\n' "$url"
}

# Au clavier, à la première installation, sans option des alertes : celles du
# téléphone, par ntfy.sh, proposées, et l'e-mail, facultatif, avec son
# serveur, son compte, facultatif aussi, et son mot de passe.
alert_questions() {
  local answer
  interactive || return 0
  ! alert_options_given || return 0
  answer=$(ask "Alertes sur un téléphone, par ntfy.sh, un service gratuit : un silence à l'antenne, un disque presque plein, une mise à jour annulée ? (o/n)" o check_yes_no)
  [[ ${answer,,} != [oy]* ]] || opts[--alert-ntfy]=$NTFY_SERVER
  answer=$(ask "E-mails qui reçoivent aussi les alertes, séparés par des virgules, facultatif" "" check_email_list_or_none)
  [[ -n $answer ]] || return 0
  opts[--alert-email]=$answer
  opts[--alert-smtp]=$(ask "Serveur SMTP qui les envoie, HÔTE:PORT" "" check_smtp)
  answer=$(ask "Son compte, rien pour un serveur sans compte" "" check_smtp_user)
  opts[--alert-smtp-user]=$answer
  [[ -z $answer ]] || opts[--alert-smtp-password]=$(ask_secret "Son mot de passe, qui ne s'affiche pas")
}

check_email_list_or_none() {
  [[ -z $1 ]] || check_email_list "$1"
}

# Un secret tapé au clavier, sans qu'il s'affiche, sans les espaces autour,
# comme secret_from : une ligne, sans apostrophe, que .env ne garderait pas.
ask_secret() { # question
  local answer
  while :; do
    printf '  %s : ' "$1" >&2
    IFS= read -rs answer || die "" "$aborted"
    printf '\n' >&2
    answer=$(trim "$answer")
    if [[ -n $answer && ${#answer} -le 1024 && $answer != *[[:cntrl:]\']* ]]; then
      printf '%s\n' "$answer"
      return 0
    fi
    echo "  Une ligne, sans apostrophe : .env ne la garderait pas. Un mot de passe qui en a une se change d'abord chez le fournisseur ; Ctrl-C arrête." >&2
  done
}

# Ce que install ou config change des alertes, vérifié avant que rien ne
# s'écrive : les réglages donnés, sinon ceux de .env, dans les variables
# alert_*. Chaque canal qui change reçoit un essai : s'il ne part pas, rien
# ne change. Un jeton ou un compte ne vaut que pour son serveur : il ne part
# jamais vers un autre.
alert_verify() {
  local ntfy_changed="" email_changed="" option old_ntfy old_smtp
  alert_options_given || return 0
  alert_load
  # Le domaine que la même commande donne, ou celui de l'installation.
  [[ -z ${opts[--domain]:-} || -z ${domain:-} ]] || alert_station=$domain
  alert_station=${alert_station:-${domain:-}}
  old_ntfy=${alert_ntfy%/*}
  old_smtp=${alert_smtp%:*}
  if [[ -n ${opts[--alert-ntfy]+x} ]]; then
    alert_ntfy=""
    [[ -z ${opts[--alert-ntfy]} ]] || alert_ntfy=$(ntfy_url "${opts[--alert-ntfy]}")
    ntfy_changed=1
  fi
  if [[ -n ${opts[--alert-ntfy-token-file]+x} ]]; then
    alert_ntfy_token=""
    [[ -z ${opts[--alert-ntfy-token-file]} ]] ||
      alert_ntfy_token=$(secret_from "${opts[--alert-ntfy-token-file]}" "Le jeton ntfy" \
        "Tirer un autre jeton sur le serveur ntfy, puis relancer.")
    ntfy_changed=1
  elif [[ -n $alert_ntfy_token && -n $alert_ntfy && ${alert_ntfy%/*} != "$old_ntfy" ]]; then
    alert_ntfy_token=""
    say "Alertes : le jeton ntfy de $old_ntfy ne part pas vers ${alert_ntfy%/*}. Un sujet protégé de ce serveur : --alert-ntfy-token-file FICHIER."
  fi
  if [[ -n ${opts[--alert-email]+x} ]]; then
    alert_email=$(tr -d ' ' <<<"${opts[--alert-email]}")
    email_changed=1
  fi
  for option in --alert-smtp --alert-smtp-user --alert-from --alert-smtp-password-file --alert-smtp-password; do
    [[ -z ${opts[$option]+x} ]] || email_changed=1
  done
  alert_smtp=${opts[--alert-smtp]-$alert_smtp}
  alert_from=${opts[--alert-from]-$alert_from}
  if [[ -n ${opts[--alert-smtp-user]+x} ]]; then
    alert_smtp_user=${opts[--alert-smtp-user]}
    # Sans compte, pas de mot de passe.
    [[ -n $alert_smtp_user ]] || alert_smtp_password=""
  fi
  alert_smtp_password=${opts[--alert-smtp-password]-$alert_smtp_password}
  if [[ -n ${opts[--alert-smtp-password-file]+x} ]]; then
    alert_smtp_password=""
    [[ -z ${opts[--alert-smtp-password-file]} ]] ||
      alert_smtp_password=$(secret_from "${opts[--alert-smtp-password-file]}" "Le mot de passe SMTP" \
        "En choisir un autre chez le fournisseur du serveur SMTP, puis relancer.")
  fi
  if [[ -n $old_smtp && ${alert_smtp%:*} != "$old_smtp" && -n $alert_smtp_user &&
    -z ${opts[--alert-smtp-password-file]+x}${opts[--alert-smtp-password]+x} ]]; then
    die "Le serveur SMTP change, de $old_smtp à ${alert_smtp%:*} : le compte et le mot de passe de l'ancien n'y partent pas. Rien n'est changé." \
      "Donner ceux du nouveau : --alert-smtp-user COMPTE --alert-smtp-password-file FICHIER, ou --alert-smtp-user \"\" pour un serveur sans compte."
  fi
  alert_sender_set
  if [[ -n $alert_email ]]; then
    [[ -n $alert_smtp ]] ||
      die "Les alertes par e-mail demandent le serveur SMTP qui les envoie. Rien n'est changé." \
        "Le donner avec le reste : --alert-smtp HÔTE:PORT, et son compte, --alert-smtp-user COMPTE --alert-smtp-password-file FICHIER."
    [[ -z $alert_smtp_user || -n $alert_smtp_password ]] ||
      die "Le compte SMTP $alert_smtp_user n'a pas de mot de passe. Rien n'est changé." \
        "Le donner dans un fichier : --alert-smtp-password-file FICHIER. Un serveur sans compte : --alert-smtp-user \"\"."
  fi
  if [[ -n $alert_ntfy && -n $ntfy_changed ]]; then
    [[ $alert_ntfy != http://* ]] ||
      warn "le sujet ntfy se joint en http : les alertes, et le jeton d'un sujet protégé, y passent en clair. Préférer https."
    alert_try ntfy
  fi
  if [[ -n $alert_email && -n $email_changed ]]; then
    alert_try e-mail
  fi
}

# Un essai par un canal. S'il ne part pas, il rend 1, et ce que dit curl est
# dans alert_failure, la variable de l'appelant.
alert_essai() { # ntfy ou e-mail
  local error
  error=$(alert_deliver "$1" "Essai des alertes" "$ALERT_TEST_TEXT" essai 2>&1 >/dev/null) && return 0
  alert_failure=$(alert_error "$error")
  return 1
}

# Un essai par un canal qui change, qui arrête tout s'il ne part pas. Dans le
# dossier d'une station, alerts.log le note, comme une alerte : status voit
# s'il est parti. À l'installation, il dit aussi comment s'en passer.
alert_try() { # ntfy ou e-mail
  local alert_failure="" without=""
  say "Alertes : un essai par $1."
  if alert_essai "$1"; then
    [[ ! -f ${env_file:-} ]] || alert_log essai "Essai des alertes" "$1" "" "$ALERT_TEST_TEXT"
    return 0
  fi
  [[ ! -f ${env_file:-} ]] || alert_log essai "Essai des alertes" "" "$1 : $alert_failure" "$ALERT_TEST_TEXT"
  if [[ ! -f ${env_file:-} && $1 == ntfy ]]; then
    without=" Ou installer sans ntfy : répondre n à sa question, ou --alert-ntfy \"\" ; station config le règle ensuite."
  elif [[ ! -f ${env_file:-} ]]; then
    without=" Ou installer sans e-mail : ne donner aucune adresse, ou --alert-email \"\" ; station config le règle ensuite."
  fi
  if [[ $1 == ntfy && $alert_failure == *"(429, "* ]]; then
    die "L'essai par ntfy ne part pas : $alert_failure. Rien n'est changé." \
      "Le serveur ntfy limite les messages par adresse, et ntfy.sh peut la bloquer un jour entier, en IPv6 avec d'autres machines du même hébergeur. Relancer plus tard, ou donner un autre serveur ntfy.$without"
  fi
  if [[ $1 == ntfy ]]; then
    die "L'essai par ntfy ne part pas : $alert_failure. Rien n'est changé." \
      "Vérifier l'adresse du sujet, le jeton d'un sujet protégé, et que la machine joint le serveur ntfy. Puis relancer.$without"
  fi
  die "L'essai par e-mail ne part pas : $alert_failure. Rien n'est changé." \
    "Vérifier le serveur SMTP et son port, 465 en TLS dès le début ou 587 en STARTTLS, le compte, le mot de passe, et l'expéditeur, que le serveur doit accepter. Puis relancer.$without"
}

# Les alertes d'une installation neuve, à la fin de son .env : vides, aucune.
alert_env_block() {
  printf '\n%s\n' "# Les alertes sur un téléphone, par ntfy, et par e-mail : station config les" \
    "# change, après un essai. Vides, aucune."
  printf 'BUTTON_ALERT_NTFY=%s\n' "$(env_quote "$alert_ntfy")"
  [[ -z $alert_ntfy_token ]] || printf 'BUTTON_ALERT_NTFY_TOKEN=%s\n' "$(env_quote "$alert_ntfy_token")"
  printf 'BUTTON_ALERT_EMAIL=%s\n' "$(env_quote "$alert_email")"
  [[ -n $alert_email ]] || return 0
  [[ -z $alert_from ]] || printf 'BUTTON_ALERT_FROM=%s\n' "$(env_quote "$alert_from")"
  printf 'BUTTON_ALERT_SMTP=%s\n' "$(env_quote "$alert_smtp")"
  [[ -z $alert_smtp_user ]] ||
    printf '%s=%s\n' BUTTON_ALERT_SMTP_USER "$(env_quote "$alert_smtp_user")" BUTTON_ALERT_SMTP_PASSWORD \
      "$(env_quote "$alert_smtp_password")"
}

# Les réglages des alertes dans .env, une fois l'essai passé. Ceux de l'e-mail
# s'écrivent aussi quand il est arrêté : ils serviront quand il reviendra.
# L'expéditeur ne s'écrit que donné : sinon, il suit le compte. Puis
# radiotomate.yaml suit (alert_engine).
alert_apply() {
  local before=$changed option email_given=""
  alert_options_given || return 0
  if [[ -n ${opts[--alert-ntfy]+x} ]]; then
    remote_set BUTTON_ALERT_NTFY "$alert_ntfy"
    [[ -n $alert_ntfy ]] || alert_ntfy_token=""
  fi
  remote_set BUTTON_ALERT_NTFY_TOKEN "$alert_ntfy_token"
  remote_set BUTTON_ALERT_EMAIL "$alert_email"
  for option in --alert-smtp --alert-smtp-user --alert-smtp-password-file --alert-smtp-password; do
    [[ -z ${opts[$option]+x} ]] || email_given=1
  done
  if [[ -n $alert_email || -n $email_given ]]; then
    remote_set BUTTON_ALERT_SMTP "$alert_smtp"
    remote_set BUTTON_ALERT_SMTP_USER "$alert_smtp_user"
    remote_set BUTTON_ALERT_SMTP_PASSWORD "$alert_smtp_password"
  fi
  [[ -z ${opts[--alert-from]+x} ]] || remote_set BUTTON_ALERT_FROM "$alert_from"
  [[ -n $alert_email || -z $email_given${opts[--alert-from]+x} ]] ||
    say "Alertes : l'e-mail est arrêté. Ces réglages serviront quand --alert-email le rallumera."
  [[ $changed != "$before" ]] || return 0
  alert_engine
  if [[ -n ${opts[--alert-ntfy]:-} ]]; then
    if terminal; then
      say "Alertes sur le téléphone : s'abonner, dans l'application ntfy, au sujet $alert_ntfy. Il ne se donne qu'aux personnes de la station : qui le connaît lit les alertes."
    else
      say "Alertes sur le téléphone : le sujet ntfy est dans $env_file, BUTTON_ALERT_NTFY, ou dans station config, lancée dans un terminal. S'y abonner dans l'application ntfy."
    fi
  fi
}

# radiotomate.yaml suit .env : radiotomate-init y écrit les alertes d'antenne,
# avec le domaine, et le scheduler les relit seul, sans couper l'antenne.
alert_engine() {
  if engine_run radiotomate-init </dev/null >/dev/null; then
    say "Alertes d'antenne : radiotomate.yaml suit, et le scheduler les prend d'ici une minute, sans couper l'antenne."
  else
    warn "radiotomate.yaml ne suit pas : les alertes d'antenne, comme un silence, gardent l'ancien réglage. Voir le message plus haut, puis : cd $dir && docker compose up -d."
  fi
}

# --alert-test : un essai par chaque canal réglé, chacun dit, et une ligne
# dans alerts.log, comme une alerte. Échoue si l'un ne part pas.
alert_test() {
  local channel sent="" failed="" errors="" alert_failure=""
  alert_load
  for channel in ntfy e-mail; do
    alert_on "$channel" || continue
    say "Alertes : un essai par $channel."
    if alert_essai "$channel"; then
      say "Alertes : l'essai par $channel est parti."
      sent="$sent${sent:+, }$channel"
    else
      warn "l'essai par $channel ne part pas : $alert_failure."
      failed="$failed${failed:+, }$channel"
      errors="$errors${errors:+ ; }$channel : $alert_failure"
    fi
  done
  [[ -n $sent$failed ]] ||
    die "Aucune alerte n'est réglée sur cette station : rien à essayer." \
      "Les régler : station config --alert-ntfy $NTFY_SERVER, ou --alert-email ADRESSE. Voir docs/exploitation/alertes.md."
  alert_log essai "Essai des alertes" "$sent" "$errors" "$ALERT_TEST_TEXT"
  [[ -z $failed ]] ||
    die "L'essai ne part pas par $failed : voir plus haut." \
      "Vérifier ses réglages, station config, puis relancer station config --alert-test. Voir docs/exploitation/alertes.md."
}

# La fin d'une installation : où partent les alertes, et comment s'abonner.
alert_summary() {
  local ntfy
  ntfy=$(env_value BUTTON_ALERT_NTFY)
  if [[ -z $ntfy$(env_value BUTTON_ALERT_EMAIL) ]]; then
    say "  Alertes : aucune, hors du journal du système. Sur un téléphone : station config --alert-ntfy $NTFY_SERVER"
    return 0
  fi
  say "  Alertes : $(alerts_label)"
  [[ -n $ntfy ]] || return 0
  if terminal; then
    say "  Sur le téléphone : s'abonner, dans l'application ntfy, au sujet $ntfy. Il ne se donne qu'aux personnes de la station."
  else
    say "  Sur le téléphone : le sujet ntfy est dans $env_file, BUTTON_ALERT_NTFY. S'y abonner dans l'application ntfy."
  fi
}

# --- config ---

cmd_config() {
  local dir="" env_file="" domain="" email="" old="" changed="" option asked="" changes=""
  local remote="" remote_password="" remote_access_key="" remote_secret_key="" generated="" fresh="" probed=""
  local alert_station="" alert_ntfy="" alert_ntfy_token="" alert_email="" alert_from="" alert_sender=""
  local alert_smtp="" alert_smtp_user="" alert_smtp_password=""
  local -A opts=()
  local args=()
  local valued="--dir --domain --email --updates --update-time --backup-remote --backup-s3-access-key"
  valued+=" --backup-s3-secret-key-file --backup-password-file --backup-media --backup-time"
  valued+=" --alert-ntfy --alert-ntfy-token-file --alert-email --alert-smtp --alert-smtp-user"
  valued+=" --alert-smtp-password-file --alert-from --console-requests"
  parse_options "--no-domain-check --alert-test -h --help" "$valued" "$@"
  if help_asked; then
    usage_command config
    return 0
  fi
  ((${#args[@]} == 0)) || usage_error "Argument inattendu : ${args[0]}."
  if [[ -n ${opts[--domain]+x} ]]; then
    domain=${opts[--domain],,}
    check_domain "$domain" || exit 2
  fi
  if [[ -n ${opts[--email]+x} ]]; then
    email=${opts[--email]}
    check_email "$email" || exit 2
  fi
  [[ -z ${opts[--updates]+x} ]] || check_updates "${opts[--updates]}" || exit 2
  [[ -z ${opts[--update-time]+x} ]] || check_update_time "${opts[--update-time]}" || exit 2
  [[ -z ${opts[--backup-remote]:-} ]] || check_remote "${opts[--backup-remote]}" || exit 2
  [[ -z ${opts[--backup-s3-access-key]+x} ]] || check_access_key "${opts[--backup-s3-access-key]}" || exit 2
  [[ -z ${opts[--backup-media]+x} || ${opts[--backup-media]} == yes || ${opts[--backup-media]} == no ]] ||
    usage_error "--backup-media vaut yes ou no."
  [[ -z ${opts[--backup-time]+x} ]] || check_update_time "${opts[--backup-time]}" || exit 2
  [[ -z ${opts[--console-requests]+x} ]] ||
    check_yes_or_no "${opts[--console-requests]}" --console-requests || exit 2
  for option in --backup-s3-secret-key-file --backup-password-file; do
    [[ -z ${opts[$option]+x} || -f ${opts[$option]} ]] || usage_error "$option : ${opts[$option]} n'existe pas."
  done
  alert_check_options
  open_station config "${opts[--dir]:-}"
  # Ce qui est demandé : un réglage à changer, ou l'essai des alertes.
  for option in "${!opts[@]}"; do
    case $option in
      --dir | --no-domain-check) ;;
      --alert-test) asked=1 ;;
      *) asked=1 changes=1 ;;
    esac
  done
  if [[ -z $asked ]]; then
    config_report
    return 0
  fi
  lock_station config
  work=$(mktemp -d)
  trap cleanup EXIT
  old=$(env_value DOMAIN)
  # Le domaine se vérifie avant tout : s'il ne mène pas ici, rien ne change.
  # Le dépôt de la sauvegarde hors de la machine aussi.
  [[ -z ${opts[--domain]+x} || $domain == "$old" ]] || domain_verify
  remote_verify
  alert_verify
  [[ -z ${opts[--updates]+x} ]] || config_set BUTTON_UPDATES "${opts[--updates]}"
  [[ -z ${opts[--update-time]+x} ]] || config_set BUTTON_UPDATE_TIME "${opts[--update-time]}"
  [[ -z ${opts[--email]+x} ]] || config_set ACME_EMAIL "$email"
  remote_apply
  alert_apply
  [[ -z ${opts[--console-requests]+x} ]] || requests_apply "${opts[--console-requests]}"
  if [[ -n ${opts[--domain]+x} && $domain != "$old" ]]; then
    domain_apply "$old"
    # Les alertes nomment la station par son domaine.
    [[ -z $(env_value BUTTON_ALERT_NTFY)$(env_value BUTTON_ALERT_EMAIL) ]] || alert_engine
  elif [[ $changed == *ACME_EMAIL* ]] && station_running caddy; then
    # Caddy lit l'e-mail à son démarrage : recréé, il s'en sert pour les
    # prochains certificats.
    compose up -d caddy || die "Caddy ne repart pas : voir le message de docker compose plus haut." "Voir pourquoi : cd $dir && docker compose logs caddy."
    say "Caddy : redémarré, avec l'e-mail ${email:-vide}. Le flux s'est coupé un instant."
  fi
  if [[ -n $changed ]]; then
    say "Changé dans $env_file :$changed."
  elif [[ -n $changes ]]; then
    say "Rien à changer : $env_file a déjà ces réglages."
  fi
  [[ -z ${opts[--alert-test]:-} ]] || alert_test
}

# Les demandes de la console, prises ou coupées : .env, le minuteur, puis le
# moteur, tout de suite, pour que la console dise pourquoi le bouton ne
# demande plus. Une demande qui attendait est refusée.
requests_apply() { # yes ou no
  local pushed="" request_id="" request_state=""
  config_set BUTTON_CONSOLE_REQUESTS "$1"
  requests_timer ||
    die "BUTTON_CONSOLE_REQUESTS est dans .env, mais le minuteur des demandes de la console ne se pose pas : voir plus haut." \
      "Une fois systemd réglé, relancer : station install le repose. D'ici là, les prendre à la main : station requests."
  if ! station_running radiotomate-interface || ! requests_sync force || [[ -z $pushed ]]; then
    warn "le moteur ne répond pas : la console le saura au premier passage du minuteur une fois le moteur revenu, dans la minute."
  fi
  if [[ $1 == yes ]]; then
    say "Demandes de la console : prises chaque minute. « Mettre à jour maintenant » marche, dans Réglages → Mises à jour."
  else
    say "Demandes de la console : coupées. « Mettre à jour maintenant » ne demande plus rien, et une demande qui attendait est refusée. Le minuteur ne fait plus que le dire à la console."
  fi
}

# Pose une variable de .env si elle change, et la note.
config_set() { # clé, valeur
  if ! env_has "$1" || [[ $(env_value "$1") != "$2" ]]; then
    env_set "$1" "$2" config
    changed="$changed${changed:+,} $1"
  fi
}

config_report() {
