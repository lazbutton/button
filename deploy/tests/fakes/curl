#!/usr/bin/env bash
# Un faux curl : GitHub et ses versions publiées ($FAKE_STATE/latest, puis
# $FAKE_STATE/releases/vX.Y.Z/), le dépôt de Docker, et la station vue de la
# machine. Une adresse de $FAKE_STATE/here mène à cette machine.
#
# Il joue aussi les alertes : un faux ntfy, qui note chaque message dans
# $FAKE_STATE/ntfy, une ligne de JSON chacun, et le fichier de configuration
# de curl (-K), qui porte le jeton, dans $FAKE_STATE/ntfy-config ; un faux
# serveur SMTP, qui note chaque e-mail dans $FAKE_STATE/mails/N.eml, et son
# envoi (adresse, expéditeur, destinataires, options, configuration) dans
# N.envoi. Un ntfy injoignable : $FAKE_STATE/ntfy-down ; qui refuse le
# jeton : ntfy-refuses. Le faux ntfy se joint en IPv6, ou en IPv4 avec -4 ou
# ntfy-ipv4, et répond comme le vrai à -w. Il limite les messages de la
# machine, avec un 429 et un Retry-After d'un jour, en IPv6 si ntfy-429 dit
# ipv6, sinon en IPv4 aussi ; curl lancé avec --retry attendrait ce jour : le
# faux échoue alors, en le disant. Il répond 503 autant de fois que le dit
# ntfy-503. Un serveur SMTP injoignable : smtp-down ; qui refuse le compte :
# smtp-refuses.
set -euo pipefail
echo "curl $*" >>"$FAKE_STATE/log"
out="" resolve="" url="" config="" data="" upload="" from="" rcpts=() flags=" " write="" retry=0
while (($#)); do
  case $1 in
    -o) out=$2 && shift 2 ;;
    --resolve) resolve=$2 && shift 2 ;;
    -K) config=$2 && shift 2 ;;
    --data-binary) data=$2 && shift 2 ;;
    -T) upload=$2 && shift 2 ;;
    --url) url=$2 && shift 2 ;;
    --mail-from) from=$2 && shift 2 ;;
    --mail-rcpt) rcpts+=("$2") && shift 2 ;;
    -w) write=$2 && shift 2 ;;
    --retry) retry=$2 && shift 2 ;;
    -H | --max-time | --retry-delay | --retry-max-time | --connect-timeout | --cacert) shift 2 ;;
    -*) flags+="$1 " && shift ;;
    *) url=$1 && shift ;;
  esac
done

# La réponse du faux ntfy à -w : le code HTTP, l'adresse jointe, le code de
# sortie et le message d'erreur, comme les donne curl.
ntfy_answer() { # code HTTP, code de sortie, message
  local text=$write ip=2001:db8::1
  [[ $flags != *" -4 "* && ! -e $FAKE_STATE/ntfy-ipv4 ]] || ip=192.0.2.1
  [[ $1 != 000 ]] || ip=""
  text=${text//'%{http_code}'/$1}
  text=${text//'%{remote_ip}'/$ip}
  text=${text//'%{exitcode}'/$2}
  text=${text//'%{errormsg}'/$3}
  printf '%s' "${text//\\n/$'\n'}"
  return "$2"
}

# Le contenu d'un -K, d'un --data-binary @… ou d'un -T : un fichier, ou
# l'entrée standard.
content() {
  if [[ $1 == - ]]; then cat; else cat "$1"; fi
}

case $url in
  https://github.com/*/releases/latest)
    # -w '%{http_code} %{redirect_url}'
    if [[ -e $FAKE_STATE/github-down ]]; then
      printf '503 '
    elif [[ -s $FAKE_STATE/latest ]]; then
      printf '302 https://github.com/lazbutton/button/releases/tag/v%s' "$(cat "$FAKE_STATE/latest")"
    else
      printf '302 https://github.com/lazbutton/button/releases'
    fi
    ;;
  https://github.com/*/releases/download/*)
    file=$FAKE_STATE/releases/${url#*/releases/download/}
    [[ -f $file ]] || exit 22
    cp "$file" "$out"
    ;;
  https://download.docker.com/*) echo "la clé du dépôt de Docker" >"$out" ;;
  http://*/.well-known/button-*)
    address=${resolve#*:80:}
    address=${address#[}
    address=${address%]}
    grep -qxF "$address" "$FAKE_STATE/here" && [[ -f $FAKE_STATE/probe-token ]] || exit 7
    cat "$FAKE_STATE/probe-token"
    ;;
  smtp://* | smtps://*)
    if [[ -e $FAKE_STATE/smtp-down ]]; then
      host=${url#*://}
      echo "curl: (7) Failed to connect to ${host%%[:/]*} port ${host##*:} after 15 ms: Could not connect to server" >&2
      exit 7
    fi
    if [[ -e $FAKE_STATE/smtp-refuses ]]; then
      echo "curl: (67) Login denied" >&2
      exit 67
    fi
    mkdir -p "$FAKE_STATE/mails"
    n=$(($(find "$FAKE_STATE/mails" -name '*.eml' | wc -l) + 1))
    content "$upload" >"$FAKE_STATE/mails/$n.eml"
    {
      echo "adresse $url"
      echo "expéditeur $from"
      echo "destinataires ${rcpts[*]}"
      echo "options$flags"
      [[ -z $config ]] || content "$config"
    } >"$FAKE_STATE/mails/$n.envoi"
    ;;
  https://* | http://*)
    if [[ -n $data ]]; then
      # Un message de ntfy, posté à la racine du serveur.
      if [[ -e $FAKE_STATE/ntfy-down ]]; then
        host=${url#*://}
        ntfy_answer 000 7 "Failed to connect to ${host%%/*} port 443 after 12 ms: Could not connect to server"
      fi
      if [[ -e $FAKE_STATE/ntfy-refuses ]]; then
        ntfy_answer 403 0 ""
        exit 0
      fi
      if [[ -s $FAKE_STATE/ntfy-429 && ($flags != *" -4 "* || $(cat "$FAKE_STATE/ntfy-429") != ipv6) ]]; then
        if ((retry > 0)); then
          echo "faux curl : il attendrait le Retry-After de ntfy, 84064 s, avant de réessayer" >&2
          exit 99
        fi
        ntfy_answer 429 0 ""
        exit 0
      fi
      if [[ -s $FAKE_STATE/ntfy-503 ]]; then
        left=$(cat "$FAKE_STATE/ntfy-503")
        if ((left > 0)); then
          echo $((left - 1)) >"$FAKE_STATE/ntfy-503"
          ntfy_answer 503 0 ""
          exit 0
        fi
      fi
      [[ -z $config ]] || content "$config" >>"$FAKE_STATE/ntfy-config"
      { printf '%s ' "$url"; content "${data#@}"; echo; } >>"$FAKE_STATE/ntfy"
      echo '{"id":"faux","event":"message"}' >"${out:-/dev/stdout}"
      [[ -z $write ]] || ntfy_answer 200 0 ""
    elif [[ $url == https://* ]]; then
      [[ ! -e $FAKE_STATE/https-down ]] || exit 7
    else
      echo "curl : adresse inattendue, $url" >&2
      exit 2
    fi
    ;;
  *)
    echo "curl : adresse inattendue, $url" >&2
    exit 2
    ;;
esac
