#!/usr/bin/env bash
# Un faux docker, hors de fakes/ : la machine des tests ne l'a que si
# $FAKE_STATE/bin y mène, comme après l'installation de Docker. Il note chaque
# appel dans $FAKE_STATE/log, et joue une machine où tout va bien, sauf ce que
# disent les fichiers de $FAKE_STATE.
set -euo pipefail
state=$FAKE_STATE
if [[ $1 == compose ]]; then
  echo "docker $* (dans $PWD)" >>"$state/log"
else
  echo "docker $*" >>"$state/log"
fi

# Les services de la station, avec le profil vps, et leur état quand elle
# tourne : $state/ps le remplace.
SERVICES=(caddy catalog console icecast meilisearch nowplaying radiotomate-dropbox radiotomate-init
  radiotomate-interface radiotomate-playout radiotomate-scheduler tusd)
running_services() {
  local service
  for service in "${SERVICES[@]}"; do
    case $service in
      radiotomate-init) echo "button-$service-1|$service|exited||0" ;;
      radiotomate-interface | radiotomate-playout | radiotomate-scheduler) echo "button-$service-1|$service|running|healthy|0" ;;
      *) echo "button-$service-1|$service|running||0" ;;
    esac
  done
}

# radiotomate-init, à chaque démarrage du moteur : il migre la base au schéma
# de la version de .env, que dit $state/schema-<version>, après en avoir fait
# une copie dans backups/, comme le vrai. Sans ce fichier, rien ne migre. La
# migration vers le schéma que dit $state/migration-fails échoue, et celles
# d'avant restent. Une version plus ancienne que la base ne démarre pas.
migrate() {
  local version target current step db=data/radiotomate/radiotomate.db
  version=$(sed -n 's/^BUTTON_VERSION=//p' .env | tail -n 1)
  [[ -f $state/schema-$version && -f $db ]] || return 0
  target=$(<"$state/schema-$version")
  current=$(sed -n 's/^schema=//p' "$db")
  if ((current > target)); then
    echo "ModuleNotFoundError: No module named 'radiotomate.commands.update.v$current'" >&2
    return 1
  fi
  ((current < target)) || return 0
  mkdir -p data/radiotomate/backups
  cp "$db" "data/radiotomate/backups/avant-v$((current + 1))-$(date -u +%Y%m%dT%H%M%SZ).db"
  for ((step = current + 1; step <= target; step++)); do
    if [[ $(cat "$state/migration-fails" 2>/dev/null) == "$step" ]]; then
      echo "Applying schema change #$step... rolled back" >&2
      return 1
    fi
    sed -i "s/^schema=.*/schema=$step/" "$db"
  done
  echo "migration : v$current → v$target" >>"$state/log"
}

# docker compose run, sur les données de la station : -v, et /data, le RT_DATA
# par défaut. Il joue backup-radiotomate.sh et restore-radiotomate.sh comme
# les vrais, sur une base faite d'une ligne « schema=N », puis d'autres ; et
# les blocs Python de station, reconnus à leur première ligne.
compose_run() {
  local entrypoint="" volumes=() envs=() spec
  while (($#)); do
    case $1 in
      --rm | --no-deps | -T) shift ;;
      -v)
        volumes+=("$2")
        shift 2
        ;;
      -e)
        envs+=("$2")
        shift 2
        ;;
      --entrypoint)
        entrypoint=$2
        shift 2
        ;;
      *)
        # Le service.
        shift
        break
        ;;
    esac
  done
  host() { # chemin dans le conteneur, ou dans un dossier monté
    local target
    for spec in "${volumes[@]}"; do
      spec=${spec%:ro}
      target=${spec#*:}
      if [[ $1 == "$target" || $1 == "$target"/* ]]; then
        echo "${spec%%:*}${1#"$target"}"
        return
      fi
    done
    [[ $1 != /data && $1 != /data/* ]] || echo "$PWD/data/radiotomate${1#/data}"
  }
  local tmp script
  case "$entrypoint ${1:-}" in
    "bash /backup-radiotomate.sh")
      # L'image du moteur n'a pas sqlite3 : un script sans repli Python, comme
      # celui de la 0.2.0, y échoue.
      if [[ -e $state/backup-fails ]] || ! grep -q python3 "$(host /backup-radiotomate.sh)"; then
        echo "sqlite3 is required" >&2
        exit 1
      fi
      tmp=$(mktemp -d)
      mkdir "$tmp/radiotomate"
      cp "$(host /data)/radiotomate.db" "$tmp/radiotomate/"
      [[ ! -f $(host /data)/radiotomate.yaml ]] || cp "$(host /data)/radiotomate.yaml" "$tmp/radiotomate/"
      (cd "$tmp/radiotomate" && sha256sum ./* >SHA256SUMS)
      tar -czf "$(host /sauvegarde)/radiotomate.tar.gz" -C "$tmp" radiotomate
      rm -rf "$tmp"
      echo /sauvegarde/radiotomate.tar.gz
      ;;
    "bash /restore-radiotomate.sh")
      if ! grep -q python3 "$(host /restore-radiotomate.sh)"; then
        echo "sqlite3 is required" >&2
        exit 1
      fi
      # Une copie de la base seule, à la place de la base en place, qui reste
      # à côté : la station arrêtée. Une fois, elle échoue : $state/restore-fails.
      if [[ $2 == *.db ]]; then
        if [[ -e $state/restore-fails ]]; then
          rm "$state/restore-fails"
          echo "No space left on device" >&2
          exit 1
        fi
        if [[ -e $state/caddy-running || -e $state/engine-running ]]; then
          echo "database in use or unreadable: /data/radiotomate.db" >&2
          exit 1
        fi
        tmp=$(host "$3")
        [[ -f $(host "$2") ]] || {
          echo "missing archive, or not readable: $2" >&2
          exit 1
        }
        mkdir -p "$tmp/backups"
        cp "$tmp/radiotomate.db" "$tmp/backups/avant-restauration-$(date -u +%Y%m%dT%H%M%SZ).db"
        cp "$(host "$2")" "$tmp/radiotomate.db"
        echo "restaurée : $2" >>"$state/log"
        echo "/data/radiotomate.db"
        exit 0
      fi
      if [[ -n $(ls -A "$(host /cible)") ]]; then
        echo "refusing to restore into a non-empty directory: /cible" >&2
        exit 1
      fi
      tmp=$(mktemp -d)
      tar -xzf "$(host /sauvegarde.tar.gz)" -C "$tmp"
      cp -a "$tmp/radiotomate/." "$(host /cible)/"
      rm -rf "$tmp"
      echo /cible
      ;;
    "python3 -")
      script=$(cat)
      case $script in
        "# schémas"*)
          sed -n 's/^schema=//p' "$(host /data)/radiotomate.db" "$(host /cible)/radiotomate.db"
          ;;
        "# copie"*)
          # Le schéma de la base en place, puis l'état de la copie : ok, sauf
          # $state/copy-corrupt, comme SQLite devant une copie abîmée.
          local copy
          for spec in "${envs[@]}"; do
            [[ $spec != BUTTON_COPY=* ]] || copy=${spec#*=}
          done
          sed -n 's/^schema=//p' "$(host /data)/radiotomate.db"
          if [[ -e $state/copy-corrupt ]]; then
            echo "database disk image is malformed"
          elif [[ -f $(host /data/backups)/$copy ]]; then
            echo ok
          else
            echo "unable to open database file"
          fi
          ;;
        "# version"*)
          # L'image de la version de BUTTON_VERSION : le schéma qu'elle lit
          # au plus, $state/schema-<version>, sinon 18.
          sed -n 's/^schema=//p' "$(host /data)/radiotomate.db"
          cat "$state/schema-${BUTTON_VERSION:-}" 2>/dev/null || echo 18
          ;;
        "# relevé"*)
          # versions.json, par un conteneur du moteur : sauf si les versions
          # n'ont pas changé. Il échoue avec $state/versions-fails.
          local body="" file
          [[ ! -e $state/versions-fails ]] || exit 1
          for spec in "${envs[@]}"; do
            [[ $spec != BUTTON_VERSIONS=* ]] || body=${spec#*=}
          done
          file=$(host /data)/versions.json
          if [[ ! -f $file ]] || ! grep -qF -- "$body" "$file"; then
            printf '{"recorded_at":"%s",%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$body" >"$file"
            chmod 644 "$file"
          fi
          ;;
        "# domaine"*)
          echo "réglages du domaine : ${envs[*]}" >>"$state/log"
          cat "$state/domain-keys" 2>/dev/null ||
            printf 'station.public_stream_url\nstation.now_url\nstation.status_url\nstation.harbor_host\n'
          ;;
        *)
          echo "docker : script Python inattendu" >&2
          exit 2
          ;;
      esac
      ;;
    " ")
      # radiotomate-init lui-même, que station config relance pour que
      # radiotomate.yaml suive les alertes de .env : il note celles qu'il lit.
      # Il échoue avec $state/init-fails.
      if [[ -e $state/init-fails ]]; then
        echo "radiotomate-init : échec" >&2
        exit 1
      fi
      echo "radiotomate-init relancé : $(grep -E '^BUTTON_ALERT_(NTFY|EMAIL)=' .env | tr '\n' ' ')" >>"$state/log"
      ;;
    *)
      echo "docker : docker compose run inattendu, $entrypoint $*" >&2
      exit 2
      ;;
  esac
}

# docker run de l'image de restic : un faux restic, sur un dépôt fait d'un
# dossier, $state/depots/<le dépôt, en lettres et _>, avec son mot de passe et
# ses sauvegardes, une par dossier, dans l'ordre, sous snapshots/. Les chemins
# du conteneur mènent à ceux de la machine par les -v, le plus long d'abord :
# la banque se monte dans la sauvegarde. Les secrets viennent de
# l'environnement, comme pour le vrai, jamais de la ligne de commande. Un
# stockage qui ne répond pas : $state/restic-down ; qui refuse la clé SSH ou
# les clés S3 : $state/restic-refuses. Une sauvegarde qui échoue :
# $state/restic-backup-fails ; faite sans des fichiers illisibles, code 3 :
# $state/restic-backup-partial. Une rotation qui échoue :
# $state/restic-forget-fails, sans un mot s'il n'est pas vide ; un dépôt que
# check refuse :
# $state/restic-check-fails. ssh-keygen, par --entrypoint, pose une fausse clé.
restic_run() {
  local volumes=() entrypoint="" spec repo command
  shift
  while (($#)); do
    case $1 in
      --rm) shift ;;
      --network | --cpu-shares | --oom-score-adj) shift 2 ;;
      -e)
        [[ $2 != *=* ]] || export "${2?}"
        shift 2
        ;;
      -v)
        volumes+=("$2")
        shift 2
        ;;
      --entrypoint)
        entrypoint=$2
        shift 2
        ;;
      docker.io/restic/restic:*)
        shift
        break
        ;;
      *)
        echo "docker : option inattendue pour restic, $1" >&2
        exit 2
        ;;
    esac
  done
  on_host() { # chemin dans le conteneur
    local target best="" path=""
    for spec in "${volumes[@]}"; do
      target=${spec#*:}
      target=${target%:ro}
      if [[ $1 == "$target" || $1 == "$target"/* ]] && ((${#target} > ${#best})); then
        best=$target
        path=${spec%%:*}
      fi
    done
    [[ -n $best ]] || {
      echo "docker : $1, dans le conteneur de restic, sans volume" >&2
      exit 2
    }
    echo "$path${1#"$best"}"
  }
  if [[ $entrypoint == ssh-keygen ]]; then
    local key=""
    while (($#)); do
      [[ $1 != -f ]] || key=$(on_host "$2")
      shift
    done
    echo "une fausse clé privée" >"$key"
    chmod 600 "$key"
    echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAUSSE button-sauvegarde@radio.example" >"$key.pub"
    exit 0
  fi
  repo=$state/depots/$(printf '%s' "$RESTIC_REPOSITORY" | tr -c 'A-Za-z0-9' '_')
  command=$1
  shift
  if [[ -e $state/restic-down ]]; then
    echo "Fatal: unable to open repository at $RESTIC_REPOSITORY: dial tcp: connection refused" >&2
    exit 1
  fi
  if [[ -e $state/restic-refuses ]]; then
    if [[ $RESTIC_REPOSITORY == sftp:* ]]; then
      echo "subprocess ssh: ci@sauvegarde.example: Permission denied (publickey)." >&2
    else
      echo "Fatal: Fatal: create repository at $RESTIC_REPOSITORY failed: client.BucketExists: The request signature we calculated does not match the signature you provided." >&2
    fi
    exit 1
  fi
  if [[ $command == init ]]; then
    if [[ -d $repo ]]; then
      echo "Fatal: Fatal: create key in repository at $RESTIC_REPOSITORY failed: repository master key and config already initialized" >&2
      exit 1
    fi
    mkdir -p "$repo/snapshots"
    printf '%s\n' "$RESTIC_PASSWORD" >"$repo/password"
    echo "created restic repository 0f1e2d3c4b at $RESTIC_REPOSITORY"
    exit 0
  fi
  if [[ ! -d $repo ]]; then
    echo "Fatal: repository does not exist: unable to open config file: Stat: The specified key does not exist." >&2
    exit 10
  fi
  if [[ $(cat "$repo/password") != "$RESTIC_PASSWORD" ]]; then
    echo "Fatal: wrong password or no key found" >&2
    exit 12
  fi
  local snapshot id tags=() host="" target="" includes=() path destination
  case $command in
    cat) echo '{"version": 2, "id": "0f1e2d3c4b"}' ;;
    backup)
      # backup /sauvegarde --host … --tag … : ce qui est monté là, et dessous.
      local source=$1
      shift
      while (($#)); do
        case $1 in
          --host) host=$2 ;;
          --tag) tags+=("$2") ;;
        esac
        shift 2
      done
      if [[ -e $state/restic-backup-fails ]]; then
        echo "Fatal: unable to save snapshot: connection reset by peer" >&2
        exit 1
      fi
      id=$(printf '%04x%04x' "$RANDOM" "$RANDOM")
      snapshot=$repo/snapshots/$(printf '%03d' $(($(find "$repo/snapshots" -mindepth 1 -maxdepth 1 | wc -l) + 1)))-$id
      mkdir -p "$snapshot/tree"
      while IFS= read -r spec; do
        path=${spec%%:*}
        spec=${spec#*:}
        spec=${spec%:ro}
        [[ $spec == "$source" || $spec == "$source"/* ]] || continue
        mkdir -p "$snapshot/tree$spec"
        cp -a "$path/." "$snapshot/tree$spec/"
      done < <(for spec in "${volumes[@]}"; do
        path=${spec#*:}
        printf '%d\t%s\n' "${#path}" "$spec"
      done | sort -n | cut -f2-)
      printf '%s\n' "${tags[@]}" >"$snapshot/tags"
      echo "$host" >"$snapshot/host"
      echo "no parent snapshot found, will read all files"
      echo "Added to the repository: 2.000 KiB (1.000 KiB stored)"
      echo "snapshot $id saved"
      if [[ -e $state/restic-backup-partial ]]; then
        echo "Warning: at least one source file could not be read" >&2
        exit 3
      fi
      ;;
    forget)
      # Sans un mot, si le fichier n'est pas vide.
      if [[ -s $state/restic-forget-fails ]]; then
        exit 1
      elif [[ -e $state/restic-forget-fails ]]; then
        echo "Fatal: unable to remove snapshots: connection reset by peer" >&2
        exit 3
      fi
      echo "Applying Policy: keep 7 daily, 4 weekly, 6 monthly snapshots"
      ;;
    snapshots)
      echo "ID        Time                 Host    Tags"
      for snapshot in "$repo"/snapshots/*; do
        [[ -d $snapshot ]] || continue
        printf '%s  %s  %s  %s\n' "${snapshot##*-}" "$(date -r "$snapshot" '+%Y-%m-%d %H:%M:%S')" "$(cat "$snapshot/host")" \
          "$(paste -sd , "$snapshot/tags")"
      done
      ;;
    restore)
      # restore ID|latest [--host …] --target … --include … : chaque chemin
      # inclus, de la sauvegarde au dossier monté.
      local wanted=$1
      shift
      while (($#)); do
        case $1 in
          --target) target=$2 ;;
          --include) includes+=("$2") ;;
        esac
        shift 2
      done
      if [[ $wanted == latest ]]; then
        snapshot=$(find "$repo/snapshots" -mindepth 1 -maxdepth 1 | sort | tail -n 1)
      else
        snapshot=$(find "$repo/snapshots" -mindepth 1 -maxdepth 1 -name "*-$wanted*" | head -n 1)
      fi
      if [[ -z $snapshot && $wanted == latest ]]; then
        echo "Fatal: failed to find snapshot: snapshot filter (Paths:[] Tags:[] Hosts:[button]): no snapshot found" >&2
        exit 1
      elif [[ -z $snapshot ]]; then
        echo "Fatal: no matching ID found for prefix \"$wanted\"" >&2
        exit 1
      fi
      echo "restoring snapshot ${snapshot##*-} of [/sauvegarde] at $(date) by root@button to $target"
      destination=$(on_host "$target")
      for path in "${includes[@]}"; do
        [[ -e $snapshot/tree$path ]] || continue
        mkdir -p "$destination${path%/*}"
        cp -a "$snapshot/tree$path" "$destination$path"
      done
      echo "Summary: Restored ${#includes[@]} files/dirs"
      ;;
    check)
      if [[ -e $state/restic-check-fails ]]; then
        echo "Fatal: repository contains errors" >&2
        exit 1
      fi
      echo "no errors were found"
      ;;
    *)
      echo "docker : commande de restic inattendue, $command" >&2
      exit 2
      ;;
  esac
}

# radiotomate maintenance updates, les demandes de la console (MAJ-07), dans
# le moteur qui tourne, dans RT_DATA/updates comme le vrai : la demande ouverte
# dans demande, « ID ÉTAT », et request.json tant qu'elle l'est ; ce que la
# machine dit d'elle dans host.json. Pourquoi elle attend va dans
# $state/attente, et comment elle finit dans $state/resultat, ses options
# puis son détail. Un moteur d'avant les demandes : $state/updates-unknown ;
# un moteur qui ne répond pas : $state/engine-down ; qui ne prend pas un
# résultat, ou une attente, une fois : $state/finish-fails, $state/wait-fails.
engine_updates() {
  local words=("$@") at=0 command id data=data/radiotomate/updates text
  local request=$data/demande
  while [[ ${words[at]} != updates ]]; do at=$((at + 1)); done
  command=${words[at + 1]:-}
  id=${words[at + 2]:-}
  text=$(cat)
  if [[ -e $state/updates-unknown ]]; then
    echo "Error: No such command 'updates'." >&2
    exit 2
  fi
  if [[ -e $state/engine-down ]]; then
    echo 'service "radiotomate-interface" is not running' >&2
    exit 1
  fi
  case $command in
    host)
      mkdir -p "$data"
      printf '%s\n' "$text" >"$data/host.json"
      [[ ! -f $request ]] || cat "$request"
      ;;
    show) [[ ! -f $request ]] || cat "$request" ;;
    wait)
      if [[ -e $state/wait-fails ]]; then
        rm "$state/wait-fails"
        exit 1
      fi
      [[ -f $request && $(cut -d' ' -f1 "$request") == "$id" ]] || exit 1
      printf '%s\n' "$text" >"$state/attente"
      echo "$id pending" >"$request"
      ;;
    start)
      [[ -f $request && $(cat "$request") == "$id pending" ]] || exit 1
      echo "$id running" >"$request"
      ;;
    finish)
      # Un moteur qui redémarre à ce moment-là, une fois : $state/finish-fails.
      if [[ -e $state/finish-fails ]]; then
        rm "$state/finish-fails"
        exit 1
      fi
      [[ -f $request && $(cut -d' ' -f1 "$request") == "$id" ]] || exit 1
      rm -f "$request" "$data/request.json"
      printf '%s\n%s\n' "${words[*]:at+2}" "$text" >"$state/resultat"
      ;;
    *) exit 2 ;;
  esac
}

case $1 in
  version) echo 27.3.1 ;;
  info)
    [[ ! -e $state/docker-down ]] || exit 1
    [[ ${2:-} != --format ]] || echo /var/lib/docker
    ;;
  pull | rm) ;;
  # Une image qui manque sur la machine : $state/image-missing.
  image) [[ ${2:-} != inspect || ! -e $state/image-missing ]] || exit 1 ;;
  # Ce que le projet garde après une désinstallation, ou ce qui tourne quand
  # station relève les versions : $state/containers et $state/volumes, un par
  # ligne.
  ps) cat "$state/containers" 2>/dev/null || true ;;
  # Leur service, leur image et leur version : $state/inspect ; ou leur
  # identifiant, leur service et les chemins qu'ils montent :
  # $state/inspect-mounts ; ou leur identifiant et leur service :
  # $state/inspect-services.
  inspect)
    if [[ " $* " == *".Mounts"* ]]; then
      cat "$state/inspect-mounts" 2>/dev/null || true
    elif [[ " $* " == *" {{.Id}}|"* ]]; then
      cat "$state/inspect-services" 2>/dev/null || true
    else
      cat "$state/inspect" 2>/dev/null || true
    fi
    ;;
  volume) [[ ${2:-} != ls ]] || cat "$state/volumes" 2>/dev/null || true ;;
  login) echo "login ${*:2} jeton=$(cat)" >>"$state/login" ;;
  run)
    if [[ " $* " == *" docker.io/restic/restic:"* ]]; then
      restic_run "$@"
    elif [[ " $* " == *" caddy respond "* ]]; then
      # Le jeton de la vérification du domaine : son dernier argument.
      echo "${*: -1}" >"$state/probe-token"
      echo probe
    elif [[ " $* " == *" nslookup "* ]]; then
      # Comme deux nslookup de busybox, A puis AAAA : $state/dns-a et
      # dns-aaaa, une adresse par ligne.
      for kind in a aaaa; do
        printf 'Server:\t\t127.0.0.11\nAddress:\t127.0.0.11:53\n\n'
        if [[ ! -s $state/dns-$kind ]]; then
          echo "*** Can't find ${*: -1}: No answer"
          continue
        fi
        echo "Non-authoritative answer:"
        while read -r address; do
          printf 'Name:\t%s\nAddress: %s\n\n' "${*: -1}" "$address"
        done <"$state/dns-$kind"
      done
    fi
    ;;
  compose)
    shift
    # Les options données avant la commande : les profils, tous pour station,
    # et les fichiers d'une version que station update tire avant de les poser.
    profiled=""
    while [[ ${1:-} == --profile || ${1:-} == -f || ${1:-} == --project-directory ]]; do
      [[ $1 != --profile ]] || profiled=1
      shift 2
    done
    command=$1
    shift
    case $command in
      version)
        [[ ! -e $state/no-compose ]] || exit 1
        [[ ${1:-} != --short ]] || echo 2.29.7
        ;;
      ps)
        if [[ " $* " == *" --services "* ]]; then
          # Avec tous les profils, ce qui tourne : $state/services-running, où
          # share peut être, lancé à part.
          if [[ -n $profiled && -f $state/services-running ]]; then
            cat "$state/services-running"
          elif [[ -e $state/caddy-running || -e $state/engine-running ]]; then
            echo radiotomate-playout
          fi
        elif [[ " $* " == *" --format "* ]]; then
          if [[ -f $state/ps ]]; then
            cat "$state/ps"
          elif [[ -e $state/caddy-running || -e $state/engine-running ]]; then
            running_services
          fi
        # Caddy, ou la station sans lui : $state/caddy-running, engine-running.
        elif [[ ${*: -1} == caddy ]]; then
          [[ ! -e $state/caddy-running ]] || echo caddy
        elif [[ -e $state/caddy-running || -e $state/engine-running ]]; then
          echo radiotomate-playout
        fi
        ;;
      config)
        # Un avertissement de Compose, sur la sortie d'erreur : $state/compose-warning.
        [[ ! -f $state/compose-warning ]] || cat "$state/compose-warning" >&2
        case " $* " in
          *" --services "*) printf '%s\n' "${SERVICES[@]}" ;;
          *" --profiles "*) printf 'cloud\nshare\nvps\n' ;;
          *" --images "*) printf 'caddy:2.11-alpine\nghcr.io/lazbutton/button-radiotomate:0.1.0\n' ;;
        esac
        ;;
      pull)
        # La version tirée : celle de .env, sauf BUTTON_VERSION du shell.
        echo "images : BUTTON_VERSION=${BUTTON_VERSION-celle de .env}" >>"$state/log"
        [[ ! -e $state/pull-fails ]] || exit 1
        ;;
      up)
        # Une fois, ou le nombre de fois qu'il dit : $state/up-fails.
        if [[ -e $state/up-fails ]]; then
          fails=$(cat "$state/up-fails")
          if ((${fails:-1} > 1)); then
            echo $((fails - 1)) >"$state/up-fails"
          else
            rm "$state/up-fails"
          fi
          exit 1
        fi
        # Ce que docker compose recevrait du shell, à la place de .env.
        echo "environnement : TZ=${TZ-absent} DOMAIN=${DOMAIN-absent}" >>"$state/log"
        [[ -e $state/env-at-first-up ]] || cp .env "$state/env-at-first-up"
        # radiotomate-init crée la base et radiotomate.yaml, et Caddy son
        # certificat ; puis Caddy tourne.
        mkdir -p data/radiotomate data/caddy/certificates
        [[ -s data/radiotomate/radiotomate.db ]] ||
          printf 'schema=18\nid=%s\n' "$RANDOM$RANDOM" >data/radiotomate/radiotomate.db
        [[ -f data/radiotomate/radiotomate.yaml ]] || echo "db: {}" >data/radiotomate/radiotomate.yaml
        [[ -f data/caddy/certificates/site.crt ]] || echo "certificat $RANDOM$RANDOM" >data/caddy/certificates/site.crt
        # radiotomate-init ne repasse pas pour Caddy seul, ni sans dépendances.
        if [[ " $* " != *" --no-deps "* && ${*: -1} != caddy ]]; then
          migrate || exit 1
        fi
        touch "$state/caddy-running"
        ;;
      stop)
        if [[ ${*: -1} == caddy ]]; then
          rm -f "$state/caddy-running"
        elif ((!$#)); then
          rm -f "$state/caddy-running" "$state/engine-running"
        fi
        ;;
      down) rm -f "$state/caddy-running" "$state/engine-running" ;;
      logs) echo "les journaux de la station" ;;
      exec)
        if [[ " $* " == *" python3 "* ]]; then
          echo "$*" >>"$state/settings"
          cat >"$state/settings.py"
          printf 'station.name\nstation.public_stream_url\n'
        elif [[ " $* " == *" maintenance next-live "* ]]; then
          [[ ! -e $state/next-live-fails ]] || exit 1
          cat "$state/next-live" 2>/dev/null || echo "QG, mercredi 23 septembre à 20:00, dans 2 j 8 h"
        elif [[ " $* " == *" maintenance window "* ]]; then
          # Un moteur d'avant la commande : $state/window-unknown. Une
          # fenêtre prise : $state/window, une fois ; prise à la lecture
          # suivante seulement : $state/window-later.
          if [[ -e $state/window-unknown ]]; then
            echo "Error: No such command 'window'." >&2
            exit 2
          elif [[ -f $state/window ]]; then
            cat "$state/window"
            rm "$state/window"
            exit 1
          fi
          # Prise après tant de lectures libres : $state/window-later-reads, 1
          # sans lui.
          if [[ -f $state/window-later ]]; then
            reads=$(cat "$state/window-later-reads" 2>/dev/null || echo 1)
            if ((reads > 1)); then
              echo $((reads - 1)) >"$state/window-later-reads"
            else
              mv "$state/window-later" "$state/window"
              rm -f "$state/window-later-reads"
            fi
          fi
          echo "libre : ni direct ni diffusion de l'Agenda d'ici 30 min"
        elif [[ " $* " == *" maintenance updates "* ]]; then
          engine_updates "$@"
        else
          echo "le moteur : $*"
        fi
        ;;
      run) compose_run "$@" ;;
    esac
    ;;
esac
