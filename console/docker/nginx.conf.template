server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 512m;

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(js|css|png|svg|ico|woff2?)$ {
        try_files $uri =404;
    }

    location = /_session {
        internal;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $rt_backend ${AUTOMATE_BACKEND};
        proxy_pass $rt_backend/account.json;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $http_host;
    }

    location = /library/inbox.json {
        auth_request /_session;
        proxy_pass ${CATALOG_UPSTREAM}/inbox.json;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 30s;
    }

    location /tus/ {
        auth_request /_session;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass ${TUSD_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /library/ {
        proxy_pass ${CATALOG_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location ~ ^/(csrf\.json|login\.json|login|logout|live\.json|account\.json|users\.json|users/|carts\.json|carts/|autodj/|antenne/|health/|system/) {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $rt_backend ${AUTOMATE_BACKEND};
        proxy_pass $rt_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_pass_header Set-Cookie;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
