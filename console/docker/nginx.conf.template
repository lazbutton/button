# A guest's token never reaches the logs, and public pages are throttled.
map $request_uri $button_loggable_uri {
    ~^(?<button_head>/public/guest/)[^/?.]+(?<button_tail>.*)$ "${button_head}…${button_tail}";
    default $request_uri;
}
log_format button_masked '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $button_loggable_uri $server_protocol" '
                         '$status $body_bytes_sent "-" "$http_user_agent"';
limit_req_zone $binary_remote_addr zone=button_public:10m rate=10r/s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 512m;
    access_log /var/log/nginx/access.log button_masked;

    # Each block that answers the browser includes the security headers: one
    # with its own add_header would not inherit them from here. Internal blocks
    # answer nginx only. src/api/nginxRoutes.test.ts checks.

    # Vite's hashed files, cached for a year. ^~ skips the regex blocks: the
    # one below would otherwise serve the .js and .css, without the cache.
    location ^~ /assets/ {
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(js|css|png|svg|ico|woff2?)$ {
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    location = /_session {
        internal;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $rt_backend ${AUTOMATE_BACKEND};
        proxy_pass $rt_backend/account.json;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $http_host;
    }

    # tus: a team session (carts or Auto-DJ), or a guest's link (X-Invite-Token).
    location = /_deposit {
        internal;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $rt_backend ${AUTOMATE_BACKEND};
        proxy_pass $rt_backend/agenda/deposit-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Invite-Token $http_x_invite_token;
        proxy_set_header Host $http_host;
    }

    location = /library/inbox.json {
        include /etc/nginx/security-headers.conf;
        auth_request /_session;
        proxy_pass ${CATALOG_UPSTREAM}/inbox.json;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 30s;
    }

    location /tus/ {
        include /etc/nginx/security-headers.conf;
        auth_request /_deposit;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass ${TUSD_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # The catalogue (search, pre-listen): a team session. The catalogue checks
    # it too, since its port can be reached without nginx.
    location /library/ {
        include /etc/nginx/security-headers.conf;
        auth_request /_session;
        proxy_pass ${CATALOG_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # A guest's page (Agenda): /invitation#<token>. The token stays after the
    # "#", so it never reaches a server; its API is throttled, never indexed.
    location = /invitation {
        include /etc/nginx/security-headers.conf;
        set $button_referrer_policy "no-referrer";
        limit_req zone=button_public burst=20 nodelay;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files /index.html =404;
    }

    location ^~ /public/ {
        include /etc/nginx/security-headers.conf;
        # The engine sets its own Referrer-Policy (no-referrer) on these
        # answers: empty, nginx adds none.
        set $button_referrer_policy "";
        limit_req zone=button_public burst=20 nodelay;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $rt_backend ${AUTOMATE_BACKEND};
        proxy_pass $rt_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # Engine routes. A route missing here works in dev (Vite proxy) and gets
    # the console's index.html in prod: src/api/nginxRoutes.test.ts checks it.
    location ~ ^/(csrf\.json|login\.json|login|logout|live\.json|account\.json|users\.json|users/|carts\.json|carts/|media/bank\.json|autodj/|antenne/|agenda\.json|agenda/|health/|system/) {
        include /etc/nginx/security-headers.conf;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $rt_backend ${AUTOMATE_BACKEND};
        proxy_pass $rt_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_pass_header Set-Cookie;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
