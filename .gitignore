# Système et éditeurs
.DS_Store
.vscode/
.idea/
.claude/settings.local.json

# Python (le moteur a aussi son propre .gitignore)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Déploiement : secrets, données et réglages propres à une machine
deploy/.env
deploy/data/
deploy/media/
deploy/compose.override.yml
deploy/local/data/
# Motifs propres à une station, pour scripts/verifier.sh donnees : leur liste
# est elle-même une donnée de la station
.motifs-station
# Parcours de la console (scripts/e2e.sh) : un dossier par lancement, avec sa
# base, ses comptes et leur mot de passe tiré au sort, ses journaux et ses traces
/.e2e/
# Added by code-review-graph
.code-review-graph/

# Claude Code : lanceurs locaux (chemins de la machine) et worktrees des agents
.claude/launch.json
.claude/worktrees/
